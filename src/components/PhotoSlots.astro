---
// A form's photos: a tile per photo with ×, and a dashed "Thêm ảnh" tile
// while there is room. Each photo uploads as it is picked and posts as a
// hidden `name` field holding its upload id (lib/photo-slots.ts).
import { PHOTO_TYPES } from '../lib/upload';
import Icon from './Icon.astro';
import Photo from './Photo.astro';

interface Props {
  /** The field each upload id posts as. */
  name: string;
  max: number;
  /** The photos the form starts with. */
  photos?: { id: string; thumb: string }[];
  label: string;
  class?: string;
}

const { name, max, photos = [], label, class: cls } = Astro.props;
const tile = 'relative aspect-square overflow-hidden rounded-lg bg-surface-container-high';
const remove = 'absolute right-1.5 top-1.5 grid h-7 w-7 place-items-center rounded-full bg-black/55 text-white backdrop-blur';
---

<div class={cls} data-photo-slots data-max={max}>
  <div class="flex items-center justify-between gap-3 px-1">
    <span class="text-body-small text-on-surface-variant">{label}</span>
    <span class="rounded-full bg-surface-container-low px-2.5 py-0.5 text-label-medium text-on-surface-variant tabular-nums" data-photo-count>
      {photos.length}/{max}
    </span>
  </div>
  <ol class="mt-2 grid max-w-[400px] grid-cols-4 gap-2" data-photos>
    {
      photos.map((p) => (
        <li class={tile} data-photo>
          <input type="hidden" name={name} value={p.id} />
          <Photo src={p.thumb} width={200} height={200} alt="" class="h-full w-full object-cover" />
          <button type="button" class={remove} aria-label="Bỏ ảnh" data-photo-remove>
            <Icon name="close-rounded" size={15} />
          </button>
        </li>
      ))
    }
    <li class="aspect-square" hidden={photos.length >= max} data-photo-add>
      <label class="flex h-full cursor-pointer flex-col items-center justify-center gap-1 rounded-lg border-[1.5px] border-dashed border-primary/40 bg-secondary-container/40 p-1 text-center has-focus-visible:ring-2 has-focus-visible:ring-primary">
        <input type="file" accept={PHOTO_TYPES.join(',')} multiple class="sr-only" data-photo-input />
        <Icon name="add-photo-alternate-outline-rounded" size={22} class="text-primary" />
        <span class="whitespace-nowrap text-label-medium text-ink">Thêm ảnh</span>
      </label>
    </li>
  </ol>
  <template data-photo-tpl>
    <li class={tile} data-photo>
      <input type="hidden" name={name} value="" />
      <img alt="" width="200" height="200" class="h-full w-full object-cover" />
      <span class="absolute inset-0 grid place-items-center bg-black/40 text-white" data-photo-busy><span class="spinner"></span></span>
      <button type="button" class={remove} aria-label="Bỏ ảnh" data-photo-remove>
        <Icon name="close-rounded" size={15} />
      </button>
    </li>
  </template>
  <noscript><p class="mt-2 px-1 text-body-small text-on-surface-variant">Cần bật JavaScript để thêm ảnh.</p></noscript>
  <p role="status" class="mt-1 px-1 text-body-small text-ink empty:hidden" data-photo-status></p>
</div>

<script>
  import { photoSlots } from '../lib/photo-slots';

  document.querySelectorAll<HTMLElement>('[data-photo-slots]').forEach(photoSlots);
</script>
