---
import Photo from './Photo.astro';
// A person's face from its URL, or their initial on one of the app's four tones (by the name's hash).

interface Props {
  name: string;
  photo?: string;
  size: number;
  class?: string;
  /** "lazy" when it sits below the first screen. */
  loading?: 'eager' | 'lazy';
}

const { name, photo, size, class: cls, loading } = Astro.props;
const TONES = [
  'bg-secondary-container text-on-secondary-container',
  'bg-primary-container text-on-primary-container',
  'bg-tertiary-container text-on-tertiary-container',
  'bg-surface-container-highest text-on-surface-variant',
];
const tone = TONES[[...name].reduce((s, c) => s + c.codePointAt(0)!, 0) % TONES.length];
const style = `width:${size}px;height:${size}px`;
---

{
  photo ? (
    <Photo src={photo} width={size * 2} height={size * 2} alt="" loading={loading} class:list={['shrink-0 rounded-full object-cover', cls]} style={style} />
  ) : (
    <span class:list={['grid shrink-0 place-items-center rounded-full text-label-medium', tone, cls]} style={style} aria-hidden="true">
      {name[0]}
    </span>
  )
}
