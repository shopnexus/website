---
// Quy định đăng tin and Điều khoản share this frame: a sticky table of contents,
// the numbered text in one readable column, and a summary card. The default
// slot fills the right column. The contents follow the section in view.
import Crumbs from '../Crumbs.astro';
import Icon from '../Icon.astro';
import type { LegalSection } from '../../data/flows';
import { R } from '../../lib/routes';
import { btnCls, PANEL } from '../../lib/ui';

interface Props {
  title: string;
  updated: string;
  sections: LegalSection[];
}

const { title, updated, sections } = Astro.props;
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<Crumbs parts={[['Trợ giúp và an toàn', R.help], [title]]} class="pt-6" />
<div class="mt-4 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-j-28 text-ink lg:text-j-30">{title}</h1>
    <p class="mt-2 text-body-medium text-on-surface-variant">Cập nhật ngày {updated} · {sections.length} mục</p>
  </div>
  <div class="flex gap-2">
    <button type="button" class={btnCls('line')} data-print><Icon name="print-outline-rounded" size={18} />In</button>
    <button type="button" class={btnCls('line')} data-copy-link><Icon name="link-rounded" size={18} /><span>Sao chép link</span></button>
  </div>
</div>

<div class="mt-6 grid grid-cols-1 items-start gap-6 lg:grid-cols-[230px_1fr] xl:grid-cols-[260px_1fr_320px]">
  <nav class="border border-line bg-card hidden flex-col gap-0.5 rounded-panel p-2 lg:sticky-fit lg:sticky lg:top-[84px] lg:flex" aria-label="Mục lục" data-toc>
    {
      sections.map(([t], i) => (
        <a
          href={`#s${i + 1}`}
          aria-current={i === 0 ? 'true' : undefined}
          class="group flex gap-2.5 rounded-field px-3 py-2 text-body-medium text-on-surface-variant hover:text-on-surface aria-[current=true]:bg-card aria-[current=true]:text-ink aria-[current=true]:shadow-knob"
        >
          <span class="w-5 shrink-0 text-label-medium tabular-nums group-aria-[current=true]:text-primary">{num(i)}</span>
          {t}
        </a>
      ))
    }
  </nav>
  <article class:list={[PANEL, 'min-w-0 px-5 pt-6 md:px-10 md:pt-8']}>
    {
      sections.map(([t, parts], i) => (
        <section id={`s${i + 1}`} class:list={['scroll-mt-24 pb-6', i > 0 && 'border-t border-line pt-6']}>
          <h2 class="flex items-baseline gap-3 text-j-22 text-ink">
            <span class="tabular-nums" data-count>{num(i)}</span>
            {t}
          </h2>
          {parts.map((p) =>
            Array.isArray(p) ? (
              <ul class="mt-3 flex flex-col gap-1.5">
                {p.map((li) => (
                  <li class="flex gap-2.5 text-body-large text-ink">
                    <span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                    <span>{li}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-3 text-body-large leading-6 text-ink">{p}</p>
            ),
          )}
        </section>
      ))
    }
  </article>
  <aside class="flex flex-col gap-4 lg:col-start-2 xl:sticky-fit xl:sticky xl:top-[80px] xl:-m-1 xl:p-1 xl:col-start-auto">
    <slot />
  </aside>
</div>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  const copy = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  copy?.addEventListener('click', async () => {
    const label = copy.querySelector('span');
    try {
      await navigator.clipboard.writeText(location.href.split('#')[0]);
      if (label) label.textContent = 'Đã sao chép';
    } catch {
      if (label) label.textContent = 'Không sao chép được';
    }
    setTimeout(() => label && (label.textContent = 'Sao chép link'), 2000);
  });

  // The contents mark the last section whose top has passed under the header.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
  const targets = links.map((a) => document.querySelector<HTMLElement>(a.hash)).filter((el): el is HTMLElement => !!el);
  const mark = () => {
    let current = 0;
    targets.forEach((el, i) => {
      if (el.getBoundingClientRect().top < 140) current = i;
    });
    if (scrollY > 0 && innerHeight + scrollY >= document.body.scrollHeight - 4) current = targets.length - 1;
    links.forEach((a, i) => (i === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
  };
  addEventListener('scroll', mark, { passive: true });
  mark();
</script>
