---
// The Đăng tin form: photos, the item, the price with its guide, and where it
// is. One form posts it (step=post) or keeps it as a draft (step=draft); the
// script uploads photos, autosaves the draft, runs "AI điền giúp" and the price
// guide. A new listing's "Đăng tin" opens Xem trước (SellPreview) first.
import Field from '../Field.astro';
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import Switch from '../Switch.astro';
import SellPreview from './SellPreview.astro';
import { categories } from '../../lib/catalog';
import { group } from '../../lib/format';
import { CONDITIONS } from '../../lib/listing';
import { communes, provinces } from '../../lib/regions';
import { R } from '../../lib/routes';
import { DESCRIPTION_MAX, PHOTOS_MAX, type SellFields, TITLE_MAX } from '../../lib/sell';
import { PHOTO_TYPES } from '../../lib/upload';
import { btnCls, PANEL } from '../../lib/ui';

interface Props {
  fields: SellFields;
  /** Each photo's preview URL, by upload id. */
  urls: Record<string, string>;
  /** Why the server refused a photo, by upload id (a rejected listing). */
  failures?: Record<string, string>;
  /** Field errors by field key (title, price, photos…). */
  errors?: Record<string, string>;
  /** Sửa tin: the listing's id. */
  editId?: string;
  draftId?: string;
  /** The post's Idempotency-Key. */
  idemKey: string;
  /** Posting is off (no phone, or no place left); the page says why. */
  locked?: boolean;
}

const { fields: f, urls, failures = {}, errors = {}, editId, draftId, idemKey, locked = false } = Astro.props;
const [tree, regions, choices] = await Promise.all([categories(), provinces(), f.province ? communes(f.province).catch(() => []) : []]);
const specs = [...f.specs, { label: '', value: '' }];
const input = 'min-w-0 flex-1 bg-transparent text-body-large text-ink outline-none placeholder:text-on-surface-variant';
const select = `${input} cursor-pointer appearance-none`;
const bad = 'mt-1 block px-1 text-body-small text-error';
const badge = 'grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand text-title-small text-white tabular-nums';
const tile = 'group relative aspect-square overflow-hidden rounded-lg bg-surface-container-high';
const chip = 'absolute grid h-7 w-7 place-items-center rounded-full bg-black/55 text-white backdrop-blur';
const coverTag = 'absolute left-2 top-2 hidden rounded-full bg-white/85 px-2 py-0.5 text-label-medium text-photo-ink backdrop-blur group-first:inline';
---

<div class="flex flex-wrap items-end justify-between gap-4 pt-8">
  <div>
    <p class="text-label-large text-primary">Bán đồ</p>
    <h1 class="text-j-28 text-ink lg:text-j-30">{editId ? 'Sửa tin' : 'Đăng tin'}</h1>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    {
      !editId && (
        <span class="flex items-center gap-1 text-body-small text-on-surface-variant" hidden data-draft-status>
          <Icon name="draft-outline-rounded" size={15} />
          <span data-draft-text />
        </span>
      )
    }
    <a href={editId ? R.myListings : R.home} class="state-layer flex h-11 items-center rounded-control px-4 text-label-large text-on-surface-variant">Hủy</a>
  </div>
</div>

<slot />

<form method="post" id="sell-form" class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[1fr_300px] xl:grid-cols-[1fr_340px]" data-sell data-edit={editId ? '' : undefined}>
  <input type="hidden" name="key" value={idemKey} />
  <input type="hidden" name="draft" value={draftId ?? ''} data-draft-id />
  <div class="flex min-w-0 flex-col gap-4">
    <section class:list={[PANEL, 'p-4 md:p-6']} aria-labelledby="sell-photos">
      <div class="flex items-center gap-3">
        <span class={badge}>1</span>
        <h2 id="sell-photos" class="flex-1 text-j-20 text-ink">Ảnh</h2>
        <span class="rounded-full bg-surface-container-low px-2.5 py-0.5 text-label-medium text-on-surface-variant tabular-nums" data-photo-count>
          {f.photos.length}/{PHOTOS_MAX}
        </span>
      </div>
      <ol class="mt-4 grid grid-cols-3 gap-2.5 md:grid-cols-5" data-photos>
        {
          f.photos.map((id) => (
            <li class={tile} data-photo>
              <input type="hidden" name="photo" value={id} />
              {urls[id] ? (
                <Photo src={urls[id]} width={240} height={240} alt="Ảnh món đồ" class="h-full w-full object-cover" />
              ) : (
                <span class="grid h-full w-full place-items-center text-on-surface-variant">
                  <Icon name="image-outline-rounded" size={24} />
                </span>
              )}
              <span class={coverTag}>Ảnh bìa</span>
              {failures[id] && (
                <span class="absolute inset-x-0 bottom-0 bg-black/65 px-2 py-1 text-body-small text-white">{failures[id]}</span>
              )}
              <button type="button" class:list={[chip, 'bottom-1.5 left-1.5 group-first:hidden']} aria-label="Đặt làm ảnh bìa" title="Đặt làm ảnh bìa" data-photo-cover>
                <Icon name="star-outline-rounded" size={15} />
              </button>
              <button type="button" class:list={[chip, 'right-1.5 top-1.5']} aria-label="Bỏ ảnh" title="Bỏ ảnh" data-photo-remove>
                <Icon name="close-rounded" size={15} />
              </button>
            </li>
          ))
        }
        <li class:list={['aspect-square', f.photos.length >= PHOTOS_MAX && 'hidden']} data-photo-add>
          <label class="flex h-full cursor-pointer flex-col items-center justify-center gap-1 rounded-lg border-[1.5px] border-dashed border-primary/40 bg-secondary-container/40 p-2 text-center has-focus-visible:ring-2 has-focus-visible:ring-primary">
            <input type="file" accept={PHOTO_TYPES.join(',')} multiple class="sr-only" data-photo-input />
            <Icon name="add-photo-alternate-outline-rounded" size={26} class="text-primary" />
            <span class="text-label-large text-ink">Thêm ảnh</span>
            <span class="text-body-small text-on-surface-variant">hoặc kéo thả</span>
          </label>
        </li>
      </ol>
      <template data-photo-tpl>
        <li class={tile} data-photo>
          <input type="hidden" name="photo" value="" />
          <img alt="Ảnh món đồ" width="240" height="240" class="h-full w-full object-cover" />
          <span class={coverTag}>Ảnh bìa</span>
          <span class="absolute inset-0 hidden place-items-center bg-black/40 text-white" data-photo-busy><span class="spinner"></span></span>
          <button type="button" class:list={[chip, 'bottom-1.5 left-1.5 group-first:hidden']} aria-label="Đặt làm ảnh bìa" title="Đặt làm ảnh bìa" data-photo-cover>
            <Icon name="star-outline-rounded" size={15} />
          </button>
          <button type="button" class:list={[chip, 'right-1.5 top-1.5']} aria-label="Bỏ ảnh" title="Bỏ ảnh" data-photo-remove>
            <Icon name="close-rounded" size={15} />
          </button>
        </li>
      </template>
      {errors.photos && <span class={bad}>{errors.photos}</span>}
      <noscript><p class="mt-3 text-body-small text-on-surface-variant">Cần bật JavaScript để tải ảnh lên.</p></noscript>
      <p role="status" class="mt-1 text-body-small text-ink empty:hidden" data-photo-status></p>
      {
        !editId && (
          <div class="mt-4 flex flex-wrap items-center gap-3 rounded-tile bg-surface-container-low p-3">
            <Icon name="auto-awesome-rounded" size={20} class="text-primary" />
            <span class="min-w-0 flex-1 text-body-medium text-ink" data-read-status></span>
            <button type="button" class={btnCls('tonal', 'sm')} disabled={f.photos.length === 0} data-read>
              AI điền giúp
            </button>
          </div>
        )
      }
    </section>

    <section class:list={[PANEL, 'p-4 md:p-6']} aria-labelledby="sell-item">
      <div class="flex items-center gap-3">
        <span class={badge}>2</span>
        <h2 id="sell-item" class="flex-1 text-j-20 text-ink">Món đồ</h2>
      </div>
      <div class="mt-4 flex flex-col gap-4">
        <div>
          <Field label="Tiêu đề">
            <input name="title" value={f.title} maxlength={TITLE_MAX} placeholder="VD: iPhone 11 64GB trắng, máy zin" class={input} data-title />
            <span slot="trail" class="text-body-small text-on-surface-variant tabular-nums" data-title-count>{[...f.title].length}/{TITLE_MAX}</span>
          </Field>
          {errors.title && <span class={bad}>{errors.title}</span>}
        </div>
        <div>
          <Field label="Danh mục">
            <select name="category" class={select} data-category>
              <option value="" selected={!f.category}>Chọn danh mục</option>
              {
                tree.map((r) => (
                  <optgroup label={r.name}>
                    {r.children.map((c) => (
                      <option value={c.code} selected={c.code === f.category} data-spec-labels={JSON.stringify(c.specs)}>
                        {c.name}
                      </option>
                    ))}
                  </optgroup>
                ))
              }
            </select>
            <Icon slot="trail" name="keyboard-arrow-down-rounded" size={20} class="pointer-events-none text-on-surface-variant" />
          </Field>
          {errors.category_code && <span class={bad}>{errors.category_code}</span>}
        </div>
        <fieldset>
          <legend class="mb-1.5 text-label-large text-on-surface-variant">Tình trạng</legend>
          <div class="flex flex-wrap gap-2">
            {
              Object.entries(CONDITIONS).map(([value, label]) => (
                <label class="flex h-10 cursor-pointer items-center rounded-full border border-line bg-card px-4 text-label-large text-ink has-checked:border-transparent has-checked:bg-mint has-checked:text-on-mint has-focus-visible:ring-2 has-focus-visible:ring-primary">
                  <input type="radio" name="condition" value={value} checked={value === f.condition} class="sr-only" data-condition />
                  {label}
                </label>
              ))
            }
          </div>
          {errors.condition && <span class={bad}>{errors.condition}</span>}
        </fieldset>
        <div>
          <Field label="Mô tả" tall>
            <textarea name="description" rows="4" maxlength={DESCRIPTION_MAX} placeholder="Dùng bao lâu, có lỗi gì, kèm theo gì" class:list={[input, 'resize-y']} data-description
              >{f.description}</textarea
            >
          </Field>
          {errors.description && <span class={bad}>{errors.description}</span>}
        </div>
        <div>
          <p class="mb-1.5 text-label-large text-on-surface-variant">Thông số</p>
          <ul class="flex flex-col gap-2" data-specs>
            {
              specs.map((s) => (
                <li class="flex items-center gap-2" data-spec>
                  <label class="flex h-11 min-w-0 flex-1 items-center rounded-field bg-surface-container-low px-3 focus-within:bg-card focus-within:ring-2 focus-within:ring-primary">
                    <span class="sr-only">Tên thông số</span>
                    <input name="spec_label" value={s.label} maxlength={50} placeholder="VD: Pin" class={input} />
                  </label>
                  <label class="flex h-11 min-w-0 flex-1 items-center rounded-field bg-surface-container-low px-3 focus-within:bg-card focus-within:ring-2 focus-within:ring-primary">
                    <span class="sr-only">Giá trị</span>
                    <input name="spec_value" value={s.value} maxlength={50} placeholder="VD: 81%" class={input} />
                  </label>
                  <button type="button" class="state-layer grid h-9 w-9 shrink-0 place-items-center rounded-full text-on-surface-variant" aria-label="Bỏ thông số" data-spec-remove>
                    <Icon name="close-rounded" size={18} />
                  </button>
                </li>
              ))
            }
          </ul>
          <button
            type="button"
            class="state-layer mt-2 flex h-9 items-center gap-1 rounded-control border border-dashed border-outline-variant px-3 text-label-large text-on-surface-variant"
            data-spec-add
          >
            <Icon name="add-rounded" size={16} />Thêm thông số
          </button>
          {errors.specs && <span class={bad}>{errors.specs}</span>}
        </div>
      </div>
    </section>

    <section class:list={[PANEL, 'p-4 md:p-6']} aria-labelledby="sell-price">
      <div class="flex items-center gap-3">
        <span class={badge}>3</span>
        <h2 id="sell-price" class="flex-1 text-j-20 text-ink">Giá</h2>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-[1fr_1.25fr]">
        <div class="flex flex-col gap-2.5">
          <label class="block">
            <span class="mb-1.5 block text-label-large text-on-surface-variant">Giá bán</span>
            <span class="flex h-12 items-center justify-between gap-3 rounded-field bg-card px-4 ring-2 ring-primary">
              <input name="price" value={f.price === null ? '' : group(f.price)} inputmode="numeric" placeholder="0" class="min-w-0 flex-1 bg-transparent text-j-22 text-ink tabular-nums outline-none" data-price />
              <span class="text-on-surface-variant">₫</span>
            </span>
          </label>
          {errors.price && <span class={bad}>{errors.price}</span>}
          <div class="flex h-11 items-center gap-3 rounded-full bg-surface-container-low pl-4 pr-1.5">
            <Icon name="sell-outline-rounded" size={18} class="text-on-surface-variant" />
            <span class="flex-1 text-label-large text-ink">Cho phép trả giá</span>
            <Switch label="Cho phép trả giá" name="allow_offers" on={f.offers} />
          </div>
        </div>
        <div class="min-w-0 rounded-tile bg-mint p-4" hidden data-guide>
          <p class="flex items-center gap-1.5 text-title-small text-ink">
            <Icon name="auto-awesome-rounded" size={16} class="text-primary" /><span data-guide-range></span>
          </p>
          <p class="mt-0.5 text-body-small text-on-surface-variant" data-guide-source></p>
          <div class="mt-3 grid grid-cols-1 gap-2 md:grid-cols-2 empty:hidden" data-guide-picks></div>
          <p class="mt-3 flex items-start gap-2 text-body-small text-ink empty:hidden" data-guide-watchers></p>
          <ul class="mt-3 grid grid-cols-4 gap-2 empty:hidden" data-guide-similar></ul>
        </div>
      </div>
      <template data-pick-tpl>
        <button type="button" class="state-layer flex flex-col items-start rounded-tile bg-white/70 px-3 py-2 text-left">
          <span class="text-body-small text-on-surface-variant" data-pick-label></span>
          <span class="text-title-small text-ink tabular-nums" data-pick-price></span>
        </button>
      </template>
      <template data-similar-tpl>
        <li class="min-w-0">
          <a class="block rounded-lg" target="_blank" rel="noopener">
            <img alt="" width="160" height="160" loading="lazy" class="aspect-square w-full rounded-lg bg-white/60 object-cover" />
            <span class="mt-1 block truncate text-label-medium text-ink tabular-nums" data-similar-price></span>
            <span class="block truncate text-body-small text-on-surface-variant" data-similar-note></span>
          </a>
        </li>
      </template>
    </section>

    <section class:list={[PANEL, 'p-4 md:p-6']} aria-labelledby="sell-deal">
      <div class="flex items-center gap-3">
        <span class={badge}>4</span>
        <h2 id="sell-deal" class="flex-1 text-j-20 text-ink">Nơi bán và giao dịch</h2>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
        <Field label="Tỉnh, thành phố">
          <select name="province" class={select} data-province>
            <option value="" disabled selected={!f.province}>Chọn tỉnh, thành phố</option>
            {
              regions.map((p) => (
                <option value={p.code} selected={p.code === f.province}>
                  {p.name}
                </option>
              ))
            }
          </select>
          <Icon slot="trail" name="keyboard-arrow-down-rounded" size={20} class="pointer-events-none text-on-surface-variant" />
        </Field>
        <div>
          <Field label="Phường, xã">
            <select name="commune" class={select} data-commune>
              <option value="" disabled selected={!choices.some((c) => c.code === f.commune)}>
                {f.province ? 'Chọn phường, xã' : 'Chọn tỉnh trước'}
              </option>
              {
                choices.map((c) => (
                  <option value={c.code} selected={c.code === f.commune}>
                    {c.name}
                  </option>
                ))
              }
            </select>
            <Icon slot="trail" name="keyboard-arrow-down-rounded" size={20} class="pointer-events-none text-on-surface-variant" />
          </Field>
          {errors.commune_code && <span class={bad}>{errors.commune_code}</span>}
          <noscript>
            <button name="step" value="province" class="state-layer mt-1 h-8 rounded-control px-2 text-label-large text-primary">Chọn phường, xã của tỉnh này</button>
          </noscript>
        </div>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-2.5 md:grid-cols-2">
        <div class="flex items-center gap-3 rounded-tile bg-surface-container-low p-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand text-white">
            <Icon name="local-shipping-outline-rounded" size={20} />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-title-small text-ink">COD, xem hàng trước</span>
          </span>
        </div>
        <div class="flex items-center gap-3 rounded-tile bg-surface-container-low p-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-card text-on-surface-variant">
            <Icon name="receipt-long-outline-rounded" size={20} />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-title-small text-ink">Tài khoản GHTK, GHN</span>
          </span>
          <a href={R.codSetup} class="state-layer rounded-control px-3 py-1 text-label-large text-primary">Thiết lập</a>
        </div>
      </div>
    </section>
  </div>

  <aside class="self-start lg:sticky-fit lg:sticky lg:top-[80px] lg:-m-1 lg:p-1">
    <div class:list={[PANEL, 'flex flex-col gap-2 p-5']}>
      <p class="text-title-small text-ink">{editId ? 'Lưu thay đổi' : 'Sẵn sàng đăng?'}</p>
      <button name="step" value="post" class:list={[btnCls('ink', 'lg'), 'mt-2 !h-12 w-full disabled:opacity-50']} disabled={locked} data-submit>
        <Icon name="send-rounded" size={18} />
        {editId ? 'Lưu tin' : 'Đăng tin'}
      </button>
      {
        !editId && (
          <button name="step" value="draft" class:list={[btnCls('line', 'lg'), 'w-full']}>
            <Icon name="draft-outline-rounded" size={18} />
            Lưu nháp
          </button>
        )
      }
    </div>
  </aside>
</form>
{!editId && <SellPreview />}

<script>
  import { busy } from '../../lib/busy';
  import { wireCommunes } from '../../lib/commune-picker';
  import { group, money } from '../../lib/format';
  import { idempotencyKey, uuidv7 } from '../../lib/key';
  import { API, R, loginHref } from '../../lib/routes';
  import { DESCRIPTION_MAX, PHOTOS_MAX, SPECS_MAX, TITLE_MAX, parsePrice } from '../../lib/sell';
  import { mountSellPreview } from '../../lib/sell-preview';
  import { UploadError, uploadPhoto } from '../../lib/upload';

  type Spec = { label: string; value: string };
  type Read = {
    id: string;
    status: 'reading' | 'done' | 'failed';
    failure?: string;
    draft?: { title: string; category_code: string; condition: string; specs: Spec[]; description: string; price: number | null; allow_offers: boolean };
  };
  type Guide = {
    estimate: { low: number; median: number; high: number; source: 'market' | 'model'; sample_size: number } | null;
    suggestions: { kind: 'fast' | 'market'; price: number; days: number }[];
    similar: { listing_id: string; title: string; cover_url: string; price: number; sold: boolean; km: number }[];
    watchers: { price_min?: number; price_max?: number; offers_only: boolean }[];
  };

  const form = document.querySelector<HTMLFormElement>('[data-sell]');
  if (form) {
    const $ = <T extends Element = HTMLElement>(s: string) => form.querySelector<T>(s) ?? document.querySelector<T>(s);
    const editing = form.hasAttribute('data-edit');
    const MAX = PHOTOS_MAX;
    const back = location.pathname + location.search;

    // ---- Photos: upload, order (the first is the cover), remove.
    const list = $('[data-photos]')!;
    const add = $('[data-photo-add]')!;
    const fileInput = $<HTMLInputElement>('[data-photo-input]')!;
    const status = $('[data-photo-status]')!;
    const tpl = $<HTMLTemplateElement>('[data-photo-tpl]')!;
    const readBtn = $<HTMLButtonElement>('[data-read]');
    const tiles = () => [...list.querySelectorAll<HTMLElement>('[data-photo]')];
    const ids = () => tiles().map((t) => t.querySelector('input')!.value).filter(Boolean);
    let uploading = 0;
    const words: Record<UploadError['reason'], string> = {
      'sign-in': 'Phiên đăng nhập đã hết. Đăng nhập lại nhé.',
      type: 'Chỉ nhận ảnh JPEG, PNG hoặc WebP.',
      size: 'Có ảnh lớn hơn 15 MB.',
      failed: 'Có ảnh chưa tải lên được. Thử lại nhé.',
    };
    const refresh = () => {
      const n = tiles().length;
      $('[data-photo-count]')!.textContent = `${n}/${MAX}`;
      add.classList.toggle('hidden', n >= MAX);
      if (readBtn) readBtn.disabled = ids().length === 0 || reading;
      busy(readBtn, reading);
    };
    const changed = () => {
      refresh();
      saveSoon();
      guideSoon();
    };
    async function addFiles(files: File[]) {
      const room = MAX - tiles().length;
      if (files.length > room) status.textContent = `Tối đa ${MAX} ảnh, đã bỏ ${files.length - room} ảnh.`;
      else status.textContent = '';
      await Promise.all(
        files.slice(0, Math.max(0, room)).map(async (file) => {
          const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
          const url = URL.createObjectURL(file);
          li.querySelector('img')!.src = url;
          const busy = li.querySelector<HTMLElement>('[data-photo-busy]')!;
          busy.classList.replace('hidden', 'grid');
          list.insertBefore(li, add);
          refresh();
          uploading++;
          try {
            li.querySelector('input')!.value = await uploadPhoto(file);
            busy.remove();
          } catch (e) {
            const reason = e instanceof UploadError ? e.reason : 'failed';
            if (reason === 'sign-in') location.href = loginHref(back);
            status.textContent = words[reason];
            li.remove();
            URL.revokeObjectURL(url);
          } finally {
            uploading--;
          }
        }),
      );
      changed();
    }
    fileInput.addEventListener('change', () => {
      addFiles([...(fileInput.files ?? [])]);
      fileInput.value = '';
    });
    add.addEventListener('dragover', (e) => e.preventDefault());
    add.addEventListener('drop', (e) => {
      e.preventDefault();
      addFiles([...(e.dataTransfer?.files ?? [])].filter((f) => f.type.startsWith('image/')));
    });
    list.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest('button');
      const li = btn?.closest<HTMLElement>('[data-photo]');
      if (!btn || !li) return;
      if (btn.hasAttribute('data-photo-remove')) li.remove();
      else if (btn.hasAttribute('data-photo-cover')) list.prepend(li);
      else return;
      changed();
    });

    // ---- Title counter, price grouping, specs.
    const title = $<HTMLInputElement>('[data-title]')!;
    const description = $<HTMLTextAreaElement>('[data-description]')!;
    const category = $<HTMLSelectElement>('[data-category]')!;
    const price = $<HTMLInputElement>('[data-price]')!;
    const offers = form.querySelector<HTMLInputElement>('input[name="allow_offers"]')!;
    const commune = $<HTMLSelectElement>('[data-commune]')!;
    const countTitle = () => ($('[data-title-count]')!.textContent = `${[...title.value].length}/${title.maxLength}`);
    title.addEventListener('input', countTitle);
    const priceValue = () => parsePrice(price.value);
    const setPrice = (v: number | null) => (price.value = v === null ? '' : group(v));
    price.addEventListener('blur', () => setPrice(priceValue()));
    price.addEventListener('input', () => showWatchers());

    const specList = $('[data-specs]')!;
    const specAdd = $<HTMLButtonElement>('[data-spec-add]')!;
    const specRow = specList.querySelector('[data-spec]')!.cloneNode(true) as HTMLElement;
    specRow.querySelectorAll('input').forEach((i) => (i.value = ''));
    const addSpec = (s: Spec = { label: '', value: '' }) => {
      const row = specRow.cloneNode(true) as HTMLElement;
      const [l, v] = row.querySelectorAll('input');
      l.value = s.label;
      v.value = s.value;
      specList.append(row);
      specAdd.hidden = specList.children.length >= SPECS_MAX;
      return row;
    };
    specAdd.addEventListener('click', () => addSpec().querySelector('input')?.focus());
    specList.addEventListener('click', (e) => {
      const row = (e.target as Element).closest('[data-spec-remove]')?.closest('[data-spec]');
      if (!row || row.hasAttribute('data-spec-required')) return;
      if (specList.children.length > 1) row.remove();
      else row.querySelectorAll('input').forEach((i) => (i.value = ''));
      specAdd.hidden = false;
      saveSoon();
    });
    // The category's own specs lead the list, named and kept; a row the old
    // category asked for stays only once it has a value.
    const lock = (row: Element, on: boolean) => {
      const [l, v] = row.querySelectorAll('input');
      row.toggleAttribute('data-spec-required', on);
      l.readOnly = on;
      v.placeholder = on ? 'Bắt buộc' : 'VD: 81%';
      const x = row.querySelector<HTMLButtonElement>('[data-spec-remove]')!;
      x.disabled = on;
      x.classList.toggle('invisible', on);
    };
    const requireSpecs = () => {
      const want: string[] = JSON.parse(category.selectedOptions[0]?.dataset.specLabels || '[]');
      const wanted = (l: string) => want.some((w) => w.toLowerCase() === l.trim().toLowerCase());
      const rows = () => [...specList.querySelectorAll('[data-spec]')];
      for (const row of rows()) {
        const [l, v] = row.querySelectorAll('input');
        if (wanted(l.value)) lock(row, true);
        else if (row.hasAttribute('data-spec-required')) v.value.trim() ? lock(row, false) : row.remove();
      }
      [...want].reverse().forEach((w) => {
        const same = (r: Element) => r.querySelector('input')!.value.trim().toLowerCase() === w.toLowerCase();
        const row = rows().find(same) ?? addSpec({ label: w, value: '' });
        lock(row, true);
        specList.prepend(row);
      });
      if (!rows().some((r) => !r.hasAttribute('data-spec-required'))) addSpec();
      specAdd.hidden = specList.children.length >= SPECS_MAX;
    };
    requireSpecs();
    category.addEventListener('change', requireSpecs);
    const specs = (): Spec[] =>
      [...specList.querySelectorAll('[data-spec]')]
        .map((r) => {
          const [l, v] = r.querySelectorAll('input');
          return { label: l.value.trim(), value: v.value.trim() };
        })
        .filter((s) => s.label && s.value);

    wireCommunes($('[data-province]'), commune, () => guideSoon());

    // ---- Category from the title, while none is chosen.
    let guessed = '';
    title.addEventListener('change', async () => {
      const t = title.value.trim();
      if (category.value || !t || t === guessed) return;
      guessed = t;
      const res = await fetch(API.categoryGuesses, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ title: t, description: description.value }),
      }).catch(() => null);
      const g: { category_code: string | null } | null = res?.ok ? await res.json() : null;
      if (g?.category_code && !category.value && [...category.options].some((o) => o.value === g.category_code)) {
        category.value = g.category_code;
        requireSpecs();
        guideSoon();
      }
    });

    // ---- The draft, kept as the seller types (not while editing a listing). One save runs
    // at a time; changes meanwhile queue one more, which sends the form as it is then.
    const draftInput = $<HTMLInputElement>('[data-draft-id]')!;
    const draftStatus = $('[data-draft-status]');
    let saveTimer = 0;
    let draftOff = editing;
    let inflight: { ctrl: AbortController; done: Promise<void> } | null = null;
    let queued = false;
    function saveSoon() {
      if (draftOff) return;
      clearTimeout(saveTimer);
      saveTimer = window.setTimeout(save, 1500);
    }
    async function save() {
      if (draftOff) return;
      if (uploading) return saveSoon();
      if (inflight) return void (queued = true);
      if (!draftInput.value) {
        if (!title.value.trim() && !ids().length) return;
        draftInput.value = uuidv7();
      }
      const id = draftInput.value;
      const ctrl = new AbortController();
      let finish = () => {};
      inflight = { ctrl, done: new Promise<void>((ok) => (finish = ok)) };
      try {
        const res = await fetch(API.listingDraft(id), { method: 'PUT', body: new FormData(form!), signal: ctrl.signal }).catch(() => null);
        const text = draftStatus?.querySelector('[data-draft-text]');
        if (!text || ctrl.signal.aborted) return;
        draftStatus!.hidden = false;
        if (res?.ok) {
          text.textContent = 'Đã lưu nháp';
          const url = new URL(location.href);
          if (url.searchParams.get('draft') !== id) {
            url.searchParams.set('draft', id);
            url.searchParams.delete('saved');
            history.replaceState(history.state, '', url);
          }
        } else if (res?.status === 409) {
          text.textContent = 'Đã có 20 nháp, nháp này chưa lưu';
          draftOff = true;
        } else if (res?.status === 401) {
          text.textContent = 'Phiên đăng nhập đã hết, nháp chưa lưu';
        } else {
          text.textContent = 'Chưa lưu được nháp';
        }
      } finally {
        inflight = null;
        finish();
        if (queued) {
          queued = false;
          save();
        }
      }
    }
    form.addEventListener('input', (e) => {
      if ((e.target as Element).matches('[data-price]')) showWatchers();
      saveSoon();
    });
    form.addEventListener('change', (e) => {
      if ((e.target as Element).matches('[data-category], [data-condition], [data-title]')) guideSoon();
      saveSoon();
    });

    // A post or Lưu nháp waits for uploads and stops the autosave. A save already sent
    // finishes first (aborted after 5 s), so it cannot land after the post deletes or rewrites the draft.
    let leaving = false;
    // "Đăng tin" shows Xem trước first; its own "Đăng tin" posts.
    let previewed = false;
    const preview = editing
      ? null
      : mountSellPreview(form, () => {
          previewed = true;
          form.requestSubmit(form.querySelector<HTMLButtonElement>('[data-submit]'));
        });
    form.addEventListener('submit', async (e) => {
      if (leaving) return;
      if (uploading) {
        e.preventDefault();
        status.textContent = 'Đợi ảnh tải lên xong rồi bấm lại nhé.';
        return;
      }
      if (preview && !previewed && (e as SubmitEvent).submitter?.getAttribute('value') === 'post') {
        e.preventDefault();
        preview();
        return;
      }
      clearTimeout(saveTimer);
      draftOff = true;
      queued = false;
      const running = inflight;
      if (!running) return;
      e.preventDefault();
      leaving = true;
      busy((e as SubmitEvent).submitter);
      const stop = window.setTimeout(() => running.ctrl.abort(), 5000);
      await running.done;
      clearTimeout(stop);
      form.requestSubmit((e as SubmitEvent).submitter as HTMLButtonElement | null);
    });

    // ---- AI điền giúp: read the cover, then fill what the read has.
    let reading = false;
    const readStatus = $('[data-read-status]');
    const failures: Record<string, string> = {
      unreadable: 'AI chưa đọc được ảnh này. Thử ảnh rõ hơn nhé.',
      no_item: 'AI không thấy một món đồ rõ ràng trong ảnh bìa.',
      unavailable: 'AI đang bận. Thử lại sau ít phút.',
    };
    readBtn?.addEventListener('click', async () => {
      const photo = ids()[0];
      if (!photo || !readStatus) return;
      reading = true;
      refresh();
      readStatus.textContent = '';
      const before = snapshot();
      const say = (t: string) => {
        readStatus.textContent = t;
        reading = false;
        refresh();
      };
      const res = await fetch(API.listingReads, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ photo, key: idempotencyKey() }),
      }).catch(() => null);
      if (res?.status === 401) return void (location.href = loginHref(back));
      if (res?.status === 403) return say('Cần thêm số điện thoại vào tài khoản trước.');
      if (res?.status === 429) return say('Hôm nay bạn đã dùng hết lượt AI đọc ảnh. Mai thử lại nhé.');
      if (!res?.ok) return say('Chưa đọc được ảnh lúc này. Thử lại sau.');
      let r: Read = await res.json();
      for (let i = 0; r.status === 'reading' && i < 45; i++) {
        await new Promise((ok) => setTimeout(ok, 2000));
        const next = await fetch(API.listingRead(r.id)).catch(() => null);
        if (next?.ok) r = await next.json();
      }
      if (r.status === 'reading') return say('AI đọc lâu hơn thường lệ. Thử lại sau nhé.');
      if (r.status === 'failed' || !r.draft) return say(failures[r.failure ?? ''] ?? failures.unavailable);
      if (ids()[0] !== photo) return say('Ảnh bìa đã đổi. Bấm AI điền giúp lại nhé.');
      fill(r.draft, before);
      say('AI đã điền xong.');
    });
    // The fields as the read began; the read fills only those still the same when it ends.
    const snapshot = () => ({
      title: title.value,
      description: description.value,
      category: category.value,
      condition: form!.querySelector<HTMLInputElement>('[data-condition]:checked')?.value ?? '',
      price: price.value,
      offers: offers.checked,
      specs: JSON.stringify(specs()),
    });
    function fill(d: NonNullable<Read['draft']>, was: ReturnType<typeof snapshot>) {
      const now = snapshot();
      const same = (k: keyof typeof now) => now[k] === was[k];
      if (d.title && same('title')) title.value = d.title.slice(0, TITLE_MAX);
      if (d.description && same('description')) description.value = d.description.slice(0, DESCRIPTION_MAX);
      if (d.category_code && same('category') && [...category.options].some((o) => o.value === d.category_code)) category.value = d.category_code;
      const c = form!.querySelector<HTMLInputElement>(`[data-condition][value="${d.condition}"]`);
      if (c && same('condition')) c.checked = true;
      if (d.price !== null && same('price')) setPrice(d.price);
      if (same('offers')) offers.checked = d.allow_offers;
      if (d.specs.length && same('specs')) {
        specList.replaceChildren();
        d.specs.slice(0, SPECS_MAX - 1).forEach((s) => addSpec(s));
        addSpec();
      }
      requireSpecs();
      countTitle();
      saveSoon();
      guideSoon();
    }

    // ---- Giá tham khảo, once the item and its place are known; hidden otherwise.
    const guide = $('[data-guide]')!;
    let watchers: Guide['watchers'] = [];
    let guideTimer = 0;
    let asked = '';
    function guideSoon() {
      clearTimeout(guideTimer);
      guideTimer = window.setTimeout(loadGuide, 800);
    }
    const tr = (v: number) => (v / 1_000_000).toLocaleString('de-DE', { maximumFractionDigits: 1 });
    async function loadGuide() {
      const condition = form!.querySelector<HTMLInputElement>('[data-condition]:checked')?.value;
      const body = {
        title: title.value.trim().slice(0, TITLE_MAX),
        category_code: category.value,
        condition,
        commune_code: commune.value,
        description: description.value.slice(0, DESCRIPTION_MAX),
        specs: specs().slice(0, SPECS_MAX),
        photos: ids().slice(0, 3),
      };
      // Hidden or failed, the same inputs may ask again later.
      const hide = () => {
        guide.hidden = true;
        asked = '';
      };
      if (!body.title || !body.category_code || !condition || !body.commune_code) return hide();
      const sig = JSON.stringify(body);
      if (sig === asked) return;
      asked = sig;
      const res = await fetch(API.priceGuides, { method: 'POST', headers: { 'content-type': 'application/json' }, body: sig }).catch(() => null);
      const g: Guide | null = res?.ok ? await res.json() : null;
      if (sig !== asked) return;
      if (!g || (!g.estimate && !g.suggestions.length && !g.similar.length)) return hide();
      const e = g.estimate;
      $('[data-guide-range]')!.textContent = e ? `Giá tham khảo ${tr(e.low)} – ${tr(e.high)} tr ₫` : 'Tin giống món này';
      $('[data-guide-source]')!.textContent = e
        ? e.source === 'market'
          ? `Từ ${e.sample_size} tin giống món này, mức giữa ${money(e.median)}`
          : `AI ước tính, mức giữa ${money(e.median)}`
        : `${g.similar.length} tin đang bán hoặc đã bán gần đây`;
      const pickTpl = $<HTMLTemplateElement>('[data-pick-tpl]')!;
      $('[data-guide-picks]')!.replaceChildren(
        ...g.suggestions.map((s) => {
          const b = pickTpl.content.firstElementChild!.cloneNode(true) as HTMLButtonElement;
          b.querySelector('[data-pick-label]')!.textContent = `${s.kind === 'fast' ? 'Bán nhanh' : 'Giá thị trường'} · ~${s.days} ngày`;
          b.querySelector('[data-pick-price]')!.textContent = money(s.price);
          b.addEventListener('click', () => {
            setPrice(s.price);
            showWatchers();
            saveSoon();
          });
          return b;
        }),
      );
      const simTpl = $<HTMLTemplateElement>('[data-similar-tpl]')!;
      $('[data-guide-similar]')!.replaceChildren(
        ...g.similar.slice(0, 4).map((s) => {
          const li = simTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
          const a = li.querySelector('a')!;
          a.href = R.listing(s.listing_id);
          a.title = s.title;
          li.querySelector('img')!.src = s.cover_url;
          li.querySelector('[data-similar-price]')!.textContent = money(s.price);
          li.querySelector('[data-similar-note]')!.textContent = s.sold ? 'Đã bán' : `${s.km} km`;
          return li;
        }),
      );
      watchers = g.watchers;
      showWatchers();
      guide.hidden = false;
    }
    function showWatchers() {
      const p = priceValue();
      const n = watchers.filter(
        (w) => p !== null && (w.price_min ?? 0) <= p && p <= (w.price_max ?? Infinity) && (!w.offers_only || offers.checked),
      ).length;
      $('[data-guide-watchers]')!.textContent = n ? `${n} người đang tìm món này ở giá này` : '';
    }
    offers.addEventListener('change', showWatchers);

    refresh();
    guideSoon();
  }
</script>
