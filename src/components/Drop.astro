---
// A filter dropdown pill; count is how many values are picked. on: the filter is set (ink).
import Icon from './Icon.astro';

interface Props {
  label: string;
  count?: number;
  on?: boolean;
}

const { label, count, on = false } = Astro.props;
---

<button
  type="button"
  class:list={[
    'state-layer flex h-9 shrink-0 items-center gap-1.5 rounded-full border pl-3.5 pr-2 text-label-large',
    on ? 'border-transparent bg-ink text-on-ink' : 'border-line bg-card/70 text-on-surface-variant',
  ]}
  aria-haspopup="listbox"
>
  {label}
  {
    count ? (
      <span class="grid h-5 min-w-5 place-items-center rounded-full bg-primary px-1.5 text-label-small text-on-primary tabular-nums">
        {count}
      </span>
    ) : null
  }
  <Icon name="keyboard-arrow-down-rounded" size={16} />
</button>
