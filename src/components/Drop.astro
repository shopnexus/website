---
// A filter dropdown; count is how many values are picked. on: the filter is set (mint).
import Icon from './Icon.astro';

interface Props {
  label: string;
  count?: number;
  on?: boolean;
}

const { label, count, on = false } = Astro.props;
---

<button
  type="button"
  class:list={[
    'state-layer flex h-8 shrink-0 items-center gap-1.5 rounded-control border pl-3 pr-2 text-body-medium',
    on ? 'border-brand bg-mint text-on-mint' : 'border-field bg-card text-sub hover:bg-page',
  ]}
  aria-haspopup="listbox"
>
  {label}
  {
    count ? (
      <span class="grid h-5 min-w-5 place-items-center rounded-full bg-brand px-1.5 text-label-small text-white tabular-nums">
        {count}
      </span>
    ) : null
  }
  <Icon name="keyboard-arrow-down-rounded" size={16} />
</button>
