---
// One MONEY sentence, word for word, with its icon.
import { MONEY } from '../data/common';
import Icon from './Icon.astro';

interface Props {
  k: keyof typeof MONEY;
  icon?: string;
  small?: boolean;
}

const { k, icon = 'info-outline-rounded', small = false } = Astro.props;
---

<p class:list={['flex gap-2 text-on-surface-variant', small ? 'text-body-small' : 'text-body-medium']}>
  <Icon name={icon} size={small ? 16 : 17} class={small ? 'mt-px text-primary' : 'mt-0.5 text-primary'} />
  <span>{MONEY[k]}</span>
</p>
