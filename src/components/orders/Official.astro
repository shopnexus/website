---
// ShopNexus's own avatar in a support chat: the agent icon on the teal gradient.
import Icon from '../Icon.astro';

interface Props {
  size?: number;
}

const { size = 36 } = Astro.props;
---

<span
  class="grid shrink-0 place-items-center rounded-full bg-linear-[140deg] from-teal to-teal-light text-white"
  style={`width:${size}px;height:${size}px`}
>
  <Icon name="support-agent-rounded" size={Math.floor((size * 11) / 20)} />
</span>
