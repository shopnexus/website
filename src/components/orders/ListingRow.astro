---
import Photo from '../Photo.astro';
// One of the seller's listings: photo, title, price and its numbers, what
// waits on it, and the ⋮ menu (Sửa tin, Đánh dấu đã bán, Ẩn tin, Xóa tin).
import { LISTING_MENU, type MyListing } from '../../data/orders';
import { img } from '../../lib/format';
import { btnCls } from '../../lib/ui';
import Icon from '../Icon.astro';
import Price from '../Price.astro';

interface Props {
  it: MyListing;
}

const { it } = Astro.props;
const hidden = it.extra === 'hidden';
const deal = typeof it.extra === 'object' ? it.extra : null;
const stats = [
  { icon: 'visibility-outline-rounded', n: it.views, t: 'Lượt xem' },
  { icon: 'chat-outline-rounded', n: it.chats, t: 'Người hỏi' },
  { icon: 'favorite-outline-rounded', n: it.saves, t: 'Lượt lưu' },
  { icon: 'schedule-outline-rounded', n: it.age, t: 'Đã đăng' },
];
---

<article class="lift relative flex flex-wrap items-center gap-x-4 gap-y-2 rounded-card border border-line bg-card p-2 md:flex-nowrap" data-row-menu>
  <div class="flex min-w-0 flex-1 basis-full items-center gap-4 md:basis-auto">
    <Photo src={img(it.photo, 160, 160)} width={160} height={160} alt={it.title} class:list={['h-16 w-16 shrink-0 rounded-lg object-cover', hidden && 'opacity-50']} />
    <div class:list={['min-w-0 flex-1', hidden && 'opacity-50']}>
      <h3 class="truncate text-title-small text-ink">{it.title}</h3>
      {
        it.extra === 'price' && (
          <p class="flex items-center gap-1 text-label-medium text-tertiary">
            <Icon name="auto-awesome-rounded" size={13} />
            Cao hơn 12% so với máy cùng đời
          </p>
        )
      }
      <div class="mt-0.5 flex items-center gap-3 overflow-hidden whitespace-nowrap">
        <Price vnd={it.price} size="text-j-15" />
        <span class="h-3 border-l border-black/10"></span>
        <span class="flex items-center gap-3 text-body-small text-on-surface-variant">
          {
            stats.map((s) => (
              <span class="flex items-center gap-1" title={s.t}>
                <Icon name={s.icon} size={15} />
                <span class="tabular-nums">{s.n}</span>
              </span>
            ))
          }
        </span>
      </div>
    </div>
  </div>
  <div class="ml-20 flex flex-1 items-center justify-end gap-2 md:ml-0 md:flex-none">
    {
      it.extra === 'price' && (
        <button type="button" class:list={[btnCls('tonal', 'sm')]}>
          <Icon name="trending-down-rounded" size={18} />
          Giảm còn 1,7 tr
        </button>
      )
    }
    {
      hidden && (
        <span class="flex items-center gap-1.5 rounded-full bg-surface-container-low px-3 py-1.5 text-label-medium text-on-surface-variant">
          <Icon name="visibility-off-outline-rounded" size={16} />
          Đã ẩn
        </span>
      )
    }
    {
      deal && (
        <a
          href={deal.href}
          class:list={[
            'state-layer flex h-9 items-center gap-2 rounded-control pl-3 pr-2 text-label-large',
            deal.todo ? 'bg-primary text-on-primary' : 'bg-secondary-container text-on-secondary-container',
          ]}
        >
          <Icon name={deal.icon} size={17} />
          {deal.label}
          <Icon name="chevron-right-rounded" size={18} />
        </a>
      )
    }
    <button
      type="button"
      class="state-layer grid h-9 w-9 shrink-0 place-items-center rounded-full text-on-surface-variant"
      aria-label={`Tùy chọn cho ${it.title}`}
      aria-haspopup="menu"
      aria-expanded="false"
      data-menu-button
    >
      <Icon name="more-vert" size={20} />
    </button>
  </div>
  <ul role="menu" class="absolute right-3 top-14 z-20 hidden w-[220px] rounded-tile bg-card/95 p-1.5 shadow-float ring-1 ring-line backdrop-blur" data-menu>
    {
      LISTING_MENU.map((m, i) => (
        <li role="none">
          <button
            type="button"
            role="menuitem"
            tabindex="-1"
            class:list={[
              'flex h-11 w-full cursor-pointer items-center gap-3 rounded-md px-3 text-body-medium hover:bg-black/[.05]',
              i === 3 ? 'text-error' : 'text-ink',
            ]}
          >
            <Icon name={m.icon} size={20} class={i === 3 ? '' : 'text-on-surface-variant'} />
            {m.label}
          </button>
        </li>
      ))
    }
  </ul>
</article>

<script>
  // The ⋮ menus: one open at a time; a click outside or Escape closes it.
  const rows = [...document.querySelectorAll<HTMLElement>('[data-row-menu]')];
  const close = () =>
    rows.forEach((r) => {
      r.querySelector('[data-menu]')?.classList.add('hidden');
      r.querySelector('[data-menu-button]')?.setAttribute('aria-expanded', 'false');
      r.classList.remove('z-10');
    });
  rows.forEach((r) => {
    const btn = r.querySelector<HTMLButtonElement>('[data-menu-button]')!;
    const menu = r.querySelector<HTMLElement>('[data-menu]')!;
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = menu.classList.contains('hidden');
      close();
      if (open) {
        menu.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        r.classList.add('z-10');
      }
    });
  });
  document.addEventListener('click', close);
  document.addEventListener('keydown', (e) => e.key === 'Escape' && close());
</script>
