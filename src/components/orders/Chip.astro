---
// A small grey capsule on the hero card: an icon and a line, slot "end" after it.
import Icon from '../Icon.astro';

interface Props {
  icon: string;
  label: string;
}

const { icon, label } = Astro.props;
const pad = Astro.slots.has('end') ? 'pr-1' : 'pr-3';
---

<span class:list={['flex h-8 items-center gap-1.5 rounded-full bg-surface-container-low pl-2.5 text-label-medium text-ink', pad]}>
  <Icon name={icon} size={15} />{label}<slot name="end" />
</span>
