---
// The order's steps, oldest first: done ones with their time, the one it is
// at ringed, the ones to come in grey.
import type { Step } from '../../lib/orders';

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
const DOT = {
  done: 'bg-primary',
  now: 'bg-primary ring-4 ring-primary/15',
  next: 'border-2 border-outline-variant bg-card',
};
---

<ol class="mt-3">
  {
    steps.map((s, i) => (
      <li class="relative flex gap-3 pb-4 last:pb-0" aria-current={s.state === 'now' ? 'step' : undefined}>
        {i < steps.length - 1 && <span class:list={['absolute bottom-0 left-[7px] top-5 w-px', s.state === 'done' ? 'bg-primary/60' : 'bg-line']} />}
        <span class:list={['relative mt-1 h-[15px] w-[15px] shrink-0 rounded-full', DOT[s.state]]} />
        <span class="min-w-0 flex-1">
          <span class:list={['block text-body-medium', s.state === 'next' ? 'text-on-surface-variant' : 'text-ink', s.state === 'now' && 'font-medium']}>{s.title}</span>
          {s.sub && <span class="block text-body-small text-on-surface-variant">{s.sub}</span>}
        </span>
        {s.when && <span class="shrink-0 text-body-small text-on-surface-variant tabular-nums">{s.when}</span>}
      </li>
    ))
  }
</ol>
