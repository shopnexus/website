---
import Photo from '../Photo.astro';
// A person's round photo, by name from FACE.
import { FACE } from '../../data/orders';
import { img } from '../../lib/format';

interface Props {
  name: string;
  size?: number;
  ring?: boolean;
  /** "lazy" when it sits below the first screen. */
  loading?: 'eager' | 'lazy';
}

const { name, size = 20, ring = false, loading } = Astro.props;
---

<Photo
  src={img(FACE[name], size * 4, size * 4)}
  width={size * 4}
  height={size * 4}
  alt=""
  loading={loading}
  class:list={['shrink-0 rounded-full object-cover', ring && 'ring-2 ring-card']}
  style={`width:${size}px;height:${size}px`}
/>
