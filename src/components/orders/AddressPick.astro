---
// "Giao đến": the buyer's addresses as radios named address_id, the picked one
// checked, then "Thêm địa chỉ". With script that opens the address form in
// place (lib/address-in-place); without, it opens Địa chỉ, which comes back
// to `back` once saved.
import type { Schemas } from '../../lib/api/client';
import { ADDRESS_KIND } from '../../lib/profile';
import { R } from '../../lib/routes';
import Icon from '../Icon.astro';

interface Props {
  addresses: Schemas['Address'][];
  picked?: string;
  /** The page that shows the form around this picker; it reads ?address= as the one to pick. */
  back: string;
  class?: string;
}

const { addresses, picked, back, class: cls } = Astro.props;
---

<fieldset class:list={['min-w-0', cls]} data-address-pick data-back={back}>
  <legend class="text-title-small text-ink">Giao đến</legend>
  <div class="mt-2 flex flex-col gap-2">
    {
      addresses.map((a) => (
        <label class="group flex cursor-pointer items-center gap-3 rounded-tile bg-surface-container-low p-3 has-[:checked]:bg-card has-[:checked]:ring-2 has-[:checked]:ring-primary has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-primary">
          <input type="radio" name="address_id" value={a.id} checked={a.id === picked} required class="sr-only" />
          <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full border-2 border-outline-variant group-has-[:checked]:border-primary">
            <span class="hidden h-2.5 w-2.5 rounded-full bg-primary group-has-[:checked]:block" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-label-medium text-on-surface-variant">
              {ADDRESS_KIND[a.kind].label} · {a.name}
            </span>
            <span class="block truncate text-body-medium text-ink">
              {a.street}, {a.commune}, {a.province}
            </span>
          </span>
        </label>
      ))
    }
    <a
      href={`${R.addresses}?new&next=${encodeURIComponent(back)}`}
      class="state-layer flex items-center gap-3 rounded-tile bg-surface-container-low p-3 text-body-medium text-primary"
      data-address-add
    >
      <Icon name="add-rounded" size={20} />
      Thêm địa chỉ
    </a>
  </div>
</fieldset>

<script>
  import '../../lib/address-in-place';
</script>
