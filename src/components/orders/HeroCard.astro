---
// The card at the top of an order: photo, state, chips; slot "chips" holds
// the chips and the default slot the step track at the right.
import Photo from '../Photo.astro';

interface Props {
  photo?: string;
  heading: string;
}

const { photo, heading } = Astro.props;
const box = 'h-20 w-20 shrink-0 rounded-card md:h-[104px] md:w-[104px]';
---

<section class="mt-3 flex flex-col gap-4 rounded-card border border-line bg-card p-3 shadow-soft xl:flex-row xl:items-center xl:gap-5 xl:pr-8">
  <div class="flex min-w-0 flex-1 items-center gap-4 xl:gap-5">
    {photo ? <Photo src={photo} width={240} height={240} alt="" class:list={[box, 'object-cover']} /> : <span class:list={[box, 'bg-soft']} />}
    <div class="min-w-0 flex-1">
      <h1 class="text-j-28 text-ink">{heading}</h1>
      <div class="mt-2 flex flex-wrap items-center gap-2"><slot name="chips" /></div>
    </div>
  </div>
  <div class="overflow-x-auto no-scrollbar [&_li]:shrink-0"><slot /></div>
</section>
