---
// One of the seller's listings on Tin của bạn: cover, title, price, status,
// its numbers, the order waiting on it, and what its status allows. The
// price opens Đổi giá, "Đã bán" and "Xóa tin" ask once, a sold listing has
// "Đăng lại", and the ⋮ menu holds the rest. Each step is a form post the
// page handles, which lib/my-listings-edit runs in place instead.
import type { Schemas } from '../../lib/api/client';
import { ago, date } from '../../lib/format';
import { R } from '../../lib/routes';
import { btnCls } from '../../lib/ui';
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import PriceLine from '../PriceLine.astro';
import ConfirmPop from '../orders/ConfirmPop.astro';
import PriceEdit from './PriceEdit.astro';

interface Props {
  it: Schemas['MyListingsItem'];
  loading?: 'eager' | 'lazy';
}

const { it, loading } = Astro.props;
const l = it.listing;
const cover = l.photos[0]?.thumb_url ?? l.photos[0]?.url;
const pub = l.status === 'active' || l.status === 'reserved';
// Active and hidden swap in place, so both draw what differs and data-status picks.
const onSale = l.status === 'active' || l.status === 'hidden';
const STATUS: Partial<Record<Schemas['ListingStatus'], [string, string]>> = {
  processing: ['hourglass-empty-rounded', 'Đang xử lý ảnh'],
  rejected: ['error-outline-rounded', 'Bị từ chối'],
  reserved: ['local-shipping-outline-rounded', 'Đang giao'],
  sold: ['check-circle-outline-rounded', l.sold_at ? `Đã bán ${date(l.sold_at)}` : 'Đã bán'],
};
const status = STATUS[l.status];
const failures = l.photos.flatMap((p, i) => (p.failure ? [`Ảnh ${i + 1}: ${p.failure}`] : []));
const stats = [
  { icon: 'visibility-outline-rounded', n: it.views, t: `Lượt xem, ${it.views_7d} trong 7 ngày` },
  { icon: 'chat-outline-rounded', n: it.askers, t: 'Người hỏi' },
  { icon: 'favorite-outline-rounded', n: it.saves, t: 'Lượt lưu' },
];
const editable = !['reserved', 'sold', 'deleted'].includes(l.status);
const deletable = l.status !== 'reserved' && l.status !== 'deleted';
const id = { sold: `sold-${l.id}`, del: `delete-${l.id}` };
const item = 'flex h-11 w-full items-center gap-3 rounded-md px-3 text-left text-body-medium text-ink hover:bg-black/[.05]';
const drop = l.price_drop?.previous_price;
---

<article
  class="group relative flex flex-wrap items-center gap-x-4 gap-y-2 rounded-card border border-line bg-card p-2 md:flex-nowrap"
  data-row={l.id}
  data-status={l.status}
>
  <div class="flex min-w-0 flex-1 basis-full items-center gap-4 md:basis-auto">
    {
      cover ? (
        <Photo src={cover} width={160} height={160} alt={l.title} loading={loading} class="h-16 w-16 shrink-0 rounded-lg object-cover group-data-[status=hidden]:opacity-50" />
      ) : (
        <span class="grid h-16 w-16 shrink-0 place-items-center rounded-lg bg-surface-container-high text-on-surface-variant">
          <Icon name="image-outline-rounded" size={22} />
        </span>
      )
    }
    <div class="min-w-0 flex-1">
      <h3 class="truncate text-title-small text-ink">
        {pub ? <a href={R.listing(l.slug)} class="hover:underline">{l.title}</a> : l.title}
      </h3>
      <div class="mt-0.5 flex items-center gap-3 overflow-hidden whitespace-nowrap">
        {
          onSale ? (
            <button
              type="button"
              popovertarget={`price-${l.id}`}
              class="state-layer -mx-1.5 flex h-8 shrink-0 flex-row-reverse items-center justify-end gap-1 rounded-sm px-1.5 hover:bg-hover"
              aria-label={`Đổi giá ${l.title}`}
              data-price-button
            >
              <!-- The pencil leads, drawn last, so a busy price turns it into the ring (busy.css). -->
              <Icon name="edit-outline-rounded" size={14} class="shrink-0 text-faint" />
              <PriceLine vnd={l.price} was={drop} size="text-j-15" class="shrink-0" />
            </button>
          ) : (
            <PriceLine vnd={l.price} was={drop} size="text-j-15" class="shrink-0" />
          )
        }
        <span class="h-3 border-l border-black/10"></span>
        <span class="flex items-center gap-3 text-body-small text-on-surface-variant">
          {
            stats.map((s) => (
              <span class="flex items-center gap-1" title={s.t}>
                <Icon name={s.icon} size={15} />
                <span class="tabular-nums">{s.n}</span>
                <span class="sr-only">{s.t}</span>
              </span>
            ))
          }
          <span class="flex items-center gap-1" title="Đã đăng">
            <Icon name="schedule-outline-rounded" size={15} />{ago(l.published_at ?? l.created_at)}
          </span>
        </span>
      </div>
      {failures.map((f) => <p class="mt-0.5 text-body-small text-error">{f}</p>)}
    </div>
  </div>
  <div class="ml-20 flex flex-1 flex-wrap items-center justify-end gap-2 md:ml-0 md:flex-none">
    {
      (status || onSale) && (
        <span
          class:list={[
            'items-center gap-1.5 rounded-full bg-surface-container-low px-3 py-1.5 text-label-medium text-on-surface-variant',
            onSale ? 'hidden group-data-[status=hidden]:flex' : 'flex',
          ]}
        >
          <Icon name={status?.[0] ?? 'visibility-off-outline-rounded'} size={16} />
          {status?.[1] ?? 'Đã ẩn'}
        </span>
      )
    }
    {
      it.order && (
        <a
          href={`${R.messages}?deal=${it.order.deal_id}`}
          class:list={[
            'state-layer flex h-9 items-center gap-2 rounded-control pl-3 pr-2 text-label-large',
            it.order.status === 'pending' ? 'bg-primary text-on-primary' : 'bg-secondary-container text-on-secondary-container',
          ]}
        >
          <Icon name={it.order.status === 'pending' ? 'receipt-long-outline-rounded' : 'local-shipping-outline-rounded'} size={17} />
          {it.order.status === 'pending' ? 'Có đơn chờ bạn' : 'Đơn đang giao'}
          <Icon name="chevron-right-rounded" size={18} />
        </a>
      )
    }
    {
      onSale && (
        <button type="button" popovertarget={id.sold} class={btnCls('line', 'sm')}>
          <Icon name="check-rounded" size={16} />
          Đã bán
        </button>
      )
    }
    {
      l.status === 'sold' && (
        <form method="post">
          <input type="hidden" name="id" value={l.id} />
          <button name="step" value="relist" class={btnCls('line', 'sm')}>
            <Icon name="replay-rounded" size={16} />
            Đăng lại
          </button>
        </form>
      )
    }
    {
      editable && (
        <a href={`${R.post}?edit=${l.id}`} class={btnCls('line', 'sm')}>
          <Icon name="edit-outline-rounded" size={16} />
          Sửa
        </a>
      )
    }
    {
      deletable && (
        <details class="relative" data-row-menu>
          <summary class="state-layer grid h-9 w-9 cursor-pointer list-none place-items-center rounded-full text-on-surface-variant [&::-webkit-details-marker]:hidden" aria-label={`Tùy chọn cho ${l.title}`}>
            <Icon name="more-vert" size={20} />
          </summary>
          <form method="post" class="absolute right-0 top-10 z-20 flex w-[220px] flex-col rounded-tile bg-card/95 p-1.5 shadow-float ring-1 ring-line backdrop-blur">
            <input type="hidden" name="id" value={l.id} />
            {onSale && (
              <>
                <button name="step" value="hide" class:list={[item, 'group-data-[status=hidden]:hidden']}>
                  <Icon name="visibility-off-outline-rounded" size={20} class="text-on-surface-variant" />
                  Ẩn tin
                </button>
                <button name="step" value="unhide" class:list={[item, 'hidden group-data-[status=hidden]:flex']}>
                  <Icon name="visibility-outline-rounded" size={20} class="text-on-surface-variant" />
                  Hiện lại
                </button>
              </>
            )}
            {l.status === 'sold' && (
              <button name="step" value="unmark-sold" class={item}>
                <Icon name="undo-rounded" size={20} class="text-on-surface-variant" />
                Bán lại
              </button>
            )}
            <button type="button" popovertarget={id.del} class:list={[item, '!text-error']}>
              <Icon name="delete-outline-rounded" size={20} />
              Xóa tin
            </button>
          </form>
        </details>
      )
    }
  </div>
  {onSale && <PriceEdit id={l.id} title={l.title} price={l.price} published={!!l.published_at} />}
  {
    onSale && (
      <ConfirmPop id={id.sold} title="Đánh dấu đã bán?" text={l.title} name="step" value="mark-sold" confirm="Đã bán">
        <input type="hidden" name="id" value={l.id} />
      </ConfirmPop>
    )
  }
  {
    deletable && (
      <ConfirmPop id={id.del} title="Xóa tin này?" text="Không hoàn tác được." name="step" value="delete" confirm="Xóa">
        <input type="hidden" name="id" value={l.id} />
      </ConfirmPop>
    )
  }
</article>
