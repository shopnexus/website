---
// The thread's items in order: day lines, bubble groups, price pills and events.
import type { ThreadItem } from '../../../lib/messages';
import Bubbles from './Bubbles.astro';
import ChatEvent from './ChatEvent.astro';
import PriceMove from './PriceMove.astro';

interface Props {
  items: ThreadItem[];
  me: string;
  other: string;
  replies?: boolean;
  /** The other person's photo, beside their messages. */
  photo?: string;
}

const { items, me, other, replies, photo } = Astro.props;
---

{
  items.map((it) =>
    it.kind === 'day' ? (
      <p class="pt-1 text-center text-label-medium text-on-surface-variant" data-day={it.label}>
        {it.label}
      </p>
    ) : it.kind === 'group' ? (
      <Bubbles side={it.side} messages={it.messages} time={it.time} me={me} other={other} replies={replies} photo={photo} />
    ) : it.kind === 'move' ? (
      <PriceMove side={it.side} amount={it.amount} time={it.time} kind={it.accept ? 'accept' : 'offer'} />
    ) : (
      <ChatEvent icon={it.icon} text={it.text} />
    ),
  )
}
