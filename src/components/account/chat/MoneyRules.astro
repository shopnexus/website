---
// The chat's "Quy tắc tiền", kept open beside the thread on a wide window.
import { MONEY } from '../../../data/common';
import { PANEL } from '../../../lib/ui';
import Icon from '../../Icon.astro';

const groups: [string, [keyof typeof MONEY, string][]][] = [
  [
    'COD, xem hàng trước',
    [
      ['cod_buyer', 'local-shipping-outline-rounded'],
      ['refuse', 'undo-rounded'],
      ['cancel', 'cancel-outline-rounded'],
    ],
  ],
];
---

<div class:list={[PANEL, 'p-3']}>
  <p class="text-title-medium text-ink">Quy tắc tiền</p>
  <div class="mt-3">
    {
      groups.map(([name, notes], i) => (
        <>
          <p class:list={['text-title-small text-primary', i > 0 && 'mt-4']}>{name}</p>
          <ul class="mt-2 flex flex-col gap-2">
            {notes.map(([k, icon]) => (
              <li class="flex gap-2 text-body-medium text-on-surface-variant">
                <Icon name={icon} size={18} class="mt-0.5" />
                <span>{MONEY[k]}</span>
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </div>
</div>
