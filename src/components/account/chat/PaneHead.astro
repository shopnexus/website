---
// The chat's bar: back to the list on a phone, the listing the chat is on and
// the person, and the menu (slot "menu"). The default slot holds the deal chips.
// The bar opens the listing; in a chat without one it opens the person's page.
import Avatar from '../../Avatar.astro';
import Icon from '../../Icon.astro';
import Photo from '../../Photo.astro';
import Popover from '../../Popover.astro';
import { R } from '../../../lib/routes';

interface Props {
  /** The listing's title, or the person's name in a chat without a deal. */
  title: string;
  name: string;
  photo?: string;
  thumb?: string;
  /** "Đang hoạt động", or how long ago. */
  sub?: string;
  /** The listing's page while it is on sale. */
  href?: string;
  /** The person's page. */
  person?: string;
}

const { title, name, photo, thumb, sub, href, person } = Astro.props;
const iconBtn = 'state-layer grid h-10 w-10 shrink-0 place-items-center rounded-full text-on-surface-variant';
const to = href ?? (thumb ? undefined : person);
const Tag = to ? 'a' : 'div';
---

<div class="border-b border-line">
  <div class="flex h-16 items-center gap-1 px-2 lg:gap-3 lg:px-4">
    <a href={R.messages} class:list={[iconBtn, 'lg:hidden']} aria-label="Về hộp thư"><Icon name="chevron-left-rounded" size={24} /></a>
    <Tag href={to} data-person={to && to === person ? '' : undefined} class:list={['flex min-w-0 flex-1 items-center gap-3 rounded-lg py-1 pr-2', to && 'state-layer']}>
      {
        thumb ? (
          <span class="relative h-10 w-10 shrink-0">
            <Photo src={thumb} width={80} height={80} alt="" class="h-10 w-10 rounded-md object-cover" data-pane-thumb />
            <span class="absolute -bottom-1 -right-1">
              <Avatar name={name} photo={photo} size={20} class="ring-2 ring-card" />
            </span>
          </span>
        ) : (
          <Avatar name={name} photo={photo} size={40} />
        )
      }
      <span class="min-w-0">
        <span class="block truncate text-title-medium text-ink" data-pane-title>{title}</span>
        <span class="block truncate text-body-small text-on-surface-variant">{[thumb ? name : '', sub].filter(Boolean).join(' · ')}</span>
      </span>
    </Tag>
    {
      Astro.slots.has('menu') && (
        <>
          <button type="button" popovertarget="chat-menu" class={iconBtn} aria-label="Tùy chọn khác">
            <Icon name="more-vert" size={22} />
          </button>
          <Popover id="chat-menu" align="end" class="w-[260px]" label="Tùy chọn">
            <slot name="menu" />
          </Popover>
        </>
      )
    }
  </div>
  <slot />
</div>
