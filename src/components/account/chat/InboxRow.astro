---
// A conversation with one person: the deal it is about, +N for the pair's other
// running deals, the last message and a tag for the deal's state. A scam
// warning is the error shield on a neutral tag.
import { type InboxItem, chatHref, dealTag, personName, preview, when } from '../../../lib/messages';
import Avatar from '../../Avatar.astro';
import Icon from '../../Icon.astro';
import Photo from '../../Photo.astro';

interface Props {
  c: InboxItem;
  me: string;
  selected?: boolean;
  /** "lazy" when it sits below the first screen. */
  loading?: 'eager' | 'lazy';
  /** What it sits on: the inbox's tinted pane, or a white card such as the header's panel. */
  on?: 'pane' | 'card';
}

const { c, me, selected = false, loading, on = 'pane' } = Astro.props;
const name = personName(c.other);
const unread = c.unread > 0;
const tag = 'mt-1.5 inline-flex h-6 items-center gap-1 rounded-full bg-surface-container-low px-2 text-label-medium text-on-surface-variant';
const role = c.deal ? (c.deal.role === 'seller' ? 'sell' : 'buy') : 'none';
const status = dealTag(c.deal);
const thumb = c.deal?.listing.cover_thumb_url;
---

<a
  href={chatHref(c.id, c.deal?.id)}
  class:list={['flex gap-3 rounded-tile p-3', on === 'card' ? 'state-layer hover:bg-hover' : 'hover:bg-card/70 aria-[current]:bg-card aria-[current]:shadow-soft']}
  data-pending="[data-chat-slot]"
  data-open={c.id}
  data-role={role}
  data-unread={unread ? '' : undefined}
  aria-current={selected ? 'true' : undefined}
>
  {
    thumb ? (
      <span class="relative h-12 w-12 shrink-0">
        <Photo src={thumb} width={96} height={96} alt="" loading={loading} class="h-12 w-12 rounded-md object-cover" />
        <span class="absolute -bottom-1 -right-1">
          <Avatar name={name} photo={c.other.avatar_url} size={24} class="ring-2 ring-card" loading={loading} />
        </span>
      </span>
    ) : (
      <Avatar name={name} photo={c.other.avatar_url} size={48} loading={loading} />
    )
  }
  <span class="min-w-0 flex-1">
    <span class="flex items-baseline gap-2">
      <span class:list={['min-w-0 flex-1 truncate text-title-small text-ink', unread && 'font-bold']}>{name}</span>
      <span class="text-body-small text-on-surface-variant">{when(c.last_message.created_at)}</span>
    </span>
    {
      c.deal && (
        <span class="mt-0.5 flex items-center gap-1 text-body-small text-on-surface-variant">
          {role === 'sell' && <Icon name="storefront-outline-rounded" size={14} class="text-primary" />}
          <span class="truncate">{c.deal.listing.title}</span>
          {c.other_active_deals > 0 && (
            <span class="ml-1 shrink-0 rounded-sm bg-surface-container-high px-1.5 text-label-small text-on-surface-variant">+{c.other_active_deals}</span>
          )}
        </span>
      )
    }
    <span class="mt-0.5 flex items-center gap-2">
      <span class:list={['min-w-0 flex-1 truncate text-body-medium', unread ? 'font-medium text-on-surface' : 'text-on-surface-variant']}>
        {preview(c.last_message, me, c.other)}
      </span>
      {unread && <span class="grid h-5 min-w-5 place-items-center rounded-full bg-primary px-1.5 text-label-small text-on-primary">{c.unread}</span>}
    </span>
    {
      c.scam_warning ? (
        <span class={tag}>
          <Icon name="gpp-maybe-outline-rounded" size={14} class="text-error" />
          Nghi lừa đảo
        </span>
      ) : (
        status && (
          <span class={tag}>
            <Icon name={status[0]} size={14} />
            {status[1]}
          </span>
        )
      )
    }
  </span>
</a>
