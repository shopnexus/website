---
// "Chọn giao COD" from the deal console: the request opens over the chat, so
// the buyer never leaves it. Where to deliver, what to check at the door,
// what they pay the shipper, then sent. The app's bottom sheet, a dialog on
// a wide window, like ReportDialog.
import { DEAL, SELLER } from '../../../data/flows';
import { crop } from '../../../lib/format';
import Icon from '../../Icon.astro';
import MoneyLine from '../../MoneyLine.astro';
import Photo from '../../Photo.astro';
import Price from '../../Price.astro';

interface Props {
  name: string;
}

const { name } = Astro.props;
const addresses = [
  { tag: 'Nhà', text: 'Vinhomes Grand Park, tòa S5.02, 512 Nguyễn Xiển, Long Bình, TP.HCM', on: true },
  { tag: 'Công ty', text: '88 Nguyễn Gia Trí, Phường 25, Bình Thạnh, TP.HCM', on: false },
];
const checks = ['Pin 88%', 'Face ID hoạt động', 'Chưa sửa chữa', 'Kèm hộp và cáp'];
const close = 'state-layer -mr-2 grid h-10 w-10 shrink-0 place-items-center rounded-full text-on-surface-variant';
const h3 = 'text-title-small text-ink';
---

<dialog
  id="cod"
  class="m-auto max-h-[calc(100dvh-32px)] w-[min(520px,calc(100vw-32px))] overflow-y-auto rounded-xl border-0 bg-card/95 p-6 text-on-surface backdrop-blur-[20px] backdrop:bg-black/30 backdrop:backdrop-blur-[2px]"
  aria-labelledby="cod-title"
>
  <div data-pane="form">
    <div class="flex items-center justify-between">
      <h2 id="cod-title" class="text-headline-small">Giao COD</h2>
      <button type="button" data-close class={close} aria-label="Đóng"><Icon name="close-rounded" size={22} /></button>
    </div>

    <div class="mt-3 flex items-center gap-3">
      <Photo src={crop(DEAL.photo, 112, 0.5, 0.52, 1.25)} width={112} height={112} alt="" class="h-14 w-14 shrink-0 rounded-field object-cover" />
      <div class="min-w-0 flex-1">
        <p class="truncate text-body-large text-ink">{DEAL.title}</p>
        <p class="flex items-center gap-1 text-label-medium text-tertiary"><Icon name="handshake-outline-rounded" size={15} />Đã chốt với {SELLER.name}</p>
      </div>
      <Price vnd={DEAL.agreed} size="text-j-20" short={false} />
    </div>

    <p class:list={[h3, 'mt-6']}>Giao đến</p>
    <p class="text-body-small text-on-surface-variant">{name} · 09•• ••• 812</p>
    <div class="mt-2 flex flex-col gap-2">
      {
        addresses.map((a) => (
          <label class="group flex cursor-pointer items-center gap-3 rounded-tile bg-surface-container-low p-3 has-[:checked]:bg-card has-[:checked]:ring-2 has-[:checked]:ring-primary">
            <input type="radio" name="cod-dia-chi" value={a.tag} checked={a.on} class="sr-only" />
            <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full border-2 border-outline-variant group-has-[:checked]:border-primary">
              <span class="hidden h-2.5 w-2.5 rounded-full bg-primary group-has-[:checked]:block" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-label-medium text-on-surface-variant">{a.tag}</span>
              <span class="block truncate text-body-medium text-ink">{a.text}</span>
            </span>
          </label>
        ))
      }
    </div>

    <p class:list={[h3, 'mt-6']}>Khi shipper tới, xem</p>
    <ul class="mt-2 flex flex-wrap gap-1.5">
      {
        checks.map((c) => (
          <li class="flex items-center gap-1.5 rounded-full bg-surface-container-low px-3 py-1.5 text-label-large text-ink">
            <Icon name="check-rounded" size={16} class="text-primary" />
            {c}
          </li>
        ))
      }
    </ul>
    <div class="mt-3 flex flex-col gap-1.5">
      <MoneyLine k="cod_buyer" icon="visibility-outline-rounded" small />
      <MoneyLine k="refuse" icon="undo-rounded" small />
    </div>

    <div class="mt-6 flex items-end justify-between gap-3 rounded-tile bg-peach-wash p-4">
      <p class="text-body-small text-on-tertiary-fixed-variant">Trả cho shipper khi nhận</p>
      <p class="flex items-baseline gap-1.5">
        <Price vnd={DEAL.agreed} size="text-j-24" short={false} /><span class="text-body-small text-on-surface-variant">+ phí ship</span>
      </p>
    </div>

    <button type="button" data-go="sent" class="state-layer mt-4 flex h-12 w-full items-center justify-center gap-2 rounded-full bg-ink text-label-large text-on-ink">
      <Icon name="send-rounded" size={18} />Gửi yêu cầu COD
    </button>
  </div>

  <div data-pane="sent" hidden>
    <div class="flex items-center justify-between">
      <h2 class="text-headline-small">Đã gửi yêu cầu COD</h2>
      <button type="button" data-close class={close} aria-label="Đóng"><Icon name="close-rounded" size={22} /></button>
    </div>
    <div class="mt-3 flex items-center gap-4">
      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-primary-container text-on-primary-container"><Icon name="check-rounded" size={24} /></span>
      <p class="text-body-medium text-on-surface-variant">{SELLER.name} tạo đơn thì bạn thấy phí ship ở đây.</p>
    </div>
    <div class="mt-6 flex justify-end">
      <button type="button" data-close class="state-layer h-10 rounded-full bg-ink px-6 text-label-large text-on-ink">Xong</button>
    </div>
  </div>
</dialog>
