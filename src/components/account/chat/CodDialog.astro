---
// "Đặt giao COD" on an agreed deal: the request opens over the chat
// (?cod=1), so the buyer never leaves it. Where to deliver, what they pay
// the shipper, their open COD orders against the cap, then sent as a form
// post. It renders open; the script makes it modal, and "Đóng" without the
// script is a link back to the chat.
import type { Schemas } from '../../../lib/api/client';
import { money } from '../../../lib/format';
import { chatHref, errorText } from '../../../lib/messages';
import { R } from '../../../lib/routes';
import Icon from '../../Icon.astro';
import AddressPick from '../../orders/AddressPick.astro';
import Notice from '../../Notice.astro';
import Photo from '../../Photo.astro';
import Price from '../../Price.astro';

interface Props {
  checkout: Schemas['CodCheckoutScreen'];
  addresses: Schemas['Address'][];
  seller: string;
  error?: string;
  /** The Idempotency-Key of this render's form. */
  idem: string;
}

const { checkout, addresses, seller, error, idem } = Astro.props;
const d = checkout.deal;
const price = d.agreed_price ?? d.listing.price;
const cap = checkout.cod_orders;
const full = cap.used >= cap.max;
const picked = checkout.address?.id;
const back = chatHref(d.conversation_id, d.id);
const close = 'state-layer -mr-2 grid h-10 w-10 shrink-0 place-items-center rounded-full text-on-surface-variant';
---

<dialog
  id="cod"
  open
  class="z-50 m-auto max-h-[calc(100dvh-32px)] w-[min(520px,calc(100vw-32px))] overflow-y-auto rounded-card border-0 bg-card/95 p-0 text-on-surface shadow-pop backdrop-blur-[20px] backdrop:bg-black/30 backdrop:backdrop-blur-[2px] max-lg:fixed max-lg:inset-4"
  aria-labelledby="cod-title"
  data-back={back}
>
  <form method="post" action={R.messages} class="p-6">
    <input type="hidden" name="do" value="cod" />
    <input type="hidden" name="chat" value={d.conversation_id} />
    <input type="hidden" name="deal" value={d.id} />
    <input type="hidden" name="key" value={idem} />
    <div class="flex items-center justify-between">
      <h2 id="cod-title" class="text-headline-small">Giao COD</h2>
      <a href={back} data-close class={close} aria-label="Đóng"><Icon name="close-rounded" size={22} /></a>
    </div>

    <div class="mt-3 flex items-center gap-3">
      {
        d.listing.cover_thumb_url ? (
          <Photo src={d.listing.cover_thumb_url} width={112} height={112} alt="" class="h-14 w-14 shrink-0 rounded-field object-cover" />
        ) : (
          <span class="h-14 w-14 shrink-0 rounded-field bg-soft" />
        )
      }
      <div class="min-w-0 flex-1">
        <p class="truncate text-body-large text-ink">{d.listing.title}</p>
        <p class="flex items-center gap-1 text-label-medium text-tertiary"><Icon name="handshake-outline-rounded" size={15} />Đã chốt với {seller}</p>
      </div>
      <Price vnd={price} size="text-j-20" short={false} />
    </div>

    {error && <Notice text={errorText(error)} class="mt-4" />}

    <AddressPick addresses={addresses} picked={picked} back={`${back}&cod=1`} class="mt-6" />

    <div class="mt-6 flex flex-col gap-1.5 text-body-medium">
      <p class="flex justify-between gap-3"><span class="text-on-surface-variant">Tiền hàng</span><span class="tabular-nums text-ink">{money(price)}</span></p>
    </div>

    <div class="mt-4 flex items-end justify-between gap-3 rounded-tile bg-peach-wash p-4">
      <p class="text-body-small text-on-tertiary-fixed-variant">Trả cho shipper khi nhận, sau khi xem hàng</p>
      <p class="flex items-baseline gap-1.5">
        <Price vnd={price} size="text-j-24" short={false} /><span class="text-body-small text-on-surface-variant">+ phí ship</span>
      </p>
    </div>

    <p class="mt-4 flex items-center gap-2 text-body-small text-on-surface-variant">
      <Icon name="receipt-long-outline-rounded" size={16} />
      {full ? `Đơn COD đang mở: đã đủ ${cap.used}/${cap.max}` : `Đơn COD đang mở: ${cap.used + 1}/${cap.max}`}
    </p>

    <button
      type="submit"
      disabled={full || !addresses.length}
      class="state-layer mt-4 flex h-12 w-full items-center justify-center gap-2 rounded-full bg-brand text-label-large text-white disabled:opacity-40"
    >
      <Icon name="send-rounded" size={18} />Gửi yêu cầu COD
    </button>
  </form>
</dialog>
