---
// "Chặn và báo cáo": the app's bottom sheet, a dialog on a wide window. The
// signals, then the block form, then sent.
import { REASONS, SCAMMER, SIGNALS } from '../../../data/account';
import Icon from '../../Icon.astro';

const close = 'state-layer -mr-2 grid h-10 w-10 shrink-0 place-items-center rounded-full text-on-surface-variant';
const btn = 'state-layer h-10 w-full rounded-full text-label-large';
---

<dialog
  id="report"
  class="m-auto w-[min(480px,calc(100vw-32px))] rounded-card border-0 bg-card/90 p-6 text-on-surface backdrop-blur-[20px] backdrop:bg-black/30 backdrop:backdrop-blur-[2px]"
  aria-labelledby="report-title"
>
  <div data-pane="signals">
    <div class="flex items-center justify-between">
      <h2 class="text-headline-small">Có thể là lừa đảo</h2>
      <button type="button" data-close class={close} aria-label="Đóng"><Icon name="close-rounded" size={22} /></button>
    </div>
    <p class="mt-1 flex items-center gap-1 text-label-medium text-primary"><Icon name="auto-awesome-rounded" size={16} />3 dấu hiệu</p>
    <ul class="mt-2">
      {
        SIGNALS.map((s) => (
          <li class="flex min-h-12 items-center gap-4">
            <Icon name={s.icon} size={24} class="text-on-surface-variant" />
            <span class="text-body-large">{s.text}</span>
          </li>
        ))
      }
    </ul>
    <button type="button" data-go="form" class:list={[btn, 'mt-6 bg-primary text-on-primary']}>Chặn và báo cáo</button>
    <button type="button" data-hide-warning class:list={[btn, 'mt-2 text-primary']}>Ẩn cảnh báo</button>
  </div>

  <div data-pane="form" hidden>
    <div class="flex items-center justify-between">
      <h2 id="report-title" class="text-headline-small">Chặn và báo cáo</h2>
      <button type="button" data-close class={close} aria-label="Đóng"><Icon name="close-rounded" size={22} /></button>
    </div>
    <p class="text-body-medium text-on-surface-variant">{SCAMMER.name}</p>
    <fieldset class="mt-3" aria-label="Lý do">
      {
        REASONS.map((r) => (
          <>
            <label class="flex min-h-12 cursor-pointer items-center gap-4">
              <input type="radio" name="reason" value={r.key} class="peer sr-only" checked={r.key === 'scam'} />
              <span class="grid h-5 w-5 flex-none place-items-center rounded-full border-2 border-on-surface-variant after:h-2.5 after:w-2.5 after:scale-0 after:rounded-full after:bg-primary after:transition-transform after:content-[''] peer-checked:border-primary peer-checked:after:scale-100 peer-focus-visible:ring-8 peer-focus-visible:ring-primary/15" />
              <span class="text-body-large">{r.label}</span>
            </label>
            {r.key === 'scam' && (
              <div class="pl-9">
                <p class="flex items-center gap-1 text-label-medium text-primary">
                  <Icon name="auto-awesome-rounded" size={14} />3 dấu hiệu
                </p>
                {SIGNALS.map((s) => (
                  <label class="flex min-h-12 cursor-pointer items-center gap-4">
                    <input type="checkbox" class="peer sr-only" checked />
                    <span class="grid h-[18px] w-[18px] flex-none place-items-center rounded-xs border-2 border-on-surface-variant text-on-primary peer-checked:border-primary peer-checked:bg-primary peer-focus-visible:ring-8 peer-focus-visible:ring-primary/15 [&>*]:opacity-0 peer-checked:[&>*]:opacity-100">
                      <Icon name="check-rounded" size={16} />
                    </span>
                    <span class="text-body-medium">{s.text}</span>
                  </label>
                ))}
              </div>
            )}
          </>
        ))
      }
    </fieldset>
    <label class="mt-3 block rounded-xs bg-surface-container-highest px-4 pb-2 pt-2">
      <span class="block text-body-small text-on-surface-variant">Ghi chú thêm (không bắt buộc)</span>
      <textarea rows="2" maxlength="300" class="mt-0.5 block w-full resize-none border-0 bg-transparent p-0 text-body-large outline-none"></textarea>
    </label>
    <p class="mt-3 flex items-center gap-2 text-body-small text-on-surface-variant">
      <Icon name="block-rounded" size={16} />{SCAMMER.name} sẽ không nhắn cho bạn được nữa.
    </p>
    <div class="mt-6 flex justify-end gap-2">
      <button type="button" data-go="signals" class="state-layer h-10 rounded-control px-4 text-label-large text-primary">Quay lại</button>
      <button type="button" data-go="sent" class="state-layer h-10 rounded-control bg-brand px-6 text-label-large text-white">Chặn và gửi báo cáo</button>
    </div>
  </div>

  <div data-pane="sent" hidden>
    <div class="flex items-center justify-between">
      <h2 class="text-headline-small">Đã gửi báo cáo</h2>
      <button type="button" data-close class={close} aria-label="Đóng"><Icon name="close-rounded" size={22} /></button>
    </div>
    <div class="mt-3 flex items-center gap-4">
      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-primary-container text-on-primary-container"><Icon name="check-rounded" size={24} /></span>
      <p class="text-body-medium text-on-surface-variant">Đã chặn {SCAMMER.name}. Cuộc trò chuyện đã rời Tin nhắn.</p>
    </div>
    <div class="mt-6 flex justify-end gap-2">
      <button type="button" data-unblock class="state-layer h-10 rounded-control px-4 text-label-large text-primary">Bỏ chặn</button>
      <button type="button" data-close class="state-layer h-10 rounded-control bg-brand px-6 text-label-large text-white">Xong</button>
    </div>
  </div>
</dialog>
