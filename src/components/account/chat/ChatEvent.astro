---
// A line in the thread that nobody typed: a price declined, an order step.
import Icon from '../../Icon.astro';

interface Props {
  icon: string;
  text: string;
}

const { icon, text } = Astro.props;
---

<p class="flex items-center justify-center gap-1.5 text-center text-label-medium text-on-surface-variant"><Icon name={icon} size={16} />{text}</p>
