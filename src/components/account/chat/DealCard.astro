---
// The listing beside the chat: photo, title, place and the price rows (slot).
import { PANEL } from '../../../lib/ui';

interface Props {
  title: string;
  photo: string;
  meta: string;
  /** The deal chip that shows this card. */
  deal?: string;
  hidden?: boolean;
  href?: string;
}

const { title, photo, meta, deal, hidden = false, href = '#' } = Astro.props;
---

<div class:list={[PANEL, 'p-3']} data-deal-card={deal} hidden={hidden}>
  <img src={photo} alt={title} class="aspect-[4/3] w-full rounded-lg object-cover" />
  <p class="mt-3 line-clamp-2 text-title-medium text-ink">{title}</p>
  <p class="mt-1 text-body-small text-on-surface-variant">{meta}</p>
  <slot />
  <a
    href={href}
    class="state-layer mt-4 flex h-10 items-center justify-center rounded-full border border-outline-variant text-label-large text-primary"
  >
    Xem tin
  </a>
</div>
