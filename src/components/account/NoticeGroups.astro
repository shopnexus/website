---
// Notices by day, the unread ones tinted. An unread one posts to Thông báo,
// which marks it read and opens its page; a read one is a plain link.
import type { Schemas } from '../../lib/api/client';
import { ago } from '../../lib/format';
import { TONES, byDay, look, noticeHref } from '../../lib/notices';
import { R } from '../../lib/routes';
import Icon from '../Icon.astro';

interface Props {
  items: Schemas['Notification'][];
}

const groups = byDay(Astro.props.items);
const row = 'state-layer flex w-full items-start gap-3 rounded-lg px-3 py-2.5 text-left';
---

{
  groups.map(([day, items]) => (
    <section class="not-first:mt-3 not-first:border-t not-first:border-line not-first:pt-3" data-more-key={day}>
      <h2 class="px-3 pb-1 text-label-medium text-on-surface-variant">{day}</h2>
      <ul class="flex flex-col gap-0.5" data-more-items>
        {items.map((n) => {
          const [icon, tone] = look(n.type);
          const to = noticeHref(n.target);
          const body = (
            <>
              <span class:list={['grid h-9 w-9 shrink-0 place-items-center rounded-full', TONES[tone]]}>
                <Icon name={icon} size={18} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-body-medium text-ink">{n.text}</span>
                <span class="block text-body-small text-on-surface-variant">{ago(n.at)} trước</span>
              </span>
              <span class="self-center">
                {n.unread ? <span class="block h-2 w-2 rounded-full bg-primary" aria-label="Chưa đọc" /> : <span class="block w-2" />}
              </span>
            </>
          );
          return (
            <li>
              {n.unread ? (
                <form method="post" action={R.notifications}>
                  <input type="hidden" name="id" value={n.id} />
                  <input type="hidden" name="to" value={to} />
                  <button type="submit" name="do" value="open" class:list={[row, 'bg-primary/5']}>
                    {body}
                  </button>
                </form>
              ) : (
                <a href={to} class={row}>
                  {body}
                </a>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  ))
}
