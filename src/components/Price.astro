---
// A price in two sizes: the number in the given J step, the unit small.
// Cards shorten 10 triệu and above ("12,5 tr ₫"); pass short={false} for the full figure.
import { priceParts } from '../lib/format';

interface Props {
  vnd: number;
  /** A text-j-* step. */
  size?: string;
  short?: boolean;
  class?: string;
}

const { vnd, size = 'text-j-16', short = true, class: cls } = Astro.props;
const [num, unit] = priceParts(vnd, short);
---

<span class:list={['whitespace-nowrap text-ink tabular-nums', size, cls]}
  >{num}<span class="ml-0.5 text-body-small font-medium tracking-normal text-sub">{unit}</span></span
>
