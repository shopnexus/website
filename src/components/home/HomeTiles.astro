---
// Home's four tiles. Signed in: the order on the way, offers, saved, their
// listings. Signed out: listings this browser viewed, ones like them, the price
// of a recent search, and signing in to keep what they viewed.
import { LISTINGS } from '../../data/listings';
import { BUYING } from '../../data/orders';
import { img } from '../../lib/format';
import { R } from '../../lib/routes';
import Icon from '../Icon.astro';

interface Props {
  signedIn: boolean;
}

const { signedIn } = Astro.props;
const tile = 'lift flex items-center gap-3 rounded-panel border border-line bg-card p-4';
const stack = 'h-12 w-12 rounded-field object-cover ring-2 ring-card';
// The order on the way is Đơn hàng's o1.
const order = BUYING.find((o) => o.id === 'o1')!;
const offer = LISTINGS[5];
const savedPhotos = [LISTINGS[3], LISTINGS[9], LISTINGS[4]].map((l) => l.photo);
const seen = [LISTINGS[5], LISTINGS[9], LISTINGS[10]];
---

<div class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-2">
  {
    signedIn ? (
      <>
        <a href={R.order(order.id)} class={tile}>
          <img src={img(order.photo, 160, 160)} alt="" class="h-16 w-16 shrink-0 rounded-lg object-cover" />
          <span class="min-w-0 flex-1">
            <span class="flex items-center gap-1.5 text-label-medium text-primary">
              <Icon name="local-shipping-outline-rounded" size={16} />
              Đơn đang giao
            </span>
            <span class="mt-0.5 block truncate text-body-medium text-ink">{order.title}</span>
            <span class="block text-body-small text-on-surface-variant">Shipper giao chiều nay · trả khi đã xem hàng</span>
          </span>
        </a>
        <a href={R.messages} class={tile}>
          <img src={img(offer.photo, 160, 160)} alt="" class="h-16 w-16 shrink-0 rounded-lg object-cover" />
          <span class="min-w-0 flex-1">
            <span class="flex items-center gap-1.5 text-label-medium text-tertiary">
              <Icon name="sell-outline-rounded" size={16} />
              Đang trả giá · 2
            </span>
            <span class="mt-0.5 block truncate text-body-medium text-ink">{offer.title}</span>
            <span class="block text-body-small text-on-surface-variant">
              Người bán trả lại <b class="font-semibold text-tertiary">4.500.000 ₫</b>
            </span>
          </span>
          <span class="shrink-0 rounded-full bg-tertiary px-3 py-1.5 text-label-medium text-on-tertiary">Trả lời</span>
        </a>
        <a href={R.saved} class={tile}>
          <span class="flex shrink-0 -space-x-4">
            {savedPhotos.map((p) => (
              <img src={img(p, 120, 120)} alt="" class={stack} />
            ))}
          </span>
          <span class="min-w-0 flex-1">
            <span class="flex items-center gap-1.5 text-label-medium text-on-surface-variant">
              <Icon name="favorite-outline-rounded" size={16} />
              Tin đã lưu · 13
            </span>
            <span class="mt-0.5 block truncate text-body-medium text-ink">Polaroid OneStep 2 vừa giảm 150.000 ₫</span>
          </span>
        </a>
        <a href={R.myListings} class={tile}>
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-field bg-secondary-container text-on-secondary-container">
            <Icon name="storefront-outline-rounded" size={22} />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-label-medium text-on-surface-variant">Tin của bạn · 5 đang bán</span>
            <span class="mt-0.5 block text-body-medium text-ink">
              <b class="font-semibold tabular-nums">46</b> lượt xem mới · <b class="font-semibold tabular-nums">5</b> tin nhắn
            </span>
          </span>
        </a>
      </>
    ) : (
      <>
        <a href={R.listing(seen[0].id)} class={tile}>
          <span class="flex shrink-0 -space-x-4">
            {seen.map((it) => (
              <img src={img(it.photo, 120, 120)} alt="" class={stack} />
            ))}
          </span>
          <span class="min-w-0 flex-1">
            <span class="flex items-center gap-1.5 text-label-medium text-on-surface-variant">
              <Icon name="history-rounded" size={16} />
              Bạn vừa xem · 3
            </span>
            <span class="mt-0.5 block truncate text-body-medium text-ink">Sofa nhung xanh và 2 ghế</span>
          </span>
        </a>
        <a href={R.category('noi-that')} class={tile}>
          <img src={img(LISTINGS[9].photo, 160, 160)} alt="" class="h-12 w-12 shrink-0 rounded-field object-cover" />
          <span class="min-w-0 flex-1">
            <span class="flex items-center gap-1.5 text-label-medium text-primary">
              <Icon name="chair-outline-rounded" size={16} />
              Giống tin bạn vừa xem
            </span>
            <span class="mt-0.5 block text-body-medium text-ink">
              <b class="font-semibold tabular-nums">8</b> sofa, ghế mới quanh Bình Thạnh
            </span>
          </span>
        </a>
        <a href={`${R.search}?q=${encodeURIComponent('iPhone 13 pin trên 85%')}`} class={tile}>
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-field bg-tertiary-fixed text-on-tertiary-fixed-variant">
            <Icon name="sell-outline-rounded" size={22} />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-label-medium text-on-surface-variant">iPhone 13, pin trên 85%</span>
            <span class="mt-0.5 block text-body-medium text-ink">
              Đang bán quanh <b class="font-semibold tabular-nums">5,3 tr ₫</b> · 412 tin
            </span>
          </span>
        </a>
        <div class="flex items-center gap-3 rounded-panel border border-line bg-card p-4">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-field bg-secondary-container text-on-secondary-container">
            <Icon name="favorite-outline-rounded" size={22} />
          </span>
          <p class="min-w-0 flex-1 text-body-medium text-ink">Giữ 3 tin bạn vừa xem trên mọi máy</p>
          <a href={`${R.login}?tiep=/`} class="state-layer flex h-9 shrink-0 items-center rounded-full bg-ink px-4 text-label-large text-on-ink">
            Đăng nhập
          </a>
        </div>
      </>
    )
  }
</div>
