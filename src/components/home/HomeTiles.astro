---
import Photo from '../Photo.astro';
// Home's two shortcuts over the feed. Signed in: the order on the way and the
// offer waiting on the buyer. Signed out: the listings this browser viewed,
// and signing in to keep them.
import { LISTINGS } from '../../data/listings';
import { BUYING } from '../../data/orders';
import { img } from '../../lib/format';
import { R } from '../../lib/routes';
import { loginUrl } from '../../lib/session';

interface Props {
  signedIn: boolean;
}

const { signedIn } = Astro.props;
const tile = 'lift flex items-center gap-3.5 rounded-card border border-line bg-card px-4 py-3.5';
const action = 'shrink-0 rounded-control border border-field bg-card px-3.5 py-2 text-title-small text-ink';
// The order on the way is Đơn hàng's o1.
const order = BUYING.find((o) => o.id === 'o1')!;
const offer = LISTINGS[5];
const seen = [LISTINGS[5], LISTINGS[9], LISTINGS[10]];
---

<div class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-2">
  {
    signedIn ? (
      <>
        <a href={R.order(order.id)} class={tile}>
          <Photo src={img(order.photo, 96, 96)} width={96} height={96} alt="" class="h-12 w-12 shrink-0 rounded-control object-cover" />
          <span class="min-w-0 flex-1">
            <span class="flex items-center gap-1.5 text-body-small text-faint">
              <span class="h-1.5 w-1.5 rounded-full bg-[#2563eb]" />
              Đơn đang giao
            </span>
            <span class="mt-0.5 block truncate text-title-medium text-ink">{order.title}</span>
            <span class="block text-body-small text-sub">Shipper giao chiều nay</span>
          </span>
          <span class={action}>Xem đơn</span>
        </a>
        <a href={R.messages} class={tile}>
          <Photo src={img(offer.photo, 96, 96)} width={96} height={96} alt="" class="h-12 w-12 shrink-0 rounded-control object-cover" />
          <span class="min-w-0 flex-1">
            <span class="flex items-center gap-1.5 text-body-small text-faint">
              <span class="h-1.5 w-1.5 rounded-full bg-brand" />
              Đang trả giá
            </span>
            <span class="mt-0.5 block truncate text-title-medium text-ink">{offer.title}</span>
            <span class="block text-body-small text-sub">Người bán trả lại 4.500.000 ₫</span>
          </span>
          <span class={action}>Trả lời</span>
        </a>
      </>
    ) : (
      <>
        <a href={R.listing(seen[0].id)} class={tile}>
          <span class="flex shrink-0 -space-x-4">
            {seen.map((it) => (
              <Photo src={img(it.photo, 96, 96)} width={96} height={96} alt="" class="h-12 w-12 rounded-control object-cover ring-2 ring-card" />
            ))}
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-body-small text-faint">Bạn vừa xem · 3</span>
            <span class="mt-0.5 block truncate text-title-medium text-ink">Sofa nhung xanh và 2 ghế</span>
          </span>
        </a>
        <div class="flex items-center gap-3.5 rounded-card border border-line bg-card px-4 py-3.5">
          <p class="min-w-0 flex-1 text-body-large text-ink">Đăng nhập để giữ tin đã xem trên mọi máy</p>
          <a href={loginUrl(Astro.url)} class="state-layer shrink-0 rounded-control bg-brand px-4 py-2 text-title-small text-white hover:bg-brand-hover">
            Đăng nhập
          </a>
        </div>
      </>
    )
  }
</div>
