---
// Home's left rail from expanded up (K2, after ai-portal's sidebar): every
// category with its count, the buyer's saved searches and lists, then how COD
// works. Signed out, the rail has the categories and COD.
import artCod from '@brand/art_cod_ready.webp';
import { group } from '../../lib/format';
import { R } from '../../lib/routes';
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';

export interface RailCategory {
  code: string;
  name: string;
  icon: string;
  count: number;
}

export interface RailWatch {
  id: string;
  query: string;
  /** New listings since the buyer last ran it. */
  fresh: number;
}

interface Props {
  categories: RailCategory[];
  /** Signed in: the saved searches; null signed out. */
  watches: RailWatch[] | null;
}

const { categories, watches } = Astro.props;
const row = 'state-layer flex h-9 items-center gap-2.5 rounded-sm px-2.5 text-body-large text-ink hover:bg-hover';
---

<aside class="sticky top-[88px] hidden self-start lg:block" aria-label="Danh mục và tìm kiếm của bạn">
  <p class="px-2.5 text-body-small text-faint">Danh mục</p>
  <nav class="mt-1.5 flex flex-col">
    {
      categories.map((c) => (
        <a href={R.category(c.code)} class={row}>
          <Icon name={c.icon} size={17} class="text-sub" />
          <span class="flex-1 truncate">{c.name}</span>
          <span class="text-body-small text-faint tabular-nums">{group(c.count)}</span>
        </a>
      ))
    }
  </nav>
  {
    watches && (
      <>
        <div class="my-4 border-t border-line" />
        {watches.length > 0 && <p class="px-2.5 text-body-small text-faint">Tìm đã lưu</p>}
        <nav class="mt-1.5 flex flex-col">
          {watches.map((w) => (
            <a href={`${R.search}?watch=${w.id}`} class={row}>
              <Icon name="notifications-outline-rounded" size={16} class="text-sub" />
              <span class="flex-1 truncate">{w.query}</span>
              {w.fresh > 0 && <span class="rounded-full bg-mint px-1.5 text-label-small text-on-mint tabular-nums">{w.fresh}</span>}
            </a>
          ))}
          <a href={R.saved} class={row}>
            <Icon name="favorite-outline-rounded" size={16} class="text-sub" />
            <span class="flex-1">Tin đã lưu</span>
          </a>
          <a href={R.myListings} class={row}>
            <Icon name="storefront-outline-rounded" size={16} class="text-sub" />
            <span class="flex-1">Tin của bạn</span>
          </a>
        </nav>
      </>
    )
  }
  <div class="my-4 border-t border-line"></div>
  <a href={R.how} class="block rounded-md bg-mint p-3.5 hover:brightness-[.98]">
    <Photo src={artCod} alt="" width={184} height={184} class="mx-auto h-[92px] w-auto" />
    <span class="mt-2 block text-title-small text-on-mint">Mua bằng COD</span>
    <span class="block text-body-small text-on-mint/80">Xem hàng rồi mới trả tiền</span>
  </a>
</aside>
