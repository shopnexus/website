---
import Photo from './Photo.astro';
import brandMark from '@brand/brand_mark.svg';
import { MONEY } from '../data/common';
import { LINK } from '../lib/routes';

const cols: [string, string[]][] = [
  ['Khám phá', ['Dành cho bạn', 'Bản đồ', 'Danh mục', 'Mới nhất']],
  ['Mua và bán', ['Cách mua bằng COD', 'Cách đăng tin', 'Gói người bán', 'Điểm uy tín']],
  ['Hỗ trợ', ['Trợ giúp và an toàn', 'Yêu cầu hỗ trợ', 'Quy định đăng tin', 'Điều khoản']],
];
---

<footer class="mx-auto mt-12 max-w-[1360px] px-4 pb-8 md:px-6 lg:px-8">
  <div
    class="grid grid-cols-2 gap-8 rounded-xl border border-line bg-card px-6 py-8 lg:grid-cols-[1.6fr_1fr_1fr_1fr] lg:gap-10 lg:px-10 lg:py-9"
  >
    <div class="col-span-2 lg:col-span-1">
      <div class="flex items-center gap-2">
        <Photo src={brandMark} alt="" loading="lazy" class="h-8 w-8" />
        <span class="text-j-20 text-ink">ShopNexus</span>
      </div>
      <p class="mt-3 max-w-[320px] text-body-medium text-on-surface-variant">
        Đồ cũ giá tốt, xem hàng rồi mới trả. {MONEY.no_hold}
      </p>
    </div>
    {
      cols.map(([title, links]) => (
        <div>
          <p class="text-label-medium text-on-surface-variant">{title}</p>
          <ul class="mt-3 flex flex-col gap-2 text-body-medium text-ink">
            {links.map((l) => (
              <li>
                <a href={LINK[l]} class="hover:text-primary">
                  {l}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="flex justify-between px-4 pt-4 text-body-small text-on-surface-variant">
    <span>© 2026 ShopNexus</span><span>TP.HCM · Hà Nội · Đà Nẵng</span>
  </div>
</footer>
