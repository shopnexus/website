---
// K2's footer: a white band under a hairline, the brand line and three link
// columns, then the copyright row.
import BrandMark from '@brand/brand_mark.svg';
import { LINK } from '../lib/routes';

const cols: [string, string[]][] = [
  ['Khám phá', ['Dành cho bạn', 'Danh mục', 'Mới nhất']],
  ['Mua và bán', ['Cách mua bằng COD', 'Cách đăng tin', 'Gói người bán', 'Uy tín']],
  ['Hỗ trợ', ['Trợ giúp và an toàn', 'Yêu cầu hỗ trợ', 'Quy định đăng tin', 'Điều khoản']],
];
---

<footer class="mt-20 border-t border-line bg-card">
  <div class="mx-auto grid max-w-[1280px] grid-cols-2 gap-8 px-4 py-10 md:px-6 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-10 lg:px-8 lg:py-12">
    <div class="col-span-2 lg:col-span-1">
      <div class="flex items-center gap-2">
        <BrandMark class="h-7 w-7" aria-hidden="true" />
        <span class="text-j-15 text-ink">ShopNexus</span>
      </div>
      <p class="mt-3 max-w-[280px] text-body-large text-sub">Mua bán đồ cũ quanh bạn. Xem hàng rồi mới trả tiền.</p>
    </div>
    {
      cols.map(([title, links]) => (
        <div>
          <p class="text-body-small text-faint">{title}</p>
          <ul class="mt-3 flex flex-col gap-2 text-body-large text-ink pointer-coarse:mt-0.5 pointer-coarse:-mb-2.5 pointer-coarse:gap-0">
            {links.map((l) => (
              <li>
                <a href={LINK[l]} class="hover:underline pointer-coarse:flex pointer-coarse:min-h-10 pointer-coarse:items-center">
                  {l}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="mx-auto flex max-w-[1280px] justify-between border-t border-line px-4 py-5 text-body-small text-faint md:px-6 lg:px-8">
    <span>© 2026 ShopNexus</span><span>TP.HCM · Hà Nội · Đà Nẵng</span>
  </div>
</footer>
