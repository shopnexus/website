---
// Every account page's side column: who you are with your rating, then the
// account's pages with the unread counts; the current one is an ink pill.
// Hidden below expanded, where BottomNav's Tôi leads to it.
import { ACCOUNT_NAV } from '../data/common';
import { unwrap } from '../lib/api/client';
import { ratingText } from '../lib/format';
import { reputation } from '../lib/profile';
import { R } from '../lib/routes';
import { viewer } from '../lib/session';
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';

export type AccountKey = (typeof ACCOUNT_NAV)[number]['key'];

interface Props {
  active: AccountKey;
}

const { active } = Astro.props;
const me = viewer(Astro)!;
// The rating and sales line, and support's unread replies; without them the card keeps the name alone.
const [rep, support] = await Promise.all([
  reputation(Astro.locals).catch(() => null),
  unwrap(Astro.locals.api.GET('/v1/support/summary')).catch(() => null),
]);
const count: Partial<Record<AccountKey, number>> = { messages: me.unread.messages, notifications: me.unread.notifications, support: support?.unread };
const HREF: Record<string, string> = {
  me: R.me,
  listings: R.myListings,
  orders: R.orders,
  sales: R.sales,
  saved: R.saved,
  messages: R.messages,
  notifications: R.notifications,
  cod: R.codSetup,
  support: R.support,
};
---

<aside class="hidden self-start lg:sticky-fit lg:sticky lg:top-[80px] lg:-m-1 lg:p-1 lg:block">
  <a href={R.me} class="border border-line bg-card flex items-center gap-3 rounded-panel p-3">
    <Avatar name={me.name} photo={me.photo} size={44} class="ring-2 ring-card" />
    <span class="min-w-0">
      <span class="block truncate text-title-small text-ink">{me.name}</span>
      {
        rep && (
          <span class="flex items-center gap-1 text-body-small text-on-surface-variant">
            <Icon name="star-rounded" size={13} class="text-star" />
            {ratingText(rep.rating)[0]} · {rep.sold} đã bán
          </span>
        )
      }
    </span>
  </a>
  <nav class="mt-3 flex flex-col gap-0.5" aria-label="Tài khoản">
    {
      ACCOUNT_NAV.map((it) => {
        const on = it.key === active;
        return (
          <a
            href={HREF[it.key]}
            aria-current={on ? 'page' : undefined}
            class:list={[
              'flex h-9 items-center gap-2.5 rounded-sm px-2.5 text-body-large',
              on ? 'bg-mint font-medium text-on-mint' : 'text-ink hover:bg-hover',
            ]}
          >
            <Icon name={on ? it.icon.replace('-outline', '') : it.icon} size={17} class={on ? 'text-brand' : 'text-sub'} />
            <span class="flex-1">{it.label}</span>
            {!!count[it.key] && (
              <span class:list={['text-body-small tabular-nums', on ? 'text-on-mint' : 'text-faint']}>{count[it.key]}</span>
            )}
          </a>
        );
      })
    }
  </nav>
</aside>
