---
// Six boxes for a six-digit code, named `code`. The page's script moves
// between them and submits the form at the sixth digit (lib/code-boxes.ts).
import { FIELD } from '../lib/ui';
---

<fieldset class="mt-3 flex justify-between gap-1.5" aria-label="Mã 6 số" data-code-boxes>
  {
    Array.from({ length: 6 }, (_, i) => (
      <input
        name="code"
        inputmode="numeric"
        maxlength={6}
        required
        autocomplete={i === 0 ? 'one-time-code' : 'off'}
        aria-label={`Số ${i + 1}`}
        class:list={[FIELD, 'h-14 w-12 min-w-0 text-center text-j-24 text-ink caret-primary tabular-nums outline-none']}
        data-digit
      />
    ))
  }
</fieldset>
