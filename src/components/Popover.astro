---
// A top-layer panel under its control (popovertarget, or data-anchor on a field),
// or over it with above. align: the edge it shares with the control; match: the
// control's width.
// Below 600 px it spans the window, or with `sheet` rises as a bottom sheet.
// type hint: a hover card, which leaves open menus and panels alone.
interface Props {
  id: string;
  align?: 'start' | 'end';
  match?: boolean;
  class?: string;
  label?: string;
  sheet?: boolean;
  type?: 'auto' | 'hint';
  above?: boolean;
}

const { id, align = 'start', match = false, class: cls, label, sheet = false, type = 'auto', above = false } = Astro.props;
---

<div
  id={id}
  popover={type}
  data-align={align}
  data-match={match ? '' : undefined}
  data-sheet={sheet ? '' : undefined}
  data-above={above ? '' : undefined}
  aria-label={label}
  class:list={['pop fixed inset-auto m-0 overflow-y-auto rounded-lg-plus border-0 bg-card p-2 text-ink shadow-pop', cls]}
>
  <slot />
</div>

<script>
  // Place each panel under its control as it opens.
  for (const pop of document.querySelectorAll<HTMLElement>('.pop[popover]')) {
    pop.addEventListener('beforetoggle', (e) => {
      if ((e as ToggleEvent).newState !== 'open') return;
      const anchor = document.querySelector(`[popovertarget="${pop.id}"], [data-anchor="${pop.id}"]`);
      if (!anchor) return;
      // A sheet on a phone keeps the place its CSS gives it.
      if ('sheet' in pop.dataset && innerWidth < 600) {
        pop.removeAttribute('style');
        return;
      }
      const r = anchor.getBoundingClientRect();
      // A long panel scrolls inside the window.
      if ('above' in pop.dataset) {
        Object.assign(pop.style, { top: 'auto', bottom: `${innerHeight - r.top + 8}px`, maxHeight: `${r.top - 24}px` });
      } else {
        Object.assign(pop.style, { top: `${r.bottom + 8}px`, bottom: 'auto', maxHeight: `${innerHeight - r.bottom - 24}px` });
      }
      // On a phone it spans the window, 16 px from each side.
      if (innerWidth < 600) {
        Object.assign(pop.style, { left: '16px', right: '16px', width: 'auto' });
        return;
      }
      if (pop.dataset.align === 'end') {
        pop.style.right = `${document.documentElement.clientWidth - r.right}px`;
        pop.style.left = 'auto';
      } else {
        pop.style.left = `${r.left}px`;
        pop.style.right = 'auto';
      }
      if ('match' in pop.dataset) pop.style.width = `${r.width}px`;
    });
  }
</script>

<style>
  /* A sheet below 600 px: the window's width at its foot, over a dim backdrop,
     rising on the spatial spring. */
  @media (width < 600px) {
    .pop[data-sheet] {
      inset: auto 0 0;
      width: 100%;
      max-width: none;
      max-height: 88dvh;
      border-radius: 20px 20px 0 0;
      padding-bottom: calc(env(safe-area-inset-bottom) + 16px);
      translate: 0 100%;
      transition:
        translate var(--duration-spatial-default) var(--ease-spatial),
        overlay var(--duration-spatial-default) allow-discrete,
        display var(--duration-spatial-default) allow-discrete;
      &:popover-open {
        translate: 0 0;
      }
      &::backdrop {
        background: rgb(0 0 0 / 0.3);
        opacity: 0;
        transition:
          opacity var(--duration-effects-default) var(--ease-effects),
          overlay var(--duration-effects-default) allow-discrete,
          display var(--duration-effects-default) allow-discrete;
      }
      &:popover-open::backdrop {
        opacity: 1;
      }
    }
    @starting-style {
      .pop[data-sheet]:popover-open {
        translate: 0 100%;
      }
      .pop[data-sheet]:popover-open::backdrop {
        opacity: 0;
      }
    }
  }
</style>
