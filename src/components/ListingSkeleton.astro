---
// A listing card while it loads: the card's frame with the photo and three
// lines as shimmering blocks. The feed draws them while a page is on its way.
---

<div class="min-w-0 rounded-card border border-line bg-card p-2" aria-hidden="true" data-skeleton>
  <div class="skeleton aspect-square rounded-lg"></div>
  <div class="px-1.5 pb-1.5 pt-3">
    <div class="skeleton h-5 w-1/2 rounded-full"></div>
    <div class="skeleton mt-2 h-3.5 w-11/12 rounded-full"></div>
    <div class="skeleton mt-1.5 h-3.5 w-2/3 rounded-full"></div>
    <div class="skeleton mt-3 h-3 w-1/2 rounded-full"></div>
  </div>
</div>
