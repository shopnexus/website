---
// Compact and medium windows: the app's bottom bar with its four destinations
// and "Đăng tin" as the extended FAB above it.
import { R } from '../lib/routes';
import Icon from './Icon.astro';
import type { Section } from './Header.astro';

interface Props {
  section: Section | null;
  fab?: boolean;
}

const { section, fab = true } = Astro.props;
const path = Astro.url.pathname;
const items = [
  { label: 'Khám phá', icon: 'explore-outline-rounded', href: R.home, on: section === 'explore' },
  { label: 'Danh mục', icon: 'category-outline-rounded', href: R.categories, on: section === 'categories' },
  { label: 'Tin nhắn', icon: 'chat-outline-rounded', href: R.messages, on: path.startsWith(R.messages) },
  { label: 'Tôi', icon: 'person-outline-rounded', href: R.me, on: path.startsWith(R.me) },
];
---

{fab && (<a
  href={R.post}
  class="state-layer fixed bottom-24 right-4 z-30 flex h-14 items-center gap-2 rounded-card bg-brand pl-4 pr-5 text-title-small text-white shadow-pop lg:hidden"
>
  <Icon name="add-rounded" size={22} />
  Đăng tin
</a>)}
<nav class="glass fixed inset-x-0 bottom-0 z-30 grid h-20 grid-cols-4 border-t border-line lg:hidden" aria-label="Mục chính">
  {
    items.map((it) => (
      <a
        href={it.href}
        aria-current={it.on ? 'page' : undefined}
        class="group flex flex-col items-center justify-center gap-1 text-label-medium text-on-surface-variant aria-[current=page]:text-ink"
      >
        <span class="grid h-8 w-16 place-items-center rounded-full group-aria-[current=page]:bg-mint group-aria-[current=page]:text-on-mint">
          <Icon name={it.on ? it.icon.replace('-outline', '') : it.icon} size={24} />
        </span>
        {it.label}
      </a>
    ))
  }
</nav>
