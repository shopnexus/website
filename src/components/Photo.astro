---
// Every image on the site goes through Astro's Image. Image loads lazily by
// default, but most photos here sit in the first screen, so Photo loads
// eagerly and a caller passes loading="lazy" for one further down.
import type { ComponentProps } from 'astro/types';
import { Image } from 'astro:assets';

type Props = ComponentProps<typeof Image> & {
  /** Fade in over the placeholder once loaded (motion.css). Listing photos do. */
  fade?: boolean;
};

const { loading = 'eager', fade = false, class: cls, ...rest } = Astro.props;
// A photo from the server holds a calm tone in its box until it arrives.
// Bundled art keeps its transparency, and a letterboxed photo its frame.
const tone = typeof rest.src === 'string' && !/\bobject-contain\b/.test(cls ?? '');
---

<Image loading={loading} data-fade={fade ? '' : undefined} class:list={[tone && 'bg-surface-container-high', cls]} {...rest} />
