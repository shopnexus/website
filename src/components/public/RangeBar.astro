---
// A price band on an axis: the band lo–hi in peach, a tick at the median, an
// optional dot for this listing, and the axis labels under it.
import { tr } from './tr';

interface Props {
  lo: number;
  hi: number;
  med: number;
  axis?: [number, number];
  mark?: number;
  labels?: boolean;
}

const { lo, hi, med, axis, mark, labels = true } = Astro.props;
const [aLo, aHi] = axis ?? [lo * 0.85, hi * 1.15];
const at = (v: number) => Math.round(((v - aLo) / (aHi - aLo)) * 10000) / 100;
---

<div class="relative h-3.5" aria-hidden="true">
  <span class="absolute inset-x-0 top-1 h-1.5 rounded-full bg-surface-container-high"></span>
  <span
    class="absolute top-1 h-1.5 rounded-full bg-mint"
    data-fill
    style={`left:${at(lo)}%;right:${100 - at(hi)}%`}></span>
  <span class="absolute top-0 h-3.5 w-0.5 -translate-x-1/2 rounded-full bg-ink" style={`left:${at(med)}%`}></span>
  {
    mark && (
      <span
        class="absolute top-0 h-3.5 w-3.5 -translate-x-1/2 rounded-full border-2 border-white bg-tertiary shadow-knob"
        data-dot
        style={`left:${at(mark)}%`}
      />
    )
  }
</div>
{
  labels && (
    <div class="mt-1 flex justify-between text-body-small text-on-surface-variant">
      <span>{tr(aLo)} tr</span>
      <span>
        giữa <b class="font-semibold text-ink tabular-nums">{tr(med)} tr</b>
      </span>
      <span>{tr(aHi)} tr</span>
    </div>
  )
}
