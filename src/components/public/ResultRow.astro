---
import Photo from '../Photo.astro';
// Tìm kiếm's list view: one listing as a row, photo, price, title, condition and place.
import { where } from '../../lib/format';
import type { Card } from '../../lib/listing';
import { R } from '../../lib/routes';
import Icon from '../Icon.astro';
import Price from '../Price.astro';

interface Props {
  item: Card;
}

const { item } = Astro.props;
const meta = [item.condition, where(item.km, item.area)].join(' · ');
---

<article class="lift relative flex gap-4 rounded-card border border-line bg-card p-2 pr-4">
  <div class="h-28 w-28 shrink-0 overflow-hidden rounded-lg bg-surface-container-high md:h-32 md:w-32">
    {item.photo && <Photo src={item.photo} width={480} height={480} alt={item.title} loading="lazy" class="h-full w-full object-cover" />}
  </div>
  <div class="flex min-w-0 flex-1 flex-col justify-center py-1">
    <Price vnd={item.price} size="text-j-20" />
    <h3 class="mt-0.5 line-clamp-2 text-body-large text-ink">
      <a href={R.listing(item.slug)} class="after:absolute after:inset-0 after:rounded-card">{item.title}</a>
    </h3>
    <p class="mt-1.5 flex items-center gap-1 text-body-small text-on-surface-variant">
      <Icon name="near-me-outline-rounded" size={13} />{meta}
    </p>
  </div>
</article>
