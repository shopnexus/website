---
// The results of Tìm kiếm and a category page (K2): the headline and what
// the model read, "Báo khi có tin mới", the filter panel on the left, then
// the query's chips (the slot), the sort tabs with the grid/list switch, the
// cards with the alert strip after the eighth, and "Xem thêm tin". A result
// opens its page; its "Xem nhanh" opens it in a drawer over them.
import { area } from '../../lib/area';
import type { Card } from '../../lib/listing';
import { type Search, type Sort, searchHref } from '../../lib/search';
import { CONTENT, btnCls } from '../../lib/ui';
import Icon from '../Icon.astro';
import ListingCard from '../ListingCard.astro';
import Seg from '../Seg.astro';
import Skeleton from '../Skeleton.astro';
import QuickView from './QuickView.astro';
import ResultRow from './ResultRow.astro';
import SearchFilters from './SearchFilters.astro';
import WatchButton from './WatchButton.astro';

interface Props {
  items: Card[];
  search: Search;
  /** The page the filters and sorts link to: Tìm kiếm or the category's. */
  base: string;
  /** Left out where the page's own h1 already names the results. */
  title?: string;
  /** The model's sentence of what was searched. */
  understood?: string;
  /** The next page's cursor. */
  next?: string;
  /** Whether "Báo khi có tin mới" shows: a query the buyer does not watch yet. */
  watchable: boolean;
  /** A saved search runs as it was saved, without the filter panel. */
  filters?: boolean;
  /** 2 under a page's own h1, as on a category page. */
  level?: 1 | 2;
}

const { items, search, base, title, understood, next, watchable, filters = true, level = 1 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
// "Gần nhất" needs the buyer's place and a search that takes one. Without
// words or a photo the server's own order is the newest first.
const ranked = !!(search.q || search.photo);
const nearest = !!area(Astro.cookies) && !search.watch;
const sorts: [string, Sort | undefined][] = [
  [ranked ? 'Phù hợp nhất' : 'Mới đăng', undefined],
  ...(ranked ? [['Mới đăng', 'newest'] as [string, Sort]] : []),
  ['Giá thấp', 'price_asc'],
  ['Giá cao', 'price_desc'],
  ...(nearest ? [['Gần nhất', 'nearest'] as [string, Sort]] : []),
];
// A sort, a filter or a chip opens the results again; skeletons hold them meanwhile.
const results = '[data-grid],[data-list]';
const strip = watchable && items.length > 8;
const current = (!ranked && search.sort === 'newest') || (search.sort === 'nearest' && !nearest) ? undefined : search.sort;
---

{
  title && (
    <div class={CONTENT} data-quick-behind>
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3 pt-6">
        <div class="min-w-0">
          <Heading class="text-j-24 text-ink lg:text-j-28">{title}</Heading>
          {understood && <p class="mt-1 text-body-large text-sub">{understood}</p>}
        </div>
        {watchable && <WatchButton href={searchHref(search)} />}
      </div>
    </div>
  )
}

<main class:list={[CONTENT, 'mt-6 grid grid-cols-1 gap-8', filters && 'lg:grid-cols-[256px_minmax(0,1fr)]']} data-quick-behind>
  {
    filters && (
      <div class="flex flex-col gap-3">
        <a href="#bo-loc" class={`${btnCls('line', 'sm')} w-fit lg:hidden`}>
          <Icon name="tune-rounded" size={16} />
          Bộ lọc
        </a>
        <!-- On a phone the panel opens as the link's target, without script. -->
        <div id="bo-loc" class="hidden scroll-mt-24 target:block lg:block">
          <SearchFilters search={search} base={base} />
        </div>
      </div>
    )
  }
  <section class="min-w-0" data-results data-quick-view>
    <slot />
    <div class="mt-3 flex items-center justify-between gap-4 border-b border-line">
      <nav class="no-scrollbar flex gap-6 overflow-x-auto" aria-label="Sắp xếp">
        {
          sorts.map(([label, sort]) => (
            <a
              href={searchHref(search, { sort }, base)}
              data-pending={results}
              aria-current={current === sort ? 'true' : undefined}
              class="-mb-px flex h-10 items-center whitespace-nowrap border-b-2 border-transparent text-body-large text-sub hover:text-ink aria-[current]:border-brand aria-[current]:font-medium aria-[current]:text-ink"
            >
              {label}
            </a>
          ))
        }
      </nav>
      <div class="shrink-0 pb-1.5" data-view>
        <Seg
          items={['grid-view-outline-rounded', 'view-list-outline-rounded']}
          labels={['Dạng lưới', 'Dạng danh sách']}
          icons
          class="bg-soft"
          itemClass="px-2!"
          name="Cách xem"
        />
      </div>
    </div>

    <div class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-4 xl:grid-cols-4" data-grid data-skeleton-kind="card" data-skeleton-count="8">
      {
        items.slice(0, 8).map((it) => (
          <div class="grid min-w-0">
            <ListingCard item={it} loading="eager" quick />
          </div>
        ))
      }
      {
        strip && (
          <div class="col-span-full flex flex-wrap items-center gap-4 rounded-card border border-line bg-card px-4 py-3" data-more-skip>
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-mint text-on-mint">
              <Icon name="notifications-outline-rounded" size={19} />
            </span>
            <p class="min-w-0 flex-1 text-body-large text-ink">
              Chưa thấy món ưng?
            </p>
            <WatchButton href={searchHref(search)} />
          </div>
        )
      }
      {
        items.slice(8).map((it) => (
          <div class="grid min-w-0">
            <ListingCard item={it} loading="lazy" quick />
          </div>
        ))
      }
    </div>

    <div class="mt-4 hidden flex-col gap-3" data-list data-skeleton-kind="row" data-skeleton-count="4">
      {items.map((it) => <ResultRow item={it} />)}
    </div>

    {
      next && (
        <div class="mt-8 flex justify-center">
          <a href={searchHref(search, { after: next }, base)} class={btnCls('line')} data-more={results}>
            Xem thêm tin
            <Icon name="chevron-right-rounded" size={16} />
          </a>
        </div>
      )
    }
    <Skeleton kind="card" />
    <Skeleton kind="row" />
  </section>
</main>
<QuickView />

<script>
  import '../../lib/more';
  import '../../lib/pending';

  // The view switch: the grid or the list of the same results.
  const root = document.querySelector<HTMLElement>('[data-results]');
  root?.querySelector('[data-view]')!.addEventListener('seg-change', (e) => {
    const asList = (e as CustomEvent).detail.index === 1;
    root.querySelector('[data-grid]')!.classList.toggle('hidden', asList);
    const list = root.querySelector('[data-list]')!;
    list.classList.toggle('hidden', !asList);
    list.classList.toggle('flex', asList);
  });
</script>
