---
// The 404: a page or listing that is not there (sold, taken down, or a wrong
// link; the server says the same for each), with the search field and the
// newest listings near the buyer.
import { newest } from '../../lib/feed';
import { R } from '../../lib/routes';
import { CONTENT } from '../../lib/ui';
import Icon from '../Icon.astro';
import ListingCard from '../ListingCard.astro';
import SearchField from '../SearchField.astro';
import SectionTitle from '../SectionTitle.astro';

const fresh = await newest(Astro, 4);
const link = 'text-label-large text-primary hover:underline';
---

<main class={CONTENT}>
  <section class="pt-8 lg:pt-12">
    <p class="border border-line bg-card flex w-fit items-center gap-2 rounded-full px-3 py-1.5 text-label-medium text-ink">
      <Icon name="link-off-rounded" size={15} class="text-primary" />Lỗi 404
    </p>
    <h1 class="mt-4 text-j-28 text-ink lg:text-j-32">Không có trang này.</h1>
    <SearchField class="mt-6 max-w-[720px]" />
    <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-body-small text-on-surface-variant">
      Link sai hoặc cũ?
      <a href={R.home} class={link}>Về Khám phá</a>
      <a href={R.categories} class={link}>Xem danh mục</a>
      <a href={R.support} class={link}>Báo link hỏng</a>
    </p>
  </section>
  {
    fresh.length > 0 && (
      <section class="mt-12">
        <SectionTitle title="Vừa đăng quanh bạn" link="Xem tất cả" href={`${R.search}?sort=newest`} />
        <div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-4 xl:grid-cols-4">
          {fresh.map((it) => <ListingCard item={it} />)}
        </div>
      </section>
    )
  }
</main>
