---
// Tìm kiếm with no match: the conditions the model read, each a link to the
// search without it, "Báo khi có tin mới", and the newest listings near the
// buyer.
import { unwrap } from '../../lib/api/client';
import { near } from '../../lib/area';
import { card } from '../../lib/listing';
import { R } from '../../lib/routes';
import { type Search, searchHref } from '../../lib/search';
import { CONTENT } from '../../lib/ui';
import Icon from '../Icon.astro';
import ListingCard from '../ListingCard.astro';
import SectionTitle from '../SectionTitle.astro';

interface Props {
  search: Search;
  /** The conditions the model read from the query. */
  chips: { id: string; label: string }[];
  watchable: boolean;
}

const { search, chips, watchable } = Astro.props;
// The app's example searches.
const tries = ['xe đạp đi làm dưới 3 triệu', 'iPhone dưới 8 triệu', 'sofa nhỏ cho căn hộ', 'bàn làm việc gỗ dưới 2 triệu'];
const fresh = await unwrap(Astro.locals.api.GET('/v1/search', { params: { query: { sort: 'newest', limit: 8, ...near(Astro.cookies) } } }))
  .then((r) => r.items.map(card))
  .catch(() => []);
---

<main class:list={[CONTENT, 'pt-6']}>
  <slot />
  <section class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-[1fr_400px]">
    <div class="min-w-0">
      <h1 class="flex items-center gap-3 text-j-32 text-ink md:text-j-28">
        <span class="text-on-surface-variant tabular-nums">0</span> tin khớp
      </h1>
      {
        chips.length ? (
          <>
            <p class="mt-1.5 text-body-medium text-on-surface-variant">Bỏ một điều kiện để thấy thêm tin:</p>
            <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
              {chips.map((c) => (
                <a href={searchHref(search, { off: [...search.off, c.id] })} class="lift flex items-center gap-3 rounded-card border border-line bg-card p-3">
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-secondary-container text-on-secondary-container">
                    <Icon name="close-rounded" size={18} />
                  </span>
                  <span class="min-w-0 flex-1 truncate text-title-small text-ink">Bỏ “{c.label}”</span>
                </a>
              ))}
            </div>
          </>
        ) : (
          <>
            <p class="mt-1.5 text-body-medium text-on-surface-variant">
              {search.q ? `Chưa có tin nào khớp “${search.q}”.` : 'Chưa có tin nào khớp bộ lọc này.'} Thử bớt một vài chữ, hoặc gõ tên món
              đồ ngắn hơn.
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              {tries.map((t) => (
                <a href={searchHref({ ...search, q: t, off: [], photo: undefined, watch: undefined, category: undefined })} class="border border-line bg-card flex h-9 items-center rounded-full px-3 text-label-large text-ink">
                  {t}
                </a>
              ))}
            </div>
          </>
        )
      }
    </div>
    {
      watchable && (
        <form method="post" action="/bao-tin-moi" class="self-start rounded-panel bg-brand p-5 text-white">
          <input type="hidden" name="tim" value={searchHref(search)} />
          <p class="flex items-center gap-2 text-j-16">
            <Icon name="notifications-outline-rounded" size={20} />
            Báo khi có tin mới
          </p>
          <p class="mt-1 text-body-small text-white/80">Có tin khớp câu này, ShopNexus báo bạn ngay.</p>
          <button class="state-layer mt-4 h-10 w-full rounded-full bg-white text-label-large text-primary">Bật báo tin</button>
        </form>
      )
    }
  </section>

  {
    fresh.length > 0 && (
      <section class="mt-10">
        <SectionTitle title="Vừa đăng quanh bạn" link="Xem tất cả" href={`${R.search}?sap-xep=moi`} />
        <div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-4 xl:grid-cols-4">
          {fresh.map((it) => <ListingCard item={it} loading="lazy" />)}
        </div>
      </section>
    )
  }
</main>
