---
// The row over the results on Tìm kiếm and Tìm bằng ảnh: the conditions read
// from the query as removable chips, then the dropdowns, then "Xóa hết".
// Slot "chips" holds AiChips, the default slot the Drops; `drops` false hides
// the dropdowns from expanded up, where the filter panel holds them.
interface Props {
  drops?: boolean;
}
const { drops = true } = Astro.props;
import { R } from '../../lib/routes';

// An empty map in the slot still counts as a slot, so check what it renders.
const chips = Astro.slots.has('chips') ? (await Astro.slots.render('chips')).trim() : '';
---

<div class="no-scrollbar flex items-center gap-2 overflow-x-auto">
  {
    chips && (
      <>
        <Fragment set:html={chips} />
        <span class:list={['mx-1 h-5 shrink-0 border-l border-line', !drops && 'lg:hidden']} />
      </>
    )
  }
  <span class:list={['contents', !drops && 'lg:hidden']}><slot /></span>
  <a href={R.search} class="shrink-0 whitespace-nowrap pl-1 text-body-medium text-faint hover:text-ink hover:underline">Xóa hết</a>
</div>
