---
// Bản đồ's district map, drawn in SVG: blocks on a street grid, two main
// roads, the river and a few parks. It fills its positioned parent.
const blocks: { x: number; y: number; w: number; h: number; park: boolean }[] = [];
const parks = ['1,3', '4,8', '2,9', '6,1'];
for (let r = 0, y = 20; y < 700; r++, y += 92) {
  for (let c = 0, x = 20; x < 1300; c++, x += 124) {
    if (560 < x + ((r * 18) % 60) && x + ((r * 18) % 60) < 760 && y > 470) continue; // the river bend
    blocks.push({ x, y, w: 104 - ((r * 7 + c * 11) % 28), h: 72 - ((r * 5 + c * 3) % 18), park: parks.includes(`${r},${c}`) });
  }
}
const river = 'M-20 560 C 160 520, 300 640, 520 600 S 760 470, 900 560 S 1180 690, 1360 600';
---

<svg viewBox="0 0 1328 720" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" aria-hidden="true">
  <rect width="1328" height="720" class="fill-surface-container-low"></rect>
  {
    blocks.map((b) => (
      <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="12" class={b.park ? 'fill-secondary-container' : 'fill-surface-container-high'} />
    ))
  }
  <path d="M-20 250 C 300 230, 700 290, 1360 240" fill="none" class="stroke-card" stroke-width="18" stroke-linecap="round"></path>
  <path d="M620 -20 C 600 200, 700 380, 660 760" fill="none" class="stroke-card" stroke-width="18" stroke-linecap="round"></path>
  <path d={`${river} L 1360 760 L -20 760 Z`} class="fill-secondary-container"></path>
  <path d={river} fill="none" class="stroke-on-primary-container" stroke-width="3"></path>
</svg>
