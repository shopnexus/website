---
// Chat nhanh on a listing: "Nhắn tin", "Trả giá" and the question chips open
// this box over the page instead of going to Tin nhắn. On a wide window it
// docks bottom-right, its left edge drags it wider (kept per browser), and
// the page stays usable; "Thu nhỏ" folds it into a pill. On a phone it is a
// bottom sheet. The page marks its openers with data-quickchat ("chat",
// "offer", or the question to send); they stay links to Tin nhắn, so without
// the script they still work. The chat inside is /messages/pane, the same
// thread and composer as Tin nhắn, run by lib/chat-pane.
import Icon from '../Icon.astro';
import Avatar from '../Avatar.astro';
import Photo from '../Photo.astro';
import { group } from '../../lib/format';

interface Props {
  listing: string;
  /** The buyer's chat with the seller, once there is one. */
  chat?: string;
  /** photo: the avatar's URL, absent without one. */
  seller: { name: string; photo?: string };
  title: string;
  /** The listing's photo URL. */
  thumb?: string;
  price: number;
  questions: string[];
  /** The full chat on Tin nhắn. */
  href: string;
}

const { listing, chat, seller, title, thumb, price, questions, href } = Astro.props;

// Three quick cuts, about 4, 6 and 10 % off, on round steps.
const unit = price >= 1_000_000 ? 100_000 : 10_000;
const cuts = [...new Set([0.04, 0.06, 0.1].map((f) => Math.max(unit, Math.round((price * f) / unit) * unit)))];
const cutLabel = (v: number) => (v >= 1_000_000 ? `−${(v / 1_000_000).toLocaleString('vi-VN')} tr` : `−${v / 1000}k`);
const start = price - cuts[Math.min(1, cuts.length - 1)];
const iconBtn = 'state-layer grid h-9 w-9 shrink-0 place-items-center rounded-full text-on-surface-variant';
const pane = `/messages/pane?${new URLSearchParams({ listing, name: seller.name, ...(chat ? { chat } : {}) })}`;
---

<dialog
  class="quickchat fixed inset-x-0 bottom-0 top-auto m-0 flex h-[min(640px,88dvh)] w-full max-w-none flex-col overflow-hidden rounded-t-xl bg-page p-0 text-ink shadow-float backdrop:bg-black/30 lg:inset-x-auto lg:bottom-5 lg:right-6 lg:h-[min(600px,calc(100dvh-120px))] lg:w-[var(--qc-width,440px)] lg:rounded-card lg:bg-card lg:shadow-lift [&:not([open])]:hidden"
  aria-label={`Chat với ${seller.name}`}
  data-qc
  data-qc-box
  data-price={price}
  data-pane={pane}
>
  <div class="absolute inset-y-0 left-0 z-10 w-1.5 cursor-ew-resize hover:bg-primary/20 max-lg:hidden" role="separator" aria-orientation="vertical" aria-label="Kéo để đổi độ rộng" data-qc-resize></div>
  <span class="mx-auto mt-2 h-1 w-8 shrink-0 rounded-full bg-on-surface-variant/40 lg:hidden"></span>
  <div class="flex items-center gap-2.5 px-3 pt-3">
    <Avatar name={seller.name} photo={seller.photo} size={36} loading="lazy" />
    <p class="min-w-0 flex-1 truncate text-title-small">{seller.name}</p>
    <a href={href} data-qc-full class={iconBtn} aria-label="Mở ở trang Tin nhắn" title="Mở ở trang Tin nhắn"><Icon name="open-in-new-rounded" size={19} /></a>
    <button type="button" class:list={[iconBtn, 'max-lg:hidden']} aria-label="Thu nhỏ" title="Thu nhỏ" data-qc-min><Icon name="remove-rounded" size={19} /></button>
    <button type="button" class={iconBtn} aria-label="Đóng" title="Đóng" data-qc-close><Icon name="close-rounded" size={19} /></button>
  </div>

  <div class="mx-3 mt-2.5 flex items-center gap-2.5 rounded-lg bg-surface-container-low p-1.5 pr-3">
    {thumb && <Photo src={thumb} width={80} height={80} alt="" loading="lazy" class="h-10 w-10 rounded-md object-cover" />}
    <p class="min-w-0 flex-1 truncate text-body-medium">{title}</p>
    <p class="text-j-15 tabular-nums">{group(price)}<span class="ml-0.5 text-body-small font-medium text-sub">₫</span></p>
  </div>

  <div class="contents" data-qc-pane>
    <p class="m-auto text-body-medium text-on-surface-variant">Đang mở…</p>
  </div>

  <div class="no-scrollbar flex shrink-0 gap-1.5 overflow-x-auto px-3 pb-1" data-qc-chips>
    <button
      type="button"
      class="state-layer flex h-8 shrink-0 items-center gap-1 rounded-control border border-field bg-card pl-2 pr-3 text-label-medium text-ink aria-expanded:border-brand aria-expanded:bg-mint aria-expanded:text-on-mint"
      aria-expanded="false"
      data-qc-offer
    >
      <Icon name="sell-outline-rounded" size={16} />Trả giá
    </button>
    {
      questions.map((q) => (
        <button type="button" class="state-layer h-8 shrink-0 rounded-control border border-line bg-card px-3 text-label-medium" data-qc-ask={q}>
          {q}
        </button>
      ))
    }
  </div>

  <form method="post" action={pane} class="mx-3 mb-2 hidden shrink-0 rounded-card border border-line bg-soft p-3" data-in-place data-qc-tray>
    <input type="hidden" name="do" value="offer" />
    <div class="flex items-center justify-between">
      <label for="qc-amount" class="text-title-small text-ink">Giá bạn trả</label>
      <p class="text-body-small text-faint">Giá đăng {group(price)} ₫</p>
    </div>
    <p class="mt-1 flex items-baseline">
      <input
        id="qc-amount"
        name="amount"
        inputmode="numeric"
        autocomplete="off"
        value={group(start)}
        class="min-w-[4ch] max-w-full bg-transparent text-j-28 tabular-nums outline-none [field-sizing:content]"
        data-qc-amount
      />
      <span class="ml-1 text-title-medium text-sub">₫</span>
    </p>
    <div class="mt-2 flex gap-1.5">
      {
        cuts.map((c) => (
          <button
            type="button"
            class="state-layer h-8 flex-1 rounded-sm border border-field bg-card text-body-medium text-ink aria-pressed:border-brand aria-pressed:bg-mint aria-pressed:font-medium aria-pressed:text-on-mint"
            aria-pressed={price - c === start ? 'true' : 'false'}
            data-qc-cut={price - c}
          >
            {cutLabel(c)}
          </button>
        ))
      }
    </div>
    <button type="submit" class="state-layer mt-2.5 flex h-10 w-full items-center justify-center gap-2 rounded-control bg-brand text-title-small text-white hover:bg-brand-hover">
      <Icon name="sell-outline-rounded" size={18} />Gửi giá
    </button>
  </form>
</dialog>

<button
  type="button"
  class="state-layer fixed bottom-5 right-6 z-40 hidden h-12 items-center gap-2 rounded-control bg-card pl-1.5 pr-4 text-label-large text-ink shadow-lift max-lg:!hidden"
  data-qc-pill
>
  <Avatar name={seller.name} photo={seller.photo} size={36} loading="lazy" />
  {seller.name}
</button>

<script>
  import { mountChatPane } from '../../lib/chat-pane';
  import { group } from '../../lib/format';
  import { R, loginHref } from '../../lib/routes';

  const box = document.querySelector<HTMLDialogElement>('[data-qc]');
  if (box) {
    const $ = <T extends Element = HTMLElement>(s: string) => box.querySelector<T>(s)!;
    const pill = document.querySelector<HTMLButtonElement>('[data-qc-pill]')!;
    const tray = $<HTMLFormElement>('[data-qc-tray]');
    const offerBtn = $<HTMLButtonElement>('[data-qc-offer]');
    const amount = $<HTMLInputElement>('[data-qc-amount]');
    const price = Number(box.dataset.price);
    const wide = matchMedia('(min-width: 64rem)');
    const full = $<HTMLAnchorElement>('[data-qc-full]');

    // The pane's URL: the chat and deal once the first message opened them.
    const paneUrl = () => {
      const u = new URL(box.dataset.pane!, location.origin);
      const meta = box.querySelector<HTMLElement>('[data-part="meta"]');
      if (meta?.dataset.chat) u.searchParams.set('chat', meta.dataset.chat);
      if (meta?.dataset.deal) u.searchParams.set('deal', meta.dataset.deal);
      return u;
    };
    const synced = () => {
      tray.action = paneUrl().pathname + paneUrl().search;
      const meta = box.querySelector<HTMLElement>('[data-part="meta"]');
      if (meta?.dataset.chat) full.href = `${R.messages}?${new URLSearchParams({ chat: meta.dataset.chat, deal: meta.dataset.deal ?? '' })}`;
    };

    // The pane loads on the first open and then follows the chat by itself.
    let loaded: Promise<void> | null = null;
    const load = () =>
      (loaded ??= (async () => {
        const res = await fetch(paneUrl(), { headers: { accept: 'text/html' } });
        if (res.redirected || res.status === 401) {
          location.href = loginHref(location.pathname);
          return;
        }
        $('[data-qc-pane]').innerHTML = await res.text();
        synced();
        mountChatPane({
          root: box,
          clean: paneUrl,
          history: false,
          shows: (u) => !!u.deal_id && u.deal_id === box.querySelector<HTMLElement>('[data-part="meta"]')?.dataset.deal,
          afterSwap: synced,
        });
      })());

    const say = async (text: string) => {
      await load();
      const form = box.querySelector<HTMLFormElement>('[data-composer]');
      const field = form?.querySelector<HTMLTextAreaElement>('[name="text"]');
      if (!form || !field) return;
      field.value = text;
      field.dispatchEvent(new Event('input'));
      form.requestSubmit();
      // A question already asked leaves the chips.
      box.querySelectorAll<HTMLElement>('[data-qc-ask]').forEach((b) => b.dataset.qcAsk === text && b.remove());
    };
    const open = (offer = false) => {
      pill.classList.add('hidden');
      pill.classList.remove('flex');
      if (!box.open) wide.matches ? box.show() : box.showModal();
      setTray(offer);
      load().then(() => (offer ? amount : box.querySelector<HTMLTextAreaElement>('[data-composer] [name="text"]'))?.focus({ preventScroll: true }));
    };
    const close = () => box.close();
    const fold = () => {
      box.close();
      pill.classList.remove('hidden');
      pill.classList.add('flex');
    };
    const setTray = (on: boolean) => {
      tray.classList.toggle('hidden', !on);
      offerBtn.setAttribute('aria-expanded', String(on));
    };

    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLElement>('[data-quickchat]');
      if (!a) return;
      e.preventDefault();
      const what = a.dataset.quickchat!;
      if (what === 'offer') open(true);
      else {
        open();
        if (what !== 'chat') say(what);
      }
    });
    pill.addEventListener('click', () => open());
    $('[data-qc-close]').addEventListener('click', close);
    $('[data-qc-min]').addEventListener('click', fold);
    // A non-modal dialog has no Esc of its own.
    box.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !box.matches(':modal')) close();
    });
    // The sheet closes on a tap on its backdrop.
    box.addEventListener('click', (e) => {
      if (e.target === box && box.matches(':modal')) {
        const r = box.getBoundingClientRect();
        if (e.clientY < r.top) close();
      }
    });

    box.querySelectorAll<HTMLButtonElement>('[data-qc-ask]').forEach((b) => b.addEventListener('click', () => say(b.dataset.qcAsk!)));
    offerBtn.addEventListener('click', () => setTray(tray.classList.contains('hidden')));

    const cuts = [...box.querySelectorAll<HTMLButtonElement>('[data-qc-cut]')];
    const mark = (v: number) => cuts.forEach((c) => c.setAttribute('aria-pressed', String(Number(c.dataset.qcCut) === v)));
    cuts.forEach((c) =>
      c.addEventListener('click', () => {
        const v = Number(c.dataset.qcCut);
        amount.value = group(v);
        mark(v);
      }),
    );
    amount.addEventListener('input', () => {
      const v = Number(amount.value.replace(/\D/g, ''));
      amount.value = v ? group(v) : '';
      mark(v);
    });
    // An offer under the price goes in place (chat-pane's data-in-place); anything else stays here.
    tray.addEventListener(
      'submit',
      (e) => {
        const v = Number(amount.value.replace(/\D/g, ''));
        if (!v || v >= price) {
          e.preventDefault();
          e.stopImmediatePropagation();
          amount.focus();
          return;
        }
        setTimeout(() => setTray(false));
      },
      { capture: true },
    );

    // The left edge drags the docked box wider or narrower; the width is kept per browser.
    const KEY = 'sn:qc-width';
    const clamp = (w: number) => Math.round(Math.min(Math.max(w, 360), Math.min(760, innerWidth - 48)));
    const setWidth = (w: number) => box.style.setProperty('--qc-width', `${clamp(w)}px`);
    try {
      const kept = Number(localStorage.getItem(KEY));
      if (kept) setWidth(kept);
    } catch {
      // Without storage the box opens at its default width.
    }
    const handle = $('[data-qc-resize]');
    handle.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      handle.setPointerCapture(e.pointerId);
      const right = box.getBoundingClientRect().right;
      const move = (m: PointerEvent) => setWidth(right - m.clientX);
      const up = () => {
        handle.removeEventListener('pointermove', move);
        handle.removeEventListener('pointerup', up);
        try {
          localStorage.setItem(KEY, String(box.getBoundingClientRect().width));
        } catch {
          // The width lasts until the page closes.
        }
      };
      handle.addEventListener('pointermove', move);
      handle.addEventListener('pointerup', up);
    });
  }
</script>
