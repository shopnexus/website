---
import Photo from '../Photo.astro';
// A Danh mục tile: photo, name, count, then up to four subcategories
// with counts.
import type { Category } from '../../lib/catalog';
import { group } from '../../lib/format';
import { R } from '../../lib/routes';
import Icon from '../Icon.astro';

interface Props {
  c: Category;
  /** Listings on sale per category code. */
  counts: Map<string, number>;
  loading?: 'eager' | 'lazy';
}

const { c, counts, loading } = Astro.props;
const href = R.category(c.code);
const subs = c.children.filter((s) => counts.get(s.code)).slice(0, 4);
---

<article class="lift flex flex-col rounded-panel border border-line bg-card p-2">
  <a href={href} class="flex items-center gap-3 rounded-tile p-1.5 pr-2 hover:bg-surface-container-low">
    <Photo src={c.photo} width={160} height={160} alt="" loading={loading} class="h-16 w-16 shrink-0 rounded-lg object-cover" />
    <span class="min-w-0 flex-1">
      <span class="flex items-center gap-1.5 text-j-16 text-ink"><Icon name={c.icon} size={18} class="text-primary" />{c.name}</span>
      <span class="mt-0.5 block text-body-small text-on-surface-variant">
        <b class="font-semibold text-ink tabular-nums">{group(counts.get(c.code) ?? 0)}</b> món
      </span>
    </span>
    <Icon name="arrow-forward-rounded" size={18} class="text-on-surface-variant" />
  </a>
  {
    subs.length > 0 && (
      <div class="flex flex-wrap gap-1 px-1.5 pb-1.5 pt-1">
        {subs.map((s) => (
          <a
            href={`${href}?category=${s.code}`}
            class="flex h-7 items-center gap-1 rounded-full bg-surface-container-low px-2.5 text-label-medium text-ink hover:bg-secondary-container"
          >
            {s.name}
            <span class="text-label-small text-on-surface-variant tabular-nums">{group(counts.get(s.code) ?? 0)}</span>
          </a>
        ))}
      </div>
    )
  }
</article>
