---
// The filter panel on Tìm kiếm and a category page (K2): a card with the
// price bounds, Tình trạng, Trả giá được and the distance from the buyer. It
// is a GET form over the same page; a change submits it, and "Áp dụng" does
// without script.
import { area } from '../../lib/area';
import { CONDITIONS } from '../../lib/listing';
import { NEAR_STEPS, type Search, searchHref, sortKey } from '../../lib/search';
import { btnCls } from '../../lib/ui';
import Icon from '../Icon.astro';

interface Props {
  search: Search;
  /** The page the form submits to: Tìm kiếm or the category's. */
  base: string;
}

const { search, base } = Astro.props;
const place = area(Astro.cookies);
const keys = { new: 'new', like_new: 'like-new', used: 'used' } as const;
const distances = [undefined, ...NEAR_STEPS].map((km) => ({
  label: km ? `${km} km` : 'Mọi nơi',
  href: searchHref(search, { km }, base),
  on: km === search.km,
}));
const group = 'border-b border-line px-4 py-4';
const head = 'text-title-small text-ink';
const box = 'grid h-4 w-4 shrink-0 place-items-center rounded-xs border-[1.5px] border-field bg-card text-transparent peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-brand';
---

<form action={base} class="self-start overflow-hidden rounded-card border border-line bg-card lg:sticky-fit lg:sticky lg:top-[88px]" data-filters>
  {search.q && <input type="hidden" name="q" value={search.q} />}
  {search.category && <input type="hidden" name="category" value={search.category} />}
  {search.off.map((o) => <input type="hidden" name="off" value={o} />)}
  {search.km && <input type="hidden" name="km" value={search.km} />}
  {search.sort && <input type="hidden" name="sort" value={sortKey(search.sort)} />}
  {search.photo && <input type="hidden" name="photo" value={search.photo} />}
  <div class={group}>
    <p class={head}>Giá</p>
    <div class="mt-3 grid grid-cols-2 gap-2 text-body-medium text-ink">
      <label class="rounded-sm border border-field px-2.5 py-2 focus-within:border-brand">
        <span class="sr-only">Giá từ</span>
        <input name="min" inputmode="numeric" placeholder="Từ" value={search.min ?? ''} class="w-full bg-transparent outline-none placeholder:text-faint" />
      </label>
      <label class="rounded-sm border border-field px-2.5 py-2 focus-within:border-brand">
        <span class="sr-only">Giá đến</span>
        <input name="max" inputmode="numeric" placeholder="Đến" value={search.max ?? ''} class="w-full bg-transparent outline-none placeholder:text-faint" />
      </label>
    </div>
  </div>
  <div class={group}>
    <p class={head}>Tình trạng</p>
    <div class="mt-2">
      {
        Object.entries(CONDITIONS).map(([c, label]) => (
          <label class="-mx-2 flex h-8 cursor-pointer items-center gap-2.5 rounded-sm px-2 text-body-large text-ink hover:bg-hover">
            <input
              type="checkbox"
              name="condition"
              value={keys[c as keyof typeof keys]}
              checked={search.conditions.includes(c as keyof typeof keys)}
              class="peer sr-only"
            />
            <span class={box}><Icon name="check-rounded" size={13} /></span>
            {label}
          </label>
        ))
      }
      <label class="-mx-2 mt-2 flex h-8 cursor-pointer items-center gap-2.5 rounded-sm px-2 text-body-large text-ink hover:bg-hover">
        <input type="checkbox" name="offers" value="1" checked={search.offers} class="peer sr-only" />
        <span class={box}><Icon name="check-rounded" size={13} /></span>
        Trả giá được
      </label>
    </div>
  </div>
  <div class={group}>
    <p class={head}>Khoảng cách</p>
    {
      place ? (
        <>
          <div class="mt-3 grid grid-cols-5 gap-0.5 rounded-control bg-soft p-0.5">
            {distances.map((d) => (
              <a
                href={d.href}
                aria-current={d.on ? 'true' : undefined}
                class="grid h-8 place-items-center whitespace-nowrap rounded-sm text-body-small text-sub hover:text-ink aria-[current]:bg-card aria-[current]:font-medium aria-[current]:text-ink aria-[current]:shadow-knob"
              >
                {d.label}
              </a>
            ))}
          </div>
          <p class="mt-3 flex items-center gap-1.5 text-body-small text-faint">
            <Icon name="location-on-outline-rounded" size={15} />
            <span class="min-w-0 flex-1 truncate">Quanh {place.name}</span>
            <button type="button" data-here class="font-medium text-brand">
              Đổi
            </button>
          </p>
        </>
      ) : (
        <button type="button" data-here class="state-layer mt-2 flex h-9 items-center gap-1.5 rounded-sm px-2 text-body-medium font-medium text-brand hover:bg-hover">
          <Icon name="my-location-outline-rounded" size={16} />Dùng vị trí hiện tại
        </button>
      )
    }
  </div>
  <div class="px-4 py-3">
    <button class:list={[btnCls('line', 'sm'), 'w-full']}>Áp dụng</button>
  </div>
</form>

<script>
  import { busy } from '../../lib/busy';
  import { locate } from '../../lib/locate';
  import { snack } from '../../lib/snackbar';

  // A checkbox submits at once, a price on change; "Dùng vị trí hiện tại" and
  // "Đổi" ask the browser for its place and load the page again with it.
  document.querySelectorAll<HTMLFormElement>('[data-filters]').forEach((f) => {
    f.addEventListener('change', () => f.requestSubmit());
    f.querySelectorAll<HTMLButtonElement>('[data-here]').forEach((b) =>
      b.addEventListener('click', async () => {
        if (b.getAttribute('aria-busy') === 'true') return;
        busy(b);
        if (await locate()) return location.reload();
        busy(b, false);
        snack({ text: 'Chưa lấy được vị trí.', error: true });
      }),
    );
  });
</script>
