---
// Tìm kiếm's filter panel: price histogram with the median, brands, Tình
// trạng, and the distance from where the buyer is, which they can change.
import { HERE, NEAR_STEPS, nearParam } from '../../lib/near';
import Icon from '../Icon.astro';
import Seg from '../Seg.astro';

const hist = [3, 5, 8, 12, 18, 26, 22, 17, 11, 7, 4, 2];
const brands: [string, number, boolean][] = [
  ['Dell', 11, true],
  ['Apple', 9, true],
  ['Lenovo', 8, false],
  ['HP', 6, false],
  ['ASUS', 4, false],
];
// Each distance is a link to this search with ?gan= set (or cleared for Mọi nơi).
const picked = nearParam(Astro.url);
const distances = [null, ...NEAR_STEPS].map((d) => {
  const u = new URL(Astro.url);
  if (d) u.searchParams.set('gan', String(d));
  else u.searchParams.delete('gan');
  return { label: d ? `${d} km` : 'Mọi nơi', href: u.pathname + u.search, on: d === picked };
});
const group = 'border-b border-line py-4';
---

<aside class="self-start rounded-panel border border-line bg-card px-5 py-1 lg:sticky lg:top-[84px]">
  <div class={group}>
    <p class="text-title-small text-ink">Giá</p>
    <div class="mt-3 flex h-[70px] items-end gap-[3px]" aria-hidden="true">
      {
        hist.map((h, i) => (
          <span class:list={['flex-1 rounded-full', i < 7 ? 'bg-primary' : 'bg-outline-variant/60']} style={`height:${h * 2.6}px`} />
        ))
      }
    </div>
    <div class="relative mt-2 h-1.5 rounded-full bg-surface-container-high" aria-hidden="true">
      <span class="absolute inset-y-0 left-0 w-[58%] rounded-full bg-primary"></span>
      <span class="absolute left-0 top-1/2 h-4 w-4 -translate-y-1/2 rounded-full border-2 border-primary bg-card"></span>
      <span class="absolute left-[58%] top-1/2 h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-primary bg-card"></span>
    </div>
    <div class="mt-3 grid grid-cols-2 gap-2 text-body-medium text-ink">
      <label class="rounded-full bg-surface-container-low px-3 py-1.5">
        <span class="sr-only">Giá từ</span><input name="gia-tu" value="0 ₫" class="w-full bg-transparent outline-none" />
      </label>
      <label class="rounded-full bg-surface-container-low px-3 py-1.5">
        <span class="sr-only">Giá đến</span><input name="gia-den" value="8.000.000 ₫" class="w-full bg-transparent outline-none" />
      </label>
    </div>
    <p class="mt-2 text-body-small text-on-surface-variant">
      Mức giữa <b class="font-semibold text-ink">7,3 tr ₫</b> cho cấu hình này
    </p>
  </div>
  <div class={group}>
    <p class="text-title-small text-ink">Hãng</p>
    <div class="mt-2">
      {
        brands.map(([label, n, on]) => (
          <label class="flex h-8 cursor-pointer items-center gap-2.5 text-body-medium text-ink">
            <input type="checkbox" checked={on} class="peer sr-only" />
            <span class="grid h-[18px] w-[18px] place-items-center rounded-2xs border-[1.5px] border-outline-variant bg-card text-transparent peer-checked:border-primary peer-checked:bg-primary peer-checked:text-on-primary peer-focus-visible:ring-2 peer-focus-visible:ring-primary">
              <Icon name="check-rounded" size={13} />
            </span>
            <span class="flex-1">{label}</span>
            <span class="rounded-full bg-surface-container-low px-2 text-label-small text-on-surface-variant tabular-nums">{n}</span>
          </label>
        ))
      }
    </div>
  </div>
  <div class={group}>
    <p class="text-title-small text-ink">Tình trạng</p>
    <div class="mt-3">
      <Seg
        items={['Mới', 'Như mới', 'Đã dùng']}
        selected={1}
        class="w-full bg-surface-container-low"
        itemClass="flex-1 px-1! text-label-medium"
        name="Tình trạng"
      />
    </div>
  </div>
  <div class="py-4">
    <p class="text-title-small text-ink">Khoảng cách</p>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {
        distances.map((d) => (
          <a
            href={d.href}
            aria-current={d.on ? 'true' : undefined}
            class="rounded-full border border-line px-3 py-1 text-label-large text-on-surface-variant hover:bg-surface-container-low aria-[current]:border-transparent aria-[current]:bg-ink aria-[current]:text-on-ink"
          >
            {d.label}
          </a>
        ))
      }
    </div>
    <details class="group mt-3">
      <summary class="flex cursor-pointer list-none items-center gap-1.5 text-body-small text-on-surface-variant [&::-webkit-details-marker]:hidden">
        <Icon name="location-on-outline-rounded" size={16} />
        <span class="min-w-0 flex-1 truncate">Quanh {HERE}</span>
        <span class="text-label-large text-primary group-open:hidden">Đổi</span>
      </summary>
      <input
        name="noi"
        aria-label="Quận, huyện hoặc tỉnh"
        placeholder="Quận, huyện hoặc tỉnh"
        class="mt-2 block w-full rounded-full bg-surface-container-low px-3 py-1.5 text-body-medium text-ink outline-none"
      />
      <button type="button" data-here class="state-layer mt-1.5 flex h-9 items-center gap-1.5 rounded-full px-2 text-label-large text-primary">
        <Icon name="my-location-outline-rounded" size={18} />Dùng vị trí hiện tại
      </button>
    </details>
  </div>
</aside>

<script>
  // "Dùng vị trí hiện tại" asks the browser for its location and folds the
  // picker. Until the server's search is wired, the place stays the mock's.
  document.querySelectorAll<HTMLButtonElement>('[data-here]').forEach((b) =>
    b.addEventListener('click', () => {
      const close = () => b.closest('details')?.removeAttribute('open');
      if (navigator.geolocation) navigator.geolocation.getCurrentPosition(close, close);
      else close();
    }),
  );
</script>
