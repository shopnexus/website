---
// A small district map drawn in SVG (blocks, a park, the river) with the
// buyer's dot, price pins and an optional dashed route with its distance.
// Positions are percentages of the box.
interface Props {
  height: number;
  you: [number, number];
  pins?: { x: number; y: number; label: string; on?: boolean }[];
  route?: { from: [number, number]; to: [number, number]; label: string };
}

const { height: h, you, pins = [], route } = Astro.props;
const blocks = [
  [30, 30, 150, 90], [200, 30, 120, 90], [340, 30, 170, 90], [30, 140, 150, 110], [200, 140, 120, 110], [340, 140, 80, 110],
  [440, 140, 70, 110], [30, 270, 150, 90], [200, 270, 120, 90], [340, 270, 170, 90], [530, 30, 110, 150], [530, 200, 110, 160],
  [660, 30, 120, 330],
];
---

<div class="relative overflow-hidden rounded-lg-plus" style={`height:${h}px`}>
  <svg viewBox={`0 0 800 ${h}`} preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" aria-hidden="true">
    <rect width="800" height={h} class="fill-surface-container-low" />
    <path d="M-10 420 C 150 380, 260 470, 420 410 S 700 380, 820 430 L 820 520 L -10 520 Z" class="fill-secondary-container" />
    {blocks.map(([x, y, w, bh]) => <rect x={x} y={y} width={w} height={bh} rx="10" class="fill-surface-container-high" />)}
    <rect x="340" y="140" width="80" height="110" rx="10" class="fill-secondary-container" />
    <circle cx="370" cy="175" r="14" class="fill-on-primary-container" />
    <circle cx="395" cy="215" r="10" class="fill-on-primary-container" />
  </svg>
  <span class="absolute bottom-6 left-8 text-label-medium tracking-[0.2em] text-secondary">SÔNG SÀI GÒN</span>
  {
    route && (
      <>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="absolute inset-0 h-full w-full" aria-hidden="true">
          <line
            x1={route.from[0]}
            y1={route.from[1]}
            x2={route.to[0]}
            y2={route.to[1]}
            class="stroke-primary"
            stroke-width="3"
            stroke-dasharray="2 6"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
        </svg>
        <span
          class="absolute -translate-x-1/2 -translate-y-1/2 rounded-full bg-inverse-surface px-3 py-1 text-label-large text-inverse-on-surface"
          style={`left:${(route.from[0] + route.to[0]) / 2}%;top:${(route.from[1] + route.to[1]) / 2 + 6}%`}
        >
          {route.label}
        </span>
      </>
    )
  }
  {
    pins.map((p) => (
      <span class="absolute -translate-x-1/2 -translate-y-full" style={`left:${p.x}%;top:${p.y}%`}>
        <span
          class:list={[
            'flex items-center gap-1 rounded-full px-3 py-1.5 text-label-large shadow-soft',
            p.on ? 'bg-primary text-on-primary' : 'bg-card text-ink',
          ]}
        >
          {p.label}
        </span>
        <span class:list={['mx-auto block h-2 w-2 -translate-y-1 rotate-45', p.on ? 'bg-primary' : 'bg-card']} />
      </span>
    ))
  }
  <span
    class="absolute h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full border-[3px] border-card bg-primary"
    style={`left:${you[0]}%;top:${you[1]}%`}></span>
</div>
