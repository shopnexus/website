---
// "Báo khi có tin mới": saves the search (/bao-tin-moi), which then tells the
// buyer about new listings that match.
import { btnCls } from '../../lib/ui';
import Icon from '../Icon.astro';

interface Props {
  /** The search's URL, which /bao-tin-moi reads and comes back to. */
  href: string;
}
---

<form method="post" action="/bao-tin-moi">
  <input type="hidden" name="tim" value={Astro.props.href} />
  <button class={btnCls('ink', 'sm')}>
    <Icon name="notifications-outline-rounded" size={16} />
    Báo khi có tin mới
  </button>
</form>
