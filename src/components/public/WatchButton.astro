---
// "Báo khi có tin mới": saves the search (/api/watches), which then tells the
// buyer about new listings that match.
import { API } from '../../lib/routes';
import { btnCls } from '../../lib/ui';
import Icon from '../Icon.astro';

interface Props {
  /** The search's URL, which /api/watches reads. */
  href: string;
  /** Where to come back to; the search by default. */
  back?: string;
  label?: string;
  size?: 'sm' | 'lg';
  /** Fills its row. */
  wide?: boolean;
}

const { href, back, label = 'Báo khi có tin mới', size = 'sm', wide = false } = Astro.props;
---

<form method="post" action={API.watches}>
  <input type="hidden" name="search" value={href} />
  {back && <input type="hidden" name="back" value={back} />}
  <button class:list={[btnCls('ink', size), wide && 'w-full']}>
    <Icon name="notifications-outline-rounded" size={size === 'lg' ? 18 : 16} />
    {label}
  </button>
</form>
