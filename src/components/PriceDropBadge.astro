---
// "Vừa giảm" in the top-left corner of a listing photo whose price dropped in
// the last week, or `inline` beside a price (a row of Tin của bạn).
import Icon from './Icon.astro';

import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  inline?: boolean;
}

const { inline = false, class: cls, ...rest } = Astro.props;
---

<span
  class:list={[
    'pointer-events-none flex h-6 items-center gap-0.5 rounded-full pl-1.5 pr-2 text-label-small',
    inline ? 'shrink-0 bg-card text-primary ring-1 ring-line' : 'absolute left-2 top-2 z-10 bg-white/90 text-brand shadow-soft',
    cls,
  ]}
  {...rest}
>
  <Icon name="arrow-downward-rounded" size={13} />Vừa giảm
</span>
