---
// The deal steps as a labelled pill track (guides, a deal in progress).
import { PHASES } from '../data/common';
import Icon from './Icon.astro';

interface Props {
  current: number;
  compact?: boolean;
}

const { current, compact = false } = Astro.props;
---

<div class="border border-line bg-card flex w-fit items-center rounded-full p-1">
  {
    PHASES.map((p, i) => (
      <>
        <span
          class:list={[
            'flex items-center whitespace-nowrap rounded-full',
            compact ? 'h-8 gap-1 px-2.5 text-label-medium' : 'h-9 gap-1.5 px-3.5 text-label-large',
            i < current ? 'text-primary' : i === current ? 'bg-card text-ink shadow-soft' : 'text-on-surface-variant/70',
          ]}
        >
          <Icon name={i < current ? p.icon.replace('-outline', '') : p.icon} size={compact ? 15 : 17} />
          {p.label}
        </span>
        {i < 3 && <span class:list={['h-px', compact ? 'w-2' : 'w-4', i < current ? 'bg-primary/50' : 'bg-black/10']} />}
      </>
    ))
  }
</div>
