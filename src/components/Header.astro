---
import Photo from './Photo.astro';
// The glass bar: sticky, no border, no shadow. From expanded up it carries the
// four sections as text links; below, they move to BottomNav.
import brandMark from '@brand/brand_mark.svg';
import { img } from '../lib/format';
import { R } from '../lib/routes';
import { viewer } from '../lib/session';
import Icon from './Icon.astro';

export type Section = 'explore' | 'categories' | 'map' | 'how';

interface Props {
  section: Section | null;
  search?: { q: string; photo?: string };
}

const { section, search } = Astro.props;
const me = viewer(Astro);
const nav: [Section, string, string][] = [
  ['explore', 'Khám phá', R.home],
  ['categories', 'Danh mục', R.categories],
  ['map', 'Bản đồ', R.map],
  ['how', 'Cách mua', R.how],
];
---

<header class="glass sticky top-0 z-30">
  <div class="mx-auto flex h-16 max-w-[1360px] items-center gap-2 px-4 md:px-6 lg:px-8">
    <a href={R.home} class="flex shrink-0 items-center gap-2 lg:pr-4">
      <Photo src={brandMark} alt="" class="h-8 w-8" />
      <span class="text-j-20 text-ink" class:list={[search && 'max-md:sr-only']}>ShopNexus</span>
    </a>
    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Mục chính">
      {
        nav.map(([key, label, href]) => (
          <a
            href={href}
            aria-current={key === section ? 'page' : undefined}
            class="flex h-9 items-center rounded-full px-3.5 text-label-large text-on-surface-variant hover:text-ink aria-[current=page]:bg-card/85 aria-[current=page]:text-ink aria-[current=page]:shadow-knob"
          >
            {label}
          </a>
        ))
      }
    </nav>
    {
      search ? (
        <form
          action={R.search}
          class="flex h-11 min-w-0 flex-1 items-center gap-2.5 rounded-full bg-card px-1.5 shadow-glow lg:mx-6"
        >
          {search.photo ? (
            <Photo src={img(search.photo, 64, 64)} width={64} height={64} alt="" class="h-8 w-8 shrink-0 rounded-full object-cover" />
          ) : (
            <Icon name="search-rounded" size={20} class="ml-2 text-primary" />
          )}
          <input
            name="q"
            value={search.q}
            aria-label="Tìm trên ShopNexus"
            class="min-w-0 flex-1 bg-transparent text-body-large text-ink outline-none"
          />
          <a
            href={R.photoSearch}
            class="state-layer grid h-8 w-8 shrink-0 place-items-center rounded-full text-on-surface-variant"
            aria-label="Tìm bằng ảnh"
          >
            <Icon name="photo-camera-outline-rounded" size={20} />
          </a>
          <button class="state-layer flex h-8 shrink-0 items-center gap-1 rounded-full bg-primary pl-3 pr-4 text-label-large text-on-primary">
            <Icon name="search-rounded" size={18} />
            Tìm
          </button>
        </form>
      ) : (
        <span class="flex-1" />
      )
    }
    <div class="flex shrink-0 items-center gap-1">
      {
        me && (
          <a
            href={R.messages}
            class="state-layer relative hidden h-10 w-10 place-items-center rounded-full text-on-surface-variant lg:grid"
            aria-label="Tin nhắn, 3 chưa đọc"
          >
            <Icon name="chat-outline-rounded" size={22} />
            <span class="absolute right-0.5 top-0.5 grid h-[18px] min-w-[18px] place-items-center rounded-full bg-error px-1 text-label-small text-on-error ring-2 ring-card">
              3
            </span>
          </a>
        )
      }
      <a
        href={R.post}
        class="state-layer ml-2 hidden h-10 items-center gap-1.5 rounded-full bg-ink pl-3.5 pr-4 text-label-large text-on-ink lg:flex"
      >
        <Icon name="add-rounded" size={18} />
        Đăng tin
      </a>
      {
        me ? (
          <a href={R.me} class="ml-2 shrink-0" aria-label="Tài khoản">
            <Photo src={img(me.photo, 80, 80)} width={80} height={80} alt="" class="h-9 w-9 rounded-full object-cover ring-2 ring-card" />
          </a>
        ) : (
          <a
            href={`${R.login}?tiep=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}
            class="state-layer ml-1 flex h-10 items-center rounded-full px-4 text-label-large text-ink"
          >
            Đăng nhập
          </a>
        )
      }
    </div>
  </div>
</header>
