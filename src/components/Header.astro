---
import Photo from './Photo.astro';
// K2's bar: the page colour, a hairline under it, sticky. The search field is
// always there, so a buyer can search from any page; Tìm kiếm fills it with
// the query. From expanded up it carries Tin nhắn, Thông báo, the account and
// "Đăng tin"; below, those move to BottomNav.
import brandMark from '@brand/brand_mark.svg';
import { img } from '../lib/format';
import { R } from '../lib/routes';
import { viewer } from '../lib/session';
import Icon from './Icon.astro';

export type Section = 'explore' | 'categories' | 'how';

interface Props {
  /** BottomNav marks it; the bar itself has no section links. */
  section: Section | null;
  search?: { q: string; photo?: string };
}

const { search } = Astro.props;
const me = viewer(Astro);
const iconBtn = 'state-layer relative hidden h-10 w-10 place-items-center rounded-control text-ink hover:bg-hover lg:grid';
---

<header class="glass sticky top-0 z-30 border-b border-line">
  <div class="mx-auto flex h-16 max-w-[1280px] items-center gap-3 px-4 md:px-6 lg:gap-4 lg:px-8">
    <a href={R.home} class="flex shrink-0 items-center gap-2 lg:pr-2">
      <Photo src={brandMark} alt="" class="h-8 w-8" />
      <span class="text-j-16 text-ink max-md:sr-only">ShopNexus</span>
    </a>
    <form
      action={R.search}
      class="flex h-10 min-w-0 flex-1 items-center gap-2 rounded-control border border-field bg-card pl-3 pr-1 focus-within:border-brand lg:max-w-[720px]"
    >
      {
        search?.photo ? (
          <Photo src={img(search.photo, 64, 64)} width={64} height={64} alt="" class="h-7 w-7 shrink-0 rounded-md object-cover" />
        ) : (
          <Icon name="search-rounded" size={17} class="text-faint" />
        )
      }
      <input
        name="q"
        value={search?.q ?? ''}
        placeholder="Tìm iPhone, xe đạp, sofa…"
        aria-label="Tìm trên ShopNexus"
        class="h-full min-w-0 flex-1 bg-transparent text-body-large text-ink outline-none placeholder:text-faint"
      />
      <a
        href={R.photoSearch}
        class="state-layer grid h-8 w-8 shrink-0 place-items-center rounded-md text-sub hover:bg-hover"
        aria-label="Tìm bằng ảnh"
      >
        <Icon name="photo-camera-outline-rounded" size={17} />
      </a>
    </form>
    <div class="ml-auto flex shrink-0 items-center gap-1">
      {
        me && (
          <>
            <a href={R.notifications} class={iconBtn} aria-label="Thông báo, có tin mới">
              <Icon name="notifications-outline-rounded" size={19} />
              <span class="absolute right-2.5 top-2.5 h-1.5 w-1.5 rounded-full bg-error" />
            </a>
            <a
              href={R.messages}
              class="state-layer hidden h-10 items-center gap-2 rounded-control px-3 text-title-small text-ink hover:bg-hover lg:flex"
              aria-label="Tin nhắn, 3 chưa đọc"
            >
              <Icon name="chat-outline-rounded" size={18} />
              Tin nhắn
              <span class="grid h-[18px] min-w-[18px] place-items-center rounded-full bg-brand px-1 text-label-small text-white">3</span>
            </a>
            <a href={R.me} class="ml-1 grid h-10 w-10 shrink-0 place-items-center rounded-full hover:bg-hover" aria-label="Tài khoản">
              <Photo src={img(me.photo, 80, 80)} width={80} height={80} alt="" class="h-8 w-8 rounded-full object-cover" />
            </a>
          </>
        )
      }
      {
        !me && (
          <a
            href={`${R.login}?tiep=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}
            class="state-layer flex h-10 items-center rounded-control px-3.5 text-title-small text-ink hover:bg-hover"
          >
            Đăng nhập
          </a>
        )
      }
      <a
        href={R.post}
        class="state-layer ml-2 hidden h-10 items-center gap-1.5 rounded-control bg-brand px-4 text-title-small text-white hover:bg-brand-hover lg:flex"
      >
        <Icon name="add-rounded" size={17} />
        Đăng tin
      </a>
    </div>
  </div>
</header>
