---
// The teal gradient card that sums a page up.
import Icon from './Icon.astro';

interface Props {
  title: string;
  points: { icon: string; text: string }[];
  icon?: string;
}

const { title, points, icon = 'summarize-outline-rounded' } = Astro.props;
---

<div class="rounded-panel bg-linear-150 from-primary to-teal-mid p-5 text-white">
  <p class="flex items-center gap-2 text-label-large text-mint-on-teal"><Icon name={icon} size={18} />{title}</p>
  <ul class="mt-3 flex flex-col gap-2.5">
    {
      points.map((p) => (
        <li class="flex gap-2.5 text-body-medium text-white">
          <Icon name={p.icon} size={18} class="mt-px text-mint-on-teal" />
          <span>{p.text}</span>
        </li>
      ))
    }
  </ul>
</div>
