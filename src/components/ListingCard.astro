---
import Photo from './Photo.astro';
// White card, 22 px, hairline; the photo at 16 px inside an 8 px inset. Lifts on hover.
import { type Listing, listingPhoto, where } from '../lib/format';
import { R } from '../lib/routes';
import Icon from './Icon.astro';
import Price from './Price.astro';

interface Props {
  item: Listing;
  saved?: boolean;
  /** CSS aspect-ratio of the photo. */
  ratio?: string;
  /** "lazy" when it sits below the first screen. */
  loading?: 'eager' | 'lazy';
}

const { item, saved = false, ratio = '1 / 1', loading } = Astro.props;
const meta = [item.condition, where(item.km, item.area), item.posted].filter(Boolean).join(' · ');
---

<article class="lift relative min-w-0 rounded-card border border-line bg-card p-2">
  <div class="relative overflow-hidden rounded-lg bg-surface-container-high" style={`aspect-ratio: ${ratio}`}>
    <Photo src={listingPhoto(item, 480)} width={480} height={480} alt={item.title} loading={loading} class="h-full w-full object-cover" />
    <button
      type="button"
      class:list={[
        'state-layer absolute right-2 top-2 z-10 grid h-8 w-8 place-items-center rounded-full bg-white/85 backdrop-blur',
        saved ? 'text-teal' : 'text-photo-ink',
      ]}
      aria-label={saved ? 'Bỏ lưu tin' : 'Lưu tin'}
      aria-pressed={saved}
      data-save
    >
      <Icon name={saved ? 'favorite-rounded' : 'favorite-outline-rounded'} size={18} />
    </button>
    {
      item.note && (
        <span class="absolute bottom-2 left-2 flex items-center gap-1 rounded-full bg-white/90 px-2 py-0.5 text-label-medium text-photo-accent backdrop-blur">
          <Icon name="auto-awesome-rounded" size={13} />
          {item.note}
        </span>
      )
    }
  </div>
  <div class="px-1.5 pb-1.5 pt-2.5">
    <div class="flex items-baseline justify-between gap-2">
      <Price vnd={item.price} />
      <span class="flex shrink-0 items-center gap-0.5 text-label-medium text-on-surface-variant">
        <Icon name="star-rounded" size={13} class="text-star" />{item.rating.toLocaleString('vi-VN', { minimumFractionDigits: 1 })}
      </span>
    </div>
    <h3 class="mt-0.5 line-clamp-2 text-body-medium text-ink">
      <a href={R.listing(item.id)} class="after:absolute after:inset-0 after:rounded-card">{item.title}</a>
    </h3>
    {
      item.facts && (
        <div class="mt-1.5 flex flex-wrap gap-1">
          {item.facts.slice(0, 2).map((f) => (
            <span class="rounded-full bg-surface-container-low px-2 py-0.5 text-label-small text-on-surface-variant">{f}</span>
          ))}
        </div>
      )
    }
    <p class="mt-1.5 flex items-center gap-1 text-body-small text-on-surface-variant">
      <Icon name="near-me-outline-rounded" size={13} />{meta}
    </p>
  </div>
</article>
