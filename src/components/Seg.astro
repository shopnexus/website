---
// The segmented control: a white thumb slides under the selected item. With
// variant="tabs" it is a row of underlined tabs instead (K2's tabs over a grid).
// Items are labels, or icon names when `icons` is set. A click moves the
// selection and fires a "seg-change" event with detail { index } on the control.
import Icon from './Icon.astro';

interface Props {
  items: string[];
  selected?: number;
  icons?: boolean;
  /** Labels for icon items, for screen readers. */
  labels?: string[];
  class?: string;
  /** Classes for each item: size, padding. */
  itemClass?: string;
  name?: string;
  variant?: 'seg' | 'tabs';
}

const { items, selected = 0, icons = false, labels, class: cls, itemClass, name, variant = 'seg' } = Astro.props;
const tabs = variant === 'tabs';
---

<div
  class:list={[tabs ? 'flex gap-6' : 'seg relative inline-flex rounded-control p-0.5', cls]}
  role="tablist"
  aria-label={name}
  data-seg
>
  {
    !tabs && (
      <span class="seg-thumb pointer-events-none absolute bottom-0.5 top-0.5 rounded-sm bg-card shadow-knob transition-[left,width] duration-(--duration-spatial-default) ease-spatial" />
    )
  }
  {
    items.map((it, i) => (
      <button
        type="button"
        role="tab"
        aria-selected={i === selected ? 'true' : 'false'}
        aria-label={icons ? labels?.[i] : undefined}
        class:list={[
          tabs
            ? '-mb-px flex h-10 items-center whitespace-nowrap border-b-2 border-transparent text-sub hover:text-ink aria-selected:border-brand aria-selected:font-medium aria-selected:text-ink'
            : 'relative z-10 flex h-8 items-center justify-center whitespace-nowrap rounded-sm px-3 text-sub aria-selected:text-ink',
          itemClass ?? (tabs ? 'text-body-large' : 'text-title-small'),
        ]}
      >
        {icons ? <Icon name={it} size={18} /> : it}
      </button>
    ))
  }
</div>

<script>
  function setup(seg: HTMLElement) {
    const thumb = seg.querySelector<HTMLElement>('.seg-thumb');
    const btns = [...seg.querySelectorAll<HTMLButtonElement>('button')];
    const put = (b: HTMLElement) => {
      if (!thumb) return;
      thumb.style.left = `${b.offsetLeft}px`;
      thumb.style.width = `${b.offsetWidth}px`;
    };
    put(btns.find((b) => b.getAttribute('aria-selected') === 'true') ?? btns[0]);
    btns.forEach((b, index) =>
      b.addEventListener('click', () => {
        btns.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
        put(b);
        seg.dispatchEvent(new CustomEvent('seg-change', { detail: { index }, bubbles: true }));
      }),
    );
    new ResizeObserver(() => put(btns.find((b) => b.getAttribute('aria-selected') === 'true') ?? btns[0])).observe(seg);
  }
  document.querySelectorAll<HTMLElement>('[data-seg]').forEach(setup);
</script>
