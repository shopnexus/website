---
// Placeholders for content on its way, built from the `.skeleton` shimmer in
// motion.css. By default a <template> that lib/skeleton.ts clones; `inline`
// draws it in place.
import ListingSkeleton from './ListingSkeleton.astro';

interface Props {
  /** card: a listing card. row: a list row with a photo. line: an icon and two lines. bubbles: chat messages. chat: a chat pane. person: a person card. */
  kind: 'card' | 'row' | 'line' | 'bubbles' | 'chat' | 'person';
  inline?: boolean;
}

const { kind, inline = false } = Astro.props;
const Tag = inline ? 'div' : 'template';
const bar = 'skeleton rounded-full';
// Theirs on the left, yours on the right, as a thread reads.
const bubbles: [string, boolean][] = [
  ['h-9 w-2/5', false],
  ['h-14 w-3/5', false],
  ['h-9 w-1/2', true],
  ['h-9 w-1/4', true],
  ['h-9 w-1/3', false],
];
---

<Tag class={inline ? 'contents' : undefined} data-skeleton-of={inline ? undefined : kind}>
  {kind === 'card' && <ListingSkeleton />}
  {
    kind === 'row' && (
      <div class="flex items-center gap-4 rounded-card border border-line bg-card p-2" aria-hidden="true" data-skeleton>
        <div class="skeleton h-16 w-16 shrink-0 rounded-lg md:h-20 md:w-20" />
        <div class="min-w-0 flex-1">
          <div class:list={[bar, 'h-3.5 w-2/3']} />
          <div class:list={[bar, 'mt-2 h-3 w-1/3']} />
          <div class:list={[bar, 'mt-2 h-3 w-1/2']} />
        </div>
      </div>
    )
  }
  {
    kind === 'line' && (
      <div class="flex items-center gap-3 p-3" aria-hidden="true" data-skeleton>
        <div class="skeleton h-10 w-10 shrink-0 rounded-full" />
        <div class="min-w-0 flex-1">
          <div class:list={[bar, 'h-3.5 w-1/2']} />
          <div class:list={[bar, 'mt-2 h-3 w-3/4']} />
        </div>
      </div>
    )
  }
  {
    kind === 'person' && (
      <div aria-hidden="true" data-skeleton>
        <div class="flex items-center gap-3">
          <div class="skeleton h-14 w-14 shrink-0 rounded-full" />
          <div class="min-w-0 flex-1">
            <div class:list={[bar, 'h-3.5 w-1/2']} />
            <div class:list={[bar, 'mt-2.5 h-3 w-3/4']} />
          </div>
        </div>
        <div class="skeleton mt-3 h-[54px] rounded-control" />
        <div class="mt-3 flex gap-2">
          <div class="skeleton h-9 flex-1 rounded-control" />
          <div class="skeleton h-9 flex-1 rounded-control" />
        </div>
      </div>
    )
  }
  {
    (kind === 'bubbles' || kind === 'chat') && (
      <div class="flex min-h-0 flex-1 flex-col self-stretch" aria-hidden="true" data-skeleton>
        {kind === 'chat' && (
          <div class="flex h-16 shrink-0 items-center gap-3 border-b border-line px-4">
            <div class="skeleton h-10 w-10 shrink-0 rounded-full" />
            <div class="min-w-0 flex-1">
              <div class:list={[bar, 'h-3.5 w-1/3']} />
              <div class:list={[bar, 'mt-2 h-3 w-1/4']} />
            </div>
          </div>
        )}
        <div class:list={['flex flex-1 flex-col justify-end gap-2', kind === 'chat' ? 'px-5 py-4' : 'py-2']}>
          {bubbles.map(([size, mine]) => (
            <div class:list={['skeleton rounded-card', size, mine && 'self-end']} />
          ))}
        </div>
      </div>
    )
  }
</Tag>
