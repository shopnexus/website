---
// One category: its name and count, its subcategories as pills (?category=
// picks one), then its listings under the same filters, sorts and paging as
// Tìm kiếm. The header's field searches in it.
import Crumbs from '../../components/Crumbs.astro';
import NotFound from '../../components/public/NotFound.astro';
import SearchResults from '../../components/public/SearchResults.astro';
import Layout from '../../layouts/Layout.astro';
import { orNull } from '../../lib/api/client';
import { byCode } from '../../lib/catalog';
import { group } from '../../lib/format';
import { card } from '../../lib/listing';
import { R } from '../../lib/routes';
import { readSearch, searchHref, serverQuery } from '../../lib/search';
import { CONTENT } from '../../lib/ui';

const cat = await byCode(Astro.params.code ?? '');
if (!cat) Astro.response.status = 404;

const base = cat ? R.category(cat.code) : R.categories;
const read = readSearch(Astro.url);
// ?category= is one of this category's subcategories, or nothing.
const sub = cat?.children.find((c) => c.code === read.category);
const s = { ...read, category: sub?.code, q: '', watch: undefined, photo: undefined };
const api = Astro.locals.api;
const query = cat && serverQuery(s, Astro.cookies);
const search = (category: string, limit?: number) =>
  orNull(api.GET('/v1/search', { params: { query: { ...query, category, ...(limit ? { limit, cursor: undefined } : {}) } } }));
// A search on the root returns the matches per subcategory; with one picked,
// a one-card search on the root still gives the pills their counts.
const [view, root] = cat ? await Promise.all([search(sub?.code ?? cat.code), sub ? search(cat.code, 1) : null]) : [null, null];
const counts = new Map(((sub ? root : view)?.counts ?? []).map((c) => [c.category, c.count]));
const total = [...counts.values()].reduce((n, c) => n + c, 0);
const pills = cat
  ? [{ name: 'Tất cả', code: undefined, count: total }, ...cat.children.map((c) => ({ name: c.name, code: c.code, count: counts.get(c.code) ?? 0 })).filter((p) => p.count)]
  : [];
const items = view?.items.map(card) ?? [];
---

{
  !cat ? (
    <Layout title="Không có danh mục này · ShopNexus" description="Danh mục này không có.">
      <NotFound />
    </Layout>
  ) : (
    <Layout
      title={`Danh mục ${cat.name} · ShopNexus`}
      description={`${group(total)} tin ${cat.name.toLowerCase()} đang bán trên ShopNexus.`}
      section="categories"
      search={{ scope: sub ?? cat }}
    >
      <main class={CONTENT} data-quick-behind>
        <Crumbs parts={[['Khám phá', R.home], ['Danh mục', R.categories], [cat.name]]} class="pt-4" />
        <section class="mt-4">
          <h1 class="text-j-30 text-ink lg:text-j-32">{cat.name}</h1>
          <p class="mt-2 text-body-large text-on-surface-variant">
            <b class="font-semibold text-ink tabular-nums">{group(total)}</b> món đang bán
          </p>
        </section>
        <nav class="mt-4 flex gap-1.5 overflow-x-auto no-scrollbar lg:flex-wrap" aria-label="Mục con">
          {pills.map((p) => {
            const on = p.code === sub?.code;
            return (
              <a
                href={searchHref(s, { category: p.code }, base)}
                data-pending="[data-grid],[data-list]"
                aria-current={on ? 'true' : undefined}
                class="group state-layer flex h-9 shrink-0 items-center gap-1.5 rounded-control border border-line bg-card px-3 text-label-large text-ink aria-[current]:border-brand aria-[current]:bg-mint aria-[current]:text-on-mint"
              >
                {p.name}
                <span class="text-label-small tabular-nums text-faint group-aria-[current]:text-on-mint/70">{group(p.count)}</span>
              </a>
            );
          })}
        </nav>
      </main>
      {items.length ? (
        <SearchResults items={items} search={s} base={base} next={view?.next_cursor} watchable={false} level={2} />
      ) : (
        <p class:list={[CONTENT, 'mt-8 block text-body-large text-sub']}>Chưa có tin nào ở đây.</p>
      )}
    </Layout>
  )
}

<script>
  import '../../lib/pending';
</script>
