---
// Danh mục: every category. The tiles with their counts and a last tile for
// search by sentence or photo, then the newest listings.
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import MiniRow from '../../components/MiniRow.astro';
import CategoryTile from '../../components/public/CategoryTile.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Layout from '../../layouts/Layout.astro';
import { unwrap } from '../../lib/api/client';
import { near } from '../../lib/area';
import { categories } from '../../lib/catalog';
import { newest } from '../../lib/feed';
import { R } from '../../lib/routes';
import { CONTENT } from '../../lib/ui';

const api = Astro.locals.api;
const [cats, home, fresh] = await Promise.all([
  categories(),
  unwrap(api.GET('/v1/screens/home', { params: { query: near(Astro.cookies) } })),
  newest(Astro, 6),
]);
const counts = new Map(home.categories.flatMap((c) => [[c.code, c.count] as const, ...c.children.map((s) => [s.code, s.count] as const)]));
---

<Layout title="Danh mục · ShopNexus" description="Mọi danh mục đồ cũ trên ShopNexus và số tin." section="categories">
  <main class={CONTENT}>
    <Crumbs parts={[['Khám phá', R.home], ['Danh mục']]} class="pt-4" />
    <section class="mt-4">
      <h1 class="text-j-28 text-ink lg:text-j-32">Danh mục</h1>
      <p class="mt-2 text-body-large text-on-surface-variant">
        <b class="font-semibold text-ink tabular-nums">{cats.length}</b> danh mục
      </p>
    </section>
    <section class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
      {cats.map((c, i) => <CategoryTile c={c} counts={counts} loading={i < 12 ? 'eager' : 'lazy'} />)}
      <article class="flex flex-col justify-between rounded-panel bg-brand p-5 text-white">
        <div>
          <p class="text-j-16">Không chắc thuộc mục nào?</p>
        </div>
        <div class="mt-4 flex gap-2">
          <a href={R.search} class="state-layer flex h-10 flex-1 items-center justify-center gap-1.5 rounded-full bg-white text-label-large text-primary">
            <Icon name="search-rounded" size={18} />Tìm bằng câu
          </a>
          <a
            href={R.photoSearch}
            class="state-layer flex h-10 flex-1 items-center justify-center gap-1.5 rounded-full bg-white/15 text-label-large text-white"
          >
            <Icon name="photo-camera-outline-rounded" size={18} />Bằng ảnh
          </a>
        </div>
      </article>
    </section>

    <section class="mt-10">
      <SectionTitle title="Vừa đăng trong mọi danh mục" link="Xem tất cả" href={`${R.search}?sort=newest`} />
      <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
        {fresh.map((it) => <MiniRow item={it} loading="lazy" />)}
      </div>
    </section>
  </main>
</Layout>
