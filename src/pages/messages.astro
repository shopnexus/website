---
// Tin nhắn: the inbox; the open chat with its deal chips, thread, deal
// consoles and composer; the deals' listings on the side. ?chat= opens a
// chat and ?deal= its deal. The entry links open one: ?listing= (with
// &offer=1 or &ask=) opens the buyer's deal on it, ?deal= finds its chat,
// ?seller= finds the pair's chat or lists the seller's items to start from.
// Every write is a form post here; the script sends some in place, and the
// socket (lib/socket.ts) asks this page again when something changes.
import Avatar from '../components/Avatar.astro';
import Icon from '../components/Icon.astro';
import Notice from '../components/Notice.astro';
import Photo from '../components/Photo.astro';
import Seg from '../components/Seg.astro';
import CodDialog from '../components/account/chat/CodDialog.astro';
import Composer from '../components/account/chat/Composer.astro';
import DealCard from '../components/account/chat/DealCard.astro';
import DealConsole from '../components/account/chat/DealConsole.astro';
import InboxList from '../components/account/chat/InboxList.astro';
import PaneHead from '../components/account/chat/PaneHead.astro';
import ReportDialog from '../components/account/chat/ReportDialog.astro';
import ChatThread from '../components/account/chat/ChatThread.astro';
import Layout from '../layouts/Layout.astro';
import { ApiError, type Schemas, idempotencyKey, orNull, unwrap } from '../lib/api/client';
import { group } from '../lib/format';
import { isId } from '../lib/listing';
import { activeText, chatHref, errorCode, errorText, loadMessages, openDeal, personName, shortTitle, thread } from '../lib/messages';
import { R } from '../lib/routes';
import { requireViewer } from '../lib/session';
import { CONTENT_WIDE, btnCls } from '../lib/ui';
import Skeleton from '../components/Skeleton.astro';

const v = requireViewer(Astro);
if (v instanceof Response) return v;
const api = Astro.locals.api;
const p = Astro.url.searchParams;

/** Opens the buyer's deal on a listing and goes to its chat; a refusal shows on the page. */
async function openFrom(listing: string, want: { offer?: string; ask?: string }): Promise<Response> {
  const extra: Record<string, string> = {};
  if (want.offer) extra.offer = '1';
  if (want.ask) extra.ask = want.ask.slice(0, 200);
  try {
    const d = await openDeal(api, listing);
    return Astro.redirect(chatHref(d.conversation_id, d.id, extra), 303);
  } catch (e) {
    return Astro.redirect(`${R.messages}?${new URLSearchParams({ error: errorCode(e) })}`, 303);
  }
}

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const s = (k: string) => String(f.get(k) ?? '').trim();
  const [act, chat, deal, account] = [s('do'), s('chat'), s('deal'), s('account')];
  // A listing's link confirmed: open the deal, which opens the chat.
  if (act === 'open') return openFrom(s('listing'), { offer: s('offer'), ask: s('ask') });
  if (!isId(chat)) return Astro.redirect(R.messages, 303);
  const path = { params: { path: { id: deal } } };
  let to = chatHref(chat, isId(deal) ? deal : undefined);
  const extra: Record<string, string> = {};
  try {
    switch (act) {
      case 'send': {
        const text = s('text');
        const photos = f.getAll('photos').map(String).filter(isId).slice(0, 4);
        const reply = s('reply_to');
        if (!text && !photos.length) break;
        await unwrap(
          api.POST('/v1/conversations/{id}/messages', {
            params: { path: { id: chat }, header: { 'Idempotency-Key': s('key') || idempotencyKey() } },
            body: { text: text || undefined, photos: photos.length ? photos : undefined, reply_to: isId(reply) ? reply : undefined },
          }),
        );
        break;
      }
      case 'offer':
        extra.offer = '1';
        await unwrap(api.POST('/v1/deals/{id}/offer', { ...path, body: { amount: Number(s('amount').replace(/\D/g, '')) } }));
        delete extra.offer;
        break;
      case 'accept':
        await unwrap(api.POST('/v1/deals/{id}/accept', { ...path, body: { price: Number(s('price')) } }));
        break;
      case 'decline':
        await unwrap(api.POST('/v1/deals/{id}/decline', path));
        break;
      case 'withdraw':
        await unwrap(api.POST('/v1/deals/{id}/withdraw', path));
        break;
      case 'cancel':
        await unwrap(api.POST('/v1/deals/{id}/cancel', path));
        break;
      // Giao COD: the order opens on its own page.
      case 'cod': {
        extra.cod = '1';
        extra.address = s('address_id');
        const key = s('key') || idempotencyKey();
        // An unclear failure sends the form back with its key, so the retry cannot open a second order.
        const d = await unwrap(
          api.POST('/v1/deals/{id}/cod', { params: { path: { id: deal }, header: { 'Idempotency-Key': key } }, body: { address_id: s('address_id') } }),
        ).catch(async (e) => {
          // A repeat that finds the order open goes to it.
          const now = e instanceof ApiError && (e.code === 'move_not_allowed' || e.code === 'deal_changed') ? await orNull(api.GET('/v1/deals/{id}', path)) : null;
          if (now?.order?.status === 'pending') return now;
          if (errorCode(e) === 'unknown') extra.key = key;
          throw e;
        });
        if (d.order) return Astro.redirect(`${R.order(d.order.id)}?done=sent`, 303);
        delete extra.cod;
        delete extra.address;
        break;
      }
      // Unread and archived leave the chat, or opening it would read it again.
      case 'unread':
        await unwrap(api.POST('/v1/conversations/{id}/unread', { params: { path: { id: chat } } }));
        to = R.messages;
        break;
      case 'archive':
        await unwrap(api.POST('/v1/conversations/{id}/archive', { params: { path: { id: chat } } }));
        to = R.messages;
        break;
      case 'unarchive':
        await unwrap(api.POST('/v1/conversations/{id}/unarchive', { params: { path: { id: chat } } }));
        break;
      case 'dismiss':
        await unwrap(api.POST('/v1/conversations/{id}/scam-warning/dismiss', { params: { path: { id: chat } } }));
        break;
      case 'report': {
        const reason = s('reason') as Schemas['ReportCreate']['reason'];
        await unwrap(api.POST('/v1/reports', { body: { account_id: account, conversation_id: chat, reason, note: s('note') } }));
        await unwrap(api.POST('/v1/blocks', { body: { account_id: account } }));
        extra.reported = '1';
        break;
      }
      case 'unblock':
        await unwrap(api.DELETE('/v1/blocks/{account_id}', { params: { path: { account_id: account } } }));
        break;
    }
  } catch (e) {
    extra.error = errorCode(e);
  }
  if (to === R.messages && !extra.error) return Astro.redirect(R.messages, 303);
  return Astro.redirect(chatHref(chat, isId(deal) ? deal : undefined, extra), 303);
}

// The entry links: each finds the chat and comes back with ?chat=.
let entryError = '';
let start: { seller: Schemas['SellerProfile']; listings: Schemas['SearchItem'][] } | null = null;
// A link from another site does not open a deal on its own: it asks first, with a form post.
let confirm: { id: string; title: string; thumb?: string; offer: string; ask: string } | null = null;
if (!p.has('chat')) {
  const listing = p.get('listing') ?? '';
  const deal = p.get('deal') ?? '';
  const seller = p.get('seller') ?? '';
  if (isId(listing)) {
    const site = Astro.request.headers.get('sec-fetch-site');
    const want = { offer: p.get('offer') ?? '', ask: p.get('ask') ?? '' };
    if (site === 'same-origin' || site === 'none') return openFrom(listing, want);
    const l = await orNull(api.GET('/v1/screens/listing/{id}', { params: { path: { id: listing } } }));
    if (l) confirm = { id: listing, title: l.listing.title, thumb: l.listing.photos.find((x) => x.url)?.url, ...want };
    else entryError = 'listing_not_found';
  } else if (isId(deal)) {
    const d = await orNull(api.GET('/v1/deals/{id}', { params: { path: { id: deal } } }));
    if (d) return Astro.redirect(chatHref(d.conversation_id, d.id));
    entryError = 'deal_not_found';
  } else if (isId(seller) && seller !== v.id) {
    // The pair's chat from a search of the seller's name; without one, their items to start from.
    const screen = await orNull(api.GET('/v1/screens/seller/{id}', { params: { path: { id: seller } } }));
    if (screen) {
      const name = screen.seller.display_name;
      const found = name ? await orNull(api.GET('/v1/screens/inbox/search', { params: { query: { q: name, limit: 1 } } }), [400, 422]) : null;
      const row = found?.threads.find((t) => t.other.id === seller);
      if (row) return Astro.redirect(chatHref(row.id, row.deal?.id));
      start = { seller: screen.seller, listings: screen.listings.items.slice(0, 6) };
    }
  }
}

const m = await loadMessages(Astro, true);
const chat = m.chat;
const error = entryError || p.get('error') || (p.has('chat') && !chat ? 'conversation_not_found' : '');
const other = chat ? personName(chat.other) : '';
const items = chat ? thread([...chat.messages.items].reverse(), chat, v.id) : [];
const deal = m.deal;
const warning = chat?.scam_warning && !chat.scam_warning.dismissed ? chat.scam_warning : null;
// ?cod=1 opens Giao COD over the chat, for the buyer of an agreed deal.
const address = p.get('address') ?? '';
const cod =
  deal && p.get('cod') === '1' && deal.role === 'buyer' && deal.status === 'agreed'
    ? await Promise.all([
        orNull(api.GET('/v1/screens/cod-checkout/{deal_id}', { params: { path: { deal_id: deal.id }, query: { address_id: isId(address) ? address : undefined } } }))
          .then((c) => c ?? orNull(api.GET('/v1/screens/cod-checkout/{deal_id}', { params: { path: { deal_id: deal.id } } }))),
        unwrap(api.GET('/v1/addresses')).then((b) => b.items),
      ]).then(([checkout, addresses]) => (checkout ? { checkout, addresses } : null))
    : null;
// Whether the block is the viewer's, so "Bỏ chặn" can lift it.
// The server answers only with the whole list, so it is paged through.
async function blocks(id: string) {
  let cursor: string | undefined;
  do {
    const page = await unwrap(api.GET('/v1/blocks', { params: { query: { cursor, limit: 100 } } }));
    if (page.items.some((x) => x.account_id === id)) return true;
    cursor = page.next_cursor;
  } while (cursor);
  return false;
}
const mineBlock = chat?.blocked ? await blocks(chat.other.id).catch(() => false) : false;
const unreadRows = m.inbox.items.filter((c) => c.unread > 0).length;
const official = !!chat?.other.official;

const pane = 'flex min-h-0 flex-col overflow-hidden rounded-panel border border-line bg-card shadow-soft h-[calc(100dvh-176px)] min-h-[560px] lg:h-auto';
const iconBtn = 'state-layer grid h-10 w-10 shrink-0 place-items-center rounded-full text-on-surface-variant';
const side = 'flex min-w-0 flex-col gap-4 overflow-y-auto no-scrollbar lg:hidden xl:flex';
const item = 'state-layer flex h-11 w-full items-center gap-3 rounded-control px-3 text-left text-body-large hover:bg-hover';
const detail = !!(chat || start || confirm);
---

<Layout title="Tin nhắn · ShopNexus" description="Tin nhắn mua bán trên ShopNexus." section={null} footer={false} fab={!detail}>
  <main class={CONTENT_WIDE}>
    <div
      class="mt-4 grid grid-cols-1 gap-4 lg:h-[calc(100dvh-96px)] lg:min-h-[760px] lg:grid-cols-[300px_minmax(0,1fr)] xl:grid-cols-[340px_minmax(0,1fr)_312px]"
    >
      <section class:list={['flex min-h-0 flex-col rounded-panel border border-line bg-card p-2 shadow-soft', detail ? 'max-lg:hidden' : 'max-lg:min-h-[70dvh]']}>
        <div class="flex items-center justify-between px-2 pt-2">
          <h1 class="text-j-26 text-ink">{m.archived ? 'Đã lưu trữ' : 'Tin nhắn'}</h1>
          <button type="button" class={iconBtn} aria-label="Tìm trong tin nhắn" aria-expanded={m.q ? 'true' : 'false'} data-search-toggle>
            <Icon name="search-rounded" size={22} />
          </button>
        </div>
        <form method="get" action={R.messages} role="search" class="mt-2 flex items-center gap-1 px-1" hidden={!m.q} data-search>
          <label class="flex h-10 min-w-0 flex-1 items-center gap-2 rounded-full border border-line bg-card px-4 focus-within:ring-2 focus-within:ring-primary">
            <Icon name="search-rounded" size={18} class="text-on-surface-variant" />
            <span class="sr-only">Tìm người hoặc tin nhắn</span>
            <input name="q" value={m.q} maxlength="100" autocomplete="off" placeholder="Tìm người, món hoặc tin nhắn" class="min-w-0 flex-1 bg-transparent text-body-large text-ink outline-none placeholder:text-on-surface-variant" />
          </label>
          {
            m.q && (
              <a href={R.messages} class={iconBtn} aria-label="Bỏ tìm">
                <Icon name="close-rounded" size={20} />
              </a>
            )
          }
        </form>
        {
          !m.q && (
            <div class="mt-2 max-w-full overflow-x-auto px-1 no-scrollbar">
              <Seg
                items={['Tất cả', 'Mua', 'Bán', unreadRows ? `Chưa đọc ${unreadRows}` : 'Chưa đọc']}
                class="bg-card/60"
                itemClass="text-label-medium"
                name="Lọc tin nhắn"
              />
            </div>
          )
        }
        <InboxList m={m} me={v.id} open={chat?.id} />
      </section>

      {
        chat ? (
          <section class={pane} data-chat={chat.id} data-other={other} data-chat-slot data-skeleton-kind="chat">
            <PaneHead
              title={deal?.listing.title ?? other}
              name={other}
              photo={chat.other.avatar_url}
              thumb={deal?.listing.cover_thumb_url}
              sub={activeText(chat.other)}
              href={deal && (deal.listing.status === 'active' || deal.listing.status === 'reserved') ? R.listing(deal.listing.slug) : undefined}
            >
              {!official && (
                <Fragment slot="menu">
                  <form method="post" action={R.messages}>
                    <input type="hidden" name="chat" value={chat.id} />
                    <button type="submit" name="do" value="unread" class={item}>
                      <Icon name="mail-outline-rounded" size={18} class="text-sub" />
                      Đánh dấu chưa đọc
                    </button>
                    <button type="submit" name="do" value={chat.archived ? 'unarchive' : 'archive'} class={item}>
                      <Icon name="inventory-2-outline-rounded" size={18} class="text-sub" />
                      {chat.archived ? 'Bỏ lưu trữ' : 'Lưu trữ'}
                    </button>
                  </form>
                  {!chat.blocked && (
                    <button type="button" class:list={[item, 'text-error']} data-open-report="form">
                      <Icon name="block-rounded" size={18} />
                      Chặn và báo cáo
                    </button>
                  )}
                </Fragment>
              )}
              {chat.deals.length > 1 && (
                <nav class="flex gap-2 overflow-x-auto px-4 pb-3 no-scrollbar" aria-label="Món đang thỏa thuận">
                  {chat.deals.map((d) => (
                    <a
                      href={chatHref(chat.id, d.id)}
                      aria-current={d.id === deal?.id ? 'true' : undefined}
                      data-deal-chip={d.id}
                      data-title={d.listing.title}
                      data-thumb={d.listing.cover_thumb_url}
                      class="state-layer flex h-8 shrink-0 items-center gap-2 rounded-control border border-outline-variant bg-card pl-1 pr-3 text-label-large text-on-surface-variant aria-[current]:border-transparent aria-[current]:bg-brand aria-[current]:text-white"
                    >
                      {d.listing.cover_thumb_url ? (
                        <Photo src={d.listing.cover_thumb_url} width={48} height={48} alt="" class="h-6 w-6 rounded-full object-cover" />
                      ) : (
                        <span class="w-1" />
                      )}
                      {shortTitle(d.listing.title)}
                    </a>
                  ))}
                </nav>
              )}
            </PaneHead>
            <div data-part="warning">
              {warning && (
                <div class="px-3 pt-3">
                  <button
                    type="button"
                    data-open-report="signals"
                    class="state-layer flex w-full items-center gap-3 rounded-tile border border-error/20 bg-error-container/60 py-3 pl-4 pr-3 text-left"
                    aria-haspopup="dialog"
                  >
                    <Icon name="gpp-maybe-outline-rounded" size={24} class="text-error" />
                    <span class="min-w-0 flex-1">
                      <span class="block text-title-small text-on-surface">Có thể là lừa đảo</span>
                      <span class="mt-0.5 flex items-center gap-1 text-body-small text-on-surface-variant">
                        <Icon name="auto-awesome-rounded" size={14} class="text-primary" />
                        {warning.signals.length} dấu hiệu · đừng chuyển tiền trước
                      </span>
                    </span>
                    <Icon name="chevron-right-rounded" size={24} class="text-on-surface-variant" />
                  </button>
                </div>
              )}
            </div>
            <ChatThread
              items={items}
              me={v.id}
              other={other}
              photo={chat.other.avatar_url}
              next={chat.messages.next_cursor ?? undefined}
              last={chat.messages.items[0]?.id}
              marked={m.marked}
              empty={`Gửi lời chào tới ${other}.`}
            />
            <div data-part="deals">
              {chat.deals.map((d) => (
                <DealConsole deal={d} other={other} offering={d.id === deal?.id && p.get('offer') === '1'} hidden={d.id !== deal?.id} />
              ))}
            </div>
            <div data-part="alert" class="px-3 pt-2 empty:hidden">
              {error && !cod && (
                <Notice text={errorText(error)}>
                  {error === 'phone_required' && (
                    <a href={R.security} class="ml-1 text-primary underline">
                      Xem Bảo mật
                    </a>
                  )}
                </Notice>
              )}
            </div>
            <p class="px-6 pt-1 text-body-small text-on-surface-variant" hidden data-typing>
              {other} đang nhập…
            </p>
            {chat.blocked ? (
              <form method="post" action={R.messages} class="m-3 flex items-center gap-3 rounded-tile bg-surface-container-low py-2 pl-4 pr-2">
                <input type="hidden" name="chat" value={chat.id} />
                <input type="hidden" name="account" value={chat.other.id} />
                <Icon name="block-rounded" size={20} class="text-on-surface-variant" />
                <p class="min-w-0 flex-1 text-body-medium text-on-surface-variant">
                  {mineBlock ? `Bạn đã chặn ${other}` : `Không nhắn được với ${other}`}
                </p>
                {mineBlock && (
                  <button type="submit" name="do" value="unblock" class="state-layer h-10 rounded-control px-3 text-label-large text-primary">
                    Bỏ chặn
                  </button>
                )}
              </form>
            ) : chat.other.deleted ? (
              <p class="m-3 rounded-tile bg-surface-container-low px-4 py-3 text-body-medium text-on-surface-variant">Người này đã xóa tài khoản.</p>
            ) : (
              <Composer peer={other} chat={chat.id} deal={deal?.id} text={p.get('ask') ?? undefined} />
            )}
          </section>
        ) : confirm ? (
          <section class={pane} data-chat-slot data-skeleton-kind="chat">
            <div class="flex h-16 items-center gap-3 border-b border-line px-4">
              <a href={R.messages} class:list={[iconBtn, 'lg:hidden']} aria-label="Về hộp thư">
                <Icon name="chevron-left-rounded" size={24} />
              </a>
              <p class="min-w-0 flex-1 truncate text-title-medium text-ink">Nhắn về tin này</p>
            </div>
            <form method="post" action={R.messages} class="flex flex-col items-center gap-4 p-6 text-center">
              <input type="hidden" name="do" value="open" />
              <input type="hidden" name="listing" value={confirm.id} />
              <input type="hidden" name="offer" value={confirm.offer} />
              <input type="hidden" name="ask" value={confirm.ask} />
              {confirm.thumb && <Photo src={confirm.thumb} width={192} height={192} alt="" class="h-24 w-24 rounded-lg object-cover" />}
              <p class="max-w-sm text-body-large text-ink">{confirm.title}</p>
              <button type="submit" class={btnCls('ink')}>
                <Icon name="chat-outline-rounded" size={18} />
                Nhắn về tin này
              </button>
            </form>
          </section>
        ) : start ? (
          <section class={pane} data-chat-slot data-skeleton-kind="chat">
            <div class="flex h-16 items-center gap-3 border-b border-line px-4">
              <a href={R.messages} class:list={[iconBtn, 'lg:hidden']} aria-label="Về hộp thư">
                <Icon name="chevron-left-rounded" size={24} />
              </a>
              <Avatar name={start.seller.display_name} photo={start.seller.avatar_url} size={40} />
              <p class="min-w-0 flex-1 truncate text-title-medium text-ink">{start.seller.display_name}</p>
            </div>
            <div class="no-scrollbar flex min-h-0 flex-1 flex-col gap-1 overflow-y-auto p-3">
              <p class="px-2 pb-2 text-body-medium text-on-surface-variant">
                {start.listings.length ? `Chọn món bạn muốn hỏi ${start.seller.display_name}.` : `${start.seller.display_name} chưa có tin nào đang bán.`}
              </p>
              {start.listings.map((l) => (
                <a href={`${R.messages}?listing=${l.id}`} class="state-layer flex items-center gap-3 rounded-tile p-2 hover:bg-hover">
                  {l.cover_thumb_url ? (
                    <Photo src={l.cover_thumb_url} width={112} height={112} alt="" class="h-14 w-14 shrink-0 rounded-md object-cover" />
                  ) : (
                    <span class="h-14 w-14 shrink-0 rounded-md bg-soft" />
                  )}
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-body-large text-ink">{l.title}</span>
                    <span class="block text-title-small tabular-nums text-ink">{group(l.price)} ₫</span>
                  </span>
                  <Icon name="chat-outline-rounded" size={20} class="text-primary" />
                </a>
              ))}
            </div>
          </section>
        ) : (
          <section class:list={[pane, 'items-center justify-center gap-3 p-6 text-center max-lg:hidden']} data-chat-slot data-skeleton-kind="chat">
            {error ? (
              <Notice text={errorText(error)} class="max-w-md">
                {error === 'phone_required' && (
                  <a href={R.security} class="ml-1 text-primary underline">
                    Xem Bảo mật
                  </a>
                )}
              </Notice>
            ) : (
              <>
                <span class="grid h-12 w-12 place-items-center rounded-full bg-surface-container-low text-on-surface-variant">
                  <Icon name="chat-outline-rounded" size={24} />
                </span>
                <p class="text-body-large text-on-surface-variant">Chọn một cuộc trò chuyện để xem.</p>
              </>
            )}
          </section>
        )
      }

      {
        chat && (
          <aside class={side} data-part="side" data-chat-slot data-skeleton-kind="none">
            {chat.deals.map((d) => (
              <DealCard deal={d} other={chat.other} hidden={d.id !== deal?.id} />
            ))}
            {chat.buyer_rating && chat.buyer_rating.count > 0 && (
              <p class="flex items-center gap-1.5 px-2 text-body-small text-on-surface-variant">
                <Icon name="star-rounded" size={16} class="text-tertiary" />
                Người mua · {chat.buyer_rating.average.toLocaleString('vi-VN', { maximumFractionDigits: 1 })} ({chat.buyer_rating.count} đánh giá)
              </p>
            )}
            {chat.archived && <p class="px-2 text-body-small text-on-surface-variant">Cuộc trò chuyện đang lưu trữ.</p>}
          </aside>
        )
      }
    </div>
    {
      !chat && error && (
        <div class="mt-3 lg:hidden">
          <Notice text={errorText(error)}>
            {error === 'phone_required' && (
              <a href={R.security} class="ml-1 text-primary underline">
                Xem Bảo mật
              </a>
            )}
          </Notice>
        </div>
      )
    }
    <Skeleton kind="chat" />
  </main>
  {
    chat && !official && (
      <ReportDialog name={other} account={chat.other.id} chat={chat.id} signals={warning?.signals ?? []} sent={p.get('reported') === '1'} />
    )
  }
  {cod && <CodDialog checkout={cod.checkout} addresses={cod.addresses} seller={other} error={error || undefined} idem={isId(p.get('key') ?? '') ? p.get('key')! : idempotencyKey()} />}
</Layout>

<script>
  import { group } from '../lib/format';
  import { mountChatPane } from '../lib/chat-pane';
  import '../lib/pending';

  const $ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => root.querySelector<T>(s);
  const $$ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => [...root.querySelectorAll<T>(s)];
  const clean = () => {
    const u = new URL(location.href);
    ['error', 'offer', 'ask', 'reported', 'cod', 'address', 'key'].forEach((k) => u.searchParams.delete(k));
    return u;
  };
  // The chat pane is lib/chat-pane's; other chats' changes refresh the inbox partial.
  mountChatPane({
    clean,
    shows: (u) => !!u.deal_id && !!$(`[data-deal-panel="${u.deal_id}"]`),
    elsewhere: () => 'inbox',
    refreshInbox: async () => {
      const res = await fetch(`/messages/inbox${clean().search}`, { headers: { accept: 'text/html' } });
      if (!res.ok || res.redirected) return;
      const holder = document.createElement('template');
      holder.innerHTML = await res.text();
      const part = holder.content.querySelector<HTMLTemplateElement>('template[data-inbox-page]');
      if (part) for (const fresh of $$('[data-part]', part.content)) $(`[data-part="${fresh.dataset.part}"]`)?.replaceWith(fresh);
      filter();
    },
    afterSwap: () => filter(),
  });

  // ------------------------------------------------------------ the deals --
  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    const chip = t.closest<HTMLAnchorElement>('[data-deal-chip]');
    if (chip) {
      e.preventDefault();
      const id = chip.dataset.dealChip!;
      $$('[data-deal-chip]').forEach((c) => (c === chip ? c.setAttribute('aria-current', 'true') : c.removeAttribute('aria-current')));
      $$('[data-deal-panel]').forEach((el) => (el.hidden = el.dataset.dealPanel !== id));
      $$('[data-deal-card]').forEach((el) => (el.hidden = el.dataset.dealCard !== id));
      const title = $('[data-pane-title]');
      if (title) title.textContent = chip.dataset.title ?? '';
      const thumb = $<HTMLImageElement>('[data-pane-thumb]');
      if (thumb && chip.dataset.thumb) {
        thumb.removeAttribute('srcset');
        thumb.src = chip.dataset.thumb;
      }
      const field = $<HTMLInputElement>('[data-composer] input[name="deal"]');
      if (field) field.value = id;
      const u = clean();
      u.searchParams.set('deal', id);
      history.replaceState(null, '', u);
      return;
    }
    const toggle = t.closest<HTMLAnchorElement>('[data-offer-toggle]');
    if (toggle) {
      e.preventDefault();
      const panel = toggle.closest<HTMLElement>('[data-deal-panel]')!;
      const form = $<HTMLFormElement>('[data-offer-form]', panel)!;
      form.hidden = !form.hidden;
      $$('[data-offer-toggle][aria-expanded]', panel).forEach((b) => b.setAttribute('aria-expanded', String(!form.hidden)));
      if (!form.hidden) $<HTMLInputElement>('[data-amount]', form)?.focus();
      return;
    }
    const fold = t.closest<HTMLButtonElement>('[data-collapse]');
    if (fold) {
      const body = fold.closest('[data-deal-panel]')?.querySelector<HTMLElement>('[data-console-body]');
      if (!body) return;
      body.hidden = !body.hidden;
      fold.setAttribute('aria-expanded', String(!body.hidden));
      fold.classList.toggle('rotate-180', body.hidden);
    }
  });
  // The amount groups its thousands as it is typed.
  document.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (!t.matches('[data-amount]')) return;
    const n = Number(t.value.replace(/\D/g, ''));
    t.value = n ? group(n) : '';
  });

  // ------------------------------------------------------------ the inbox --
  let shown = 0;
  function filter() {
    $$('[data-inbox] > a[data-open]').forEach((r) => {
      const ok = shown === 0 || (shown === 1 && r.dataset.role === 'buy') || (shown === 2 && r.dataset.role === 'sell') || (shown === 3 && 'unread' in r.dataset);
      r.classList.toggle('hidden', !ok);
    });
  }
  $('[aria-label="Lọc tin nhắn"]')?.addEventListener('seg-change', (e) => {
    shown = (e as CustomEvent<{ index: number }>).detail.index;
    filter();
  });
  $('[data-search-toggle]')?.addEventListener('click', (e) => {
    const form = $<HTMLFormElement>('[data-search]')!;
    form.hidden = !form.hidden;
    (e.currentTarget as HTMLElement).setAttribute('aria-expanded', String(!form.hidden));
    if (!form.hidden) $<HTMLInputElement>('input', form)?.focus();
  });

  // ------------------------------------------------------- report dialog --
  const dlg = $<HTMLDialogElement>('#report');
  if (dlg) {
    const show = (p: string) => {
      const has = $(`[data-pane="${p}"]`, dlg) ? p : 'form';
      $$('[data-pane]', dlg).forEach((el) => (el.hidden = el.dataset.pane !== has));
    };
    document.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-open-report]');
      if (!b) return;
      $<HTMLElement>('#chat-menu')?.hidePopover?.();
      show(b.dataset.openReport!);
      dlg.showModal();
    });
    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const go = t.closest<HTMLElement>('[data-go]');
      if (go) show(go.dataset.go!);
      if (t.closest('[data-close]') || t === dlg) dlg.close();
    });
    if ('sent' in dlg.dataset) {
      show('sent');
      dlg.showModal();
      history.replaceState(null, '', clean());
    }
  }

  // ------------------------------------------------------------ Giao COD --
  // It renders open over the chat; here it becomes modal, and closing it
  // leaves ?cod= behind.
  const codDlg = $<HTMLDialogElement>('#cod');
  if (codDlg) {
    codDlg.close();
    codDlg.showModal();
    history.replaceState(null, '', clean());
    // The form fills the dialog, so a click on the dialog itself is the backdrop.
    codDlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === codDlg || t.closest('[data-close]')) {
        e.preventDefault();
        codDlg.close();
      }
    });
  }

</script>
