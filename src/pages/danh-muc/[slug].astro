---
// One category: its name and count, the search field, its subcategories as
// pills (?muc= picks one), then its listings under the same filters, sorts
// and paging as Tìm kiếm.
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import NotFound from '../../components/public/NotFound.astro';
import SearchResults from '../../components/public/SearchResults.astro';
import SearchField from '../../components/SearchField.astro';
import Layout from '../../layouts/Layout.astro';
import { ApiError, unwrap } from '../../lib/api/client';
import { bySlug } from '../../lib/catalog';
import { group } from '../../lib/format';
import { card } from '../../lib/listing';
import { R } from '../../lib/routes';
import { readSearch, searchHref, serverQuery } from '../../lib/search';
import { CONTENT } from '../../lib/ui';

const cat = await bySlug(Astro.params.slug ?? '');
if (!cat) Astro.response.status = 404;

const base = cat ? R.category(cat.slug) : R.categories;
const read = readSearch(Astro.url);
// ?muc= is one of this category's subcategories, or nothing.
const sub = cat?.children.find((c) => c.code === read.category);
const s = { ...read, category: sub?.code, q: '', watch: undefined, photo: undefined };
const api = Astro.locals.api;
const query = cat && serverQuery(s, Astro.cookies);
const search = (category: string, limit?: number) =>
  unwrap(api.GET('/v1/search', { params: { query: { ...query, category, ...(limit ? { limit, cursor: undefined } : {}) } } })).catch((e) => {
    if (e instanceof ApiError && (e.status === 400 || e.status === 404)) return null;
    throw e;
  });
// A search on the root returns the matches per subcategory; with one picked,
// a one-card search on the root still gives the pills their counts.
const [view, root] = cat ? await Promise.all([search(sub?.code ?? cat.code), sub ? search(cat.code, 1) : null]) : [null, null];
const counts = new Map(((sub ? root : view)?.counts ?? []).map((c) => [c.category, c.count]));
const total = [...counts.values()].reduce((n, c) => n + c, 0);
const pills = cat
  ? [{ name: 'Tất cả', code: undefined, count: total }, ...cat.children.map((c) => ({ name: c.name, code: c.code, count: counts.get(c.code) ?? 0 })).filter((p) => p.count)]
  : [];
const items = view?.items.map(card) ?? [];
---

{
  !cat ? (
    <Layout title="Không có danh mục này · ShopNexus" description="Danh mục này không có.">
      <NotFound />
    </Layout>
  ) : (
    <Layout title={`Danh mục ${cat.name} · ShopNexus`} description={`${group(total)} tin ${cat.name.toLowerCase()} đang bán trên ShopNexus.`} section="categories">
      <main class={CONTENT}>
        <Crumbs parts={[['Khám phá', R.home], ['Danh mục', R.categories], [cat.name]]} class="pt-4" />
        <section class="mt-4 grid grid-cols-1 items-end gap-6 lg:grid-cols-[1fr_520px] lg:gap-8">
          <div>
            <p class="border border-line bg-card flex w-fit items-center gap-2 rounded-full px-3 py-1.5 text-label-medium text-ink">
              <Icon name={cat.icon} size={15} class="text-primary" />
              Danh mục
            </p>
            <h1 class="mt-3 text-j-30 text-ink lg:text-j-32">{cat.name}</h1>
            <p class="mt-2 text-body-large text-on-surface-variant">
              <b class="font-semibold text-ink tabular-nums">{group(total)}</b> món đang bán
            </p>
          </div>
          <SearchField placeholder={`Tìm trong ${cat.name}`} />
        </section>
        <nav class="mt-4 flex gap-1.5 overflow-x-auto no-scrollbar lg:flex-wrap" aria-label="Mục con">
          {pills.map((p) => {
            const on = p.code === sub?.code;
            return (
              <a
                href={searchHref(s, { category: p.code }, base)}
                aria-current={on ? 'true' : undefined}
                class:list={[
                  'state-layer flex h-9 shrink-0 items-center gap-1.5 rounded-control px-3 text-label-large',
                  on ? 'border border-brand bg-mint text-on-mint' : 'border border-line bg-card text-ink',
                ]}
              >
                {p.name}
                <span class:list={['text-label-small tabular-nums', on ? 'text-on-mint/70' : 'text-faint']}>{group(p.count)}</span>
              </a>
            );
          })}
        </nav>
      </main>
      {items.length ? (
        <SearchResults items={items} search={s} base={base} title={sub?.name ?? 'Đang bán'} next={view?.next_cursor} watchable={false} level={2} />
      ) : (
        <p class:list={[CONTENT, 'mt-8 block text-body-large text-sub']}>Chưa có tin nào ở đây.</p>
      )}
    </Layout>
  )
}
