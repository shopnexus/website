---
import Photo from '../../components/Photo.astro';
// One category. Điện thoại carries the mockup's content (brands, hot
// searches, Giá tham khảo per model, the phone checks at the door); the other
// categories reuse the frame with their subcategories, "Đang được tìm nhiều"
// in place of the price panel, and the general listing pool.
import Crumbs from '../../components/Crumbs.astro';
import Drop from '../../components/Drop.astro';
import Icon from '../../components/Icon.astro';
import ListingCard from '../../components/ListingCard.astro';
import Price from '../../components/Price.astro';
import RangeBar from '../../components/public/RangeBar.astro';
import { tr } from '../../components/public/tr';
import SearchField from '../../components/SearchField.astro';
import Seg from '../../components/Seg.astro';
import Trending from '../../components/Trending.astro';
import Layout from '../../layouts/Layout.astro';
import { LISTINGS } from '../../data/listings';
import { CATEGORY_INDEX, MODELS, PHONES } from '../../data/public';
import { img } from '../../lib/format';
import { R } from '../../lib/routes';
import { CONTENT } from '../../lib/ui';

const cat = CATEGORY_INDEX.find((c) => c.slug === Astro.params.slug);
if (!cat) return new Response(null, { status: 404 });

const phones = cat.slug === 'dien-thoai';
const chips: [string, string][] = phones
  ? [['Tất cả', '3.412'], ['iPhone', '1.986'], ['Samsung', '742'], ['Xiaomi', '268'], ['OPPO', '171'], ['Google Pixel', '58'], ['Khác', '187']]
  : [['Tất cả', cat.count], ...cat.subs.map((s): [string, string] => [s.name, s.count])];
const picked = Astro.url.searchParams.get('muc');
const hot = phones ? ['iPhone 13 Pro pin trên 85%', 'Galaxy S23 Ultra', 'iPhone 12 dưới 7 triệu', 'máy zin chưa sửa'] : [];
const items = phones ? PHONES : LISTINGS.slice(0, 8);
const minutes = (p?: string) => (p?.endsWith('phút') ? parseInt(p) : Infinity);
const fresh = [...(phones ? PHONES : LISTINGS)]
  .filter((it) => it.posted?.endsWith('phút'))
  .sort((a, b) => minutes(a.posted) - minutes(b.posted))
  .slice(0, 4);
const unit = phones ? 'máy' : 'món';
const more = parseInt(cat.count.replace('.', '')) - 8;
const s = (q: string) => `${R.search}?q=${encodeURIComponent(q)}`;
---

<Layout
  title={`Danh mục ${cat.name} · ShopNexus`}
  description={`${cat.count} tin ${cat.name.toLowerCase()} đang bán trên ShopNexus.`}
  section="categories"
>
  <main class={CONTENT}>
    <Crumbs parts={[['Khám phá', R.home], ['Danh mục', R.categories], [cat.name]]} class="pt-4" />
    <section class="mt-4 grid grid-cols-1 gap-8 lg:grid-cols-[1fr_400px] xl:grid-cols-[1fr_480px]">
      <div class="flex min-w-0 flex-col">
        <p class="glass glass-edge flex w-fit items-center gap-2 rounded-full px-3 py-1.5 text-label-medium text-ink">
          <Icon name={cat.icon} size={15} class="text-primary" />Danh mục
        </p>
        <h1 class="mt-3 text-j-44 text-ink lg:text-j-64">{cat.name}</h1>
        <p class="mt-2 text-body-large text-on-surface-variant">
          <b class="font-semibold text-ink tabular-nums">{cat.count}</b> {unit} đang bán
        </p>
        <SearchField
          class="mt-6"
          placeholder={phones ? 'Tìm trong Điện thoại: iPhone pin trên 85%, dưới 6 triệu' : `Tìm trong ${cat.name}`}
        />
        <div class="mt-4 flex gap-1.5 overflow-x-auto no-scrollbar lg:flex-wrap">
          {
            chips.map(([b, n], i) => {
              const on = picked ? b === picked : i === 0;
              return (
                <a
                  href={i === 0 ? R.category(cat.slug) : `${R.category(cat.slug)}?muc=${encodeURIComponent(b)}`}
                  aria-current={on ? 'true' : undefined}
                  class:list={[
                    'state-layer flex h-9 shrink-0 items-center gap-1.5 rounded-full px-3 text-label-large',
                    on ? 'bg-ink text-on-ink' : 'glass glass-edge text-ink',
                  ]}
                >
                  {b}
                  <span class:list={['text-label-small tabular-nums', on ? 'text-on-ink/70' : 'text-on-surface-variant']}>{n}</span>
                </a>
              );
            })
          }
        </div>
        {
          hot.length > 0 && (
            <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-body-small text-on-surface-variant">
              <Icon name="trending-up-rounded" size={16} class="text-primary" />
              Hay tìm:
              {hot.map((t) => (
                <a href={s(t)} class="text-ink hover:text-primary">
                  {t}
                </a>
              ))}
            </p>
          )
        }
        <div class="mt-auto pt-5">
          <p class="mb-2 flex items-center gap-1.5 text-label-medium text-on-surface-variant">
            <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>Vừa đăng
          </p>
          <div class="grid grid-cols-2 gap-2 xl:grid-cols-4">
            {
              fresh.map((it) => (
                <a href={R.listing(it.id)} class="lift flex items-center gap-2.5 rounded-tile border border-line bg-card p-1.5 pr-3">
                  <Photo src={img(it.photo, 120, 120)} width={120} height={120} alt="" class="h-11 w-11 shrink-0 rounded-md object-cover" />
                  <span class="min-w-0">
                    <Price vnd={it.price} size="text-j-15" />
                    <span class="block truncate text-body-small text-on-surface-variant">{it.posted} trước</span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
      {
        phones ? (
          <div class="glass glass-edge rounded-xl px-5 pb-2 pt-4 shadow-soft">
            <div class="flex flex-wrap items-center justify-between gap-x-3">
              <p class="flex items-center gap-1.5 text-title-small text-ink">
                <Icon name="auto-awesome-rounded" size={16} class="text-primary" />
                Giá tham khảo
              </p>
              <span class="text-body-small text-on-surface-variant">30 ngày · đã tính tình trạng, dung lượng</span>
            </div>
            <ul class="mt-1">
              {MODELS.map((m, i) => (
                <li class:list={['py-3', i > 0 && 'border-t border-line']}>
                  <div class="flex items-baseline justify-between gap-3">
                    <span class="text-title-small text-ink">{m.name}</span>
                    <span class="whitespace-nowrap text-j-16 text-ink tabular-nums">
                      {tr(m.lo)} – {tr(m.hi)}
                      <span class="ml-0.5 text-body-small font-medium text-on-surface-variant">tr ₫</span>
                    </span>
                  </div>
                  <div class="mt-2">
                    <RangeBar lo={m.lo} hi={m.hi} med={m.med} labels={false} />
                  </div>
                  <p class="mt-1.5 flex justify-between text-body-small text-on-surface-variant">
                    <span>
                      giữa <b class="font-semibold text-ink tabular-nums">{tr(m.med)} tr</b> · {m.n} tin trong 30 ngày
                    </span>
                    <a href={s(m.name)} class="text-label-medium text-primary hover:underline">
                      Xem tin
                    </a>
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <div class="glass glass-edge self-start rounded-xl p-3 shadow-soft">
            <Trending n={5} />
          </div>
        )
      }
    </section>

    <section class="mt-8">
      <div
        class="glass glass-edge sticky top-[76px] z-20 flex items-center gap-2 overflow-x-auto rounded-full py-1 pl-1.5 pr-1 shadow-soft no-scrollbar"
      >
        <Drop label="Mọi khu vực" />
        <Drop label="Giá" />
        <Drop label="Tình trạng" count={1} />
        {phones && <Drop label="Pin trên 85%" />}
        <Drop label="Trả giá được" />
        <span class="flex-1"></span>
        <Seg items={['Phù hợp nhất', 'Mới đăng', 'Giá thấp', 'Gần nhất']} class="shrink-0 bg-ink/[.04]" name="Sắp xếp" />
      </div>
      <div class="mt-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-1">
        <h2 class="text-j-24 text-ink lg:text-j-26">{phones ? 'Máy đang bán' : 'Đang bán'}</h2>
        <span class="text-body-small text-on-surface-variant">Mọi tỉnh thành · gần thì ghi km, xa thì ghi nơi bán</span>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-4 xl:grid-cols-4">
        {items.slice(0, 4).map((it, i) => <ListingCard item={it} saved={i === 1} />)}
        {items.slice(4, 8).map((it) => <ListingCard item={it} loading="lazy" />)}
      </div>
      <div class="mt-6 flex justify-center">
        <a
          href={`${R.search}?q=${encodeURIComponent(cat.name)}`}
          class="state-layer flex h-11 items-center rounded-full border border-line bg-card px-6 text-label-large text-ink"
        >
          Xem thêm {more.toLocaleString('de-DE')} {unit}
        </a>
      </div>
    </section>
  </main>
</Layout>
