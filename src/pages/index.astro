---
// Trang chủ (K2). From expanded up a rail on the left holds the categories,
// the buyer's saved searches and lists, and how COD works; the column on the
// right greets the buyer, shows the order on its way and the deal waiting
// on them, then the feed under its tabs, and the listings like
// what they viewed last. The header carries the search field, so the page
// has no search hero.
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import ListingSkeleton from '../components/ListingSkeleton.astro';
import Photo from '../components/Photo.astro';
import Price from '../components/Price.astro';
import Seg from '../components/Seg.astro';
import HomeRail from '../components/home/HomeRail.astro';
import HomeTiles from '../components/home/HomeTiles.astro';
import Layout from '../layouts/Layout.astro';
import { unwrap } from '../lib/api/client';
import { area } from '../lib/area';
import { categories } from '../lib/catalog';
import { homeScreen } from '../lib/feed';
import { TZ } from '../lib/format';
import { R } from '../lib/routes';
import { viewer } from '../lib/session';
import { CONTENT } from '../lib/ui';

const me = viewer(Astro);
const [home, cats, watches] = await Promise.all([
  homeScreen(Astro),
  categories().catch(() => []),
  // The rail's saved searches are extra: without them the rail shows the rest.
  me ? unwrap(Astro.locals.api.GET('/v1/search/watches')).then((w) => w.items).catch(() => []) : null,
]);
const counts = new Map(home.categories.map((c) => [c.code, c.count]));
const rail = cats.map((c) => ({ code: c.code, name: c.name, icon: c.icon, count: counts.get(c.code) ?? 0 }));
const place = area(Astro.cookies);
const now = new Date();
const hour = +now.toLocaleString('en-US', { hour: 'numeric', hour12: false, timeZone: TZ });
const part = hour < 11 ? 'Sáng' : hour < 18 ? 'Chiều' : 'Tối';
const day = now.toLocaleDateString('vi-VN', { weekday: 'long', day: 'numeric', month: 'numeric', timeZone: TZ });
const tabs = [me ? 'Dành cho bạn' : 'Gợi ý', 'Gần bạn', 'Mới nhất'];
---

<Layout title="ShopNexus · Đồ cũ giá tốt" description="Đồ cũ giá tốt, xem hàng rồi mới trả." section="explore">
  <div class:list={[CONTENT, 'grid gap-10 pt-6 lg:grid-cols-[224px_minmax(0,1fr)]']}>
    <HomeRail categories={rail} watches={me ? watches!.map((w) => ({ id: w.id, query: w.query, fresh: w.new_count })) : null} />
    <main class="min-w-0">
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
        <div>
          <p class="text-body-small text-faint first-letter:uppercase">{part} {day}</p>
          <h1 class="mt-1 text-j-24 text-ink lg:text-j-28">{me ? `Chào ${me.name.split(' ').pop()}` : 'Đồ cũ quanh bạn'}</h1>
        </div>
        {place && <p class="text-body-large text-sub">Quanh {place.name}</p>}
      </div>

      {me && <HomeTiles />}

      <nav class="no-scrollbar -mx-4 mt-5 flex gap-2 overflow-x-auto px-4 lg:hidden" aria-label="Danh mục">
        {
          rail.map((c) => (
            <a href={R.category(c.code)} class="flex h-9 shrink-0 items-center gap-1.5 rounded-control border border-line bg-card px-3 text-body-large text-ink">
              <Icon name={c.icon} size={16} class="text-sub" />
              {c.name}
            </a>
          ))
        }
      </nav>

      <section class="mt-9" data-feed>
        <div class="flex items-center justify-between border-b border-line">
          <Seg items={tabs} variant="tabs" name="Bảng tin" />
        </div>
        <div class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-4 xl:grid-cols-4" aria-live="polite" data-feed-grid>
          {home.forYou.map((it, i) => <ListingCard item={it} loading={i < 8 ? 'eager' : 'lazy'} />)}
        </div>
        <div class="mt-8 flex justify-center">
          <a
            href={R.search}
            class="state-layer flex h-10 items-center gap-1.5 rounded-control border border-field bg-card px-5 text-title-small text-ink hover:bg-page"
            hidden
            data-feed-more
          >
            Xem thêm tin
            <Icon name="keyboard-arrow-down-rounded" size={17} />
          </a>
        </div>
        <template data-feed-skeleton><ListingSkeleton /></template>
      </section>

      {
        home.viewed && (
          <section class="mt-14">
            <h2 class="text-j-16 text-ink">Vì bạn đã xem {home.viewed.category}</h2>
            <div class="no-scrollbar mt-4 flex gap-4 overflow-x-auto">
              {home.viewed.items.map((it) => (
                <a href={R.listing(it.id)} class="w-[132px] shrink-0">
                  <span class="block aspect-square w-full overflow-hidden rounded-tile bg-soft">
                    {it.photo && <Photo src={it.photo} width={264} height={264} alt="" loading="lazy" class="h-full w-full object-cover" />}
                  </span>
                  <Price vnd={it.price} size="text-j-15" class="mt-1.5 block" />
                  <span class="block truncate text-body-small text-sub">{it.title}</span>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </main>
  </div>
</Layout>

<script>
  import { R } from '../lib/routes';
  import { FEED_PAGE, FEED_TABS } from '../lib/feed-tabs';
  import { locate } from '../lib/locate';

  // The tabs and "Xem thêm tin" fetch pages of cards from /bang-tin, passing
  // the last page's cursor. While a page is on its way, skeleton cards hold
  // its place: from 80 ms on, and once shown for at least 350 ms, so a fast
  // answer does not flash them. Gần bạn's ask for the place asks the browser,
  // then loads the tab again.
  const root = document.querySelector<HTMLElement>('[data-feed]');
  if (root) {
    const grid = root.querySelector<HTMLElement>('[data-feed-grid]')!;
    const more = root.querySelector<HTMLAnchorElement>('[data-feed-more]')!;
    const skeleton = root.querySelector<HTMLTemplateElement>('[data-feed-skeleton]')!;
    let tab: string = FEED_TABS[0];
    let next = '';
    let run = 0;
    // Dành cho bạn is one page the server sent with Home: going back to it
    // shows those cards again instead of asking for Home once more.
    const first = [...grid.children];

    const fetchPage = async (t: string, after: string) => {
      const res = await fetch(`${R.feed}?${new URLSearchParams({ tab: t, ...(after ? { after } : {}) })}`);
      if (!res.ok) throw new Error(String(res.status));
      const holder = document.createElement('template');
      holder.innerHTML = await res.text();
      const part = holder.content.querySelector<HTMLTemplateElement>('template[data-feed-page]')!;
      return { cards: [...part.content.children] as HTMLElement[], next: part.dataset.next ?? '' };
    };
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    async function show(t: string, after: string, replace: boolean) {
      const mine = ++run;
      const bones = Array.from({ length: FEED_PAGE }, () => skeleton.content.firstElementChild!.cloneNode(true) as HTMLElement);
      let shownAt = 0;
      const timer = setTimeout(() => {
        shownAt = performance.now();
        if (replace) grid.replaceChildren(...bones);
        else grid.append(...bones);
      }, 80);
      grid.setAttribute('aria-busy', 'true');
      more.hidden = true;
      try {
        const page = await fetchPage(t, after);
        if (shownAt) await wait(Math.max(0, 350 - (performance.now() - shownAt)));
        if (mine !== run) return;
        clearTimeout(timer);
        bones.forEach((b) => b.remove());
        page.cards.forEach((c) => c.setAttribute('data-fresh', ''));
        if (replace) grid.replaceChildren(...page.cards);
        else grid.append(...page.cards);
        next = page.next;
        more.hidden = !next;
      } catch {
        clearTimeout(timer);
        bones.forEach((b) => b.remove());
        more.hidden = !next;
      } finally {
        if (mine === run) grid.removeAttribute('aria-busy');
      }
    }

    root.addEventListener('seg-change', (e) => {
      tab = FEED_TABS[(e as CustomEvent<{ index: number }>).detail.index];
      next = '';
      if (tab !== FEED_TABS[0]) return show(tab, '', true);
      run++;
      grid.replaceChildren(...first);
      more.hidden = true;
    });
    more.addEventListener('click', (e) => {
      e.preventDefault();
      show(tab, next, false);
    });
    grid.addEventListener('click', async (e) => {
      const ask = (e.target as Element).closest<HTMLButtonElement>('[data-locate]');
      if (!ask) return;
      ask.disabled = true;
      if (await locate()) show(tab, '', true);
      else {
        ask.disabled = false;
        ask.textContent = 'Chưa lấy được vị trí. Thử lại';
      }
    });
  }
</script>
