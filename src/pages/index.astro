---
// Trang chủ (K2). From expanded up a rail on the left holds the categories,
// the buyer's searches and lists, and how COD works; the column on the right
// greets the buyer, shows the two things waiting on them, then the feed under
// its tabs, and what they viewed last. Signed out the rail shows this
// browser's searches and the shortcuts what it viewed. The header carries
// the search field, so the page has no search hero.
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import ListingSkeleton from '../components/ListingSkeleton.astro';
import Photo from '../components/Photo.astro';
import Price from '../components/Price.astro';
import Seg from '../components/Seg.astro';
import HomeRail from '../components/home/HomeRail.astro';
import HomeTiles from '../components/home/HomeTiles.astro';
import Layout from '../layouts/Layout.astro';
import { ME } from '../data/common';
import { LISTINGS } from '../data/listings';
import { CATEGORY_INDEX } from '../data/public';
import { feedPage } from '../lib/feed';
import { img } from '../lib/format';
import { R } from '../lib/routes';
import { viewer } from '../lib/session';
import { CONTENT } from '../lib/ui';

const me = viewer(Astro);
const now = new Date();
const hour = +now.toLocaleString('en-US', { hour: 'numeric', hour12: false, timeZone: 'Asia/Ho_Chi_Minh' });
const part = hour < 11 ? 'Sáng' : hour < 18 ? 'Chiều' : 'Tối';
const day = now.toLocaleDateString('vi-VN', { weekday: 'long', day: 'numeric', month: 'numeric', timeZone: 'Asia/Ho_Chi_Minh' });
const feed = feedPage('cho-ban', 1);
const tabs = [me ? 'Dành cho bạn' : 'Gợi ý', 'Gần bạn', 'Mới nhất'];
const seen = [LISTINGS[7], LISTINGS[1], LISTINGS[5], LISTINGS[9], LISTINGS[3], LISTINGS[11], LISTINGS[2], LISTINGS[6]].filter(Boolean);
---

<Layout title="ShopNexus · Đồ cũ giá tốt" description="Đồ cũ giá tốt, xem hàng rồi mới trả." section="explore">
  <div class:list={[CONTENT, 'grid gap-10 pt-6 lg:grid-cols-[224px_minmax(0,1fr)]']}>
    <HomeRail signedIn={!!me} />
    <main class="min-w-0">
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
        <div>
          <p class="text-body-small text-faint first-letter:uppercase">{part} {day}</p>
          <h1 class="mt-1 text-j-24 text-ink lg:text-j-28">{me ? `Chào ${ME.name.split(' ').pop()}` : 'Đồ cũ quanh bạn'}</h1>
        </div>
        <p class="text-body-large text-sub"><b class="font-semibold text-ink tabular-nums">214</b> tin mới quanh Bình Thạnh hôm nay</p>
      </div>

      <nav class="no-scrollbar -mx-4 mt-5 flex gap-2 overflow-x-auto px-4 lg:hidden" aria-label="Danh mục">
        {
          CATEGORY_INDEX.map((c) => (
            <a href={R.category(c.slug)} class="flex h-9 shrink-0 items-center gap-1.5 rounded-control border border-line bg-card px-3 text-body-large text-ink">
              <Icon name={c.icon} size={16} class="text-sub" />
              {c.name}
            </a>
          ))
        }
      </nav>

      <HomeTiles signedIn={!!me} />

      <section class="mt-9" data-feed>
        <div class="flex items-center justify-between border-b border-line">
          <Seg items={tabs} variant="tabs" name="Bảng tin" />
          <span class="hidden pb-2 text-body-small text-faint md:block">Gần thì ghi km, xa thì ghi nơi bán</span>
        </div>
        <div class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-4 xl:grid-cols-4" aria-live="polite" data-feed-grid>
          {feed.items.map((it, i) => <ListingCard item={it} saved={!!me && i === 2} loading={i < 8 ? 'eager' : 'lazy'} sellerLoading={i < 4 ? 'eager' : 'lazy'} />)}
        </div>
        <div class="mt-8 flex justify-center">
          <a
            href={R.search}
            class="state-layer flex h-10 items-center gap-1.5 rounded-control border border-field bg-card px-5 text-title-small text-ink hover:bg-page"
            hidden={!feed.more}
            data-feed-more
          >
            Xem thêm tin
            <Icon name="keyboard-arrow-down-rounded" size={17} />
          </a>
        </div>
        <template data-feed-skeleton><ListingSkeleton /></template>
      </section>

      <section class="mt-14">
        <div class="flex items-center justify-between">
          <h2 class="text-j-16 text-ink">Bạn vừa xem</h2>
          <button type="button" class="text-body-small text-faint hover:underline">Xóa lịch sử</button>
        </div>
        <div class="no-scrollbar mt-4 flex gap-4 overflow-x-auto">
          {
            seen.map((it) => (
              <a href={R.listing(it.id)} class="w-[132px] shrink-0">
                <Photo src={img(it.photo, 264, 264)} width={264} height={264} alt="" loading="lazy" class="aspect-square w-full rounded-tile object-cover" />
                <Price vnd={it.price} size="text-j-15" class="mt-1.5 block" />
                <span class="block truncate text-body-small text-sub">{it.title}</span>
              </a>
            ))
          }
        </div>
      </section>
    </main>
  </div>
</Layout>

<script>
  import { R } from '../lib/routes';
  import { FEED_PAGE, FEED_TABS } from '../lib/feed-tabs';

  // The tabs and "Xem thêm tin" fetch pages of cards from /bang-tin. While a
  // page is on its way, skeleton cards hold its place: from 80 ms on, and once
  // shown for at least 350 ms, so a fast answer does not flash them.
  const root = document.querySelector<HTMLElement>('[data-feed]');
  if (root) {
    const grid = root.querySelector<HTMLElement>('[data-feed-grid]')!;
    const more = root.querySelector<HTMLAnchorElement>('[data-feed-more]')!;
    const skeleton = root.querySelector<HTMLTemplateElement>('[data-feed-skeleton]')!;
    let tab: string = FEED_TABS[0];
    let page = 1;
    let run = 0;

    const fetchPage = async (t: string, p: number) => {
      const res = await fetch(`${R.feed}?tab=${t}&trang=${p}`);
      const holder = document.createElement('template');
      holder.innerHTML = await res.text();
      const part = holder.content.querySelector<HTMLTemplateElement>('template[data-feed-page]')!;
      return { cards: [...part.content.children] as HTMLElement[], more: part.dataset.more === 'true' };
    };
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    async function show(t: string, p: number, replace: boolean) {
      const mine = ++run;
      const bones = Array.from({ length: FEED_PAGE }, () => skeleton.content.firstElementChild!.cloneNode(true) as HTMLElement);
      let shownAt = 0;
      const timer = setTimeout(() => {
        shownAt = performance.now();
        if (replace) grid.replaceChildren(...bones);
        else grid.append(...bones);
      }, 80);
      grid.setAttribute('aria-busy', 'true');
      more.hidden = true;
      try {
        const next = await fetchPage(t, p);
        if (shownAt) await wait(Math.max(0, 350 - (performance.now() - shownAt)));
        if (mine !== run) return;
        clearTimeout(timer);
        bones.forEach((b) => b.remove());
        next.cards.forEach((c) => c.setAttribute('data-fresh', ''));
        if (replace) grid.replaceChildren(...next.cards);
        else grid.append(...next.cards);
        more.hidden = !next.more;
      } catch {
        clearTimeout(timer);
        bones.forEach((b) => b.remove());
        more.hidden = false;
      } finally {
        if (mine === run) grid.removeAttribute('aria-busy');
      }
    }

    root.addEventListener('seg-change', (e) => {
      tab = FEED_TABS[(e as CustomEvent<{ index: number }>).detail.index];
      page = 1;
      show(tab, page, true);
    });
    more.addEventListener('click', (e) => {
      e.preventDefault();
      page += 1;
      show(tab, page, false);
    });
  }
</script>
