---
import IconSearch from '~icons/material-symbols/search-rounded';
import Layout from '../layouts/Layout.astro';
---

<Layout title="ShopNexus" description="Giá tốt, gần bạn, chốt nhanh.">
  <main class="mx-auto max-w-7xl px-4 py-16 md:px-6">
    <h1 class="text-headline-small">ShopNexus</h1>
    <p class="mt-2 text-on-surface-variant">Giá tốt, gần bạn, chốt nhanh</p>
    <label
      class="mt-8 flex h-14 max-w-xl items-center gap-3 rounded-full bg-surface-container-high px-4 text-on-surface-variant"
    >
      <IconSearch width="24" height="24" aria-hidden="true" />
      <input
        type="search"
        placeholder="Tìm trên ShopNexus"
        class="h-full flex-1 bg-transparent text-body-large text-on-surface outline-none placeholder:text-on-surface-variant"
      />
    </label>
  </main>
</Layout>
