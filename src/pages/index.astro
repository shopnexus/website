---
// Trang chủ. Signed in: the buyer's own deals (order on the way, offers,
// saved, their listings). Signed out: what this browser already knows (recent
// searches, viewed listings, the area from the IP), and signing in offered as
// a way to keep them. Neither is a pitch. One column: the search, the
// buyer's tiles, three sideways rows, then the feed.
import Carousel from '../components/Carousel.astro';
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import ListingSkeleton from '../components/ListingSkeleton.astro';
import SearchField from '../components/SearchField.astro';
import Seg from '../components/Seg.astro';
import HomeTiles from '../components/home/HomeTiles.astro';
import Layout from '../layouts/Layout.astro';
import { CATS, ME, TRENDING } from '../data/common';
import { LISTINGS } from '../data/listings';
import { feedPage } from '../lib/feed';
import { R } from '../lib/routes';
import { viewer } from '../lib/session';
import { CONTENT } from '../lib/ui';

const me = viewer(Astro);
const hour = new Date().toLocaleString('en-US', { hour: 'numeric', hour12: false, timeZone: 'Asia/Ho_Chi_Minh' });
const greeting = +hour < 11 ? 'Chào buổi sáng' : +hour < 18 ? 'Chào buổi chiều' : 'Chào buổi tối';

// Signed in: their searches, a followed one with its new listings. Signed out: this browser's.
const recent = me
  ? [
      { q: 'Sony A7 III dưới 25 triệu', icon: 'notifications-outline-rounded', more: '+2' },
      { q: 'iPhone 13 pin trên 85%', icon: 'history-rounded' },
      { q: 'xe đạp cho bé 8 tuổi', icon: 'history-rounded' },
      { q: 'sofa 3 chỗ Q.7', icon: 'history-rounded' },
    ]
  : [
      { q: 'iPhone 13 pin trên 85%', icon: 'history-rounded' },
      { q: 'sofa 3 chỗ', icon: 'history-rounded' },
      { q: 'xe đạp cho bé 8 tuổi', icon: 'history-rounded' },
    ];
// Listed within 10 km, nearest first.
const near = LISTINGS.filter((it) => it.km < 10).sort((a, b) => a.km - b.km);
const feed = feedPage('cho-ban', 1);
const tabs = me ? ['Dành cho bạn', 'Gần bạn', 'Mới nhất'] : ['Gợi ý cho bạn', 'Gần bạn', 'Mới nhất'];
---

<Layout title="ShopNexus · Đồ cũ giá tốt" description="Đồ cũ giá tốt, xem hàng rồi mới trả." section="explore">
  <main class={CONTENT}>
    <section class="mx-auto flex max-w-[820px] flex-col items-center pt-8 text-center lg:pt-14">
      {
        me ? (
          <p class="text-label-large text-on-surface-variant">
            {greeting}, {ME.name}
          </p>
        ) : (
          <p class="flex items-center gap-1 text-label-large text-on-surface-variant">
            <Icon name="location-on-outline-rounded" size={16} />
            Gần Bình Thạnh, TP.HCM
            <a href="#khu-vuc" class="ml-1 text-primary hover:underline">
              Đổi
            </a>
          </p>
        )
      }
      <h1 class="mt-1 text-j-34 text-ink lg:text-j-48">Hôm nay tìm gì?</h1>
      <SearchField large class="mt-6 w-full text-left" placeholder="Gõ như nhắn tin: laptop cho sinh viên thiết kế, dưới 8 triệu" />
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {
          recent.map((r) => (
            <a
              href={`${R.search}?q=${encodeURIComponent(r.q)}`}
              class="state-layer glass glass-edge flex h-9 items-center gap-1.5 rounded-full px-3 text-label-large text-ink"
            >
              <Icon name={r.icon} size={16} class="text-on-surface-variant" />
              {r.q}
              {r.more && (
                <span class="grid h-5 min-w-5 place-items-center rounded-full bg-tertiary px-1 text-label-small text-on-tertiary">
                  {r.more}
                </span>
              )}
            </a>
          ))
        }
      </div>
    </section>

    <HomeTiles signedIn={!!me} />

    <Carousel title="Danh mục" link="Tất cả" href={R.categories} class="mt-10" trackClass="stagger gap-2">
      {
        CATS.map((c) => (
          <a
            href={R.categories}
            class="state-layer flex h-11 items-center gap-2 rounded-full border border-line bg-card pl-1.5 pr-3 text-label-large text-ink"
          >
            <span class="grid h-8 w-8 place-items-center rounded-full bg-secondary-container text-on-secondary-container">
              <Icon name={c.icon} size={18} />
            </span>
            {c.name}
            <span class="rounded-full bg-surface-container-low px-2 py-0.5 text-label-small text-on-surface-variant tabular-nums">
              {c.count}
            </span>
          </a>
        ))
      }
    </Carousel>

    <Carousel
      title={me ? 'Vừa đăng quanh bạn' : 'Vừa đăng quanh Bình Thạnh'}
      note="Trong 10 km, gần nhất trước"
      link="Xem tất cả"
      href={`${R.search}?sap-xep=moi`}
      class="mt-10"
    >
      {/* Signed out the tiles are shorter and this row is in the first screen on a desktop. */}
      {
        near.map((it) => (
          <div class="w-[172px] md:w-[200px] lg:w-[216px]">
            <ListingCard item={it} loading={me ? 'lazy' : 'eager'} />
          </div>
        ))
      }
    </Carousel>

    <Carousel title="Đang được tìm nhiều" icon="trending-up-rounded" class="mt-10" trackClass="gap-2">
      {
        TRENDING.map((t, i) => (
          <a
            href={`${R.search}?q=${encodeURIComponent(t.q)}`}
            class="lift flex w-[220px] items-center gap-3 rounded-tile border border-line bg-card px-3 py-3"
          >
            <span
              class:list={[
                'grid h-8 w-8 shrink-0 place-items-center rounded-full text-label-large tabular-nums',
                i < 3 ? 'bg-primary text-on-primary' : 'bg-surface-container-low text-on-surface-variant',
              ]}
            >
              {i + 1}
            </span>
            <span class="min-w-0">
              <span class="block truncate text-title-small text-ink">{t.q}</span>
              <span class="block text-body-small text-on-surface-variant tabular-nums">
                {t.count} tin · giữa {t.median}
              </span>
            </span>
          </a>
        ))
      }
    </Carousel>

    <section class="mt-12" data-feed>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <Seg items={tabs} class="bg-black/5" name="Bảng tin" />
        <span class="text-body-small text-on-surface-variant">Mọi tỉnh thành · gần thì ghi km, xa thì ghi nơi bán</span>
      </div>
      <div
        class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4 lg:gap-4 xl:grid-cols-5"
        aria-live="polite"
        data-feed-grid
      >
        {feed.items.map((it, i) => <ListingCard item={it} saved={!!me && i === 2} loading="lazy" />)}
      </div>
      <div class="mt-6 flex justify-center">
        <a
          href={R.search}
          class="state-layer flex h-11 items-center gap-1.5 rounded-full border border-line bg-card px-6 text-label-large text-ink"
          hidden={!feed.more}
          data-feed-more
        >
          Xem thêm tin
          <Icon name="keyboard-arrow-down-rounded" size={18} />
        </a>
      </div>
      <template data-feed-skeleton><ListingSkeleton /></template>
    </section>
  </main>
</Layout>

<script>
  import { R } from '../lib/routes';
  import { FEED_PAGE, FEED_TABS } from '../lib/feed-tabs';

  // The tabs and "Xem thêm tin" fetch pages of cards from /bang-tin. While a
  // page is on its way, skeleton cards hold its place: from 80 ms on, and once
  // shown for at least 350 ms, so a fast answer does not flash them.
  const root = document.querySelector<HTMLElement>('[data-feed]');
  if (root) {
    const grid = root.querySelector<HTMLElement>('[data-feed-grid]')!;
    const more = root.querySelector<HTMLAnchorElement>('[data-feed-more]')!;
    const skeleton = root.querySelector<HTMLTemplateElement>('[data-feed-skeleton]')!;
    let tab: string = FEED_TABS[0];
    let page = 1;
    let run = 0;

    const fetchPage = async (t: string, p: number) => {
      const res = await fetch(`${R.feed}?tab=${t}&trang=${p}`);
      const holder = document.createElement('template');
      holder.innerHTML = await res.text();
      const part = holder.content.querySelector<HTMLTemplateElement>('template[data-feed-page]')!;
      return { cards: [...part.content.children] as HTMLElement[], more: part.dataset.more === 'true' };
    };
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    async function show(t: string, p: number, replace: boolean) {
      const mine = ++run;
      const bones = Array.from({ length: FEED_PAGE }, () => skeleton.content.firstElementChild!.cloneNode(true) as HTMLElement);
      let shownAt = 0;
      const timer = setTimeout(() => {
        shownAt = performance.now();
        if (replace) grid.replaceChildren(...bones);
        else grid.append(...bones);
      }, 80);
      grid.setAttribute('aria-busy', 'true');
      more.hidden = true;
      try {
        const next = await fetchPage(t, p);
        if (shownAt) await wait(Math.max(0, 350 - (performance.now() - shownAt)));
        if (mine !== run) return;
        clearTimeout(timer);
        bones.forEach((b) => b.remove());
        next.cards.forEach((c) => c.setAttribute('data-fresh', ''));
        if (replace) grid.replaceChildren(...next.cards);
        else grid.append(...next.cards);
        more.hidden = !next.more;
      } catch {
        clearTimeout(timer);
        bones.forEach((b) => b.remove());
        more.hidden = false;
      } finally {
        if (mine === run) grid.removeAttribute('aria-busy');
      }
    }

    root.addEventListener('seg-change', (e) => {
      tab = FEED_TABS[(e as CustomEvent<{ index: number }>).detail.index];
      page = 1;
      show(tab, page, true);
    });
    more.addEventListener('click', (e) => {
      e.preventDefault();
      page += 1;
      show(tab, page, false);
    });
  }
</script>
