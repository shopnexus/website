---
// Tìm bằng ảnh, signed in. Without ?photo= the page asks for a photo: chosen,
// taken, dropped on the page or pasted. The photo uploads from the browser
// (lib/upload.ts) and the page opens again with its upload id, which runs
// the search on the photo under the usual filters, sorts and paging.
import Icon from '../components/Icon.astro';
import SearchResults from '../components/public/SearchResults.astro';
import SearchEmpty from '../components/public/SearchEmpty.astro';
import Skeleton from '../components/Skeleton.astro';
import Layout from '../layouts/Layout.astro';
import { ApiError, unwrap } from '../lib/api/client';
import { card } from '../lib/listing';
import { R } from '../lib/routes';
import { readSearch, serverQuery } from '../lib/search';
import { requireViewer } from '../lib/session';
import { PHOTO_TYPES } from '../lib/upload';
import { CONTENT, btnCls } from '../lib/ui';

const v = requireViewer(Astro);
if (v instanceof Response) return v;

const s = { ...readSearch(Astro.url), q: '', watch: undefined };
let failed: string | undefined;
const view = s.photo
  ? await unwrap(Astro.locals.api.GET('/v1/search', { params: { query: serverQuery(s, Astro.cookies) } })).catch((e) => {
      if (!(e instanceof ApiError)) throw e;
      failed = e.code === 'search_unavailable' ? 'Chưa đọc được ảnh lúc này. Thử lại sau ít phút.' : 'Ảnh này đã hết hạn. Chọn lại ảnh nhé.';
      return null;
    })
  : null;
const items = view?.items.map(card) ?? [];
const pick = 'flex-1 cursor-pointer';
---

<Layout title="Tìm bằng ảnh · ShopNexus" description="Tìm tin giống ảnh của bạn trên ShopNexus." section="explore">
  {
    view && items.length > 0 ? (
      <SearchResults items={items} search={s} base={R.photoSearch} title="Tin giống ảnh" understood={view.understood} next={view.next_cursor} watchable={false}>
        <div class="flex items-center gap-3 rounded-card border border-line bg-card p-2" data-photo-bar>
          <span class="grid h-12 w-12 shrink-0 place-items-center overflow-hidden rounded-md bg-soft text-faint">
            <img alt="Ảnh của bạn" class="hidden h-full w-full object-cover" data-preview={s.photo} data-photo-shown />
            <Icon name="image-outline-rounded" size={20} />
          </span>
          <span class="min-w-0 flex-1 text-body-medium text-sub">Ảnh của bạn</span>
          <label class:list={[btnCls('line', 'sm'), 'cursor-pointer']}>
            <Icon name="upload-rounded" size={16} />
            Đổi ảnh
            <input type="file" accept={PHOTO_TYPES.join(',')} class="sr-only" data-photo-input />
          </label>
        </div>
      </SearchResults>
    ) : view ? (
      <SearchEmpty search={s} chips={[]} watchable={false} />
    ) : (
      <main class:list={[CONTENT, 'pt-8']}>
        <h1 class="text-j-28 text-ink lg:text-j-32">Tìm bằng ảnh</h1>
        <div class="mt-6 max-w-[640px] rounded-card border-2 border-dashed border-field bg-card p-8 text-center aria-busy:pointer-events-none" data-drop>
          <img alt="Ảnh của bạn" class="mx-auto hidden h-24 w-24 rounded-tile object-cover" data-photo-shown />
          <Icon name="photo-camera-outline-rounded" size={36} class="mx-auto text-sub" />
          <p class="mt-3 text-body-large text-ink">Kéo ảnh vào đây, hoặc dán bằng Ctrl+V</p>
          <p class="mt-1 text-body-small text-faint">JPEG, PNG hoặc WebP, tối đa 15 MB</p>
          <div class="mx-auto mt-5 flex max-w-[360px] gap-2">
            <label class:list={[btnCls('ink'), pick]}>
              <Icon name="upload-rounded" size={18} />
              Chọn ảnh
              <input type="file" accept={PHOTO_TYPES.join(',')} class="sr-only" data-photo-input />
            </label>
            <label class:list={[btnCls('line'), pick]}>
              <Icon name="photo-camera-outline-rounded" size={18} />
              Chụp
              <input type="file" accept={PHOTO_TYPES.join(',')} capture="environment" class="sr-only" data-photo-input />
            </label>
          </div>
          <p role="status" class="mt-4 min-h-5 text-body-small text-sub" data-photo-status>{failed}</p>
        </div>
        <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-4 xl:grid-cols-4" data-photo-wait data-skeleton-kind="card" data-skeleton-count="8"></div>
        <Skeleton kind="card" />
      </main>
    )
  }
</Layout>

<script>
  import { busy } from '../lib/busy';
  import { pending } from '../lib/pending';
  import { R, loginHref } from '../lib/routes';
  import { snack } from '../lib/snackbar';
  import { UploadError, uploadPhoto } from '../lib/upload';

  // A chosen, dropped or pasted photo uploads, then the page opens with it; meanwhile the photo
  // shows and skeletons hold the results. The preview waits in sessionStorage, since the upload
  // itself is private; a missing one leaves the icon.
  const status = document.querySelector<HTMLElement>('[data-photo-status]');
  const say = (t: string) => status && (status.textContent = t);
  const drop = document.querySelector<HTMLElement>('[data-drop]');
  const inputs = [...document.querySelectorAll<HTMLInputElement>('[data-photo-input]')];
  const labels = inputs.map((i) => i.closest('label')).filter((l) => !!l);
  const words: Record<UploadError['reason'], string> = {
    'sign-in': 'Phiên đăng nhập đã hết. Đăng nhập lại nhé.',
    type: 'Chọn ảnh JPEG, PNG hoặc WebP.',
    size: 'Ảnh lớn hơn 15 MB.',
    failed: 'Chưa tải được ảnh lên. Thử lại sau.',
  };
  let reset: (() => void) | null = null;

  // The photo in its frame, the icon beside it hidden; returns how to put them back.
  function put(img: HTMLImageElement, url: string) {
    const src = img.getAttribute('src');
    const shown = !img.classList.contains('hidden');
    const icon = img.nextElementSibling;
    img.src = url;
    img.classList.remove('hidden');
    icon?.classList.add('hidden');
    return () => {
      if (src) img.src = src;
      else img.removeAttribute('src');
      img.classList.toggle('hidden', !shown);
      icon?.classList.toggle('hidden', shown);
    };
  }

  async function send(file?: File | null) {
    if (!file || reset) return;
    say('');
    const img = document.querySelector<HTMLImageElement>('[data-photo-shown]');
    const back = img ? put(img, URL.createObjectURL(file)) : null;
    const undo = pending('[data-photo-wait],[data-grid],[data-list]');
    drop?.setAttribute('aria-busy', 'true');
    inputs.forEach((i) => (i.disabled = true));
    labels.forEach((l) => busy(l, true));
    reset = () => {
      reset = null;
      back?.();
      undo();
      drop?.removeAttribute('aria-busy');
      inputs.forEach((i) => (i.disabled = false));
      labels.forEach((l) => busy(l, false));
    };
    try {
      const id = await uploadPhoto(file);
      try {
        const url = await new Promise<string>((done) => {
          const r = new FileReader();
          r.onload = () => done(String(r.result));
          r.readAsDataURL(file);
        });
        if (url.length < 2_000_000) sessionStorage.setItem(`sn-photo-${id}`, url);
      } catch {}
      location.href = `${R.photoSearch}?photo=${id}`;
    } catch (e) {
      const reason = e instanceof UploadError ? e.reason : 'failed';
      if (reason === 'sign-in') return void (location.href = loginHref(R.photoSearch));
      reset?.();
      if (status) say(words[reason]);
      else snack({ text: words[reason], icon: 'error-outline-rounded', error: true });
    }
  }
  addEventListener('pageshow', (e) => e.persisted && reset?.());

  inputs.forEach((i) =>
    i.addEventListener('change', () => {
      send(i.files?.[0]);
      i.value = '';
    }),
  );
  if (drop) {
    drop.addEventListener('dragover', (e) => e.preventDefault());
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      send(e.dataTransfer?.files[0]);
    });
    document.addEventListener('paste', (e) => send([...(e.clipboardData?.files ?? [])][0]));
  }
  document.querySelectorAll<HTMLImageElement>('[data-preview]').forEach((img) => {
    try {
      const url = sessionStorage.getItem(`sn-photo-${img.dataset.preview}`);
      if (!url) return;
      img.src = url;
      img.classList.remove('hidden');
      img.nextElementSibling?.classList.add('hidden');
    } catch {}
  });
</script>
