---
// Tin cũ hơn: a page of older messages as thread items, for Tin nhắn to put
// above the thread. data-next on the template is the next page's cursor.
import Thread from '../../components/account/chat/Thread.astro';
import { orNull, unwrap } from '../../lib/api/client';
import { isId } from '../../lib/listing';
import { personName, thread } from '../../lib/messages';
import { requireViewer } from '../../lib/session';

export const partial = true;

const v = requireViewer(Astro);
if (v instanceof Response) return v;
const api = Astro.locals.api;
const id = Astro.url.searchParams.get('chat') ?? '';
const cursor = Astro.url.searchParams.get('cursor') ?? '';
if (!isId(id) || !isId(cursor)) return new Response(null, { status: 400 });
const chat = await orNull(api.GET('/v1/screens/chat/{conversation_id}', { params: { path: { conversation_id: id } } }));
if (!chat) return new Response(null, { status: 404 });
const page = await unwrap(api.GET('/v1/conversations/{id}/messages', { params: { path: { id }, query: { cursor, limit: 50 } } }));
const other = personName(chat.other);
---

<template data-older-page data-next={page.next_cursor ?? ''}>
  <Thread items={thread([...page.items].reverse(), chat, v.id)} me={v.id} other={other} photo={chat.other.avatar_url} />
</template>
