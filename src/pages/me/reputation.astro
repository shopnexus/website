---
// Uy tín của bạn: the figures buyers see on the seller page, the buyer's own
// record over 90 days and the caps every account has.
import Icon from '../../components/Icon.astro';
import SettingsFrame from '../../components/account/SettingsFrame.astro';
import { reputation } from '../../lib/profile';
import { group, ratingText } from '../../lib/format';
import { R } from '../../lib/routes';
import { requireViewer } from '../../lib/session';
import { LABEL, PANEL } from '../../lib/ui';

const v = requireViewer(Astro);
if (v instanceof Response) return v;

const rep = await reputation(Astro.locals);
const [rated, ratedLine] = ratingText(rep.rating);
const [buyerRated, buyerLine] = ratingText(rep.buyer_rating);
const seller: { value: string; of?: string; label: string }[] = [
  { value: rated, of: rep.rating.count ? '/5' : undefined, label: ratedLine },
  { value: group(rep.sold), label: 'đã bán' },
  { value: rep.reply ? `${rep.reply.percent}%` : '–', label: rep.reply ? 'trả lời trong 24 giờ' : 'Chưa đủ tin nhắn để tính' },
  { value: group(rep.followers), label: 'người theo dõi' },
];
const buyer = [
  { value: buyerRated, of: rep.buyer_rating.count ? '/5' : undefined, label: buyerLine },
  { value: group(rep.figures_90d.cod_orders), label: 'Đơn COD đã đặt' },
  { value: group(rep.figures_90d.failed), label: 'Đơn giao không thành' },
];
const caps = [
  { ...rep.caps.cod_orders, label: 'Đơn COD đang mở' },
  { ...rep.caps.listings, label: 'Tin đang đăng' },
];
const stat = 'flex-1 px-4 first:pl-0';
const figure = 'text-j-26 text-ink tabular-nums';
const unit = 'text-body-medium font-medium tracking-normal text-on-surface-variant';
---

<SettingsFrame title="Uy tín của bạn" page="Uy tín" meta={`Tham gia ${new Date(rep.joined_at).getFullYear()} · người mua thấy các số này trên trang của bạn`}>
  <a href={R.seller(v.id)} class:list={['lift block px-5 pb-5 pt-4 md:px-6', PANEL]}>
    <span class="flex items-center justify-between gap-3">
      <span class={LABEL}>Khi bán</span>
      <span class="flex items-center gap-1 text-label-large text-primary">Trang của bạn<Icon name="chevron-right-rounded" size={18} /></span>
    </span>
    <span class="mt-3 grid grid-cols-2 gap-y-4 md:flex md:divide-x md:divide-line">
      {
        seller.map((s) => (
          <span class="block flex-1 pr-4 md:px-5 md:first:pl-0">
            <span class:list={['block', figure]} data-count>
              {s.value}
              {s.of && <span class={unit}>{s.of}</span>}
            </span>
            <span class="block text-body-small text-on-surface-variant">{s.label}</span>
          </span>
        ))
      }
    </span>
  </a>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-[3fr_2fr]">
    <div class:list={[PANEL, 'p-5']}>
      <p class={LABEL}>Khi mua · 90 ngày</p>
      <div class="mt-3 flex divide-x divide-line">
        {
          buyer.map((r) => (
            <div class={stat}>
              <p class={figure}>
                {r.value}
                {r.of && <span class={unit}>{r.of}</span>}
              </p>
              <p class="text-body-small text-on-surface-variant">{r.label}</p>
            </div>
          ))
        }
      </div>
    </div>
    <div class:list={[PANEL, 'p-5']}>
      <p class={LABEL}>Giới hạn của bạn</p>
      <div class="mt-3 flex divide-x divide-line">
        {
          caps.map((c) => (
            <div class={stat}>
              <p class={figure}>
                {c.used}
                <span class={unit}>/{c.max}</span>
              </p>
              <p class="text-body-small text-on-surface-variant">{c.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <Fragment slot="side">
    <div class:list={[PANEL, 'p-4']}>
      <ul class="flex flex-col gap-2 text-body-small text-on-surface-variant">
        <li class="flex gap-2">
          <Icon name="bolt-rounded" size={16} class="mt-px" />Trả lời tính trên tin nhắn người khác mở về tin của bạn trong 90 ngày, từ 5 cuộc trò chuyện
        </li>
        <li class="flex gap-2">
          <Icon name="sell-outline-rounded" size={16} class="mt-px" />Tin đang đăng gồm cả tin chờ duyệt, bị ẩn, bị từ chối và tin đang giữ cho một đơn
        </li>
      </ul>
    </div>
  </Fragment>
</SettingsFrame>
