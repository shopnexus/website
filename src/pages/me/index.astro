---
// Tôi: the profile and its figures, the address book and the theme; on the
// side the profile steps left and the account links.
import AvatarZoom from '../../components/AvatarZoom.astro';
import Icon from '../../components/Icon.astro';
import Seg from '../../components/Seg.astro';
import AccountShell from '../../components/account/AccountShell.astro';
import Ring from '../../components/account/Ring.astro';
import Row from '../../components/account/Row.astro';
import { unwrap } from '../../lib/api/client';
import { group, ratingText } from '../../lib/format';
import { ADDRESS_KIND, TASK, phoneOf, reputation } from '../../lib/profile';
import { R } from '../../lib/routes';
import { requireViewer } from '../../lib/session';
import { THEMES, theme } from '../../lib/theme';
import { btnCls, LABEL, PANEL } from '../../lib/ui';

const v = requireViewer(Astro);
if (v instanceof Response) return v;

const api = Astro.locals.api;
const [profile, rep, book] = await Promise.all([
  unwrap(api.GET('/v1/screens/profile-tasks')),
  reputation(Astro.locals),
  unwrap(api.GET('/v1/addresses')),
]);
const [rated, ratedLine] = ratingText(rep.rating);
const stats: [string, string][] = [
  [rated, ratedLine],
  [group(rep.sold), 'đã bán'],
  ...(rep.reply ? [[`${rep.reply.percent}%`, 'trả lời trong 24 giờ'] as [string, string]] : []),
  [group(rep.followers), 'người theo dõi'],
];
const phone = phoneOf(profile.account.identities);
const tasks = profile.tasks;
const done = tasks.filter((t) => t.done).length;
const todo = tasks.filter((t) => !t.done);
const settings = [
  { icon: 'notifications-outline-rounded', title: 'Thông báo', href: R.notifications },
  { icon: 'military-tech-outline-rounded', title: 'Uy tín của bạn', href: R.reputation },
  { icon: 'storefront-outline-rounded', title: 'Gói người bán', href: R.plans },
  { icon: 'shield-outline-rounded', title: 'Bảo mật và xác minh', href: R.security },
  { icon: 'help-outline-rounded', title: 'Trợ giúp và an toàn', href: R.help },
];
---

<AccountShell title="Tôi · ShopNexus" active="me">
  <div class:list={[PANEL, 'p-5 md:p-6']}>
    <div class="flex flex-wrap items-center gap-5">
      <AvatarZoom name={v.name} photo={v.photo} size={88} class="ring-4 ring-card" />
      <div class="min-w-[200px] flex-1">
        <h1 class="text-j-32 text-ink">{v.name}</h1>
        <p class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-body-medium text-on-surface-variant">
          <span class="flex items-center gap-1"><Icon name="calendar-month-outline-rounded" size={15} />Tham gia {new Date(rep.joined_at).getFullYear()}</span>
          {
            phone && (
              <span class="flex items-center gap-1">
                <Icon name="verified-rounded" size={15} class="text-primary" />
                Đã xác minh số điện thoại
              </span>
            )
          }
        </p>
        {profile.account.bio && <p class="mt-2 text-body-medium text-ink">{profile.account.bio}</p>}
      </div>
      <div class="flex items-center gap-2 max-md:w-full md:self-start">
        <a href={R.seller(v.id)} class={btnCls('line', 'lg')}>Trang của bạn</a>
        <a href={R.profileTasks} class={btnCls('ghost', 'lg')}>Sửa hồ sơ</a>
      </div>
    </div>
    <div class="mt-5 grid grid-cols-2 gap-y-4 border-t border-line pt-4 md:flex md:divide-x md:divide-line">
      {
        stats.map(([value, label]) => (
          <div class="flex-1 pr-4 md:px-5 md:first:pl-0">
            <p class="text-j-26 tabular-nums text-ink" data-count>{value}</p>
            <p class="text-body-small text-on-surface-variant">{label}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div class:list={[PANEL, 'p-4']}>
      <p class={LABEL}>Địa chỉ của tôi</p>
      <div class="mt-1 flex flex-col">
        {
          book.items.map((a) => (
            <Row icon={ADDRESS_KIND[a.kind].icon} sub={`${a.street} · ${a.commune}`} href={R.addresses} class="-mx-2">
              <Fragment slot="title">
                {ADDRESS_KIND[a.kind].label}
                {a.is_default && <span class="ml-1 rounded-full bg-secondary-container px-2 text-label-medium text-on-secondary-container">Mặc định</span>}
              </Fragment>
            </Row>
          ))
        }
        <Row icon="add-rounded" title="Thêm địa chỉ" href={`${R.addresses}?new`} tone="bg-primary/10 text-primary" chevron={false} class="-mx-2" />
      </div>
    </div>
    <div class:list={[PANEL, 'p-4']}>
      <p class={LABEL}>Giao diện</p>
      <p class="mt-3 px-1 text-body-large text-ink">Giao diện tối</p>
      <div class="mt-2">
        <Seg items={THEMES} selected={['light', 'dark'].indexOf(theme(Astro) ?? '') + 1} class="bg-surface-container-low" itemClass="text-label-medium" name="Giao diện tối" />
      </div>
    </div>
  </div>

  <Fragment slot="side">
    <a href={R.profileTasks} class:list={['lift block p-4', PANEL]}>
      <span class="flex items-center gap-3">
        <Ring done={done} total={tasks.length} />
        <span class="flex-1">
          <span class="block text-title-medium font-semibold text-ink">Hoàn thiện hồ sơ</span>
          <span class="block text-body-small text-on-surface-variant">{todo.length ? `Còn ${todo.length} bước` : 'Đã đủ các bước'}</span>
        </span>
        <Icon name="chevron-right-rounded" size={20} class="text-on-surface-variant" />
      </span>
      {
        todo.length > 0 && (
          <span class="mt-3 flex flex-wrap gap-1.5">
            {todo.map((t) => (
              <span class="flex items-center gap-1 rounded-full bg-surface-container-low px-2.5 py-1 text-label-medium text-on-surface-variant">
                <Icon name={TASK[t.key].icon} size={14} />
                {TASK[t.key].title}
              </span>
            ))}
          </span>
        )
      }
    </a>

    <div class:list={[PANEL, 'p-4']}>
      <p class={LABEL}>Tài khoản</p>
      <div class="mt-1 flex flex-col">
        {settings.map((s) => <Row icon={s.icon} title={s.title} href={s.href} class="-mx-2" />)}
      </div>
      <form method="post" action={R.logout} class="-mx-2 mt-1">
        <button type="submit" class="state-layer flex w-full items-center gap-3 rounded-field px-2 py-2 text-body-large text-error">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-error/10"><Icon name="logout-rounded" size={20} /></span>
          Đăng xuất
        </button>
      </form>
    </div>
  </Fragment>
</AccountShell>

<script>
  import { setTheme } from '../../lib/theme';

  // "Giao diện tối" sets the theme and keeps it in a cookie.
  document
    .querySelector('[aria-label="Giao diện tối"]')
    ?.addEventListener('seg-change', (e) => setTheme((e as CustomEvent<{ index: number }>).detail.index));
</script>
