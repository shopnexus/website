---
// Tin của bạn: the last seven days, then one pane, ?pane=on_sale (processing
// to reserved), drafts or sold, a page at a time (?after=). Every action is a
// form post that comes back with ?done=.
import Icon from '../../components/Icon.astro';
import Notice from '../../components/Notice.astro';
import PageTitle from '../../components/PageTitle.astro';
import Skeleton from '../../components/Skeleton.astro';
import Photo from '../../components/Photo.astro';
import MyListingRow from '../../components/account/MyListingRow.astro';
import AccountFrame from '../../components/orders/AccountFrame.astro';
import { ApiError, pageOrFirst, unwrap } from '../../lib/api/client';
import { money } from '../../lib/format';
import { isId } from '../../lib/listing';
import { reputation } from '../../lib/profile';
import { R } from '../../lib/routes';
import { requireViewer } from '../../lib/session';
import { btnCls, PANEL } from '../../lib/ui';

const v = requireViewer(Astro);
if (v instanceof Response) return v;
const api = Astro.locals.api;
const q = Astro.url.searchParams;
const PANES = { on_sale: 'Đang bán', drafts: 'Nháp', sold: 'Đã bán' } as const;
type Pane = keyof typeof PANES;
const pane: Pane = (q.get('pane') ?? '') in PANES ? (q.get('pane') as Pane) : 'on_sale';
const here = (extra = '') => `${R.myListings}?pane=${pane}${extra}`;

const DONE: Record<string, string> = {
  posted: 'Đã đăng tin.',
  saved: 'Đã lưu tin.',
  hide: 'Đã ẩn tin.',
  unhide: 'Tin đã hiện lại.',
  'mark-sold': 'Đã đánh dấu đã bán.',
  'unmark-sold': 'Tin đã quay lại Đang bán.',
  delete: 'Đã xóa tin.',
  'delete-draft': 'Đã xóa nháp.',
};

let error: string | undefined;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const step = String(form.get('step') ?? '');
  const id = String(form.get('id') ?? '');
  const path = { params: { path: { id } } };
  const calls: Record<string, () => Promise<unknown>> = {
    hide: () => unwrap(api.POST('/v1/listings/{id}/hide', path)),
    unhide: () => unwrap(api.POST('/v1/listings/{id}/unhide', path)),
    'mark-sold': () => unwrap(api.POST('/v1/listings/{id}/mark-sold', path)),
    'unmark-sold': () => unwrap(api.POST('/v1/listings/{id}/unmark-sold', path)),
    delete: () => unwrap(api.DELETE('/v1/listings/{id}', path)),
    'delete-draft': () => unwrap(api.DELETE('/v1/listing-drafts/{id}', path)),
  };
  if (isId(id) && calls[step]) {
    try {
      await calls[step]();
      return Astro.redirect(here(`&done=${step}`), 303);
    } catch (e) {
      if (!(e instanceof ApiError)) throw e;
      // Gone already (a listing, or another device's deleted draft): the list shows what is left.
      if (e.code === 'listing_not_found' || e.code === 'draft_not_found') return Astro.redirect(here(), 303);
      error =
        e.code === 'listing_held'
          ? 'ShopNexus đã ẩn tin này, chỉ ShopNexus mở lại được. Bạn gửi yêu cầu hỗ trợ nhé.'
          : e.code === 'listing_cap_reached'
            ? 'Bạn đã có đủ số tin cho phép. Xóa hoặc đánh dấu đã bán một tin khác trước.'
            : e.code === 'listing_state_conflict'
              ? 'Tin vừa đổi trạng thái nên chưa làm được. Xem lại danh sách nhé.'
              : 'Chưa làm được. Thử lại sau ít phút.';
    }
  }
}

const after = q.get('after') ?? undefined;
const screen = (p: 'on_sale' | 'sold', cursor?: string, limit = 20) =>
  api.GET('/v1/screens/my-listings', { params: { query: { pane: p, cursor, limit } } });
const [view, drafts, caps] = await Promise.all([
  pane === 'drafts' ? unwrap(screen('on_sale', undefined, 1)) : pageOrFirst(after, (c) => screen(pane, c)),
  unwrap(api.GET('/v1/listing-drafts')).then((d) => d.items),
  reputation(Astro.locals).then((r) => r.caps.listings).catch(() => null),
]);
const items = pane === 'drafts' ? [] : view.items;
const week = [
  { icon: 'visibility-outline-rounded', n: view.week.views, label: 'Lượt xem · 7 ngày' },
  { icon: 'chat-outline-rounded', n: view.week.askers, label: 'Người hỏi · 7 ngày' },
  { icon: 'favorite-outline-rounded', n: view.week.saves, label: 'Lượt lưu · 7 ngày' },
];
const daysLeft = (iso: string) => Math.max(1, Math.ceil((Date.parse(iso) - Date.now()) / 86_400_000));
const done = DONE[q.get('done') ?? ''];
const empty: Record<Pane, string> = {
  on_sale: 'Bạn chưa có tin nào đang bán.',
  drafts: 'Chưa có nháp.',
  sold: 'Chưa có tin nào đã bán.',
};
const tab = 'state-layer flex h-9 items-center rounded-full bg-surface-container-low px-4 text-label-large text-on-surface-variant aria-[current]:bg-mint aria-[current]:text-on-mint';
---

<AccountFrame title="Tin của bạn" description="Tin đang bán, nháp và tin đã bán của bạn." active="listings">
  <PageTitle title="Tin của bạn" meta={caps ? `Đang dùng ${caps.used}/${caps.max} chỗ đăng tin · ${drafts.length} nháp` : `${drafts.length} nháp`}>
    <a href={R.post} class={btnCls('ink')}><Icon name="add-photo-alternate-outline-rounded" size={18} />Đăng tin</a>
  </PageTitle>

  <div class="mt-5 grid grid-cols-3 gap-3">
    {
      week.map((s) => (
        <div class:list={[PANEL, 'flex items-center gap-3 p-3 md:p-4']}>
          <span class="hidden h-10 w-10 shrink-0 place-items-center rounded-full bg-brand text-white md:grid">
            <Icon name={s.icon} size={20} />
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-j-24 text-ink tabular-nums">{s.n}</p>
            <p class="text-body-small text-on-surface-variant">{s.label}</p>
          </div>
        </div>
      ))
    }
  </div>

  <nav class="mt-6 flex flex-wrap gap-2" aria-label="Tin của bạn">
    {
      (Object.keys(PANES) as Pane[]).map((p) => (
        <a
          href={`${R.myListings}?pane=${p}`}
          aria-current={p === pane ? 'page' : undefined}
          class={tab}
          data-pending="[data-my-listings]"
        >
          {PANES[p]}
          {p === 'drafts' && ` · ${drafts.length}`}
        </a>
      ))
    }
  </nav>

  {done && <Notice ok text={done} class="mt-4" />}
  {error && <Notice text={error} class="mt-4" />}

  <section class="mt-4 flex flex-col gap-2.5" data-my-listings data-skeleton-kind="row" data-skeleton-count="4">
    {items.map((it, i) => <MyListingRow it={it} loading={i < 6 ? 'eager' : 'lazy'} />)}
    {
      pane === 'drafts' &&
        drafts.map((d, i) => (
          <article class="flex items-center gap-4 rounded-card border border-line bg-card p-2">
            {d.photos[0] ? (
              <Photo src={d.photos[0].url} width={160} height={160} alt="" loading={i < 6 ? 'eager' : 'lazy'} class="h-16 w-16 shrink-0 rounded-lg object-cover" />
            ) : (
              <span class="grid h-16 w-16 shrink-0 place-items-center rounded-lg bg-surface-container-high text-on-surface-variant">
                <Icon name="draft-outline-rounded" size={22} />
              </span>
            )}
            <div class="min-w-0 flex-1">
              <h3 class="truncate text-title-small text-ink">{d.title || 'Chưa có tiêu đề'}</h3>
              <p class="truncate text-body-small text-on-surface-variant">
                {d.photos.length} ảnh · {d.price === null ? 'chưa có giá' : money(d.price)}
              </p>
              <p class="flex items-center gap-1 text-label-small text-on-surface-variant">
                <Icon name="schedule-outline-rounded" size={12} />
                Tự xóa sau {daysLeft(d.expires_at)} ngày
              </p>
            </div>
            <a href={`${R.post}?draft=${d.id}`} class={btnCls('tonal', 'sm')}>
              Tiếp tục
            </a>
            <form method="post">
              <input type="hidden" name="id" value={d.id} />
              <button
                name="step"
                value="delete-draft"
                class="state-layer grid h-9 w-9 place-items-center rounded-full text-on-surface-variant"
                aria-label={`Xóa nháp ${d.title}`}
                data-confirm="Xóa nháp này?"
              >
                <Icon name="delete-outline-rounded" size={20} />
              </button>
            </form>
          </article>
        ))
    }
    {
      (pane === 'drafts' ? drafts.length === 0 : items.length === 0) && (
        <div class:list={[PANEL, 'p-6 text-center']}>
          <p class="text-body-large text-on-surface-variant">{empty[pane]}</p>
          {pane !== 'sold' && (
            <a href={R.post} class:list={[btnCls('ink'), 'mx-auto mt-4 inline-flex']}>
              Đăng tin
            </a>
          )}
        </div>
      )
    }
  </section>

  {
    pane !== 'drafts' && (after || view.next_cursor) && (
      <div class="mt-4 flex justify-center gap-2">
        {after && (
          <a href={here()} class={btnCls('line')}>
            Về đầu
          </a>
        )}
        {view.next_cursor && (
          <a href={here(`&after=${view.next_cursor}`)} class={btnCls('line')} data-more="[data-my-listings]">
            Xem thêm
          </a>
        )}
      </div>
    )
  }
  <Skeleton kind="row" />
</AccountFrame>

<script>
  import '../../lib/more';
  import '../../lib/pending';

  // Deleting asks once, on rows "Xem thêm" added too.
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-confirm]');
    if (b && !confirm(b.dataset.confirm)) e.preventDefault();
  });
</script>
