---
// Địa chỉ: the address book as cards, the default first; ?new or ?edit=<id>
// opens the form under them; ?next= is the page a save goes back to. Every action
// is a form post, so the page works without script. ?new&part=1 is the new
// address form alone, for a dialog to show in place (lib/address-in-place).
import { communes, provinces } from '../../lib/regions';
import Notice from '../../components/Notice.astro';
import Icon from '../../components/Icon.astro';
import AddressForm from '../../components/account/AddressForm.astro';
import SettingsFrame from '../../components/account/SettingsFrame.astro';
import { ApiError, idempotencyKey, unwrap } from '../../lib/api/client';
import { type AddressDraft, addressRefusal, kindOf, newDraft, postedDraft, saveAddress, savedDraft } from '../../lib/addresses';
import { phoneText } from '../../lib/format';
import { ADDRESS_KIND } from '../../lib/profile';
import { R, localPath } from '../../lib/routes';
import { requireViewer } from '../../lib/session';
import { btnCls, PANEL } from '../../lib/ui';

const v = requireViewer(Astro);
if (v instanceof Response) return v;
const api = Astro.locals.api;
const part = Astro.url.searchParams.get('part') === '1';
const next = localPath(Astro.url.searchParams.get('next') ?? '', '');
const nextQ = next ? `&next=${encodeURIComponent(next)}` : '';
/** The book itself, still carrying ?next=. */
const bookHref = next ? `${R.addresses}?next=${encodeURIComponent(next)}` : R.addresses;

let error: string | undefined;
let fields: Record<string, string> = {};
let posted: AddressDraft | undefined;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const step = String(form.get('step') ?? '');
  const id = String(form.get('id') ?? '');
  try {
    if (step === 'default') {
      await unwrap(api.POST('/v1/addresses/{id}/default', { params: { path: { id } } }));
      return Astro.redirect(bookHref, 303);
    }
    if (step === 'delete') {
      await unwrap(api.DELETE('/v1/addresses/{id}', { params: { path: { id } } }));
      return Astro.redirect(bookHref, 303);
    }
    posted = postedDraft(form);
    // "Chọn" without script: the same form again, with the province's communes.
    if (step === 'save') {
      const saved = await saveAddress(api, posted, String(form.get('key') ?? ''));
      if (!next) return Astro.redirect(R.addresses, 303);
      // The page it goes back to picks the saved address.
      const back = new URL(next, Astro.url);
      back.searchParams.set('address', saved.id);
      return Astro.redirect(back.pathname + back.search, 303);
    }
  } catch (e) {
    if (e instanceof ApiError && e.code === 'address_not_found') return Astro.redirect(bookHref, 303);
    ({ error, fields } = addressRefusal(e));
  }
}

const [book, regions] = await Promise.all([unwrap(api.GET('/v1/addresses')), provinces()]);
const list = book.items;
const main = list.find((a) => a.is_default);

const editId = part ? null : Astro.url.searchParams.get('edit');
const editing = editId ? list.find((a) => a.id === editId) : undefined;
const adding = Astro.url.searchParams.has('new') || list.length === 0;
const draft = posted ?? (editing ? savedDraft(editing) : adding ? newDraft(v, list.length) : undefined);
const choices = draft?.province ? await communes(draft.province).catch(() => []) : [];
const old = draft?.id ? list.find((a) => a.id === draft.id) : undefined;
const form = draft && {
  draft,
  provinces: regions,
  communes: choices,
  title: old ? `Sửa địa chỉ ${ADDRESS_KIND[kindOf(old.kind)].label}` : 'Thêm địa chỉ',
  action: draft.id ? `${R.addresses}?edit=${draft.id}${nextQ}` : `${R.addresses}?new${nextQ}`,
  idem: idempotencyKey(),
  canDefault: !old?.is_default,
  error,
  fields,
};
---

{
  part ? (
    form && <AddressForm {...form} inDialog />
  ) : (
    <SettingsFrame title="Địa chỉ của tôi" page="Địa chỉ" meta={main ? `${list.length} địa chỉ · ${ADDRESS_KIND[kindOf(main.kind)].label} là mặc định` : 'Chưa có địa chỉ'}>
      {
        list.length > 0 && (
          <a slot="end" href={`${R.addresses}?new${nextQ}`} class={btnCls('ink')}>
            <Icon name="add-rounded" size={18} />
            Thêm địa chỉ
          </a>
        )
      }

      {
        error && !draft && (
          <Notice text={error} />
        )
      }

      {
        list.length > 0 && (
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {list.map((a) => {
              const k = ADDRESS_KIND[kindOf(a.kind)];
              return (
                <article class:list={[PANEL, 'p-4', a.id === draft?.id && 'ring-2 ring-primary/40']}>
                  <div class="flex items-start gap-3">
                    <span
                      class:list={[
                        'grid h-11 w-11 shrink-0 place-items-center rounded-full',
                        a.is_default ? 'bg-primary text-on-primary' : 'bg-surface-container-low text-on-surface-variant',
                      ]}
                    >
                      <Icon name={k.icon} size={22} />
                    </span>
                    <div class="min-w-0 flex-1">
                      <p class="flex items-center gap-2 text-title-medium font-semibold text-ink">
                        {k.label}
                        {a.is_default && <span class="rounded-full bg-secondary-container px-2 py-0.5 text-label-medium text-on-secondary-container">Mặc định</span>}
                      </p>
                      <p class="mt-1 text-body-large text-ink">{a.street}</p>
                      <p class="text-body-medium text-on-surface-variant">
                        {a.commune}, {a.province}
                      </p>
                      <p class="mt-1 text-body-small text-on-surface-variant">
                        {a.name} · {phoneText(a.phone)}
                      </p>
                    </div>
                    {!a.is_default && (
                      <form method="post" class="-mr-2 -mt-2">
                        <input type="hidden" name="id" value={a.id} />
                        <button
                          name="step"
                          value="delete"
                          class="state-layer grid h-10 w-10 place-items-center rounded-full text-on-surface-variant"
                          aria-label={`Xóa ${k.label}: ${a.street}`}
                          data-confirm="Xóa địa chỉ này?"
                        >
                          <Icon name="delete-outline-rounded" size={20} />
                        </button>
                      </form>
                    )}
                  </div>
                  <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-line pt-3">
                    <a href={`${R.addresses}?edit=${a.id}${nextQ}`} class={btnCls('line')}>
                      <Icon name="edit-outline-rounded" size={18} />
                      Sửa
                    </a>
                    {a.is_default ? (
                      <span class="px-2 text-body-small text-on-surface-variant">Đang là địa chỉ mặc định</span>
                    ) : (
                      <form method="post">
                        <input type="hidden" name="id" value={a.id} />
                        <button name="step" value="default" class={btnCls('ghost')}>
                          Đặt làm mặc định
                        </button>
                      </form>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        )
      }

      {form && <AddressForm {...form} close={list.length ? bookHref : next || undefined} />}
    </SettingsFrame>
  )
}

<script>
  // Deleting asks once.
  document.querySelectorAll<HTMLButtonElement>('[data-confirm]').forEach((b) =>
    b.addEventListener('click', (e) => {
      if (!confirm(b.dataset.confirm)) e.preventDefault();
    }),
  );
</script>
