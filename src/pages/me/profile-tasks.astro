---
// Hoàn thiện hồ sơ: the steps left and the profile itself. The name and the
// bio post with the page; the avatar uploads from the browser, then posts its
// upload id. The phone is added on Bảo mật, by a code texted to it.
import Notice from '../../components/Notice.astro';
import Avatar from '../../components/Avatar.astro';
import Field from '../../components/Field.astro';
import Icon from '../../components/Icon.astro';
import Ring from '../../components/account/Ring.astro';
import Row from '../../components/account/Row.astro';
import SettingsFrame from '../../components/account/SettingsFrame.astro';
import SideList from '../../components/account/SideList.astro';
import { ApiError, type Schemas, unwrap } from '../../lib/api/client';
import { ADDRESS_KIND, TASK, type TaskKey, phoneOf } from '../../lib/profile';
import { R } from '../../lib/routes';
import { requireViewer } from '../../lib/session';
import { btnCls, LABEL, PANEL } from '../../lib/ui';

const v = requireViewer(Astro);
if (v instanceof Response) return v;

const api = Astro.locals.api;
const NAME_MAX = 50;
const BIO_MAX = 200;

let error: string | undefined;
let fields: Record<string, string> = {};
let posted: { name: string; bio: string } | undefined;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const step = form.get('step');
  let body: Schemas['AccountUpdate'] | undefined;
  if (step === 'profile') {
    posted = { name: String(form.get('display_name') ?? ''), bio: String(form.get('bio') ?? '') };
    body = { display_name: posted.name, bio: posted.bio };
  } else if (step === 'avatar' && form.get('avatar_upload_id')) {
    body = { avatar_upload_id: String(form.get('avatar_upload_id')) };
  } else if (step === 'remove-avatar') {
    body = { avatar_upload_id: null };
  }
  if (body) {
    try {
      await unwrap(api.PATCH('/v1/accounts/me', { body }));
      return Astro.redirect(`${R.profileTasks}?saved`, 303);
    } catch (e) {
      const code = e instanceof ApiError ? e.code : '';
      if (code === 'invalid_account' && e instanceof ApiError) {
        fields = Object.fromEntries(
          Object.keys(e.fields).map((k) => [k, k === 'bio' ? `Tối đa ${BIO_MAX} ký tự.` : `Tên từ 1 đến ${NAME_MAX} ký tự.`]),
        );
      } else if (code === 'invalid_upload') error = 'Ảnh này chưa dùng được. Bạn chọn ảnh khác nhé.';
      else error = 'Chưa lưu được. Bạn thử lại sau nhé.';
    }
  }
}

const screen = await unwrap(api.GET('/v1/screens/profile-tasks'));
const { account, address, tasks } = screen;
const phone = phoneOf(account.identities);
const done = tasks.filter((t) => t.done);
const todo = tasks.filter((t) => !t.done);
const name = posted?.name ?? account.display_name;
const bio = posted?.bio ?? account.bio;

// A step not done: where it is done.
const todoHref: Record<TaskKey, string> = {
  avatar: '#avatar',
  bio: '#bio',
  address: R.addresses,
  phone: `${R.security}?add-phone`,
};
const doneSub: Record<TaskKey, string | undefined> = {
  avatar: 'Đã thêm',
  bio: 'Đã viết',
  address: address ? `${ADDRESS_KIND[address.kind].label} là mặc định · ${address.street}` : undefined,
  phone,
};
---

<SettingsFrame title="Hoàn thiện hồ sơ" page="Hoàn thiện hồ sơ" meta={`${done.length}/${tasks.length} bước đã xong`}>
  <div class:list={[PANEL, 'p-5']}>
    <div class="flex items-center gap-5">
      <Ring done={done.length} total={tasks.length} size={84} stroke={8} />
      <div class="min-w-0 flex-1">
        <p class="text-label-large text-on-surface-variant">{todo.length ? `Còn ${todo.length} bước` : 'Đã đủ các bước'}</p>
        <p class="text-j-24 text-ink md:text-j-26">Hồ sơ đủ, người mua dễ tin hơn</p>
      </div>
    </div>
  </div>

  {
    todo.length > 0 && (
      <div class:list={[PANEL, 'p-3']}>
        <p class:list={[LABEL, 'px-2 pb-1 pt-1']}>Cần làm · {todo.length}</p>
        {todo.map((t) => (
          <Row icon={TASK[t.key].icon} title={TASK[t.key].title} href={todoHref[t.key]} />
        ))}
      </div>
    )
  }

  <div class:list={[PANEL, 'p-5']}>
    <p class="text-title-medium font-semibold text-ink">Hồ sơ</p>
    {
      error && (
        <Notice text={error} class="mt-3" />
      )
    }
    <form method="post" id="avatar" class="mt-4 flex flex-wrap items-center gap-4" data-avatar-form>
      <Avatar name={v.name} photo={v.photo} size={72} />
      <input type="hidden" name="avatar_upload_id" data-avatar-id />
      <button type="submit" name="step" value="avatar" hidden data-avatar-submit>Lưu ảnh</button>
      <div class="flex flex-wrap items-center gap-2">
        <label class:list={[btnCls('tonal'), 'cursor-pointer']}>
          <Icon name="photo-camera-outline-rounded" size={18} />
          {v.photo ? 'Đổi ảnh' : 'Thêm ảnh'}
          <input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-avatar-input />
        </label>
        {
          v.photo && (
            <button type="submit" name="step" value="remove-avatar" class={btnCls('ghost')}>
              Gỡ ảnh
            </button>
          )
        }
      </div>
    </form>

    <form method="post" class="mt-5 flex flex-col gap-3">
      <input type="hidden" name="step" value="profile" />
      <div>
      <Field label="Tên hiển thị">
        <input
          name="display_name"
          value={name}
          maxlength={NAME_MAX}
          autocomplete="nickname"
          placeholder="VD: Khánh Linh"
          class="min-w-0 flex-1 bg-transparent text-body-large text-ink outline-none"
        />
      </Field>
      {fields.display_name && <p class="mt-1 px-1 text-body-small text-error">{fields.display_name}</p>}
      </div>
      <div>
        <Field label="Vài dòng về bạn" tall>
          <textarea
            id="bio"
            name="bio"
            rows="3"
            maxlength={BIO_MAX}
            placeholder="VD: hay bán đồ công nghệ đã dùng kỹ, giao trong ngày ở Bình Thạnh"
            class="min-w-0 flex-1 resize-none bg-transparent text-body-large text-ink outline-none"
            data-bio>{bio}</textarea
          >
        </Field>
        <p class="mt-1 flex gap-3 px-1 text-body-small">
          <span class="flex-1 text-error">{fields.bio}</span>
          <span class="text-on-surface-variant tabular-nums" data-bio-count>{[...bio].length}/{BIO_MAX}</span>
        </p>
      </div>
      <div class="flex justify-end">
        <button type="submit" class={btnCls('ink')}>Lưu</button>
      </div>
    </form>
  </div>

  <Fragment slot="side">
    {
      done.length > 0 && (
        <SideList title={`Đã xong · ${done.length}`}>
          {done.map((t) => (
            <Row
              icon={TASK[t.key].icon}
              title={TASK[t.key].title}
              sub={doneSub[t.key]}
              href={t.key === 'address' ? R.addresses : undefined}
              tone="bg-primary/10 text-primary"
              class="-mx-2"
            >
              <Icon slot="trail" name="check-circle-rounded" size={20} class="text-primary" />
            </Row>
          ))}
        </SideList>
      )
    }
    <a href={R.reputation} class:list={['lift flex items-center gap-3 p-4', PANEL]}>
      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-primary/10 text-primary">
        <Icon name="military-tech-outline-rounded" size={20} />
      </span>
      <span class="flex-1 text-body-medium text-ink">Uy tín của bạn</span>
      <Icon name="chevron-right-rounded" size={20} class="text-on-surface-variant" />
    </a>
  </Fragment>
</SettingsFrame>

<script>
  import { busy } from '../../lib/busy';
  import { snack } from '../../lib/snackbar';
  import { R, loginHref } from '../../lib/routes';
  import { UploadError, uploadPhoto } from '../../lib/upload';

  const bio = document.querySelector<HTMLTextAreaElement>('[data-bio]');
  const count = document.querySelector('[data-bio-count]');
  bio?.addEventListener('input', () => {
    if (count) count.textContent = `${[...bio.value].length}/${bio.maxLength}`;
  });

  // After a save the page comes back with ?saved: say so once.
  const url = new URL(location.href);
  if (url.searchParams.has('saved')) {
    snack({ text: 'Đã lưu hồ sơ' });
    url.searchParams.delete('saved');
    history.replaceState(history.state, '', url);
  }

  // A chosen photo uploads, then its upload id posts with the avatar form.
  // Its button stays busy until the page comes back.
  const form = document.querySelector<HTMLFormElement>('[data-avatar-form]');
  const input = document.querySelector<HTMLInputElement>('[data-avatar-input]');
  const words: Record<UploadError['reason'], string> = {
    'sign-in': 'Phiên đăng nhập đã hết. Đăng nhập lại nhé.',
    type: 'Chọn ảnh JPEG, PNG hoặc WebP.',
    size: 'Ảnh lớn hơn 15 MB.',
    failed: 'Chưa tải được ảnh lên. Thử lại sau.',
  };
  input?.addEventListener('change', async () => {
    const file = input.files?.[0];
    const label = input.closest('label');
    if (!file || !form || label?.getAttribute('aria-busy') === 'true') return;
    busy(label);
    try {
      form.querySelector<HTMLInputElement>('[data-avatar-id]')!.value = await uploadPhoto(file);
      form.requestSubmit(form.querySelector<HTMLButtonElement>('[data-avatar-submit]'));
    } catch (e) {
      const reason = e instanceof UploadError ? e.reason : 'failed';
      if (reason === 'sign-in') location.href = loginHref(R.profileTasks);
      else snack({ text: words[reason], error: true });
      busy(label, false);
      input.value = '';
    }
  });
</script>
