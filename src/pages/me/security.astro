---
// Bảo mật: how the account signs in, the signed-in devices and "Xóa tài khoản".
// Signing the other devices out, adding an email and deleting the account need
// a sign-in within 15 minutes; past that the server answers reauth_required,
// the page mails a code to the account's email, and the code runs the action.
// Without an email the proof is a code texted to the account's phone, and a
// Google account can prove it instead of the mailed code. Adding a phone
// proves the owner first, then texts the new number and posts its token at
// once. Firebase runs those in the browser; everything else is a form post.
import CodeBoxes from '../../components/CodeBoxes.astro';
import Notice from '../../components/Notice.astro';
import PhoneCode from '../../components/PhoneCode.astro';
import Icon from '../../components/Icon.astro';
import Row from '../../components/account/Row.astro';
import SettingsFrame from '../../components/account/SettingsFrame.astro';
import SideList from '../../components/account/SideList.astro';
import { ApiError, idempotencyKey, orNull, unwrap } from '../../lib/api/client';
import { identity } from '../../lib/profile';
import { ago, clock, date, phoneText } from '../../lib/format';
import { R } from '../../lib/routes';
import { authAge, cookie, dropTokens, renewAccess, requireViewer } from '../../lib/session';
import { type CodeFlow, codeError, dropChallenge, emailProof, type Proof, readChallenge, resendSeconds, sendEmailCode, tokenKind, tokenProof } from '../../lib/sign-in';
import { btnCls, PANEL } from '../../lib/ui';

const v = requireViewer(Astro);
if (v instanceof Response) return v;
let api = Astro.locals.api;
const { cookies, url } = Astro;

// The code that proves it is still the owner, and the code that adds an email.
const REAUTH: CodeFlow = { name: 'sn_ra', path: R.security };
const ADD_EMAIL: CodeFlow = { name: 'sn_ae', path: R.security };
const ADD = 'add-email:';
// The phone's texted step opens only with a sign-in this recent, so the server's
// 15 minutes still hold when its token comes back.
const PHONE_WINDOW = 12 * 60;
// Without an email the proof is a texted code; what it goes on to do waits here.
const REAUTH_PHONE = { name: 'sn_rp', path: R.security };
/** What a reauthentication goes on to do, for its sentence. */
const AFTER: Record<string, string> = { others: 'đăng xuất các thiết bị khác', delete: 'xóa tài khoản', email: 'thêm email', 'add-phone': 'thêm số điện thoại' };
const afterKey = (then = '') => (then.startsWith(ADD) ? 'email' : then);

const email = identity(v.identities, 'email');
const phone = identity(v.identities, 'phone');

/** The line for a failed step: `proof` is what proved the owner, `adds` what the action adds. */
const actionError = (e: unknown, proof: 'email' | 'phone' | 'google', adds: 'email' | 'phone') => {
  switch (e instanceof ApiError ? e.code : '') {
    case 'orders_open':
      return 'Bạn còn đơn đang chờ hoặc đang giao. Xóa tài khoản khi các đơn đã xong nhé.';
    case 'identity_taken':
      return adds === 'phone' ? 'Số này đã đăng nhập một tài khoản khác.' : 'Email này đã đăng nhập một tài khoản khác.';
    case 'identity_kind_taken':
      return adds === 'phone' ? 'Tài khoản đã có số điện thoại.' : 'Tài khoản đã có email.';
    case 'wrong_account':
      return proof === 'google'
        ? 'Tài khoản Google này không phải email trong tài khoản.'
        : proof === 'phone'
          ? 'Số này không phải số trong tài khoản.'
          : 'Mã này không phải của email trong tài khoản.';
    default:
      return codeError(e, 'Chưa làm được. Thử lại sau ít phút.').text;
  }
};

/** Runs `then`: signs the others out, deletes the account, opens the phone's texted step, or mails the code that adds an email. */
async function run(then: string, key: string): Promise<Response> {
  if (then === 'add-phone') {
    if (authAge(Astro.locals.session.token) > PHONE_WINDOW) throw new ApiError(428, 'reauth_required');
    return Astro.redirect(`${R.security}?add-phone`, 303);
  }
  if (then === 'others') {
    await unwrap(api.DELETE('/v1/auth/sessions/others'));
    return Astro.redirect(`${R.security}?done=others`, 303);
  }
  if (then === 'delete') {
    await unwrap(api.DELETE('/v1/accounts/me'));
    dropTokens(cookies);
    return Astro.redirect(R.home, 303);
  }
  await sendEmailCode(api, cookies, url, then.slice(ADD.length), key, { flow: ADD_EMAIL, mine: true });
  return Astro.redirect(R.security, 303);
}

/** run, and when the sign-in is too old, a code to the account's email (or its phone) first. */
async function guarded(then: string, key: string): Promise<Response> {
  try {
    return await run(then, key);
  } catch (e) {
    if (!(e instanceof ApiError && e.code === 'reauth_required')) throw e;
    if (email) await sendEmailCode(api, cookies, url, email, idempotencyKey(), { flow: REAUTH, then });
    else cookies.set(REAUTH_PHONE.name, then, cookie(url, 600, REAUTH_PHONE.path));
    return Astro.redirect(R.security, 303);
  }
}

const dropReauth = () => {
  dropChallenge(cookies, REAUTH);
  cookies.delete(REAUTH_PHONE.name, { path: REAUTH_PHONE.path });
};

/** Proves the owner again, then runs `then` with the new token for the rest of this request. */
async function reauthThen(proof: Proof, then: string, key: string): Promise<Response> {
  const t = await unwrap(api.POST('/v1/auth/sessions/current/reauthenticate', { params: { header: { 'Idempotency-Key': key } }, body: proof }));
  renewAccess(Astro, t);
  dropReauth();
  api = Astro.locals.api;
  return run(then, idempotencyKey());
}

let error: string | undefined;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const key = String(form.get('key') ?? '') || idempotencyKey();
  const step = String(form.get('step') ?? '');
  const kind = tokenKind(form.get('kind'));
  const proofKind = kind ?? 'email';
  // What the action adds, for the wording of identity errors.
  const adds = step === 'add-phone' ? 'phone' : 'email';
  try {
    switch (step) {
      case 'device': {
        await orNull(api.DELETE('/v1/auth/sessions/{id}', { params: { path: { id: String(form.get('id') ?? '') } } }), [404]);
        return Astro.redirect(`${R.security}?done=device`, 303);
      }
      case 'others':
      case 'delete':
        return await guarded(step, key);
      case 'add-email':
        return await guarded(ADD + String(form.get('email') ?? ''), key);
      case 'add-phone-start':
        return await guarded('add-phone', key);
      case 'add-phone': {
        // The token Firebase gave for the texted code, spent at once and never kept.
        const proof = tokenProof('phone', form.get('token'));
        if (!proof) throw new ApiError(400, 'needs_script');
        try {
          await unwrap(api.POST('/v1/accounts/me/identities', { params: { header: { 'Idempotency-Key': key } }, body: proof }));
        } catch (e) {
          // The sign-in aged meanwhile: prove the owner, then text the number again.
          if (e instanceof ApiError && e.code === 'reauth_required') return await guarded('add-phone', key);
          throw e;
        }
        return Astro.redirect(`${R.security}?done=phone`, 303);
      }
      case 'reauth-token': {
        // Google, or the code texted to the account's phone, in place of the mailed code.
        const then = readChallenge(cookies, REAUTH)?.then ?? cookies.get(REAUTH_PHONE.name)?.value;
        const proof = kind && tokenProof(kind, form.get('token'));
        if (then === undefined) return Astro.redirect(R.security, 303);
        if (!proof) throw new ApiError(400, 'needs_script');
        return await reauthThen(proof, then, key);
      }
      case 'reauth-code': {
        const c = readChallenge(cookies, REAUTH);
        if (!c) return Astro.redirect(R.security, 303);
        try {
          return await reauthThen(emailProof(c, form.getAll('code').join('')), c.then ?? '', key);
        } catch (e) {
          // A spent code needs a new one; a failure after the proof leaves nothing to drop.
          if (codeError(e).restart) dropChallenge(cookies, REAUTH);
          throw e;
        }
      }
      case 'reauth-resend': {
        const c = readChallenge(cookies, REAUTH);
        if (c) await sendEmailCode(api, cookies, url, c.email, key, { flow: REAUTH, then: c.then });
        return Astro.redirect(R.security, 303);
      }
      case 'reauth-cancel':
        dropReauth();
        return Astro.redirect(R.security, 303);
      case 'email-code': {
        const c = readChallenge(cookies, ADD_EMAIL);
        if (!c) return Astro.redirect(R.security, 303);
        try {
          await unwrap(api.POST('/v1/accounts/me/identities', { params: { header: { 'Idempotency-Key': key } }, body: emailProof(c, form.getAll('code').join('')) }));
        } catch (e) {
          if (e instanceof ApiError && e.code === 'reauth_required') {
            dropChallenge(cookies, ADD_EMAIL);
            return await guarded(ADD + c.email, key);
          }
          if (codeError(e).restart || (e instanceof ApiError && e.status === 409)) dropChallenge(cookies, ADD_EMAIL);
          throw e;
        }
        dropChallenge(cookies, ADD_EMAIL);
        return Astro.redirect(`${R.security}?done=email`, 303);
      }
      case 'email-resend': {
        const c = readChallenge(cookies, ADD_EMAIL);
        return c ? await guarded(ADD + c.email, key) : Astro.redirect(R.security, 303);
      }
      case 'email-cancel':
        dropChallenge(cookies, ADD_EMAIL);
        return Astro.redirect(R.security, 303);
    }
  } catch (e) {
    error =
      e instanceof ApiError && e.code === 'needs_script'
        ? 'Việc này cần bật JavaScript để nhận mã qua tin nhắn.'
        : actionError(e, proofKind, adds);
  }
}

const sessions = (await unwrap(api.GET('/v1/auth/sessions', { params: { query: { limit: 100 } } }))).items;
// One flow at a time, the first that applies: proving the owner (mailed code, or
// texted when the account has no email), the code that adds an email, the new
// email's form, or the new phone's texted step while the sign-in is recent.
const reauthMail = readChallenge(cookies, REAUTH);
const reauthText = phone ? cookies.get(REAUTH_PHONE.name)?.value : undefined;
const addCode = readChallenge(cookies, ADD_EMAIL);
const asks = (k: string) => Astro.url.searchParams.has(k);
const mode: 'reauth-email' | 'reauth-phone' | 'add-email-code' | 'add-email' | 'add-phone' | null = reauthMail
  ? 'reauth-email'
  : reauthText !== undefined
    ? 'reauth-phone'
    : addCode
      ? 'add-email-code'
      : !email && asks('add-email')
        ? 'add-email'
        : !phone && asks('add-phone') && authAge(Astro.locals.session.token) <= PHONE_WINDOW
          ? 'add-phone'
          : null;
const reauth = mode === 'reauth-email' ? reauthMail : undefined;
const confirmDelete = Astro.url.searchParams.has('confirm-delete');
const code = mode === 'reauth-email' ? reauthMail : mode === 'add-email-code' ? addCode : undefined;
const resendIn = code ? resendSeconds(code) : 0;
const DONE: Record<string, string> = { others: 'Đã đăng xuất các thiết bị khác.', device: 'Đã đăng xuất thiết bị.', email: 'Đã thêm email.', phone: 'Đã thêm số điện thoại.' };
const done = !error ? DONE[Astro.url.searchParams.get('done') ?? ''] : undefined;
const key = idempotencyKey();
const methods = [phone && 'Số điện thoại', email && 'Email'].filter(Boolean);

const line = 'flex flex-wrap items-center gap-3 py-3';
const bubble = 'grid h-10 w-10 shrink-0 place-items-center rounded-full';
const link = 'state-layer h-8 rounded-control px-2 text-label-large text-primary';
const boxes = 'max-w-[360px]';
---

<SettingsFrame title="Bảo mật" page="Bảo mật" meta="Cách đăng nhập, thiết bị và tài khoản">
  {/* One alert line, for the server's errors and the script's. */}
  <div hidden={!error} data-alert>
    <Notice text={error ?? ''} />
  </div>
  {
    done && (
      <div data-done>
        <Notice text={done} ok />
      </div>
    )
  }

  {
    mode === 'reauth-phone' && phone && (
      <section class:list={[PANEL, 'px-5 py-4']} aria-labelledby="phone-reauth-title" data-phone-flow data-number={phone} data-step="reauth-token">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="phone-reauth-title" class="text-j-20 text-ink">Xác nhận là bạn</h2>
        </div>
        <p class="mt-1 text-body-medium text-on-surface-variant">
          ShopNexus nhắn mã tới {phoneText(phone)}. Nhập mã để {AFTER[afterKey(reauthText)] ?? 'tiếp tục'}.
        </p>
        <noscript>
          <p class="mt-1 text-body-small text-on-surface-variant">Nhận mã qua tin nhắn cần bật JavaScript.</p>
        </noscript>
        <form method="post" class="mt-3" data-phone-start>
          <input type="hidden" name="key" value={key} />
          <button name="step" value="reauth-token" class={btnCls('ink', 'lg')}>
            Gửi mã
          </button>
        </form>
        <PhoneCode submitLabel="Xác nhận" />
        <form method="post" class="mt-2">
          <button name="step" value="reauth-cancel" class={link}>Hủy</button>
        </form>
      </section>
    )
  }

  {
    code && (
      <form method="post" class:list={[PANEL, 'px-5 py-4']} aria-labelledby="code-title">
        <input type="hidden" name="key" value={key} />
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="code-title" class="text-j-20 text-ink">
            {reauth ? 'Xác nhận là bạn' : 'Nhập mã 6 số'}
          </h2>
          {resendIn > 0 && (
            <span class="text-body-small text-on-surface-variant tabular-nums" data-resend={resendIn}>
              Gửi lại sau {clock(resendIn)}
            </span>
          )}
        </div>
        <p class="mt-1 text-body-medium text-on-surface-variant">
          {reauth ? `Mã đã gửi tới ${code.email}. Nhập mã để ${AFTER[afterKey(reauth.then)] ?? 'tiếp tục'}.` : `Mã đã gửi tới ${code.email}.`}
        </p>
        <div class={boxes}>
          <CodeBoxes />
        </div>
        <div class="mt-3">
          <button name="step" value={reauth ? 'reauth-code' : 'email-code'} class={btnCls('ink', 'lg')} data-code-submit>
            Xác nhận
          </button>
        </div>
        <div class="mt-2 flex flex-wrap gap-2">
          <button name="step" value={reauth ? 'reauth-resend' : 'email-resend'} formnovalidate class={link} disabled={resendIn > 0} data-resend-btn>
            Gửi lại mã
          </button>
          {reauth && (
            <button type="button" class={link} hidden data-google-reauth>
              Dùng Google
            </button>
          )}
          <button name="step" value={reauth ? 'reauth-cancel' : 'email-cancel'} formnovalidate class={link}>
            Hủy
          </button>
        </div>
      </form>
    )
  }

  <div class:list={[PANEL, 'px-5 py-4']}>
    <h2 class="text-j-20 text-ink">Đăng nhập</h2>
    <div class="mt-1">
      <div class={line}>
        <span class:list={[bubble, phone ? 'bg-primary/10 text-primary' : 'bg-surface-container-low text-on-surface-variant']}>
          <Icon name="phone-android-outline-rounded" size={20} />
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-body-large text-ink">Số điện thoại</p>
          <p class="text-body-small text-on-surface-variant">
            {phone ? `${phoneText(phone)} · người khác không thấy số này` : 'Chưa thêm · đăng tin, hỏi mua và nhắn tin cần số điện thoại'}
          </p>
        </div>
        {
          !phone && mode === null && (
            <form method="post">
              <input type="hidden" name="key" value={key} />
              <button name="step" value="add-phone-start" class={btnCls('ink')}>
                <Icon name="add-rounded" size={18} />
                Thêm
              </button>
            </form>
          )
        }
      </div>
      {
        mode === 'add-phone' && (
          <div class="pb-3" data-phone-flow data-step="add-phone">
            <form method="post" action={`${R.security}?add-phone`} class="flex flex-wrap items-end gap-2" data-phone-start>
              <input type="hidden" name="key" value={key} />
              <label class="min-w-[220px] flex-1">
                <span class="mb-1.5 block text-label-large text-on-surface-variant">Số điện thoại</span>
                <span class="flex h-12 items-center gap-2 rounded-field bg-surface-container-low pl-1.5 pr-4 focus-within:bg-card focus-within:ring-2 focus-within:ring-primary">
                  <span class="flex h-9 items-center rounded-full bg-card px-3 text-label-large text-ink">+84</span>
                  <input
                    name="phone"
                    type="tel"
                    inputmode="tel"
                    required
                    autocomplete="tel-national"
                    placeholder="912 345 678"
                    class="min-w-0 flex-1 bg-transparent text-body-large text-ink tabular-nums outline-none placeholder:text-faint"
                  />
                </span>
              </label>
              <a href={R.security} class={btnCls('line', 'lg')}>
                Hủy
              </a>
              <button name="step" value="add-phone" class={btnCls('ink', 'lg')}>
                Gửi mã
              </button>
            </form>
            <noscript>
              <p class="mt-2 text-body-small text-on-surface-variant">Nhận mã qua tin nhắn cần bật JavaScript.</p>
            </noscript>
            <PhoneCode submitLabel="Xác nhận" change>
              <a href={R.security} class:list={[link, 'inline-flex items-center']}>Hủy</a>
            </PhoneCode>
          </div>
        )
      }
      <div class:list={[line, 'border-t border-line']}>
        <span class:list={[bubble, email ? 'bg-primary/10 text-primary' : 'bg-surface-container-low text-on-surface-variant']}>
          <Icon name="mail-outline-rounded" size={20} />
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-body-large text-ink">Email</p>
          <p class="text-body-small text-on-surface-variant">{email ?? 'Chưa thêm · đăng nhập khi không có điện thoại bên cạnh'}</p>
        </div>
        {
          !email && mode === null && (
            <a href={`${R.security}?add-email`} class={btnCls('ink')}>
              <Icon name="add-rounded" size={18} />
              Thêm
            </a>
          )
        }
      </div>
      {
        mode === 'add-email' && (
          <form method="post" action={`${R.security}?add-email`} class="flex flex-wrap items-end gap-2 pb-3">
            <input type="hidden" name="key" value={key} />
            <label class="min-w-[220px] flex-1">
              <span class="mb-1.5 block text-label-large text-on-surface-variant">Email mới</span>
              <input
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="ban@email.com"
                class="h-12 w-full rounded-field bg-surface-container-low px-4 text-body-large text-ink outline-none placeholder:text-faint focus:bg-card focus:ring-2 focus:ring-primary"
              />
            </label>
            <a href={R.security} class={btnCls('line', 'lg')}>
              Hủy
            </a>
            <button name="step" value="add-email" class={btnCls('ink', 'lg')}>
              Gửi mã
            </button>
          </form>
        )
      }
    </div>
  </div>

  <div class:list={[PANEL, 'px-5 py-4']}>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-j-20 text-ink">Thiết bị đang đăng nhập · {sessions.length}</h2>
      {
        sessions.length > 1 && (
          <form method="post">
            <input type="hidden" name="key" value={key} />
            <button name="step" value="others" class={btnCls('line')}>
              <Icon name="logout-rounded" size={18} />
              Đăng xuất các thiết bị khác
            </button>
          </form>
        )
      }
    </div>
    <div class="mt-1">
      {
        sessions.map((s, i) => (
          <div class:list={[line, i > 0 && 'border-t border-line']}>
            <span class:list={[bubble, 'bg-surface-container-low text-on-surface-variant']}>
              <Icon name={/Android|iOS|app/i.test(s.device_name) ? 'phone-android-outline-rounded' : 'computer-outline-rounded'} size={20} />
            </span>
            <div class="min-w-0 flex-1">
              <p class="flex flex-wrap items-center gap-2 text-body-large text-ink">
                {s.device_name || 'Thiết bị'}
                {s.current && <span class="rounded-full bg-primary/10 px-2 py-0.5 text-label-medium text-primary">Thiết bị này</span>}
              </p>
              <p class="text-body-small text-on-surface-variant">
                {s.current ? 'Đang dùng' : `Dùng ${ago(s.last_used_at)} trước`} · đăng nhập {date(s.created_at)}
              </p>
            </div>
            {!s.current && (
              <form method="post">
                <input type="hidden" name="id" value={s.id} />
                <button name="step" value="device" class="state-layer h-9 rounded-control px-3 text-label-large text-error">
                  Đăng xuất
                </button>
              </form>
            )}
          </div>
        ))
      }
    </div>
    {
      sessions.length > 1 && (
        <p class="mt-1 flex gap-2 rounded-field bg-surface-container-low px-3 py-2.5 text-body-small text-on-surface-variant">
          <Icon name="info-outline-rounded" size={16} class="mt-px shrink-0" />
          Thiết bị này vẫn đăng nhập. Đăng nhập đã hơn 15 phút thì ShopNexus gửi mã tới {email ? 'email' : 'số điện thoại'} của bạn để xác nhận trước.
        </p>
      )
    }
  </div>

  <section id="delete" class="scroll-mt-24 rounded-panel border border-error/20 bg-error/5 p-5">
    <h2 class="flex items-center gap-2 text-title-medium font-semibold text-error">
      <Icon name="delete-forever-outline-rounded" size={20} />Xóa tài khoản
    </h2>
    <p class="mt-2 text-body-medium text-on-surface-variant">
      Tin đăng, trang, địa chỉ và cách đăng nhập của bạn được xóa ngay, và mọi thiết bị đăng xuất. Các đơn, đánh giá và tin nhắn cũ vẫn còn, ghi là tài khoản đã xóa.
    </p>
    {
      confirmDelete ? (
        <form method="post" class="mt-3 flex flex-wrap items-center gap-2">
          <input type="hidden" name="key" value={key} />
          <span class="text-body-medium text-ink">Xóa vĩnh viễn? Việc này không hoàn tác được.</span>
          <a href={R.security} class={btnCls('line')}>
            Giữ tài khoản
          </a>
          <button name="step" value="delete" class="state-layer h-10 rounded-control bg-error px-4 text-label-large text-on-error">
            Xóa vĩnh viễn
          </button>
        </form>
      ) : (
        <a href={`${R.security}?confirm-delete#delete`} class="state-layer mt-3 inline-flex h-10 items-center rounded-control border border-error/40 px-4 text-label-large text-error">
          Xóa tài khoản
        </a>
      )
    }
  </section>

  <Fragment slot="side">
    <div class:list={[PANEL, 'p-4']}>
      <div class="flex items-center gap-3">
        <span class:list={[bubble, 'bg-primary text-on-primary']}><Icon name="verified-user-outline-rounded" size={22} /></span>
        <div>
          <p class="text-title-medium font-semibold text-ink">{methods.length} cách đăng nhập</p>
          <p class="text-body-small text-on-surface-variant">{methods.join(' và ')}</p>
        </div>
      </div>
      {!phone && <p class="mt-3 text-body-small text-on-surface-variant">Đăng tin, hỏi mua và nhắn tin cần một số điện thoại đã xác minh.</p>}
    </div>
    <SideList title="Liên quan">
      <Row icon="lock-outline-rounded" title="Quyền riêng tư" sub="Người đã chặn, người khác thấy gì" href={R.privacy} class="-mx-2" />
      <Row icon="help-outline-rounded" title="Thấy đăng nhập lạ?" sub="Gửi yêu cầu hỗ trợ" href={R.support} class="-mx-2" />
    </SideList>
  </Fragment>

  <form method="post" hidden data-token-form>
    <input type="hidden" name="key" value={key} />
    <input type="hidden" name="step" />
    <input type="hidden" name="kind" />
    <input type="hidden" name="token" />
  </form>
</SettingsFrame>

<script>
  import { codeBoxes } from '../../lib/code-boxes';
  import { phoneFlow } from '../../lib/phone-flow';
  import { alertLine, googleButton, postToken, resendTimer, stepper } from '../../lib/proof-form';

  codeBoxes();
  resendTimer();

  // Adding a phone, and the proof by phone or by Google: Firebase runs in the
  // browser and the token form posts what it gave, with the flow's step.
  const tokenForm = document.querySelector<HTMLFormElement>('[data-token-form]')!;
  const say = alertLine(document.querySelector('[data-alert]'));
  const step = stepper(say);
  const google = document.querySelector<HTMLButtonElement>('[data-google-reauth]');
  if (google) googleButton(google, step, say, (token) => postToken(tokenForm, 'google', token, 'reauth-token'));
  document.querySelectorAll<HTMLElement>('[data-phone-flow]').forEach((root) =>
    phoneFlow(root, step, (token) => postToken(tokenForm, 'phone', token, root.dataset.step)),
  );
</script>
