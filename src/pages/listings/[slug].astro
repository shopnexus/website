---
// Chi tiết tin (detail-c): the gallery, price and actions, the seller with
// three of their other listings, the description, condition and specs, two
// reviews of the seller, and similar listings. A sold listing answers 410
// with what it was and listings like it; anything else not on sale is the 404.
import Ago from '../../components/Ago.astro';
import Avatar from '../../components/Avatar.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import ListingCard from '../../components/ListingCard.astro';
import PhoneBadge from '../../components/PhoneBadge.astro';
import Photo from '../../components/Photo.astro';
import Price from '../../components/Price.astro';
import BuyDialog from '../../components/public/BuyDialog.astro';
import Gallery from '../../components/public/Gallery.astro';
import ListingActions from '../../components/public/ListingActions.astro';
import ListingHead from '../../components/public/ListingHead.astro';
import NotFound from '../../components/public/NotFound.astro';
import SoldListing from '../../components/public/SoldListing.astro';
import ReviewItem from '../../components/public/ReviewItem.astro';
import QuickChat from '../../components/public/QuickChat.astro';
import ViewedMark from '../../components/public/ViewedMark.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import ShareSheet from '../../components/ShareSheet.astro';
import Layout from '../../layouts/Layout.astro';
import { orNull, unwrap } from '../../lib/api/client';
import { near } from '../../lib/area';
import { rootOf } from '../../lib/catalog';
import { REPLY_TIME, decimal, group, ratingText, where } from '../../lib/format';
import { CONDITIONS, QUESTIONS, card, conditionLabel, dealState } from '../../lib/listing';
import { R } from '../../lib/routes';
import { SHARE_IMAGE } from '../../lib/seo';
import { viewer } from '../../lib/session';
import { CONTENT, PANEL } from '../../lib/ui';

const slug = Astro.params.slug ?? '';
const api = Astro.locals.api;
// The server finds the listing by an ID or by the code that ends a slug;
// any address but the current slug moves there for good.
const screen = await orNull(api.GET('/v1/screens/listing/{id}', { params: { path: { id: slug }, query: near(Astro.cookies) } }));
if (screen && screen.listing.slug !== slug) return Astro.redirect(R.listing(screen.listing.slug) + Astro.url.search, 301);
// A sold listing is gone for good, so 410 drops it from search engines sooner than a 200
// with noindex, which they would keep crawling; people following an old link still get the page.
const sold = screen ? null : await orNull(api.GET('/v1/screens/sold-listing/{id}', { params: { path: { id: slug } } }));
if (sold && sold.listing.slug !== slug) return Astro.redirect(R.listing(sold.listing.slug) + Astro.url.search, 301);
if (!screen) Astro.response.status = sold ? 410 : 404;

const it = screen?.listing;
const id = it?.id ?? '';
const seller = screen?.seller;
const [similar, others, reviews, root] = it
  ? await Promise.all([
      unwrap(api.GET('/v1/search', { params: { query: { like: id, limit: 6, ...near(Astro.cookies) } } }))
        .then((r) => r.items.filter((s) => s.id !== id).slice(0, 5).map(card))
        .catch(() => []),
      unwrap(api.GET('/v1/sellers/{id}/listings', { params: { path: { id: it.seller_id }, query: { limit: 4, ...near(Astro.cookies) } } }))
        .then((r) => r.items.filter((o) => o.id !== it.id).slice(0, 3).map(card))
        .catch(() => []),
      unwrap(api.GET('/v1/sellers/{id}/reviews', { params: { path: { id: it.seller_id }, query: { limit: 2 } } }))
        .then((r) => r.items)
        .catch(() => []),
      rootOf(it.category_code).catch(() => undefined),
    ])
  : [[], [], [], undefined];

const me = viewer(Astro);
const { mine, reserved, offers, ordered, chat } = screen ? dealState(screen, me) : { mine: false, reserved: false, offers: false, ordered: false, chat: '' };
const condition = it ? conditionLabel(it.condition) : '';
const place = it ? where(screen!.distance_km, it.location.commune.display_name) : '';
const posted = it ? (it.published_at ?? it.created_at) : '';
const description = it?.description.split(/\n+/).filter(Boolean) ?? [];
const photos = (it?.photos ?? []).filter((p) => p.url).map((p) => ({ big: p.url!, thumb: p.url! }));
const crumbs: [string, string?][] = [['Khám phá', R.home], ...(root ? [[root.name, R.category(root.code)] as [string, string]] : []), [it?.title ?? '']];
const act = 'state-layer flex h-8 items-center gap-1.5 rounded-sm px-2.5 text-body-medium text-sub hover:bg-hover hover:text-ink';
/** What each condition on the scale means. */
const GRADE: Record<string, string> = {
  [CONDITIONS.new]: 'Chưa dùng',
  [CONDITIONS.like_new]: 'Không vết, hoặc vết rất nhỏ chỉ thấy khi soi gần',
  [CONDITIONS.used]: 'Có vết dùng, người bán ghi trong mô tả',
};
const rating = seller?.rating;
const stats: [string, string][] = seller ? [ratingText(rating!), [String(seller.sold), 'đã bán']] : [];
/** The seller's other listings on sale, for the reviews' listing links. */
const onSale = Object.fromEntries(others.map((o) => [o.id, o.slug]));
const ld = it && {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: it.title,
  image: photos[0]?.big,
  description: description.join(' '),
  offers: {
    '@type': 'Offer',
    price: it.price,
    priceCurrency: 'VND',
    availability: reserved ? 'https://schema.org/LimitedAvailability' : 'https://schema.org/InStock',
    itemCondition: it.condition === 'new' ? 'https://schema.org/NewCondition' : 'https://schema.org/UsedCondition',
    seller: { '@type': 'Person', name: seller!.display_name },
  },
};
---

{
  sold ? (
    <Layout title={`${sold.listing.title} · Đã bán · ShopNexus`} description="Món này đã bán. Xem tin tương tự còn bán." section="explore">
      <SoldListing listing={sold.listing} />
    </Layout>
  ) : !it || !seller ? (
    <Layout title="Không có tin này · ShopNexus" description="Tin có thể đã bán hoặc đã bị gỡ. Xem tin khác còn bán.">
      <NotFound />
    </Layout>
  ) : (
    <Layout
      title={`${it.title} · ShopNexus`}
      description={`${group(it.price)} ₫ · ${condition} · ${place}. Xem hàng rồi mới trả.`}
      section="explore"
      image={R.listingCard(it.id, it.updated_at)}
      imageSize={SHARE_IMAGE}
      canonical={R.listing(it.slug)}
    >
      <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
      <main class={CONTENT}>
        {Astro.locals.session.prefetch && screen!.viewer && <ViewedMark listing={it.id} />}
        <Crumbs parts={crumbs} class="pt-5">
          {!mine && (
            <button
              type="button"
              class={act}
              aria-label={screen!.viewer?.saved ? 'Bỏ lưu tin' : 'Lưu tin'}
              aria-pressed={screen!.viewer?.saved ? 'true' : 'false'}
              data-save={it.id}
            >
              <Icon name="favorite-outline-rounded" size={16} class="save-off" />
              <Icon name="favorite-rounded" size={16} class="save-on text-error" />
              <span class="max-md:sr-only">Lưu</span>
            </button>
          )}
          <button type="button" class={act} popovertarget="share">
            <Icon name="share-outline-rounded" size={16} /><span class="max-md:sr-only">Chia sẻ</span>
          </button>
        </Crumbs>
        <ShareSheet id="share" url={new URL(R.listing(it.slug), Astro.url).href} title={it.title} price={it.price} photo={photos[0]?.thumb} />

        <!-- On a phone the order is gallery, price and actions, then the rest; from
             expanded up the actions stick in the right column beside both. -->
        <div class="mt-3 grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1fr)_380px] lg:grid-rows-[auto_1fr] lg:gap-x-8">
          <div class="min-w-0 lg:col-start-1 lg:row-start-1">
            <Gallery photos={photos} title={it.title} />
          </div>
          <aside class="flex flex-col gap-4 self-start lg:sticky-fit lg:sticky lg:top-[84px] lg:-m-1 lg:p-1 lg:col-start-2 lg:row-span-2 lg:row-start-1">
            <div class:list={[PANEL, 'p-5 lg:p-6']}>
              <ListingHead condition={condition} place={place} posted={posted} title={it.title} price={it.price} drop={it.price_drop} />
              {reserved && <p class="mt-1 text-body-small text-faint">Món này đang được giao cho một người mua.</p>}
              <ListingActions screen={screen!} me={me} class="mt-5 flex flex-col gap-2" />
              {!mine && (
                <>
                  <p class="mt-5 text-body-small text-faint">Hỏi nhanh</p>
                  <div class="mt-1 flex flex-col">
                    {QUESTIONS.map((q) => (
                      <a
                        href={`${chat}&ask=${encodeURIComponent(q)}`}
                        data-quickchat={q}
                        class="state-layer -mx-2 flex h-10 items-center justify-between rounded-sm px-2 text-body-large text-ink hover:bg-hover"
                      >
                        {q}
                        <Icon name="arrow-forward-rounded" size={15} class="text-faint" />
                      </a>
                    ))}
                  </div>
                </>
              )}
            </div>

            <div class:list={[PANEL, 'p-5']}>
              <a href={R.seller(seller.id)} data-person class="state-layer -m-2 flex items-center gap-3 rounded-control p-2 hover:bg-hover">
                <Avatar name={seller.display_name} photo={seller.avatar_url} size={44} />
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-title-medium text-ink">{seller.display_name}</span>
                  <span class="flex flex-wrap items-center gap-x-1.5 text-body-small text-faint">
                    Tham gia {new Date(seller.joined_at).getFullYear()}
                    {seller.phone_verified && (
                      <>
                        <span aria-hidden="true">·</span>
                        <PhoneBadge />
                      </>
                    )}
                  </span>
                </span>
                <Icon name="chevron-right-rounded" size={20} class="text-faint" />
              </a>
              <div class="mt-4 grid grid-cols-2 divide-x divide-line rounded-control border border-line text-center">
                {stats.map(([v, l]) => (
                  <div class="py-2.5">
                    <p class="text-j-15 text-ink tabular-nums">{v}</p>
                    <p class="text-body-small text-faint">{l}</p>
                  </div>
                ))}
              </div>
              {seller.reply_time && (
                <p class="mt-3 flex items-center gap-1.5 text-body-small text-sub">
                  <Icon name="schedule-outline-rounded" size={15} class="text-primary" />
                  {REPLY_TIME[seller.reply_time]}
                </p>
              )}
              {others.length > 0 && (
                <>
                  <p class="mt-4 text-body-small text-faint">Tin khác của {seller.display_name}</p>
                  <div class="mt-2 grid grid-cols-3 gap-2">
                    {others.map((o) => (
                      <a href={R.listing(o.slug)} class="min-w-0">
                        <span class="block aspect-square w-full overflow-hidden rounded-control bg-soft">
                          {o.photo && <Photo src={o.photo} width={200} height={200} alt={o.title} class="h-full w-full object-cover" />}
                        </span>
                        <Price vnd={o.price} size="text-j-15" class="mt-1 block text-[13px]" />
                      </a>
                    ))}
                  </div>
                </>
              )}
            </div>
          </aside>
          <div class="flex min-w-0 flex-col gap-4 lg:col-start-1 lg:row-start-2">
            <section class:list={[PANEL, 'p-5 lg:p-6']}>
              <h2 class="text-j-16 text-ink">Mô tả</h2>
              <div class="mt-3 flex max-w-[680px] flex-col gap-2">
                {description.map((d) => (
                  <p class="text-j-15 font-normal leading-7 text-ink">{d}</p>
                ))}
              </div>
              <p class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-body-small text-faint">
                <span>Đăng <Ago at={posted} /></span>
                <span>{it.location.commune.display_name}, {it.location.province.display_name}</span>
              </p>
            </section>

            <section class:list={[PANEL, 'p-5 lg:p-6']}>
              <h2 class="text-j-16 text-ink">Tình trạng</h2>
              <div class="mt-3 grid grid-cols-3 gap-1 rounded-control bg-soft p-1">
                {Object.entries(GRADE).map(([g, d]) => (
                  <div class:list={['rounded-sm px-3 py-2', g === condition ? 'bg-brand text-white' : 'text-sub']}>
                    <p class="text-title-small">{g}</p>
                    <p class:list={['text-body-small max-md:hidden', g === condition && 'text-white/75']}>{d}</p>
                  </div>
                ))}
              </div>
            </section>

            {it.specs.length > 0 && (
              <section class:list={[PANEL, 'p-5 lg:p-6']}>
                <h2 class="text-j-16 text-ink">Thông số</h2>
                <dl class="mt-2 grid grid-cols-1 gap-x-10 md:grid-cols-2">
                  {it.specs.map((sp) => (
                    <div class="flex justify-between gap-4 border-b border-line py-2.5 text-body-large">
                      <dt class="text-sub">{sp.label}</dt>
                      <dd class="text-right font-medium text-ink">{sp.value}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            )}

            {reviews.length > 0 && (
              <section class:list={[PANEL, 'p-5 lg:p-6']}>
                <div class="flex items-center justify-between gap-4">
                  <h2 class="text-j-16 text-ink">Đánh giá về {seller.display_name}</h2>
                  <p class="flex items-center gap-1 text-body-large text-sub">
                    <Icon name="star-rounded" size={15} class="text-star" />
                    <b class="font-semibold text-ink">{decimal(rating!.average)}</b> · {rating!.count} đánh giá
                  </p>
                </div>
                <div class="mt-4 flex flex-col gap-4">
                  {reviews.map((r, i) => (
                    <ReviewItem review={r} subject={seller.display_name} compact onSale={onSale} class={i > 0 ? 'border-t border-line pt-4' : undefined} />
                  ))}
                </div>
              </section>
            )}
          </div>
        </div>

        {similar.length > 0 && (
          <section class="mt-10">
            <SectionTitle title="Tin tương tự" link="Xem tất cả" href={`${R.search}?q=${encodeURIComponent(it.title)}`} />
            <div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-4 xl:grid-cols-5">
              {similar.map((sm) => (
                <ListingCard item={sm} loading="lazy" />
              ))}
            </div>
          </section>
        )}
      </main>
      {me && !mine && (
        <QuickChat
          listing={it.id}
          chat={screen!.viewer?.conversation_id}
          seller={{ name: seller.display_name, photo: seller.avatar_url }}
          title={it.title}
          thumb={photos[0]?.thumb}
          price={it.price}
          offers={offers}
          questions={QUESTIONS}
          href={chat}
        />
      )}
      {me && !mine && !reserved && !ordered && <BuyDialog />}
    </Layout>
  )
}
