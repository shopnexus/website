---
// Tìm kiếm. The words and the category live in the header's field (?q=,
// ?category=); the filters, sort, chips left out and the cursor in the rest of
// the URL (lib/search.ts). A saved search (?watch=) runs as it was saved.
import AiChip from '../components/AiChip.astro';
import FilterRow from '../components/public/FilterRow.astro';
import SearchEmpty from '../components/public/SearchEmpty.astro';
import SearchResults from '../components/public/SearchResults.astro';
import Layout from '../layouts/Layout.astro';
import { orNull, unwrap } from '../lib/api/client';
import { findCategory } from '../lib/catalog';
import { card } from '../lib/listing';
import { R } from '../lib/routes';
import { readSearch, searchHref, serverQuery } from '../lib/search';
import { viewer } from '../lib/session';

const s = readSearch(Astro.url);
const api = Astro.locals.api;
const [view, watch, category] = await Promise.all([
  // A bad cursor, a watch that is gone, a price range upside down: no results.
  orNull(api.GET('/v1/search', { params: { query: serverQuery(s, Astro.cookies) } })),
  s.watch && viewer(Astro)
    ? unwrap(api.GET('/v1/search/watches')).then((r) => r.items.find((w) => w.id === s.watch))
    : undefined,
  s.category ? findCategory(s.category) : undefined,
]);
const items = view?.items.map(card) ?? [];
const q = watch?.query ?? s.q;
const title = q ? `“${q}”` : (category?.name ?? 'Tin mới đăng');
const chips = (view?.chips ?? []).map((c) => ({ id: c.id, label: c.label }));
const watchable = !!s.q && !s.watch && !s.photo && !view?.watch_id;
const full = Astro.url.searchParams.get('watches') === 'full';
---

<Layout
  title={items.length ? `${q || category?.name || 'Tìm kiếm'} · ShopNexus` : 'Không có kết quả · ShopNexus'}
  description={q ? `Tin đồ cũ khớp “${q}” trên ShopNexus.` : 'Tin đồ cũ mới đăng trên ShopNexus.'}
  section="explore"
  search={{ q, scope: category }}
>
  {
    items.length === 0 ? (
      <SearchEmpty search={s} chips={chips} watchable={watchable}>
        {chips.length > 0 && (
          <FilterRow drops={false}>
            {chips.map((c) => (
              <AiChip slot="chips" label={c.label} remove={searchHref(s, { off: [...s.off, c.id] })} />
            ))}
          </FilterRow>
        )}
      </SearchEmpty>
    ) : (
      <SearchResults
        items={items}
        search={s}
        base={R.search}
        title={title}
        understood={full ? 'Bạn đã lưu 20 tìm kiếm. Xóa bớt trong Đã lưu để lưu thêm.' : view?.understood}
        next={view?.next_cursor}
        watchable={watchable}
        filters={!s.watch}
      >
        {chips.length > 0 && (
          <FilterRow drops={false}>
            {chips.map((c) => (
              <AiChip slot="chips" label={c.label} remove={searchHref(s, { off: [...s.off, c.id] })} />
            ))}
          </FilterRow>
        )}
      </SearchResults>
    )
  }
</Layout>
