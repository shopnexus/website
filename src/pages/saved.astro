---
import Photo from '../components/Photo.astro';
// Đã lưu: saved searches with their new listings, then saved listings by
// category, with the three phones compared side by side.
import Icon from '../components/Icon.astro';
import PageTitle from '../components/PageTitle.astro';
import Switch from '../components/Switch.astro';
import AccountFrame from '../components/orders/AccountFrame.astro';
import IconBtn from '../components/orders/IconBtn.astro';
import SavedCard from '../components/orders/SavedCard.astro';
import { COMPARE, SAVED_GROUPS, SAVED_SEARCHES } from '../data/orders';
import { img } from '../lib/format';
import { R } from '../lib/routes';
import { requireViewer } from '../lib/session';
import { btnCls } from '../lib/ui';

const v = requireViewer(Astro);
if (v instanceof Response) return v;

// The first 8 cards fill the first screen; the rest load lazily.
const later = new Set(SAVED_GROUPS.flatMap((g) => g.items).slice(8));
const count = SAVED_GROUPS.reduce((n, g) => n + g.items.length, 0);
const cuts = SAVED_GROUPS.flatMap((g) => g.items).filter((it) => typeof it.change === 'object' && 'cut' in it.change).length;
// On wide windows each group spans as many of the five columns as it has cards.
const SPAN: Record<number, string> = { 2: 'xl:col-span-2', 3: 'xl:col-span-3' };
const COLS: Record<number, string> = { 2: 'xl:grid-cols-2', 3: 'xl:grid-cols-3' };
---

<AccountFrame title="Đã lưu" description="Tin và tìm kiếm bạn đã lưu." active="saved">
  <PageTitle title="Đã lưu" meta={`${count} tin · ${SAVED_SEARCHES.length} tìm kiếm · ${cuts} tin vừa giảm giá`}>
    <div class="border border-line bg-card flex items-center gap-3 rounded-full py-1.5 pl-4 pr-1.5">
      <Icon name="trending-down-rounded" size={18} class="text-primary" />
      <span class="text-label-large text-ink">Báo khi giảm giá</span>
      <Switch on label="Báo khi giảm giá" />
    </div>
  </PageTitle>

  <div class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-2">
    {
      SAVED_SEARCHES.map((s) => (
        <div class="lift relative flex items-center gap-3 rounded-card border border-line bg-card p-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-secondary-container text-on-secondary-container">
            <Icon name="search-rounded" size={20} />
          </span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-title-small text-ink">
              <a href={`${R.search}?q=${encodeURIComponent(s.q)}`} class="after:absolute after:inset-0 after:rounded-card">
                {s.q}
              </a>
            </p>
            <p class="text-body-small text-on-surface-variant">{s.where}</p>
          </div>
          {s.fresh ? (
            <span class="shrink-0 rounded-full bg-primary px-2.5 py-0.5 text-label-medium text-on-primary">{s.fresh}</span>
          ) : (
            <span class="shrink-0 text-body-small text-on-surface-variant">Chưa có tin mới</span>
          )}
          <IconBtn label="Tắt thông báo" icon="notifications-active-rounded" class="relative z-10 text-primary" />
        </div>
      ))
    }
  </div>

  <div class="mt-6 grid grid-cols-1 gap-x-3 gap-y-6 xl:grid-cols-5">
    {
      SAVED_GROUPS.map((g) => (
        <>
          <section class:list={['min-w-0', SPAN[g.items.length]]}>
            <div class="mb-2 flex h-8 items-center justify-between pl-1">
              <h2 class="text-title-small text-ink">
                {g.name} <span class="font-normal text-on-surface-variant tabular-nums">{g.items.length}</span>
              </h2>
              {g.name === 'Điện thoại' && (
                <a href="#so-sanh" class:list={[btnCls('line'), 'h-8 px-3']}>
                  <Icon name="compare-arrows-rounded" size={18} />
                  So sánh
                </a>
              )}
            </div>
            <div class:list={['grid grid-cols-2 gap-3 md:grid-cols-3', COLS[g.items.length]]}>
              {g.items.map((it) => (
                <SavedCard it={it} loading={later.has(it) ? 'lazy' : 'eager'} />
              ))}
            </div>
          </section>
          {g.name === 'Điện thoại' && (
            <section id="so-sanh" class="flex min-w-0 flex-col rounded-panel border border-line bg-card p-4 xl:col-span-2">
              <h2 class="text-title-small text-ink">So sánh 3 điện thoại</h2>
              <div class="overflow-x-auto">
                <table class="mt-2 w-full">
                  <thead>
                    <tr>
                      <th class="w-[72px]" />
                      {COMPARE.cols.map((c) => (
                        <th class="px-1 pb-1.5 text-left align-bottom font-normal">
                          <Photo src={img(c.photo, 80, 80)} width={80} height={80} alt="" class="h-7 w-7 rounded-sm object-cover" />
                          <span class="mt-1 block text-label-medium text-ink">{c.name}</span>
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {COMPARE.rows.map((label, r) => (
                      <tr class="border-t border-line">
                        <td class="py-1.5 pr-1 text-body-small text-on-surface-variant">{label}</td>
                        {COMPARE.cols.map((c, j) => (
                          <td class="px-1 py-1.5 text-body-small">
                            <span
                              class:list={[
                                'inline-flex items-center gap-1.5 whitespace-nowrap tabular-nums',
                                COMPARE.best[r] === j ? 'rounded-full bg-secondary-container px-2 text-on-secondary-container' : 'text-ink',
                              ]}
                            >
                              {c.cells[r]}
                            </span>
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="mt-3 flex items-center gap-3 rounded-tile bg-mint p-3">
                <p class="min-w-0 flex-1 text-body-small text-on-surface-variant">
                  <b class="flex items-center gap-1 text-label-large text-on-surface">
                    <Icon name="auto-awesome-rounded" size={15} class="text-primary" />
                    iPhone 13 Pro đáng tiền nhất
                  </b>
                  Pin 88%, như mới, người bán Xuất sắc.
                </p>
                <a href={R.messages} class:list={[btnCls('ink', 'sm'), 'px-3']}>
                  <Icon name="chat-outline-rounded" size={18} />
                  Nhắn
                </a>
              </div>
            </section>
          )}
        </>
      ))
    }
  </div>
</AccountFrame>
