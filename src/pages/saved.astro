---
// Đã lưu: the saved searches with their new listings and bells, then the
// saved listings, those still on sale first, a page at a time.
import Notice from '../components/Notice.astro';
import Icon from '../components/Icon.astro';
import PageTitle from '../components/PageTitle.astro';
import Skeleton from '../components/Skeleton.astro';
import AccountFrame from '../components/orders/AccountFrame.astro';
import SavedCard from '../components/orders/SavedCard.astro';
import { ApiError, pageOrFirst, type Schemas, unwrap } from '../lib/api/client';
import { categoryName } from '../lib/catalog';
import { money } from '../lib/format';
import { conditionLabel, isId, saveEnded } from '../lib/listing';
import { R } from '../lib/routes';
import { requireViewer } from '../lib/session';
import { btnCls } from '../lib/ui';

const v = requireViewer(Astro);
if (v instanceof Response) return v;
const api = Astro.locals.api;

// The forms post here: a listing's price alert, and forgetting a search.
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const act = String(f.get('do') ?? '');
  const listing = String(f.get('listing') ?? '');
  const watch = String(f.get('watch') ?? '');
  const path = { params: { path: { listing_id: listing } } };
  try {
    if (act === 'alert' && isId(listing)) {
      const below = Number(String(f.get('below') ?? '').replace(/\D/g, ''));
      await unwrap(api.PUT('/v1/saved/{listing_id}/alert', { ...path, body: { below } }));
    } else if (act === 'alert-clear' && isId(listing)) {
      await unwrap(api.DELETE('/v1/saved/{listing_id}/alert', path));
    } else if (act === 'forget' && isId(watch)) {
      await unwrap(api.DELETE('/v1/search/watches/{id}', { params: { path: { id: watch } } }));
    }
  } catch (e) {
    // A level out of range, a listing no longer on sale, or a search already gone.
    if (!(e instanceof ApiError) || ![400, 404, 409].includes(e.status)) throw e;
    return Astro.redirect(`${R.saved}?failed=${act === 'forget' ? 'forget' : 'alert'}`, 303);
  }
  return Astro.redirect(R.saved, 303);
}

// "Xem thêm" opens the next page of saves in place of the first; a broken cursor reads the first.
const after = Astro.url.searchParams.get('after') ?? undefined;
const [saved, watches] = await Promise.all([
  pageOrFirst(after, (cursor) => api.GET('/v1/saved', { params: { query: { cursor, limit: 24 } } })),
  unwrap(api.GET('/v1/search/watches')).then((r) => r.items),
]);
const failed = Astro.url.searchParams.get('failed');
// The server lists the saves on sale first; the sold and taken-down ones form a group of their own,
// which a later page's first group joins (lib/more).
const cut = saved.items.findIndex(saveEnded);
// Each group starts on a row of its own; the first two rows of four are the first screen at 1280.
const groups = [
  { key: 'on-sale', items: cut < 0 ? saved.items : saved.items.slice(0, cut), row: 0 },
  { key: 'ended', items: cut < 0 ? [] : saved.items.slice(cut), row: Math.ceil(Math.max(cut, 0) / 4) },
].filter((g) => g.items.length);

/** A watch's filters and place, as one line. */
async function filtersLine(w: Schemas['SearchWatch']) {
  const f = w.filters;
  const price =
    f.price_min !== undefined && f.price_max !== undefined
      ? `${money(f.price_min, true)} – ${money(f.price_max, true)}`
      : f.price_min !== undefined
        ? `Từ ${money(f.price_min, true)}`
        : f.price_max !== undefined
          ? `Dưới ${money(f.price_max, true)}`
          : '';
  const parts = [
    f.category ? ((await categoryName(f.category).catch(() => undefined)) ?? '') : '',
    price,
    (f.conditions ?? []).map(conditionLabel).join(', '),
    f.offers_only ? 'Trả giá được' : '',
    w.area ? `${w.area.name}${w.radius_km ? ` · ${w.radius_km} km` : ''}` : '',
  ];
  return parts.filter(Boolean).join(' · ') || 'Mọi nơi';
}
const lines = await Promise.all(watches.map(filtersLine));
const count = `${saved.items.length}${saved.next_cursor ? '+' : ''} tin`;
---

<AccountFrame title="Đã lưu" description="Tin và tìm kiếm bạn đã lưu." active="saved">
  <PageTitle title="Đã lưu" meta={after ? 'Tin đã lưu cũ hơn' : `${count} · ${watches.length} tìm kiếm`} />

  {
    failed && (
      <Notice
        text={failed === 'forget' ? 'Chưa xóa được tìm kiếm này. Tải lại trang rồi thử lại.' : 'Chưa đặt được mức báo giá. Tin có thể đã ngừng bán, hoặc mức giá chưa hợp lệ.'}
        class="mt-4"
      />
    )
  }

  {
    !after && watches.length > 0 && (
      <section class="mt-5">
        <h2 class="mb-2 pl-1 text-title-small text-ink">
          Tìm kiếm đang theo dõi <span class="font-normal text-on-surface-variant tabular-nums">{watches.length}</span>
        </h2>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          {watches.map((w, i) => (
            <div class="lift relative flex items-center gap-3 rounded-card border border-line bg-card p-3">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-secondary-container text-on-secondary-container">
                <Icon name="search-rounded" size={20} />
              </span>
              <div class="min-w-0 flex-1">
                <p class="truncate text-title-small text-ink">
                  <a href={`${R.search}?watch=${w.id}`} class="after:absolute after:inset-0 after:rounded-card">
                    {w.query}
                  </a>
                </p>
                <p class="truncate text-body-small text-on-surface-variant">{lines[i]}</p>
              </div>
              {w.new_count ? (
                <span class="shrink-0 rounded-full bg-primary px-2.5 py-0.5 text-label-medium text-on-primary tabular-nums">
                  {w.new_count >= 99 ? '99+' : w.new_count} tin mới
                </span>
              ) : (
                <span class="shrink-0 text-body-small text-on-surface-variant">Chưa có tin mới</span>
              )}
              <button
                type="button"
                class="group state-layer relative z-10 grid h-9 w-9 shrink-0 place-items-center rounded-full text-on-surface-variant aria-pressed:text-primary"
                aria-pressed={w.alert ? 'true' : 'false'}
                aria-label="Báo khi có tin mới"
                data-watch-alert={w.id}
              >
                <span class="hidden group-aria-pressed:block"><Icon name="notifications-outline-rounded" size={20} /></span>
                <span class="group-aria-pressed:hidden"><Icon name="notifications-off-outline-rounded" size={20} /></span>
              </button>
              <form method="post" class="relative z-10">
                <input type="hidden" name="watch" value={w.id} />
                <button
                  type="submit"
                  name="do"
                  value="forget"
                  class="state-layer grid h-9 w-9 shrink-0 place-items-center rounded-full text-on-surface-variant"
                  aria-label={`Bỏ theo dõi “${w.query}”`}
                >
                  <Icon name="delete-outline-rounded" size={20} />
                </button>
              </form>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    saved.items.length ? (
      <section class="mt-6">
        {!after && watches.length > 0 && <h2 class="mb-2 pl-1 text-title-small text-ink">Tin đã lưu</h2>}
        <div class="grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-4" data-saved data-skeleton-kind="card" data-skeleton-count="4">
          {groups.map(({ key, items, row }) => (
            <div class="col-span-full grid grid-cols-subgrid gap-3" data-more-key={key}>
              {key === 'ended' && (
                <h2 class="col-span-full mt-3 flex items-center gap-3 pl-1 text-title-small text-sub">
                  Không còn bán
                  <span class="h-px flex-1 bg-line" />
                </h2>
              )}
              <div class="contents" data-more-items>
                {items.map((it, i) => (
                  <SavedCard it={it} loading={row + Math.floor(i / 4) < 2 ? 'eager' : 'lazy'} />
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ) : (
      <div class="mt-6 flex flex-col items-center rounded-panel border border-line bg-card px-6 py-12 text-center">
        <span class="grid h-12 w-12 place-items-center rounded-full bg-surface-container-low text-on-surface-variant">
          <Icon name="favorite-outline-rounded" size={24} />
        </span>
        <p class="mt-3 text-title-medium text-ink">{after ? 'Không còn tin cũ hơn' : 'Chưa lưu tin nào'}</p>
        <a href={R.home} class:list={[btnCls('ink'), 'mt-4']}>Khám phá tin</a>
      </div>
    )
  }
  {
    (saved.next_cursor || after) && (
      <div class="mt-8 flex justify-center gap-2">
        {after && (
          <a href={R.saved} class={btnCls('line')}>
            Mới lưu nhất
          </a>
        )}
        {saved.next_cursor && (
          <a href={`?${new URLSearchParams({ after: saved.next_cursor })}`} class={btnCls('line')} data-more="[data-saved]">
            Xem thêm tin
            <Icon name="keyboard-arrow-down-rounded" size={17} />
          </a>
        )}
      </div>
    )
  }
  <Skeleton kind="card" />
</AccountFrame>

<script>
  import '../lib/more';
  import { API } from '../lib/routes';
  import { snack } from '../lib/snackbar';
  import { toggleRemote } from '../lib/toggle';

  // A search's bell mutes or unmutes it through /api/watches/<id>/alert; a failed call puts it back.
  document.querySelectorAll<HTMLButtonElement>('[data-watch-alert]').forEach((b) =>
    b.addEventListener('click', async () => {
      const on = b.getAttribute('aria-pressed') !== 'true';
      b.setAttribute('aria-pressed', String(on));
      if (await toggleRemote(API.watchAlert(b.dataset.watchAlert!), on)) {
        snack({ text: on ? 'Sẽ báo khi có tin mới' : 'Đã tắt thông báo tìm kiếm này' });
      } else {
        b.setAttribute('aria-pressed', String(!on));
        snack({ text: 'Chưa đổi được. Thử lại sau.', icon: 'error-outline-rounded', error: true });
      }
    }),
  );
</script>
