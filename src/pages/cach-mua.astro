---
import Photo from '../components/Photo.astro';
// Cách mua: the four deal steps, what ShopNexus does and does not do, and the
// questions buyers ask. Every money sentence is a MONEY sentence.
import artAiCamera from '@brand/art_ai_camera.webp';
import artDeal from '@brand/art_deal.webp';
import artOrders from '@brand/art_orders.webp';
import artReceived from '@brand/art_received.webp';
import artReviews from '@brand/art_reviews.webp';
import Icon from '../components/Icon.astro';
import Price from '../components/Price.astro';
import Stepper from '../components/Stepper.astro';
import Faq from '../components/flows/Faq.astro';
import Layout from '../layouts/Layout.astro';
import { MONEY } from '../data/common';
import { DEAL, FAQ, HOW_DO, HOW_DONT, SELLER } from '../data/flows';
import { crop } from '../lib/format';
import { R } from '../lib/routes';
import { btnCls, CONTENT, H2, PANEL } from '../lib/ui';

type MoneyKey = keyof typeof MONEY;
const steps: { art: ImageMetadata; title: string; text: string; keys: MoneyKey[]; extra?: 'deal' | 'stars' }[] = [
  {
    art: artDeal,
    title: 'Chốt giá',
    text: 'Tìm món gần bạn bằng một câu hoặc một tấm ảnh, rồi nhắn người bán và trả giá. Hai bên đồng ý là chốt, giá đó vào đơn.',
    keys: [],
    extra: 'deal',
  },
  {
    art: artOrders,
    title: 'Tạo đơn',
    text: 'Bạn chọn giao COD với một địa chỉ trong sổ. Người bán tạo vận đơn bằng tài khoản GHTK hoặc GHN đứng tên mình, hoặc tự gửi rồi nhập mã vận đơn.',
    keys: ['cancel'],
  },
  {
    art: artReceived,
    title: 'Nhận hàng',
    text: 'Shipper tới, bạn mở hàng và so với Tin ghi trên tin đăng, rồi bấm “Đã nhận hàng”. Hãng báo đã giao mà bạn chưa nhận, bấm “Báo chưa nhận hàng”.',
    keys: ['pay_shipper', 'refuse'],
  },
  { art: artReviews, title: 'Đánh giá', text: 'Chấm sao cho người bán. Đánh giá tính vào điểm uy tín của họ.', keys: [], extra: 'stars' },
];
const stats = [
  ['4 bước', 'chốt giá tới đánh giá'],
  ['GHTK · GHN', 'hãng của người bán'],
];
const badge = 'grid place-items-center rounded-full bg-linear-140 from-teal to-teal-light text-title-small text-white tabular-nums';
---

<Layout title="Cách mua · ShopNexus" description={MONEY.cod_buyer} section="how">
  <main class={CONTENT}>
    <section class="grid grid-cols-1 items-center gap-8 pt-8 lg:grid-cols-[1fr_440px] lg:pt-10 xl:grid-cols-[1fr_520px] xl:gap-12">
      <div class="min-w-0">
        <span class="glass glass-edge inline-flex items-center gap-2 rounded-full px-3 py-1 text-label-medium text-ink">
          <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>Cách mua trên ShopNexus
        </span>
        <h1 class="mt-4 text-j-40 text-ink md:text-j-52 xl:text-j-60">
          Xem hàng tận tay,<br />rồi mới trả tiền.
        </h1>
        <p class="mt-4 max-w-[520px] text-body-large text-on-surface-variant">{MONEY.cod_buyer}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          <a href={R.search} class={btnCls('ink', 'lg')}><Icon name="search-rounded" size={18} />Bắt đầu tìm</a>
          <a href="#faq" class={btnCls('line', 'lg')}>Câu hỏi thường gặp</a>
        </div>
        <div class="mt-8 grid max-w-[560px] grid-cols-1 gap-2 md:grid-cols-2">
          {
            stats.map(([v, l]) => (
              <div class="glass glass-edge rounded-tile px-4 py-3">
                <p class="text-j-24 text-ink tabular-nums">{v}</p>
                <p class="text-body-small text-on-surface-variant">{l}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class:list={[PANEL, 'min-w-0 p-5 shadow-soft']}>
        <div class="flex items-center gap-3">
          <Photo src={crop(DEAL.photo, 128, 0.5, 0.52, 1.25)} width={128} height={128} alt="" class="h-14 w-14 shrink-0 rounded-field object-cover" />
          <div class="min-w-0 flex-1">
            <p class="truncate text-title-small text-ink">{DEAL.title}</p>
            <p class="text-body-small text-on-surface-variant">{SELLER.name} · GHTK · S1.A1.20931</p>
          </div>
          <span class="shrink-0 rounded-full bg-secondary-container px-2.5 py-1 text-label-medium text-on-secondary-container">Đang giao</span>
        </div>
        <div class="mt-4 max-w-full overflow-x-auto no-scrollbar"><Stepper current={2} compact /></div>
        <div class="mt-4 grid grid-cols-2 gap-2">
          <div class="rounded-lg bg-surface-container-low px-4 py-3">
            <p class="text-body-small text-on-surface-variant">Tiền hàng</p>
            <p class="mt-0.5"><Price vnd={DEAL.agreed} short={false} /></p>
          </div>
          <div class="rounded-lg bg-surface-container-low px-4 py-3">
            <p class="text-body-small text-on-surface-variant">Phí ship</p>
            <p class="mt-0.5"><Price vnd={32000} /></p>
          </div>
        </div>
        <div class="mt-3 flex items-center gap-3 rounded-lg bg-peach-wash px-4 py-3">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white text-tertiary">
            <Icon name="payments-outline-rounded" size={20} />
          </span>
          <p class="text-body-medium text-on-tertiary-fixed-variant">{MONEY.pay_shipper}</p>
        </div>
        <div class="mt-3 grid grid-cols-2 gap-2">
          <a href={R.orders} class={btnCls('ink')}>Đã nhận hàng</a>
          <a href={R.support} class={btnCls('line')}>Báo chưa nhận hàng</a>
        </div>
      </div>
    </section>

    <section class="mt-10">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class={H2}>Bốn bước, từ lúc chốt giá tới lúc đánh giá</h2>
        <span class="text-body-small text-on-surface-variant">Mỗi đơn hiện đủ bốn bước</span>
      </div>
      <ol class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
        {
          steps.map((s, i) => (
            <li class:list={[PANEL, 'lift flex flex-col p-5']}>
              <div class="flex items-start justify-between">
                <span class:list={[badge, 'h-9 w-9']}>{i + 1}</span>
                <Photo src={s.art} alt="" class="-mr-1 -mt-1 h-[92px] w-[92px] object-contain" />
              </div>
              <h3 class="mt-1 text-j-20 text-ink">{s.title}</h3>
              <p class="mt-1.5 text-body-medium text-on-surface-variant">{s.text}</p>
              <div class="mt-auto flex flex-col gap-2 pt-3">
                {s.keys.map((k) => (
                  <p class="flex gap-2 rounded-field bg-surface-container-low px-3 py-2 text-body-small text-ink">
                    <Icon name="check-circle-outline-rounded" size={16} class="mt-px shrink-0 text-primary" />
                    <span>{MONEY[k]}</span>
                  </p>
                ))}
                {s.extra === 'deal' && (
                  <div class="flex items-center justify-between rounded-field bg-peach-wash px-3 py-2">
                    <span class="text-body-small text-on-surface-variant line-through">{DEAL.listed}</span>
                    <Icon name="arrow-forward-rounded" size={15} class="text-tertiary" />
                    <span class="text-title-small text-tertiary tabular-nums">5.100.000 ₫ · Đã chốt</span>
                  </div>
                )}
                {s.extra === 'stars' && (
                  <div class="flex items-center justify-between rounded-field bg-surface-container-low px-3 py-2">
                    <span class="flex text-star">
                      {[1, 2, 3, 4, 5].map(() => (
                        <Icon name="star-rounded" size={16} />
                      ))}
                    </span>
                    <span class="text-title-small text-ink tabular-nums">
                      4,9 <span class="text-body-small font-normal text-on-surface-variant">· 126 đánh giá</span>
                    </span>
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-2">
      <div class:list={[PANEL, 'p-6']}>
        <h2 class="text-j-20 text-ink">ShopNexus làm</h2>
        <ul class="mt-4 flex flex-col gap-4">
          {
            HOW_DO.map((d) => (
              <li class="flex gap-3">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-secondary-container text-on-secondary-container">
                  <Icon name={d.icon} size={20} />
                </span>
                <div>
                  <p class="text-title-small text-ink">{d.title}</p>
                  <p class="text-body-medium text-on-surface-variant">{d.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-panel bg-ink p-6">
        <h2 class="text-j-20 text-on-ink">ShopNexus không làm</h2>
        <ul class="mt-4 flex flex-col gap-4">
          {
            HOW_DONT.map((d) => (
              <li class="flex gap-3">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-on-ink/10 text-inverse-primary">
                  <Icon name={d.icon} size={20} />
                </span>
                <p class="pt-2 text-body-medium text-on-ink/85">{d.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="faq" class="mt-10 grid scroll-mt-24 grid-cols-1 gap-6 lg:grid-cols-[300px_1fr] xl:grid-cols-[340px_1fr]">
      <div class="flex flex-col gap-4">
        <h2 class={H2}>Câu hỏi thường gặp</h2>
        <p class="text-body-medium text-on-surface-variant">
          Chưa thấy câu bạn cần? Gửi yêu cầu trong Hỗ trợ, ShopNexus trả lời trong chat.
        </p>
        <div class="relative mt-auto overflow-hidden rounded-panel bg-linear-to-br from-teal to-teal-mid p-5 text-white">
          <p class="text-j-20">Có đồ cũ muốn bán?</p>
          <p class="mt-1 max-w-[200px] text-body-medium text-white/80">Tải vài tấm ảnh lên, AI điền giúp tên, tình trạng và giá.</p>
          <a
            href={R.post}
            class="state-layer mt-4 inline-flex h-10 items-center gap-1.5 rounded-full bg-white px-4 text-label-large text-primary"
          >
            <Icon name="add-rounded" size={18} />Đăng tin
          </a>
          <Photo src={artAiCamera} alt="" loading="lazy" class="absolute -bottom-3 -right-3 w-[130px]" />
        </div>
      </div>
      <div class="grid grid-cols-1 content-start gap-3 md:grid-cols-2">
        {FAQ.map(([q, a, open]) => <Faq q={q} answer={a} open={open} panel />)}
      </div>
    </section>
  </main>
</Layout>
