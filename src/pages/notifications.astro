---
// Thông báo: the server's notices by day, newest first, the unread ones
// tinted; opening one marks it read. On the side, the push settings.
import Icon from '../components/Icon.astro';
import PageTitle from '../components/PageTitle.astro';
import Switch from '../components/Switch.astro';
import AccountShell from '../components/account/AccountShell.astro';
import NoticeGroups from '../components/account/NoticeGroups.astro';
import Row from '../components/account/Row.astro';
import Skeleton from '../components/Skeleton.astro';
import { ApiError, orNull, pageOrFirst, type Schemas, unwrap } from '../lib/api/client';
import { R, localPath } from '../lib/routes';
import { requireViewer } from '../lib/session';
import { FIELD, btnCls, PANEL } from '../lib/ui';

const v = requireViewer(Astro);
if (v instanceof Response) return v;
const api = Astro.locals.api;

// The forms post here: open one notice, read all, or save the settings.
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const act = String(f.get('do') ?? '');
  if (act === 'open') {
    const id = String(f.get('id') ?? '');
    const to = String(f.get('to') ?? '');
    await orNull(api.POST('/v1/notifications/{id}/read', { params: { path: { id } } }));
    return Astro.redirect(localPath(to, R.notifications), 303);
  }
  if (act === 'read-all') {
    await unwrap(api.POST('/v1/notifications/read-all'));
    return Astro.redirect(R.notifications, 303);
  }
  if (act === 'settings') {
    const on = (k: string) => f.get(k) === 'on';
    const body: Schemas['NotificationSettings'] = {
      messages: on('messages'),
      offers: on('offers'),
      orders: on('orders'),
      price_cuts: on('price_cuts'),
      followed: on('followed'),
      reviews: on('reviews'),
      quiet: { on: on('quiet'), from: String(f.get('quiet_from') ?? ''), to: String(f.get('quiet_to') ?? '') },
    };
    try {
      await unwrap(api.PUT('/v1/me/notification-settings', { body }));
      return Astro.redirect(`${R.notifications}?settings=saved#settings`, 303);
    } catch (e) {
      if (e instanceof ApiError && e.status === 400) return Astro.redirect(`${R.notifications}?settings=bad#settings`, 303);
      throw e;
    }
  }
  return Astro.redirect(R.notifications, 303);
}

// "Xem thêm" opens the next page in place of the first; a broken cursor reads the first.
const after = Astro.url.searchParams.get('after') ?? undefined;
const [listed, settings] = await Promise.all([
  pageOrFirst(after, (cursor) => api.GET('/v1/notifications', { params: { query: { cursor, limit: 30 } } })),
  unwrap(api.GET('/v1/me/notification-settings')),
]);
const saved = Astro.url.searchParams.get('settings');

type Pref = { name: keyof Omit<Schemas['NotificationSettings'], 'quiet'>; icon: string; title: string };
const prefs: [string, Pref[]][] = [
  [
    'Giao dịch',
    [
      { name: 'messages', icon: 'chat-outline-rounded', title: 'Tin nhắn' },
      { name: 'offers', icon: 'sell-outline-rounded', title: 'Trả giá và chốt giá' },
      { name: 'orders', icon: 'local-shipping-outline-rounded', title: 'Đơn hàng và giao hàng' },
    ],
  ],
  [
    'Giá và tin mới',
    [
      { name: 'price_cuts', icon: 'trending-down-rounded', title: 'Giảm giá ở tin đã lưu' },
      { name: 'followed', icon: 'storefront-outline-rounded', title: 'Người bán bạn theo dõi' },
    ],
  ],
  ['Đánh giá', [{ name: 'reviews', icon: 'star-outline-rounded', title: 'Đánh giá và trả lời' }]],
];
const time = `h-9 px-3 text-body-medium text-ink tabular-nums outline-none ${FIELD}`;
---

<AccountShell title="Thông báo · ShopNexus" active="notifications">
  <PageTitle title="Thông báo">
    <p slot="meta" class="mt-1 flex items-center gap-1.5 text-body-medium text-on-surface-variant">
      {listed.unread > 0 && <span class="h-2 w-2 rounded-full bg-primary" />}
      {listed.unread ? `${listed.unread} chưa đọc` : 'Đã đọc hết'}
    </p>
    {
      listed.unread > 0 && (
        <form method="post">
          <button type="submit" name="do" value="read-all" class={btnCls('line')}>
            <Icon name="done-all-rounded" size={18} />
            Đánh dấu đã đọc
          </button>
        </form>
      )
    }
  </PageTitle>
  <div class:list={[PANEL, 'p-3']} data-notes data-skeleton-kind="line" data-skeleton-count="4">
    {
      listed.items.length === 0 ? (
        <div class="flex flex-col items-center px-6 py-12 text-center">
          <span class="grid h-12 w-12 place-items-center rounded-full bg-surface-container-low text-on-surface-variant">
            <Icon name="notifications-outline-rounded" size={24} />
          </span>
          <p class="mt-3 text-title-medium text-ink">{after ? 'Không còn thông báo cũ hơn' : 'Chưa có thông báo'}</p>
        </div>
      ) : (
        <NoticeGroups items={listed.items} />
      )
    }
  </div>
  {
    (listed.next_cursor || after) && (
      <div class="flex justify-center gap-2">
        {after && (
          <a href={R.notifications} class={btnCls('line')}>
            Mới nhất
          </a>
        )}
        {listed.next_cursor && (
          <a href={`?${new URLSearchParams({ after: listed.next_cursor })}`} class={btnCls('line')} data-more="[data-notes]">
            Xem thêm
            <Icon name="keyboard-arrow-down-rounded" size={17} />
          </a>
        )}
      </div>
    )
  }

  <Skeleton kind="line" />

  <Fragment slot="side">
    <form method="post" id="settings" class:list={[PANEL, 'scroll-mt-24 p-4']}>
      <h2 class="px-1 pb-2 text-title-medium font-semibold text-ink">Cài đặt thông báo</h2>
      <div hidden data-push-row>
        <Row icon="notifications-outline-rounded" title="Trên trình duyệt này" class="-mx-2">
          <span slot="sub" hidden data-push-blocked>Trình duyệt đang chặn</span>
          <Switch slot="trail" on={false} label="Thông báo trên trình duyệt này" />
        </Row>
        <div class="mx-1 my-2 border-t border-line"></div>
      </div>
      {
        prefs.map(([group, rows], i) => (
          <>
            <p class:list={['px-1 text-label-medium text-on-surface-variant', i > 0 && 'mt-3']}>{group}</p>
            {rows.map((r) => (
              <Row icon={r.icon} title={r.title} class="-mx-2">
                <Switch slot="trail" name={r.name} on={settings[r.name]} label={r.title} />
              </Row>
            ))}
          </>
        ))
      }
      <Row icon="search-rounded" title="Tìm kiếm đang theo dõi" href={R.saved} class="-mx-2" />
      <p class="mt-3 px-1 text-label-medium text-on-surface-variant">Giờ yên lặng</p>
      <Row icon="bedtime-outline-rounded" title="Tắt tiếng ban đêm" sub="Giờ Việt Nam" class="-mx-2">
        <Switch slot="trail" name="quiet" on={settings.quiet.on} label="Tắt tiếng ban đêm" />
      </Row>
      <div class="mt-1 grid grid-cols-2 gap-2 px-1">
        <label class="flex flex-col gap-1 text-label-medium text-on-surface-variant">
          Bắt đầu
          <input type="time" name="quiet_from" value={settings.quiet.from} required class={time} />
        </label>
        <label class="flex flex-col gap-1 text-label-medium text-on-surface-variant">
          Kết thúc
          <input type="time" name="quiet_to" value={settings.quiet.to} required class={time} />
        </label>
      </div>
      {saved === 'bad' && <p class="mt-3 px-1 text-body-small text-error">Giờ bắt đầu và kết thúc phải khác nhau.</p>}
      {saved === 'saved' && <p class="mt-3 px-1 text-body-small text-primary">Đã lưu cài đặt.</p>}
      <button type="submit" name="do" value="settings" class:list={[btnCls('ink'), 'mt-4 w-full']}>Lưu cài đặt</button>
    </form>
  </Fragment>
</AccountShell>

<script>
  import '../lib/more';
  import { disablePush, enablePush, pushable, pushState } from '../lib/push';
  import { snack } from '../lib/snackbar';

  // "Trên trình duyệt này" acts at once, outside the form: the browser's own
  // permission and this browser's token, shown where the browser takes pushes.
  const row = document.querySelector<HTMLElement>('[data-push-row]');
  if (row && pushable()) {
    const sw = row.querySelector<HTMLButtonElement>('[data-switch]')!;
    const blocked = row.querySelector<HTMLElement>('[data-push-blocked]')!;
    const show = () => {
      const state = pushState();
      sw.setAttribute('aria-checked', String(state === 'on'));
      sw.disabled = state === 'blocked';
      blocked.hidden = state !== 'blocked';
    };
    show();
    row.hidden = false;
    sw.addEventListener('click', async () => {
      const on = pushState() !== 'on';
      sw.disabled = true;
      try {
        if (on) await enablePush();
        else await disablePush();
      } catch {
        snack({ text: on ? 'Chưa bật được thông báo. Thử lại sau.' : 'Chưa tắt được thông báo. Thử lại sau.', error: true });
      }
      show();
    });
  }
</script>
