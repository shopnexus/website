---
import Photo from '../components/Photo.astro';
// Giao COD: the buyer asks for cash on delivery on an agreed deal. The address
// comes from their book, the checks from the seller's Tin ghi; the money panel
// says what they pay the shipper. It needs the buyer, so it is behind sign-in.
import Icon from '../components/Icon.astro';
import MoneyLine from '../components/MoneyLine.astro';
import Price from '../components/Price.astro';
import Stepper from '../components/Stepper.astro';
import Layout from '../layouts/Layout.astro';
import { MONEY } from '../data/common';
import { DEAL, SELLER } from '../data/flows';
import { crop, img } from '../lib/format';
import { R } from '../lib/routes';
import { requireViewer } from '../lib/session';
import { btnCls, CONTENT, PANEL } from '../lib/ui';

const me = requireViewer(Astro);
if (me instanceof Response) return me;

const openCod = 2;
const cap = 3;
const addresses = [
  {
    tag: 'Nhà',
    who: `${me.name} · 09•• ••• 812`,
    text: 'Chung cư Vinhomes Grand Park, tòa S5.02, 512 Nguyễn Xiển, Phường Long Bình, Hồ Chí Minh',
    on: true,
  },
  { tag: 'Công ty', who: `${me.name} · 09•• ••• 812`, text: '88 Nguyễn Gia Trí, Phường 25, Bình Thạnh, Hồ Chí Minh', on: false },
];
const checks = ['Pin 88%', 'Face ID hoạt động', 'Chưa sửa chữa', 'Kèm hộp và cáp'];
---

<Layout title="Giao COD · ShopNexus" description={MONEY.cod_buyer}>
  <main class={CONTENT}>
    <div class="pt-6">
      <a href={R.messages} class="inline-flex items-center gap-1 rounded-full px-1 text-body-small text-on-surface-variant hover:text-on-surface">
        <Icon name="arrow-back-rounded" size={16} />Quay lại chat với {SELLER.name}
      </a>
    </div>
    <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
      <h1 class="text-j-40 text-ink lg:text-j-44">Giao COD</h1>
      <div class="max-w-full overflow-x-auto no-scrollbar"><Stepper current={1} /></div>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[1fr_360px] xl:grid-cols-[1fr_400px]">
      <div class="flex min-w-0 flex-col gap-4">
        <section class:list={[PANEL, 'flex flex-wrap items-center gap-4 p-3 md:flex-nowrap md:pr-6']}>
          <Photo src={crop(DEAL.photo, 192, 0.5, 0.52, 1.25)} width={192} height={192} alt="" class="h-24 w-24 shrink-0 rounded-tile object-cover" />
          <div class="min-w-0 flex-1">
            <p class="text-title-medium text-ink md:truncate">{DEAL.title}</p>
            <p class="mt-1 flex items-center gap-2 text-body-medium text-on-surface-variant">
              <Photo src={img(SELLER.photo, 48, 48)} width={48} height={48} alt="" class="h-6 w-6 shrink-0 rounded-full object-cover" />
              {SELLER.name} · {DEAL.meta}
            </p>
          </div>
          <div class="text-right max-md:w-full">
            <Price vnd={DEAL.agreed} size="text-j-26" short={false} />
            <p class="mt-0.5 flex items-center justify-end gap-1 text-label-medium text-tertiary">
              <Icon name="handshake-outline-rounded" size={15} />Đã chốt · niêm yết <s class="text-on-surface-variant">{DEAL.listed}</s>
            </p>
          </div>
        </section>

        <section class:list={[PANEL, 'p-5']}>
          <div class="flex items-center justify-between">
            <h2 class="text-title-medium text-ink">Giao đến</h2>
            <a href={R.addresses} class="text-label-large text-primary hover:underline">Sổ địa chỉ</a>
          </div>
          <div class="mt-3 grid grid-cols-1 gap-2.5 md:grid-cols-2">
            {
              addresses.map((a) => (
                <label class="group flex cursor-pointer items-center gap-3 rounded-tile bg-surface-container-low p-3 has-[:checked]:bg-card has-[:checked]:ring-2 has-[:checked]:ring-primary">
                  <input type="radio" name="dia-chi" value={a.tag} checked={a.on} class="sr-only" />
                  <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full border-2 border-outline-variant group-has-[:checked]:border-primary">
                    <span class="hidden h-2.5 w-2.5 rounded-full bg-primary group-has-[:checked]:block" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="flex items-center gap-2">
                      <span class="rounded-full bg-surface-container-low px-2 text-label-small text-on-surface-variant">{a.tag}</span>
                      <span class="text-body-small text-on-surface-variant">{a.who}</span>
                    </span>
                    <span class="mt-0.5 line-clamp-2 block text-body-medium text-ink">{a.text}</span>
                  </span>
                </label>
              ))
            }
          </div>
        </section>

        <section class:list={[PANEL, 'grid grid-cols-1 gap-6 p-5 md:grid-cols-2']}>
          <div>
            <h2 class="text-title-medium text-ink">Khi shipper tới</h2>
            <p class="mt-1 text-body-medium text-on-surface-variant">Mở hàng, so với Tin ghi của {SELLER.name}:</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {
                checks.map((c) => (
                  <li class="flex items-center gap-2 rounded-full bg-surface-container-low px-3 py-1.5 text-label-large text-ink">
                    <Icon name="check-rounded" size={16} class="text-primary" />
                    {c}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="flex flex-col gap-2 border-line max-md:border-t max-md:pt-5 md:border-l md:pl-6">
            <MoneyLine k="cod_buyer" icon="visibility-outline-rounded" />
            <MoneyLine k="refuse" icon="undo-rounded" />
            <MoneyLine k="cancel" icon="close-rounded" />
          </div>
        </section>

        <section class="flex flex-wrap items-center gap-4 rounded-panel bg-linear-to-r from-secondary-container via-mint-wash to-peach-soft p-3 pr-5 md:flex-nowrap">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-white text-primary">
            <Icon name="handshake-outline-rounded" size={22} />
          </span>
          <p class="min-w-0 flex-1 text-body-medium text-ink">
            <b class="font-semibold">{MONEY.meet_hint}</b>{' '}
            <span class="text-on-surface-variant">Hẹn chỗ và giờ trong tin nhắn; COD vẫn chọn được.</span>
          </p>
          <a href={R.messages} class:list={[btnCls('line', 'lg'), '!h-10']}><Icon name="map-outline-rounded" size={17} />Hẹn gặp</a>
        </section>
      </div>

      <aside class="self-start lg:sticky lg:top-[84px]">
        <div class:list={[PANEL, 'p-5 shadow-soft']}>
          <h2 class="text-title-medium text-ink">Tiền</h2>
          <div class="mt-1 divide-y divide-line">
            <div class="flex items-center gap-3 py-2.5">
              <Icon name="handshake-outline-rounded" size={20} class="text-on-surface-variant" />
              <span class="flex-1 text-body-large text-ink">Tiền hàng</span>
              <Price vnd={DEAL.agreed} short={false} />
            </div>
            <div class="flex items-center gap-3 py-2.5">
              <Icon name="local-shipping-outline-rounded" size={20} class="text-on-surface-variant" />
              <span class="flex-1 text-body-large text-ink">Phí ship</span>
              <span class="text-body-large text-on-surface-variant">Chưa có</span>
            </div>
          </div>
          <p class="text-body-small text-on-surface-variant">Có phí ship khi người bán tạo đơn.</p>
          <div class="mt-4 rounded-tile bg-peach-wash p-4">
            <p class="text-body-small text-on-tertiary-fixed-variant">Trả cho shipper khi nhận</p>
            <p class="mt-0.5 flex flex-wrap items-baseline gap-1.5">
              <Price vnd={DEAL.agreed} size="text-j-30" short={false} /><span class="text-body-medium text-on-surface-variant">+ phí ship</span>
            </p>
          </div>
          <a href={R.reputation} class="state-layer mt-3 flex items-center gap-3 rounded-tile bg-surface-container-low px-4 py-3">
            <Icon name="verified-outline-rounded" size={20} class="text-on-surface-variant" />
            <span class="min-w-0 flex-1">
              <span class="block text-body-medium text-ink">Đơn COD đang mở: {openCod}/{cap}</span>
              <span class="mt-1.5 block h-1.5 rounded-full bg-card">
                <span class="block h-full rounded-full bg-linear-to-r from-teal to-teal-light" style={`width:${Math.round((openCod / cap) * 100)}%`}></span>
              </span>
            </span>
            <Icon name="chevron-right-rounded" size={20} class="text-on-surface-variant" />
          </a>
          <button type="button" class:list={[btnCls('ink', 'lg'), 'mt-4 !h-12 w-full']}><Icon name="send-rounded" size={18} />Gửi yêu cầu COD</button>
          <p class="mt-3 text-center text-body-small text-on-surface-variant">{MONEY.no_hold}</p>
        </div>
      </aside>
    </div>
  </main>
</Layout>
