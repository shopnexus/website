---
// Người bán: the seller's name and facts, the four figures, their listings
// a page at a time, and the reviews in two tabs, as a seller and as a buyer.
// An unknown id is the 404.
import AvatarZoom from '../../components/AvatarZoom.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import ListingCard from '../../components/ListingCard.astro';
import NotFound from '../../components/public/NotFound.astro';
import ReviewItem from '../../components/public/ReviewItem.astro';
import Stars from '../../components/public/Stars.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Seg from '../../components/Seg.astro';
import ShareSheet from '../../components/ShareSheet.astro';
import Layout from '../../layouts/Layout.astro';
import { orNull } from '../../lib/api/client';
import { near } from '../../lib/area';
import { REPLY_TIME, ago, decimal, ratingText } from '../../lib/format';
import { card, isId } from '../../lib/listing';
import { R } from '../../lib/routes';
import { viewer } from '../../lib/session';
import { CONTENT, btnCls } from '../../lib/ui';

const id = Astro.params.id ?? '';
const after = Astro.url.searchParams.get('after') ?? undefined;
const api = Astro.locals.api;
// "Xem thêm tin" opens the next page in place of the first; it loads beside
// the profile, and an old or broken cursor falls back to the first page.
const [found, next] = isId(id)
  ? await Promise.all([
      orNull(api.GET('/v1/screens/seller/{id}', { params: { path: { id }, query: near(Astro.cookies) } })),
      after ? orNull(api.GET('/v1/sellers/{id}/listings', { params: { path: { id }, query: { cursor: after, ...near(Astro.cookies) } } })) : null,
    ])
  : [null, null];
if (!found) Astro.response.status = 404;
const page = next ?? found?.listings;
const items = page?.items.map(card) ?? [];
/** The listings on sale this page shows, for the reviews' listing links. */
const onSale = Object.fromEntries(items.map((c) => [c.id, c.slug]));
const s = found?.seller;
const me = viewer(Astro);
const mine = !!me && me.id === s?.id;
const following = !!found?.viewer?.following;
const active = s?.last_active_at && Date.now() - Date.parse(s.last_active_at) < 300_000;
const facts: [string, string][] = s
  ? [
      ['calendar-month-outline-rounded', `Tham gia ${new Date(s.joined_at).getFullYear()}`],
      ...(s.last_active_at ? [['schedule-outline-rounded', active ? 'Đang hoạt động' : `Hoạt động ${ago(s.last_active_at)} trước`] as [string, string]] : []),
      ...(s.reply_time ? [['chat-outline-rounded', REPLY_TIME[s.reply_time]] as [string, string]] : []),
    ]
  : [];
const [rated, ratedLine] = s ? ratingText(s.rating) : ['', ''];
const stats: [string, string, string][] = s
  ? [
      [rated, s.rating.count ? '/5' : '', ratedLine],
      [String(s.sold), '', 'đã bán'],
      [String(s.on_sale), '', 'đang bán'],
      [String(s.followers), '', 'người theo dõi'],
    ]
  : [];
// Someone who never sold shows only Khi mua.
const reviewTabs = s
  ? [
      ...(s.sold || s.rating.count ? [{ label: 'Khi bán', rating: s.rating, items: found!.reviews.items }] : []),
      { label: 'Khi mua', rating: s.buyer_rating, items: found!.buyer_reviews.items },
    ]
  : [];
const line = 'state-layer grid h-10 w-10 place-items-center rounded-full border border-line bg-card text-on-surface-variant';
---

{
  !found || !s ? (
    <Layout title="Không có người bán này · ShopNexus" description="Trang người bán này không còn.">
      <NotFound />
    </Layout>
  ) : (
    <Layout
      title={`Người bán · ${s.display_name}`}
      description={`${s.display_name}: ${s.rating.count ? `${decimal(s.rating.average)}/5 từ ${s.rating.count} đánh giá, ` : ''}${s.sold} món đã bán. Xem tin đang bán.`}
      image={s.avatar_url}
    >
      <main class={CONTENT}>
        <Crumbs parts={[['Khám phá', R.home], ['Người bán']]} class="pt-4" />
        <section class="mt-4 flex flex-col gap-6 xl:flex-row xl:items-end xl:justify-between xl:gap-8">
          <div class="flex flex-col gap-4 md:flex-row md:items-center md:gap-6">
            <AvatarZoom name={s.display_name} photo={s.avatar_url} size={112} class="ring-4 ring-white" />
            <div class="min-w-0">
              <h1 class="text-j-28 text-ink md:text-j-32">{s.display_name}</h1>
              {s.bio && <p class="mt-1 max-w-[560px] text-body-large text-sub">{s.bio}</p>}
              <div class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-2 text-body-medium text-on-surface-variant">
                {facts.map(([ic, t]) => (
                  <span class="flex items-center gap-1.5">
                    <Icon name={ic} size={16} class="text-on-surface-variant" />
                    {t}
                  </span>
                ))}
              </div>
              <div class="mt-4 flex items-center gap-2">
                {!mine && (
                  <>
                    <button
                      type="button"
                      aria-pressed={following ? 'true' : 'false'}
                      class="state-layer flex h-10 items-center gap-1.5 rounded-control bg-brand pl-3.5 pr-4 text-label-large text-white"
                      data-follow={s.id}
                    >
                      <Icon name="person-add-outline-rounded" size={18} />
                      <span>{following ? 'Đang theo dõi' : 'Theo dõi'}</span>
                    </button>
                    <a
                      href={`${R.messages}?seller=${s.id}`}
                      class="state-layer flex h-10 items-center gap-1.5 rounded-control border border-line bg-card pl-3.5 pr-4 text-label-large text-ink"
                    >
                      <Icon name="chat-outline-rounded" size={18} />
                      Nhắn tin
                    </a>
                  </>
                )}
                <button type="button" class={line} aria-label="Chia sẻ" popovertarget="share">
                  <Icon name="share-outline-rounded" size={18} />
                </button>
              </div>
              <ShareSheet
                id="share"
                align="start"
                url={new URL(R.seller(s.id), Astro.url).href}
                title={s.display_name}
                line={`${s.on_sale} tin đang bán${s.sold ? ` · ${s.sold} đã bán` : ''}`}
                photo={s.avatar_url}
                person
              />
            </div>
          </div>
          <div class="border border-line bg-card grid shrink-0 grid-cols-2 gap-y-4 rounded-card py-5 shadow-soft md:grid-cols-4">
            {stats.map(([v, u, l], i) => (
              <div class:list={['px-5', i % 2 === 1 && 'border-l border-line', i === 2 && 'md:border-l md:border-line']}>
                <p class="text-j-28 text-ink tabular-nums">
                  {v}
                  <span class="text-title-medium font-medium tracking-normal text-on-surface-variant">{u}</span>
                </p>
                <p class="text-body-small text-on-surface-variant">{l}</p>
              </div>
            ))}
          </div>
        </section>

        <div class="mt-8">
          <div class="border border-line bg-card sticky top-[76px] z-20 flex w-fit items-center gap-2 rounded-full p-1 shadow-soft" data-tabs>
            <Seg items={[`Đang bán ${s.on_sale}`, `Đánh giá ${s.rating.count + s.buyer_rating.count}`]} class="bg-soft" name="Tin và đánh giá" />
          </div>
          {items.length ? (
            <div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-4 xl:grid-cols-4">
              {items.map((it, i) => (
                <ListingCard item={it} loading={i < 8 ? 'eager' : 'lazy'} />
              ))}
            </div>
          ) : (
            <p class="mt-6 text-body-large text-sub">{s.display_name} chưa có tin nào đang bán.</p>
          )}
          {page?.next_cursor && (
            <div class="mt-8 flex justify-center">
              <a href={`?${new URLSearchParams({ after: page.next_cursor })}`} class={btnCls('line')}>
                Xem thêm tin
                <Icon name="keyboard-arrow-down-rounded" size={17} />
              </a>
            </div>
          )}
        </div>

        <section class="mt-10 scroll-mt-24" id="danh-gia">
          <SectionTitle title="Đánh giá" />
          {reviewTabs.length > 1 && (
            <div class="mt-2 border-b border-line" data-review-tabs>
              <Seg variant="tabs" items={reviewTabs.map((t) => `${t.label} · ${t.rating.count}`)} name="Đánh giá" />
            </div>
          )}
          {reviewTabs.map((t, ti) => (
            <div
              class="mt-4 grid grid-cols-1 gap-6 rounded-panel border border-line bg-card p-5 md:grid-cols-[240px_1fr]"
              hidden={ti > 0}
              data-review-pane
            >
              <div>
                {reviewTabs.length === 1 && <p class="mb-2 text-title-small text-ink">{t.label}</p>}
                {t.rating.count ? (
                  <>
                    <p class="text-j-32 text-ink tabular-nums">
                      {decimal(t.rating.average)}
                      <span class="text-title-large font-medium tracking-normal text-on-surface-variant">/5</span>
                    </p>
                    <p class="mt-1">
                      <Stars n={Math.round(t.rating.average)} size={18} />
                    </p>
                    <p class="mt-1 text-body-small text-on-surface-variant">{t.rating.count} đánh giá</p>
                  </>
                ) : (
                  <p class="text-body-large text-sub">Chưa có đánh giá.</p>
                )}
              </div>
              <ul class="min-w-0">
                {t.items.map((r, i) => (
                  <li class:list={['py-4', i > 0 && 'border-t border-line', i === 0 && 'pt-0']}>
                    <ReviewItem review={r} subject={s.display_name} onSale={onSale} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      </main>
    </Layout>
  )
}

<script>
  import { API } from '../../lib/routes';
  import { snack } from '../../lib/snackbar';
  import { toggleRemote } from '../../lib/toggle';

  // "Đánh giá" jumps to the reviews; Khi bán and Khi mua switch their pane. "Theo dõi" follows through /api/follows/<id>;
  // a guest goes to Đăng nhập, and a failed call puts the button back and says so.
  document.querySelector('[data-tabs]')?.addEventListener('seg-change', (e) => {
    if ((e as CustomEvent).detail.index === 1) document.getElementById('danh-gia')?.scrollIntoView({ behavior: 'smooth' });
  });
  const panes = document.querySelectorAll<HTMLElement>('[data-review-pane]');
  document.querySelector('[data-review-tabs] [data-seg]')?.addEventListener('seg-change', (e) => {
    panes.forEach((p, i) => (p.hidden = i !== (e as CustomEvent).detail.index));
  });
  const show = (b: HTMLButtonElement, on: boolean) => {
    b.setAttribute('aria-pressed', String(on));
    b.querySelector('span')!.textContent = on ? 'Đang theo dõi' : 'Theo dõi';
  };
  document.querySelectorAll<HTMLButtonElement>('[data-follow]').forEach((b) =>
    b.addEventListener('click', async () => {
      const on = b.getAttribute('aria-pressed') !== 'true';
      show(b, on);
      if (await toggleRemote(API.follows(b.dataset.follow!), on)) return;
      show(b, !on);
      snack({ text: 'Chưa đổi được. Thử lại sau.', error: true });
    }),
  );
</script>
