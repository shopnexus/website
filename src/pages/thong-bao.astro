---
import Photo from '../components/Photo.astro';
// Thông báo: grouped by day, the unread ones tinted; on the side the browser
// prompt and the notification settings.
import Icon from '../components/Icon.astro';
import PageTitle from '../components/PageTitle.astro';
import Seg from '../components/Seg.astro';
import Switch from '../components/Switch.astro';
import AccountShell from '../components/account/AccountShell.astro';
import Row from '../components/account/Row.astro';
import { NOTES } from '../data/account';
import { PROFILE_TASKS, TASKS_DONE } from '../data/common';
import { img } from '../lib/format';
import { R } from '../lib/routes';
import { requireViewer } from '../lib/session';
import { btnCls, PANEL } from '../lib/ui';

const v = requireViewer(Astro);
if (v instanceof Response) return v;

const TONES = {
  offer: 'bg-tertiary-fixed text-on-tertiary-fixed-variant',
  deal: 'bg-primary/10 text-primary',
  neutral: 'bg-surface-container-low text-on-surface-variant',
};
const groups = NOTES.map(([day, items]) => [
  day,
  items.map((n) => (n.icon === 'checklist-rounded' ? { ...n, html: `Còn ${PROFILE_TASKS.length - TASKS_DONE} bước để hoàn thiện hồ sơ` } : n)),
] as const);
// Photos past the fifth sit below the first screen.
const later = new Set(groups.flatMap(([, n]) => n).filter((n) => n.photo).slice(5));
const unread = NOTES.flatMap(([, n]) => n).filter((n) => n.unread).length;
const counts = [
  ['4', 'hôm nay'],
  ['2', 'trả giá'],
  ['2', 'đơn COD'],
];

type Pref = { icon: string; title: string; sub?: string; trail: 'on' | 'off' | 'chevron' | string; href?: string };
const prefs: [string, Pref[]][] = [
  [
    'Giao dịch',
    [
      { icon: 'chat-outline-rounded', title: 'Tin nhắn', trail: 'on' },
      { icon: 'sell-outline-rounded', title: 'Trả giá và chốt giá', trail: 'on' },
      { icon: 'local-shipping-outline-rounded', title: 'Đơn hàng và giao hàng', trail: 'on' },
    ],
  ],
  [
    'Giá và tin mới',
    [
      { icon: 'trending-down-rounded', title: 'Giảm giá ở tin đã lưu', trail: 'on' },
      { icon: 'storefront-outline-rounded', title: 'Người bán bạn theo dõi', trail: 'on' },
      { icon: 'search-rounded', title: 'Tìm kiếm đang theo dõi', sub: 'Bật chuông ở từng tìm kiếm trong Đã lưu', trail: 'chevron', href: R.saved },
    ],
  ],
  ['Tài khoản', [{ icon: 'star-outline-rounded', title: 'Đánh giá mới', trail: 'on' }]],
  [
    'Giờ yên lặng',
    [
      { icon: 'bedtime-outline-rounded', title: 'Tắt tiếng ban đêm', sub: 'Từ 22:00 đến 07:00', trail: 'on' },
      { icon: 'schedule-outline-rounded', title: 'Bắt đầu', trail: '22:00' },
      { icon: 'schedule-outline-rounded', title: 'Kết thúc', trail: '07:00' },
    ],
  ],
];
---

<AccountShell title="Thông báo · ShopNexus" active="notifications">
  <PageTitle title="Thông báo">
    <p slot="meta" class="mt-1 flex flex-wrap items-center gap-x-3 text-body-medium text-on-surface-variant">
      <span class="flex items-center gap-1.5" data-unread-count><span class="h-2 w-2 rounded-full bg-primary"></span>{unread} chưa đọc</span>
      {
        counts.map(([n, l]) => (
          <span>
            <b class="font-semibold text-ink tabular-nums">{n}</b> {l}
          </span>
        ))
      }
    </p>
    <button type="button" class={btnCls('line')} data-read-all><Icon name="done-all-rounded" size={18} />Đánh dấu đã đọc</button>
  </PageTitle>
  <div class="max-w-full overflow-x-auto no-scrollbar">
    <Seg items={['Tất cả', 'Giao dịch', 'Giá và tin mới', 'Tài khoản']} class="glass glass-edge" name="Loại thông báo" />
  </div>
  <div class:list={[PANEL, 'p-3']}>
    {
      groups.map(([day, items], i) => (
        <section class:list={[i > 0 && 'mt-3 border-t border-line pt-3']} data-group>
          <h2 class="px-3 pb-1 text-label-medium uppercase tracking-[0.1em] text-on-surface-variant">{day}</h2>
          <ul class="flex flex-col gap-0.5">
            {items.map((n) => (
              <li
                class:list={['state-layer flex items-start gap-3 rounded-lg px-3 py-2.5', n.unread && 'bg-primary/5']}
                data-tab={n.tab}
                data-unread={n.unread ? '' : undefined}
              >
                <span class:list={['grid h-9 w-9 shrink-0 place-items-center rounded-full', TONES[n.tone]]}>
                  <Icon name={n.icon} size={18} />
                </span>
                <div class="min-w-0 flex-1">
                  <p class="text-body-medium text-ink" set:html={n.html} />
                  <p class="text-body-small text-on-surface-variant">{n.when}</p>
                  {n.action && (
                    <a
                      href={n.action.href}
                      class="mt-1.5 inline-flex h-7 items-center rounded-full border border-line bg-card px-3 text-label-medium text-primary hover:bg-surface-container-low"
                    >
                      {n.action.label}
                    </a>
                  )}
                </div>
                {n.photo && <Photo src={img(n.photo, 96, 96)} width={96} height={96} alt="" loading={later.has(n) ? 'lazy' : 'eager'} class="h-12 w-12 shrink-0 rounded-md object-cover" />}
                <span class="self-center">
                  {n.unread ? (
                    <span class="block h-2 w-2 shrink-0 rounded-full bg-primary" aria-label="Chưa đọc" data-dot />
                  ) : (
                    <span class="block w-2 shrink-0" />
                  )}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <Fragment slot="side">
    <section
      class="relative overflow-hidden rounded-panel bg-radial-[120%_120%_at_100%_0%] from-[#ffb59c] via-clay via-30% to-[#773115] to-85% p-5 text-white"
    >
      <span class="grid h-10 w-10 place-items-center rounded-full bg-white/20"><Icon name="notifications-active-outline-rounded" size={22} /></span>
      <p class="mt-3 text-j-20">Không bỏ lỡ lời trả giá</p>
      <p class="mt-1 text-body-small text-white/85">Bật thông báo trên trình duyệt hoặc tải app để nhận ngay khi có người trả giá.</p>
      <button type="button" class="state-layer mt-4 h-10 w-full rounded-full bg-white text-label-large text-clay" data-push>Bật thông báo trình duyệt</button>
    </section>
    <div class:list={[PANEL, 'p-4']}>
      <h2 class="px-1 pb-2 text-title-medium font-semibold text-ink">Cài đặt thông báo</h2>
      {
        prefs.map(([group, rows], i) => (
          <>
            <p class:list={['px-1 text-label-medium uppercase tracking-[0.1em] text-on-surface-variant', i > 0 && 'mt-3']}>{group}</p>
            {rows.map((r) =>
              r.trail === 'chevron' ? (
                <Row icon={r.icon} title={r.title} sub={r.sub} href={r.href} class="-mx-2" />
              ) : (
                <Row icon={r.icon} title={r.title} sub={r.sub} class="-mx-2">
                  {r.trail === 'on' || r.trail === 'off' ? (
                    <Switch slot="trail" on={r.trail === 'on'} label={r.title} />
                  ) : (
                    <span slot="trail" class="text-body-medium text-on-surface-variant tabular-nums">
                      {r.trail}
                    </span>
                  )}
                </Row>
              ),
            )}
          </>
        ))
      }
    </div>
  </Fragment>
</AccountShell>

<script>
  // The tabs filter the list; "Đánh dấu đã đọc" clears the unread tint and dots.
  const TABS = ['all', 'deal', 'price', 'account'];
  const list = document.querySelectorAll<HTMLElement>('[data-tab]');
  document.querySelector('[aria-label="Loại thông báo"]')?.addEventListener('seg-change', (e) => {
    const tab = TABS[(e as CustomEvent<{ index: number }>).detail.index];
    list.forEach((li) => (li.hidden = tab !== 'all' && li.dataset.tab !== tab));
    document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => (g.hidden = !g.querySelector('[data-tab]:not([hidden])')));
  });
  document.querySelector('[data-read-all]')?.addEventListener('click', () => {
    document.querySelectorAll('[data-unread]').forEach((li) => li.classList.remove('bg-primary/5'));
    document.querySelectorAll('[data-dot]').forEach((d) => d.remove());
    const c = document.querySelector('[data-unread-count]');
    if (c?.lastChild) c.lastChild.textContent = '0 chưa đọc';
  });
  document.querySelector('[data-push]')?.addEventListener('click', () => {
    if ('Notification' in window) Notification.requestPermission();
  });
</script>
