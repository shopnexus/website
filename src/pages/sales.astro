---
// Đơn bán: the seller's COD orders, newest first (?after= pages on). Each
// opens the order, where a pending one gets its shipment.
import OrderList from '../components/orders/OrderList.astro';
import { pageOrFirst } from '../lib/api/client';
import { requireViewer } from '../lib/session';

const v = requireViewer(Astro);
if (v instanceof Response) return v;
const after = Astro.url.searchParams.get('after') ?? undefined;
const screen = await pageOrFirst(after, (cursor) =>
  Astro.locals.api.GET('/v1/screens/orders', { params: { query: { role: 'selling', cursor, limit: 20 } } }),
);
---

<OrderList role="seller" screen={screen} paged={!!after} />
