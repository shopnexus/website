---
import Photo from '../components/Photo.astro';
// Hỗ trợ: each ticket is its own chat with ShopNexus. The tickets on the left,
// the open one's chat in the middle, the order in it and the carrier's
// timeline on the right. Support stays out of Tin nhắn.
import Icon from '../components/Icon.astro';
import Price from '../components/Price.astro';
import Seg from '../components/Seg.astro';
import Official from '../components/orders/Official.astro';
import Layout from '../layouts/Layout.astro';
import { NO_ARBITRATION, ORDERS, QUICK_QUESTIONS, REPORT, SUPPORT_REPLY, SUPPORT_TRACK, TICKET_KINDS, TICKETS } from '../data/orders';
import { img } from '../lib/format';
import { R } from '../lib/routes';
import { requireViewer } from '../lib/session';
import { btnCls, CONTENT, PANEL } from '../lib/ui';

const v = requireViewer(Astro);
if (v instanceof Response) return v;

const order = ORDERS.o1;
const open = TICKETS.filter((t) => t.open);
const done = TICKETS.filter((t) => !t.open);
const current = TICKET_KINDS[TICKETS[0].kind];
---

<Layout title="Hỗ trợ · ShopNexus" description="Yêu cầu hỗ trợ của bạn với ShopNexus." section={null}>
  <main class={CONTENT}>
    <div class="flex flex-wrap items-end justify-between gap-4 pt-8">
      <div>
        <h1 class="text-j-28 text-ink lg:text-j-30">Hỗ trợ</h1>
        <p class="mt-1 flex items-start gap-1.5 text-body-medium text-on-surface-variant">
          <Icon name="balance-rounded" size={16} class="mt-0.5" />
          <span>{NO_ARBITRATION} Thường trả lời trong 2 giờ.</span>
        </p>
      </div>
      <button type="button" class={btnCls('ink', 'lg')}><Icon name="edit-outline-rounded" size={18} />Yêu cầu mới</button>
    </div>

    <div class="mt-6 grid grid-cols-1 items-start gap-4 lg:grid-cols-[300px_minmax(0,1fr)] xl:h-[660px] xl:grid-cols-[340px_minmax(0,1fr)_300px]">
      <div class="flex flex-col gap-4">
        <section class="border border-line bg-card flex flex-col rounded-panel p-3">
          <div class="px-1">
            <Seg
              items={[`Đang xử lý · ${open.length}`, `Đã xử lý · ${done.length}`]}
              class="flex w-full bg-black/[.04]"
              itemClass="flex-1 text-label-large"
              name="Yêu cầu"
            />
          </div>
          {
            [open, done].map((list, g) => (
              <>
                {g === 1 && <p class="mb-1 mt-5 px-3 text-label-medium text-on-surface-variant">Đã xử lý</p>}
                <div class:list={['flex flex-col gap-1', g === 0 ? 'mt-3' : 'opacity-80']}>
                  {list.map((t) => {
                    const k = TICKET_KINDS[t.kind];
                    const sel = t === TICKETS[0];
                    return (
                      <a
                        href="#"
                        aria-current={sel ? 'true' : undefined}
                        class:list={['flex gap-3 rounded-tile p-2.5', sel ? 'bg-card shadow-soft' : 'hover:bg-card/70']}
                      >
                        <span
                          class:list={[
                            'grid h-10 w-10 shrink-0 place-items-center rounded-full',
                            sel
                              ? 'bg-brand text-white'
                              : t.open
                                ? 'bg-secondary-container text-on-secondary-container'
                                : 'bg-surface-container-low text-on-surface-variant',
                          ]}
                        >
                          <Icon name={k.icon} size={20} />
                        </span>
                        <span class="min-w-0 flex-1">
                          <span class="flex items-baseline gap-2">
                            <span class="min-w-0 flex-1 truncate text-title-small text-ink">{k.name}</span>
                            <span class="shrink-0 text-body-small text-on-surface-variant">{t.when}</span>
                          </span>
                          <span class="block truncate text-body-small text-on-surface-variant">{t.subject}</span>
                          <span class="block truncate text-body-medium text-on-surface-variant">{t.last}</span>
                        </span>
                      </a>
                    );
                  })}
                </div>
              </>
            ))
          }
        </section>
        <section class:list={[PANEL, 'p-3']}>
          <p class="px-2 pb-1 pt-1 text-label-medium text-on-surface-variant">Hỏi nhanh</p>
          {
            QUICK_QUESTIONS.map((q) => (
              <a href={`${R.how}#faq`} class="flex items-center gap-2 rounded-field px-2 py-2 text-body-medium text-ink hover:bg-surface-container-low">
                <Icon name="help-outline-rounded" size={18} class="text-on-surface-variant" />
                <span class="min-w-0 flex-1 truncate">{q}</span>
                <Icon name="chevron-right-rounded" size={18} class="text-on-surface-variant" />
              </a>
            ))
          }
        </section>
      </div>

      <section class:list={[PANEL, 'flex min-h-0 flex-col overflow-hidden xl:h-full']}>
        <div class="flex h-16 shrink-0 items-center gap-3 border-b border-line px-4">
          <Official size={38} />
          <div class="min-w-0 flex-1">
            <p class="truncate text-title-medium text-ink">{current.name}</p>
            <p class="flex items-center gap-1 text-body-small text-on-surface-variant">
              ShopNexus<Icon name="verified-rounded" size={14} class="text-primary" />· Đang xử lý
            </p>
          </div>
          <span class="shrink-0 rounded-full bg-secondary-container px-2.5 py-1 text-label-medium text-on-secondary-container">Đang xử lý</span>
        </div>
        <div class="flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto px-4 py-5 md:px-6">
          <p class="mx-auto flex w-fit items-center gap-1.5 rounded-full bg-surface-container-low px-3 py-1 text-center text-body-small text-on-surface-variant">
            <Icon name="balance-rounded" size={14} />{NO_ARBITRATION}
          </p>
          <p class="text-center text-label-medium text-on-surface-variant">Hôm nay</p>
          <div class="flex flex-col items-end">
            <article class="w-full max-w-[400px] rounded-card rounded-br-2xs border border-line bg-card p-4 shadow-soft">
              <p class="flex items-center gap-2 text-title-small text-ink">
                <Icon name={current.icon} size={18} class="text-primary" />{current.name}
              </p>
              <div class="mt-3 flex items-center gap-3 rounded-field bg-surface-container-low p-2">
                <Photo src={img(order.photo, 112, 112)} width={112} height={112} alt="" class="h-11 w-11 shrink-0 rounded-sm object-cover" />
                <span class="min-w-0">
                  <span class="block truncate text-title-small text-ink">{order.title}</span>
                  <span class="block text-body-small text-on-surface-variant">{order.carrier} · {order.code}</span>
                </span>
              </div>
              <p class="mt-3 text-body-large text-ink">{REPORT}</p>
            </article>
            <p class="mt-1 px-2 text-body-small text-on-surface-variant">08:12 · Đã xem</p>
          </div>
          <div class="flex items-end gap-2">
            <Official size={30} />
            <div class="flex min-w-0 flex-col gap-1">
              {
                SUPPORT_REPLY.map((t, i) => (
                  <p class:list={['w-fit max-w-[440px] rounded-card bg-surface-container-low px-4 py-2.5 text-body-large text-ink', i > 0 && 'rounded-tl-2xs']}>
                    {t}
                  </p>
                ))
              }
              <p class="px-2 text-body-small text-on-surface-variant">09:05</p>
            </div>
          </div>
          <div class="flex flex-col items-end">
            <p class="max-w-[440px] rounded-card rounded-br-2xs bg-teal px-4 py-2.5 text-body-large text-white">Ok bạn, để mình hỏi bảo vệ rồi báo lại nhé.</p>
            <p class="mt-1 px-2 text-body-small text-on-surface-variant">09:11 · Đã xem</p>
          </div>
        </div>
        <form class="flex shrink-0 items-center gap-2 p-3" onsubmit="return false">
          <button type="button" class="state-layer grid h-10 w-10 shrink-0 place-items-center rounded-full text-on-surface-variant" aria-label="Đính kèm">
            <Icon name="add-circle-outline-rounded" size={22} />
          </button>
          <input
            placeholder="Nhắn ShopNexus"
            aria-label="Nhắn ShopNexus"
            class="h-11 min-w-0 flex-1 rounded-full bg-surface-container-low px-4 text-body-large text-ink outline-none placeholder:text-on-surface-variant focus:ring-2 focus:ring-primary"
          />
          <button type="submit" class="state-layer grid h-11 w-11 shrink-0 place-items-center rounded-full bg-brand text-white" aria-label="Gửi">
            <Icon name="send-rounded" size={18} />
          </button>
        </form>
      </section>

      <aside class="flex flex-col gap-4 lg:col-span-2 lg:grid lg:grid-cols-2 xl:col-span-1 xl:flex">
        <div class:list={[PANEL, 'p-4']}>
          <p class="text-label-medium text-on-surface-variant">Đơn trong yêu cầu</p>
          <div class="mt-2 flex items-center gap-3">
            <Photo src={img(order.photo, 112, 112)} width={112} height={112} alt="" class="h-14 w-14 shrink-0 rounded-field object-cover" />
            <div class="min-w-0">
              <p class="truncate text-title-small text-ink">{order.title}</p>
              <Price vnd={order.price} size="text-j-15" />
            </div>
          </div>
          <a href={R.order('o1')} class:list={[btnCls('line'), 'mt-3 w-full']}>Mở đơn</a>
        </div>
        <div class:list={[PANEL, 'p-4']}>
          <p class="flex items-center justify-between gap-3 text-label-medium text-on-surface-variant">
            <span>Lịch trình {order.carrier}</span><span class="tabular-nums">{order.code}</span>
          </p>
          <ol class="mt-3">
            {
              SUPPORT_TRACK.map((s, i) => (
                <li class="relative flex gap-3 pb-4 last:pb-0">
                  {i < SUPPORT_TRACK.length - 1 && <span class="absolute left-[7px] top-4 h-full w-0.5 bg-black/[.06]" />}
                  <span class:list={['relative mt-1 h-4 w-4 shrink-0 rounded-full', s.ok ? 'bg-primary' : 'border-2 border-tertiary bg-card']} />
                  <span>
                    <span class:list={['block text-title-small', s.ok ? 'text-ink' : 'text-tertiary']}>{s.title}</span>
                    <span class="block text-body-small text-on-surface-variant">{s.sub}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </aside>
    </div>
  </main>
</Layout>
