---
import Photo from '../../components/Photo.astro';
// Bảo mật: sign-in methods, signed-in devices, blocked people and "Xóa tài khoản".
import Icon from '../../components/Icon.astro';
import GoogleG from '../../components/GoogleG.astro';
import Row from '../../components/account/Row.astro';
import SettingsFrame from '../../components/account/SettingsFrame.astro';
import SideList from '../../components/account/SideList.astro';
import { PHONE } from '../../data/account';
import { img } from '../../lib/format';
import { R } from '../../lib/routes';
import { requireViewer } from '../../lib/session';
import { btnCls, PANEL } from '../../lib/ui';

const v = requireViewer(Astro);
if (v instanceof Response) return v;

const devices = [
  { icon: 'computer-outline-rounded', title: 'Chrome trên Windows', sub: 'TP.HCM · đang dùng', here: true },
  { icon: 'phone-android-outline-rounded', title: 'Pixel 9 · app ShopNexus', sub: 'TP.HCM · hôm nay 08:12' },
  { icon: 'phone-android-outline-rounded', title: 'Galaxy A55 · app ShopNexus', sub: 'TP.HCM · hôm nay 07:40' },
  { icon: 'tablet-outline-rounded', title: 'Galaxy Tab S9', sub: 'Đồng Nai · 3 ngày trước' },
];
const recent = [
  { icon: 'login-rounded', title: 'Đăng nhập trên Chrome', sub: 'Hôm nay 09:02 · TP.HCM', tone: 'bg-primary/10 text-primary' },
  { icon: 'sms-outline-rounded', title: `Mã SMS gửi tới ${PHONE}`, sub: 'Hôm nay 09:01' },
  { icon: 'link-rounded', title: 'Liên kết Google', sub: '28/09 · Pixel 9' },
];
const line = 'flex flex-wrap items-center gap-3 py-3';
const bubble = 'grid h-10 w-10 shrink-0 place-items-center rounded-full';
---

<SettingsFrame title="Bảo mật" page="Bảo mật" meta="Cách đăng nhập, thiết bị và người bạn đã chặn">
  <div class:list={[PANEL, 'px-5 py-4']}>
    <h2 class="text-j-20 text-ink">Đăng nhập</h2>
    <div class="mt-1">
      <div class={line}>
        <span class:list={[bubble, 'bg-primary/10 text-primary']}><Icon name="phone-android-outline-rounded" size={20} /></span>
        <div class="min-w-0 flex-1">
          <p class="text-body-large text-ink">Số điện thoại</p>
          <p class="text-body-small text-on-surface-variant">{PHONE} · đã xác minh · người khác không thấy số này</p>
        </div>
        <button type="button" class={btnCls('line')}>Đổi số</button>
      </div>
      <div class:list={[line, 'border-t border-line']}>
        <span class:list={[bubble, 'bg-surface-container-low']}><GoogleG /></span>
        <div class="min-w-0 flex-1">
          <p class="text-body-large text-ink">Google</p>
          <p class="text-body-small text-on-surface-variant">k•••@gmail.com · đăng nhập một chạm</p>
        </div>
        <button type="button" class={btnCls('ghost')}>Gỡ liên kết</button>
      </div>
      <div class:list={[line, 'border-t border-line']}>
        <span class:list={[bubble, 'bg-surface-container-low text-on-surface-variant']}><Icon name="mail-outline-rounded" size={20} /></span>
        <div class="min-w-0 flex-1">
          <p class="text-body-large text-ink">Email</p>
          <p class="text-body-small text-on-surface-variant">Chưa thêm · đăng nhập khi không có điện thoại bên cạnh</p>
        </div>
        <button type="button" class={btnCls('ink')}><Icon name="add-rounded" size={18} />Thêm</button>
      </div>
    </div>
  </div>

  <div class:list={[PANEL, 'px-5 py-4']}>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-j-20 text-ink">Thiết bị đang đăng nhập · {devices.length}</h2>
      <button type="button" class={btnCls('line')}><Icon name="logout-rounded" size={18} />Đăng xuất các thiết bị khác</button>
    </div>
    <div class="mt-1">
      {
        devices.map((d, i) => (
          <div class:list={[line, i > 0 && 'border-t border-line']}>
            <span class:list={[bubble, 'bg-surface-container-low text-on-surface-variant']}>
              <Icon name={d.icon} size={20} />
            </span>
            <div class="min-w-0 flex-1">
              <p class="flex flex-wrap items-center gap-2 text-body-large text-ink">
                {d.title}
                {d.here && <span class="rounded-full bg-primary/10 px-2 py-0.5 text-label-medium text-primary">Thiết bị này</span>}
              </p>
              <p class="text-body-small text-on-surface-variant">{d.sub}</p>
            </div>
            {!d.here && (
              <button type="button" class="state-layer h-9 rounded-control px-3 text-label-large text-error">
                Đăng xuất
              </button>
            )}
          </div>
        ))
      }
    </div>
    <p class="mt-1 flex gap-2 rounded-field bg-surface-container-low px-3 py-2.5 text-body-small text-on-surface-variant">
      <Icon name="info-outline-rounded" size={16} class="mt-px" />Thiết bị này vẫn đăng nhập. Đăng nhập đã hơn 15 phút thì bạn đăng nhập lại một lần trước khi đăng xuất các thiết bị khác.
    </p>
  </div>

  <div class="grid grid-cols-1 items-start gap-4 md:grid-cols-2">
    <div class:list={[PANEL, 'p-5']}>
      <h2 class="text-title-medium font-semibold text-ink">Đã chặn · 1</h2>
      <div class="mt-3 flex items-center gap-3">
        <Photo src={img('1556740758-90de374c12ad', 96, 96)} width={96} height={96} alt="" loading="lazy" class="h-10 w-10 rounded-full object-cover" />
        <div class="min-w-0 flex-1">
          <p class="text-body-large text-ink">Thanh Lý 24h</p>
          <p class="text-body-small text-on-surface-variant">Chặn 02/10 · không nhắn được cho bạn</p>
        </div>
        <button type="button" class={btnCls('line')}>Bỏ chặn</button>
      </div>
    </div>
    <section class="rounded-panel border border-error/20 bg-error/5 p-5">
      <h2 class="flex items-center gap-2 text-title-medium font-semibold text-error">
        <Icon name="delete-forever-outline-rounded" size={20} />Xóa tài khoản
      </h2>
      <p class="mt-2 text-body-medium text-on-surface-variant">
        Tin đăng và trang của bạn được gỡ ngay. ShopNexus lưu ghi nhận của các đơn đã xong trong 12 tháng.
      </p>
      <button type="button" class="state-layer mt-3 h-10 rounded-control border border-error/40 px-4 text-label-large text-error">Xóa tài khoản</button>
    </section>
  </div>

  <Fragment slot="side">
    <div class:list={[PANEL, 'p-4']}>
      <div class="flex items-center gap-3">
        <span class:list={[bubble, 'bg-primary text-on-primary']}><Icon name="verified-user-outline-rounded" size={22} /></span>
        <div>
          <p class="text-title-medium font-semibold text-ink">2 cách đăng nhập</p>
          <p class="text-body-small text-on-surface-variant">Số điện thoại và Google</p>
        </div>
      </div>
      <p class="mt-3 text-body-small text-on-surface-variant">Đăng tin, hỏi mua và nhắn tin cần một số điện thoại đã xác minh.</p>
    </div>
    <SideList title="Hoạt động gần đây">
      {recent.map((r) => <Row icon={r.icon} title={r.title} sub={r.sub} tone={r.tone} chevron={false} class="-mx-2" />)}
    </SideList>
    <SideList title="Liên quan">
      <Row icon="lock-outline-rounded" title="Quyền riêng tư" sub="Người khác thấy gì về bạn" href={R.privacy} class="-mx-2" />
      <Row icon="help-outline-rounded" title="Thấy đăng nhập lạ?" sub="Gửi yêu cầu hỗ trợ" href={R.support} class="-mx-2" />
    </SideList>
  </Fragment>
</SettingsFrame>
