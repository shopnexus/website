---
import Photo from '../../components/Photo.astro';
// Tôi: the profile, what waits on the buyer, their listings, addresses and
// theme; on the side the profile steps, COD setup and the account links.
import codReady from '@brand/art_cod_ready.webp';
import tierTrusted from '@brand/tier_trusted.webp';
import Icon from '../../components/Icon.astro';
import Price from '../../components/Price.astro';
import Seg from '../../components/Seg.astro';
import AccountShell from '../../components/account/AccountShell.astro';
import Ring from '../../components/account/Ring.astro';
import Row from '../../components/account/Row.astro';
import { MY_LISTINGS } from '../../data/account';
import { ADDRESS_BOOK, PROFILE_TASKS, TASKS_DONE } from '../../data/common';
import { img } from '../../lib/format';
import { R } from '../../lib/routes';
import { requireViewer, theme } from '../../lib/session';
import { btnCls, LABEL, PANEL } from '../../lib/ui';

const v = requireViewer(Astro);
if (v instanceof Response) return v;

const stats = [
  ['14', 'đã bán'],
  ['8 phút', 'thường trả lời'],
  ['0', 'ghi nhận bị từ chối · 90 ngày'],
  ['0/11', 'COD bị từ chối nhận'],
];
const todo = PROFILE_TASKS.filter((t) => !t.done);
const doneList = PROFILE_TASKS.filter((t) => t.done)
  .map((t) => t.title.toLowerCase())
  .join(', ');
const settings = [
  { icon: 'notifications-outline-rounded', title: 'Thông báo', href: R.notifications },
  { icon: 'storefront-outline-rounded', title: 'Gói người bán', sub: 'Cơ bản · miễn phí', href: R.plans },
  { icon: 'shield-outline-rounded', title: 'Bảo mật và xác minh', href: R.security },
  { icon: 'help-outline-rounded', title: 'Trợ giúp và an toàn', sub: '2 yêu cầu đang xử lý', href: R.help },
];
---

<AccountShell title="Tôi · ShopNexus" active="me">
  <div class:list={[PANEL, 'p-5 md:p-6']}>
    <div class="flex flex-wrap items-center gap-5">
      <div class="relative shrink-0">
        <Photo src={img(v.photo, 176, 176)} width={176} height={176} alt="" class="h-[88px] w-[88px] rounded-full object-cover ring-4 ring-card" />
        <Photo src={tierTrusted} alt="" class="absolute -bottom-1 -right-2 h-9 w-9" />
      </div>
      <div class="min-w-[200px] flex-1">
        <h1 class="text-j-32 text-ink">{v.name}</h1>
        <p class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-body-medium text-on-surface-variant">
          <span class="flex items-center gap-1"><Icon name="star-rounded" size={15} class="text-star" />{v.rating} · 27 đánh giá</span>
          <span class="flex items-center gap-1"><Icon name="location-on-outline-rounded" size={15} />{v.area}</span>
          <span class="flex items-center gap-1"><Icon name="verified-rounded" size={15} class="text-primary" />Đã xác minh số điện thoại</span>
        </p>
        <span class="mt-2.5 inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-label-large text-primary">
          <Icon name="military-tech-outline-rounded" size={16} />Người bán tin cậy
        </span>
      </div>
      <div class="flex items-center gap-2 max-md:w-full md:self-start">
        <a href="#" class={btnCls('line', 'lg')}>Trang của bạn</a>
        <button type="button" class="state-layer grid h-11 w-11 place-items-center rounded-full border border-line bg-card text-ink" aria-label="Chia sẻ">
          <Icon name="share-outline-rounded" size={20} />
        </button>
      </div>
    </div>
    <div class="mt-5 grid grid-cols-2 gap-y-4 border-t border-line pt-4 md:flex md:divide-x md:divide-line">
      {
        stats.map(([value, label]) => (
          <div class="flex-1 pr-4 md:px-5 md:first:pl-0">
            <p class="text-j-26 tabular-nums text-ink" data-count>{value}</p>
            <p class="text-body-small text-on-surface-variant">{label}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <a href={R.support} class:list={['lift flex items-center gap-3 p-4', PANEL]}>
      <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-primary text-on-primary"><Icon name="support-agent-rounded" size={22} /></span>
      <span class="min-w-0 flex-1">
        <span class="flex items-center gap-2 text-title-small text-ink"
          >ShopNexus đã trả lời<span class="grid h-5 min-w-5 place-items-center rounded-full bg-error px-1.5 text-label-small text-on-error">1</span></span
        >
        <span class="block truncate text-body-small text-on-surface-variant">Báo chưa nhận hàng · Bạn kiểm tra giúp mình với bảo vệ toà nhà…</span>
      </span>
      <Icon name="chevron-right-rounded" size={20} class="text-on-surface-variant" />
    </a>
    <a href={R.sales} class:list={['lift flex flex-wrap items-center gap-3 p-4', PANEL]}>
      <Photo src={img('1580480055273-228ff5388ef8', 96, 96)} width={96} height={96} alt="" class="h-11 w-11 shrink-0 rounded-md object-cover" />
      <span class="min-w-0 flex-1">
        <span class="block text-title-small text-primary">Đang chờ bạn: tạo đơn cho Đức Huy</span>
        <span class="block truncate text-body-small text-on-surface-variant">Ghế xoay vải be chân gỗ · đã gửi yêu cầu COD</span>
      </span>
      <span class="flex h-9 shrink-0 items-center gap-1 rounded-full bg-ink px-3.5 text-label-large text-on-ink"
        >Mở Đơn bán<Icon name="arrow-forward-rounded" size={16} /></span
      >
    </a>
  </div>

  <div class:list={[PANEL, 'p-3']}>
    <div class="flex flex-wrap items-center justify-between gap-2 px-2 pb-1">
      <h2 class="text-j-20 text-ink">Tin của bạn</h2>
      <div class="flex flex-wrap items-center gap-3">
        <Seg items={['Đang bán 5', 'Nháp 2', 'Đã bán 14']} class="bg-surface-container-low" itemClass="text-label-medium" name="Tin của bạn" />
        <a href={R.myListings} class="text-label-large text-primary hover:underline">Xem cả 7 tin</a>
      </div>
    </div>
    <ul class="mt-2 flex flex-col">
      {
        MY_LISTINGS.map((l, i) => (
          <li>
            <a href={R.myListings} class="state-layer flex items-center gap-3 rounded-lg p-2">
              <Photo
                src={img(l.photo, 112, 112)}
                width={112}
                height={112}
                alt=""
                loading={i < 3 ? 'eager' : 'lazy'}
                class:list={['h-14 w-14 shrink-0 rounded-field object-cover', l.kind === 'sold' && 'opacity-60']}
              />
              <span class="min-w-0 flex-1">
                <span class="block truncate text-body-large text-ink">{l.title}</span>
                <span class="mt-0.5 flex flex-wrap items-center gap-3">
                  {l.kind === 'draft' && (
                    <span class="rounded-full bg-surface-container-low px-2 py-0.5 text-label-small text-on-surface-variant">Bản nháp</span>
                  )}
                  {l.kind === 'sold' && (
                    <span class="text-body-small text-on-surface-variant tabular-nums">
                      {l.price.toLocaleString('de-DE')} ₫ · bán tuần trước
                    </span>
                  )}
                  {l.kind === 'sale' && (
                    <>
                      <Price vnd={l.price} size="text-j-15" short={false} />
                      <span class="flex items-center gap-1 text-body-small text-on-surface-variant">
                        <Icon name="chat-outline-rounded" size={14} />
                        {l.chats}
                      </span>
                      <span class="flex items-center gap-1 text-body-small text-on-surface-variant">
                        <Icon name="visibility-outline-rounded" size={14} />
                        {l.views}
                      </span>
                      {'judge' in l && (
                        <span class="flex items-center gap-1 text-label-medium text-tertiary">
                          <Icon name="auto-awesome-rounded" size={13} />
                          {l.judge}
                        </span>
                      )}
                    </>
                  )}
                </span>
              </span>
              {l.kind === 'draft' && (
                <span class="flex h-9 shrink-0 items-center rounded-full bg-secondary-container px-4 text-label-large text-on-secondary-container">Tiếp tục</span>
              )}
              {l.kind === 'sold' && (
                <span class="shrink-0 rounded-full bg-surface-container-low px-2.5 py-1 text-label-medium text-on-surface-variant">Đã bán</span>
              )}
              {l.kind === 'sale' && <Icon name="chevron-right-rounded" size={20} class="text-on-surface-variant" />}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div class:list={[PANEL, 'p-4']}>
      <p class={LABEL}>Địa chỉ của tôi</p>
      <div class="mt-1 flex flex-col">
        {
          ADDRESS_BOOK.map((a) => (
            <Row icon={a.icon} sub={`${a.street} · ${a.ward.split(',')[0]}`} href={R.addresses} class="-mx-2">
              <Fragment slot="title">
                {a.label}
                {a.default && <span class="ml-1 rounded-full bg-secondary-container px-2 text-label-medium text-on-secondary-container">Mặc định</span>}
              </Fragment>
            </Row>
          ))
        }
        <Row icon="add-rounded" title="Thêm địa chỉ" href={R.addresses} tone="bg-primary/10 text-primary" chevron={false} class="-mx-2" />
      </div>
    </div>
    <div class:list={[PANEL, 'p-4']}>
      <p class={LABEL}>Giao diện</p>
      <p class="mt-3 px-1 text-body-large text-ink">Giao diện tối</p>
      <div class="mt-2">
        <Seg items={['Theo hệ thống', 'Sáng', 'Tối']} selected={['light', 'dark'].indexOf(theme(Astro) ?? '') + 1} class="bg-surface-container-low" itemClass="text-label-medium" name="Giao diện tối" />
      </div>
      <p class="mt-3 px-1 text-body-small text-on-surface-variant">Theo hệ thống thì trang đổi sáng tối cùng máy của bạn.</p>
    </div>
  </div>

  <Fragment slot="side">
    <div class:list={[PANEL, 'p-4']}>
      <div class="flex items-center gap-3">
        <Ring done={TASKS_DONE} total={PROFILE_TASKS.length} />
        <span class="flex-1">
          <span class="block text-title-medium font-semibold text-ink">Hoàn thiện hồ sơ</span>
          <span class="block text-body-small text-on-surface-variant">Còn {PROFILE_TASKS.length - TASKS_DONE} bước</span>
        </span>
      </div>
      <div class="mt-3 flex flex-col">
        {
          todo.map((t, i) => (
            <Row
              icon={t.icon}
              title={t.title}
              href={t.key === 'cod' ? R.codSetup : R.profileTasks}
              tone={i === 0 ? 'bg-primary/10 text-primary' : undefined}
              class="-mx-2"
            />
          ))
        }
      </div>
      <p class="mt-2 flex items-center gap-1.5 text-body-small text-on-surface-variant">
        <Icon name="check-circle-rounded" size={15} class="text-primary" />Đã xong: {doneList}
      </p>
    </div>

    <section class="relative overflow-hidden rounded-panel bg-radial-[120%_120%_at_100%_0%] from-teal-light via-teal-mid via-35% to-teal to-80% p-5 text-white">
      <Photo src={codReady} alt="" class="absolute -right-2 -top-2 h-24 w-24" />
      <p class="text-label-medium uppercase tracking-[0.12em] text-white/75">Giao COD</p>
      <p class="mt-1 max-w-[200px] text-j-20">Chưa liên kết bên vận chuyển</p>
      <p class="mt-2 text-body-small text-white/85">Liên kết tài khoản GHTK hoặc GHN của bạn để nhận đơn COD.</p>
      <a href={R.codSetup} class="state-layer mt-4 flex h-10 w-full items-center justify-center rounded-full bg-white text-label-large text-teal"
        >Thiết lập giao COD</a
      >
    </section>

    <div class:list={[PANEL, 'p-4']}>
      <p class={LABEL}>Tài khoản</p>
      <div class="mt-1 flex flex-col">
        {settings.map((s) => <Row icon={s.icon} title={s.title} sub={s.sub} href={s.href} class="-mx-2" />)}
      </div>
      <form method="post" action={R.logout} class="-mx-2 mt-1">
        <button type="submit" class="state-layer flex w-full items-center gap-3 rounded-field px-2 py-2 text-body-large text-error">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-error/10"><Icon name="logout-rounded" size={20} /></span>
          Đăng xuất
        </button>
      </form>
    </div>
  </Fragment>
</AccountShell>

<script>
  // "Giao diện tối" sets the theme and keeps it in a cookie; "Theo hệ thống" follows the system.
  const seg = document.querySelector<HTMLElement>('[aria-label="Giao diện tối"]');
  seg?.addEventListener('seg-change', (e) => {
    const i = (e as CustomEvent<{ index: number }>).detail.index;
    const t = ['', 'light', 'dark'][i];
    if (t) document.documentElement.dataset.theme = t;
    else delete document.documentElement.dataset.theme;
    document.cookie = t ? `sn_theme=${t}; path=/; max-age=31536000; samesite=lax` : 'sn_theme=; path=/; max-age=0';
  });
</script>
