---
import Notice from '../components/Notice.astro';
import Photo from '../components/Photo.astro';
// Đăng nhập. Google, the phone code, or a code mailed to an address
// (?method=email): the address step sends the code, the code step signs in and
// goes back to `next`. The email steps are form posts and work without script;
// Google and the phone get their proof from Firebase in the browser, which the
// page posts as a token. Signed in already, the page goes straight to `next`.
import CodeBoxes from '../components/CodeBoxes.astro';
import PhoneCode from '../components/PhoneCode.astro';
import GoogleG from '../components/GoogleG.astro';
import Icon from '../components/Icon.astro';
import Price from '../components/Price.astro';
import Layout from '../layouts/Layout.astro';
import { ApiError, idempotencyKey, type Schemas, unwrap } from '../lib/api/client';
import { area, near } from '../lib/area';
import { clock, group, where } from '../lib/format';
import { newest } from '../lib/feed';
import { R, localPath } from '../lib/routes';
import { keepTokens, viewer } from '../lib/session';
import { codeError, deviceName, dropChallenge, emailProof, readChallenge, resendSeconds, sendEmailCode, signIn, tokenKind, tokenProof } from '../lib/sign-in';
import { btnCls, CONTENT } from '../lib/ui';

// Only paths on this site; "//host" would leave it.
const raw = Astro.url.searchParams.get('next') ?? '';
const next = localPath(raw, R.home);
const here = (params: Record<string, string>) => `${R.login}?${new URLSearchParams({ ...params, ...(raw ? { next: raw } : {}) })}`;
const emailUrl = here({ method: 'email' });

let error: string | undefined;
// Why the last session ended: another device signed it out, or the account is suspended.
const endedParam = Astro.url.searchParams.get('ended');
let ended: 'elsewhere' | 'suspended' | undefined =
  endedParam === 'account_suspended' || Astro.locals.session.ended === 'account_suspended' ? 'suspended' : endedParam !== null ? 'elsewhere' : undefined;
/** Shows a failed step: its line, or for a suspended account the notice at the top. */
const fail = (e: unknown) => {
  const why = codeError(e);
  if (e instanceof ApiError && e.code === 'account_suspended') ended = 'suspended';
  else error = why.text;
  return why;
};
const device = deviceName(Astro.request.headers.get('user-agent'));
// Set when the address step failed (or a code ran out), so the address form shows again.
let email = '';
/** A sign-in that went through: keeps the tokens, drops the email challenge, goes on. */
const finish = (done: Schemas['SignIn']) => {
  keepTokens(Astro.cookies, Astro.url, done);
  dropChallenge(Astro.cookies);
  return Astro.redirect(done.account.is_new ? R.profileTasks : next, 303);
};
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const key = String(form.get('key') ?? '') || idempotencyKey();
  const step = form.get('step');
  if (step === 'send-code') {
    const to = String(form.get('email') ?? '');
    try {
      await sendEmailCode(Astro.locals.api, Astro.cookies, Astro.url, to, key);
      return Astro.redirect(emailUrl, 303);
    } catch (e) {
      fail(e);
      // A failed resend keeps the code step; the code already sent still works.
      if (!readChallenge(Astro.cookies)) email = to;
    }
  } else if (step === 'enter-code') {
    const c = readChallenge(Astro.cookies);
    if (!c) return Astro.redirect(emailUrl, 303);
    try {
      return finish(await signIn(Astro.locals.api, emailProof(c, form.getAll('code').join('')), key, device));
    } catch (e) {
      if (fail(e).restart) {
        dropChallenge(Astro.cookies);
        email = c.email;
      }
    }
  } else if (step === 'change-email') {
    dropChallenge(Astro.cookies);
    return Astro.redirect(emailUrl, 303);
  } else if (step === 'token') {
    // The proof the page's script got from Firebase.
    const kind = tokenKind(form.get('kind'));
    const proof = kind && tokenProof(kind, form.get('token'));
    if (!proof) return Astro.redirect(here({}), 303);
    try {
      return finish(await signIn(Astro.locals.api, proof, key, device));
    } catch (e) {
      fail(e);
    }
  } else {
    // Google and the phone posted without script.
    error = 'Đăng nhập bằng Google hoặc số điện thoại cần bật JavaScript. Bạn bật lên, hoặc dùng email nhé.';
  }
} else if (viewer(Astro)) {
  return Astro.redirect(next);
}

const byEmail = Astro.url.searchParams.get('method') === 'email';
const challenge = byEmail && !email ? readChallenge(Astro.cookies) : undefined;
const resendIn = challenge ? resendSeconds(challenge) : 0;
// One key per form as rendered: a double click sends the same action once.
const key = idempotencyKey();
const promises = [
  ['local-shipping-outline-rounded', 'Giao tận nơi, xem hàng rồi mới trả'],
  ['photo-camera-outline-rounded', 'Ảnh chụp trong app'],
  ['shield-outline-rounded', 'Không cọc trước'],
];
// The left column: how many listings are on sale and the newest near the buyer.
const api = Astro.locals.api;
const [home, fresh] = await Promise.all([
  unwrap(api.GET('/v1/screens/home', { params: { query: near(Astro.cookies) } })).catch(() => null),
  newest(Astro, 6),
]);
const onSale = home?.categories.reduce((n, c) => n + c.count, 0);
const place = area(Astro.cookies);
const field = 'mt-1.5 flex h-12 items-center gap-2 rounded-full border border-line bg-card px-1.5 focus-within:border-primary focus-within:ring-4 focus-within:ring-primary/10';
const sendBtn = 'state-layer h-9 shrink-0 rounded-control bg-brand px-4 text-label-large text-white';
---

<Layout title="Đăng nhập · ShopNexus" description="Đăng nhập bằng Google hoặc số điện thoại.">
  <main class={CONTENT}>
    <div class="mt-6 grid grid-cols-1 gap-8 lg:mt-8 lg:grid-cols-[1fr_400px] xl:grid-cols-[1fr_480px] xl:gap-10">
      <section class="order-2 min-w-0 lg:order-1 lg:pt-4">
        <h1 class="max-w-[640px] text-j-28 text-ink md:text-j-32 xl:text-j-32">
          Đồ cũ giá tốt,<br />xem hàng rồi mới trả.
        </h1>
        <div class="mt-6 flex flex-wrap gap-2">
          {
            promises.map(([icon, t]) => (
              <span class="border border-line bg-card flex h-10 items-center gap-2 rounded-full pl-3 pr-4 text-label-large text-ink">
                <Icon name={icon} size={18} class="text-primary" />
                {t}
              </span>
            ))
          }
        </div>
        {
          onSale !== undefined && (
            <div class="mt-7">
              <p class="text-j-28 tabular-nums text-ink" data-count>{group(onSale)}</p>
              <p class="text-body-small text-on-surface-variant">món đang bán</p>
            </div>
          )
        }
        {
          fresh.length > 0 && (
            <>
              <h2 class="mt-8 text-title-medium font-semibold text-ink">{place ? `Mới đăng quanh ${place.name}` : 'Mới đăng'}</h2>
              <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-3">
                {fresh.map((it) => (
                  <a href={R.listing(it.id)} class="lift block min-w-0 rounded-card border border-line bg-card p-1.5">
                    <div class="relative overflow-hidden rounded-[15px] bg-soft" style="aspect-ratio: 4 / 3">
                      {it.photo && <Photo src={it.photo} width={360} height={270} alt={it.title} class="h-full w-full object-cover" />}
                      <span class="absolute left-1.5 top-1.5 flex items-center gap-0.5 rounded-full bg-white/85 px-2 py-0.5 text-label-small text-photo-ink backdrop-blur">
                        <Icon name="near-me-outline-rounded" size={12} />
                        {where(it.km, it.area)}
                      </span>
                    </div>
                    <p class="px-1.5 pt-2">
                      <Price vnd={it.price} size="text-j-16" />
                    </p>
                    <p class="truncate px-1.5 pb-1 text-body-small text-on-surface-variant">{it.title}</p>
                  </a>
                ))}
              </div>
            </>
          )
        }
      </section>

      <section class="border border-line bg-card order-1 self-start rounded-card p-5 shadow-soft md:p-7 lg:order-2">
        {
          ended && (
            <div role="alert" class="mb-6 flex items-start gap-3 rounded-tile bg-white/70 p-3.5" data-ended>
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-surface-container-low text-on-surface-variant">
                <Icon name={ended === 'suspended' ? 'lock-outline-rounded' : 'devices-off-outline-rounded'} size={18} />
              </span>
              {ended === 'suspended' ? (
                <div class="min-w-0 flex-1">
                  <p class="text-title-small text-ink">Tài khoản đang bị khóa</p>
                  <p class="text-body-small text-on-surface-variant">
                    Tài khoản này tạm thời không đăng nhập được. Xem lý do và cách mở lại ở <a href={R.help} class="text-primary hover:underline">Trợ giúp</a>.
                  </p>
                </div>
              ) : (
                <div class="min-w-0 flex-1">
                  <p class="text-title-small text-ink">Bạn đã được đăng xuất</p>
                  <p class="text-body-small text-on-surface-variant">Phiên này đã kết thúc từ một thiết bị khác. Đăng nhập lại để tiếp tục.</p>
                </div>
              )}
              <button
                type="button"
                class="state-layer h-8 shrink-0 rounded-control px-2.5 text-label-large text-primary"
                onclick="this.closest('[data-ended]').remove()"
              >
                Đã hiểu
              </button>
            </div>
          )
        }
        <h2 class="text-j-28 text-ink">Đăng nhập</h2>
        <div hidden={!error} data-alert>
          <Notice text={error ?? ''} class="mt-4" />
        </div>
        {
          challenge ? (
            <form method="post" data-login>
              <input type="hidden" name="key" value={key} />
              <input type="hidden" name="step" value="enter-code" />
              <div class="mt-5">
                <div class="flex items-baseline justify-between">
                  <h3 class="text-title-medium font-semibold text-ink">Nhập mã 6 số</h3>
                  {resendIn > 0 && (
                    <span class="text-body-small text-on-surface-variant tabular-nums" data-resend={resendIn}>
                      Gửi lại sau {clock(resendIn)}
                    </span>
                  )}
                </div>
                <p class="mt-0.5 text-body-small text-on-surface-variant">Gửi tới {challenge.email}</p>
                <CodeBoxes />
                <button class:list={[btnCls('ink', 'lg'), 'mt-4 w-full']} data-code-submit>Đăng nhập</button>
              </div>
            </form>
            <form method="post" class="mt-2 flex flex-wrap justify-between gap-2">
              <input type="hidden" name="key" value={key} />
              <input type="hidden" name="email" value={challenge.email} />
              <button name="step" value="change-email" class="state-layer h-8 rounded-control px-2 text-label-large text-primary">
                Đổi email
              </button>
              <button name="step" value="send-code" class="state-layer h-8 rounded-control px-2 text-label-large text-primary" disabled={resendIn > 0} data-resend-btn>
                Gửi lại mã
              </button>
            </form>
          ) : byEmail ? (
            <form method="post">
              <input type="hidden" name="key" value={key} />
              <label for="email" class="mt-5 block text-label-medium text-on-surface-variant">Email</label>
              <div class={field}>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  value={email}
                  placeholder="ban@email.com"
                  class="min-w-0 flex-1 bg-transparent pl-3 text-body-large text-ink outline-none placeholder:text-faint"
                />
                <button name="step" value="send-code" class={sendBtn}>Gửi mã</button>
              </div>
              <p class="mt-2 text-body-small text-on-surface-variant">Mã 6 số có hiệu lực trong 5 phút.</p>
              <a href={here({})} class="state-layer mt-3 flex h-8 w-fit items-center gap-1 rounded-control px-2 text-label-large text-primary">
                <Icon name="phone-iphone-outline-rounded" size={16} />Dùng số điện thoại
              </a>
            </form>
          ) : (
            <div data-phone-flow>
              <form method="post" data-phone-hide>
                <input type="hidden" name="key" value={key} />
                <button name="step" value="google" class:list={[btnCls('line', 'lg'), 'mt-5 !h-12 w-full gap-3']} data-google>
                  <GoogleG />
                  Tiếp tục với Google
                </button>
              </form>
              <div class="my-5 flex items-center gap-3 text-body-small text-on-surface-variant" data-phone-hide>
                <span class="h-px flex-1 bg-line"></span>hoặc<span class="h-px flex-1 bg-line"></span>
              </div>
              <form method="post" data-phone-start>
                <input type="hidden" name="key" value={key} />
                <label for="phone" class="block text-label-medium text-on-surface-variant">Số điện thoại</label>
                <div class={field}>
                  <span class="flex h-9 items-center rounded-full bg-surface-container-low px-3 text-label-large text-ink">+84</span>
                  <input
                    id="phone"
                    name="phone"
                    type="tel"
                    inputmode="tel"
                    autocomplete="tel-national"
                    class="min-w-0 flex-1 bg-transparent text-body-large text-ink tabular-nums outline-none"
                  />
                  <button name="step" value="phone" class={sendBtn}>Gửi mã</button>
                </div>
                <noscript>
                  <p class="mt-2 text-body-small text-on-surface-variant">Google và số điện thoại cần bật JavaScript. Không bật được thì dùng email.</p>
                </noscript>
                <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
                  <p class="flex items-center gap-1.5 text-body-small text-on-surface-variant">
                    <Icon name="visibility-off-outline-rounded" size={16} />Người khác không thấy số của bạn.
                  </p>
                  <a href={emailUrl} class="state-layer flex h-8 items-center gap-1 rounded-control px-2 text-label-large text-primary">
                    <Icon name="mail-outline-rounded" size={16} />Dùng email
                  </a>
                </div>
              </form>
              {/* The phone's code step, which the script shows after Firebase texts the code. */}
              <div class="mt-2">
                <PhoneCode title="Nhập mã 6 số" submitLabel="Đăng nhập" change wide />
              </div>
              <form method="post" hidden data-token-form>
                <input type="hidden" name="key" value={key} />
                <input type="hidden" name="step" value="token" />
                <input type="hidden" name="kind" />
                <input type="hidden" name="token" />
              </form>
            </div>
          )
        }
        <p class="mt-5 text-center text-body-small text-on-surface-variant">
          Tiếp tục là bạn đồng ý với <a href={R.terms} class="text-primary hover:underline">Điều khoản sử dụng</a> và <a
            href={R.privacy}
            class="text-primary hover:underline">Chính sách quyền riêng tư</a
          > của ShopNexus.
        </p>
        <a href={next} class="state-layer mx-auto mt-2 flex h-10 w-fit items-center gap-1.5 rounded-control px-4 text-label-large text-primary">
          Xem trước, đăng nhập sau<Icon name="arrow-forward-rounded" size={18} />
        </a>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { codeBoxes } from '../lib/code-boxes';
  import { phoneFlow } from '../lib/phone-flow';
  import { alertLine, googleButton, postToken, resendTimer, stepper } from '../lib/proof-form';

  // The code boxes, and the email code's "Gửi lại sau" countdown.
  codeBoxes();
  resendTimer();

  // Google and the phone: Firebase proves the account in the browser, and
  // the token form posts the proof to this page, which signs in.
  const flow = document.querySelector<HTMLElement>('[data-phone-flow]');
  const tokenForm = document.querySelector<HTMLFormElement>('[data-token-form]');
  if (flow && tokenForm) {
    const say = alertLine(document.querySelector('[data-alert]'));
    const step = stepper(say);
    googleButton(flow.querySelector('[data-google]')!, step, say, (token) => postToken(tokenForm, 'google', token));
    phoneFlow(flow, step, (token) => postToken(tokenForm, 'phone', token));
  }
</script>
