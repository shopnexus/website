---
import '../styles/global.css';
import appleTouchIcon from '@brand/apple-touch-icon.png';
import favicon from '@brand/favicon.svg';
import favicon32 from '@brand/favicon-32.png';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import Header, { type Section } from '../components/Header.astro';
import PersonCard from '../components/PersonCard.astro';
import ListingPageSkeleton from '../components/public/ListingPageSkeleton.astro';
import Snackbar from '../components/Snackbar.astro';
import { theme } from '../lib/theme';

interface Props {
  title: string;
  description?: string;
  /** The header's current section, or null outside the four. */
  section?: Section | null;
  /** Tìm kiếm puts its field in the header: the query text, and the photo it came from. */
  search?: { q: string; photo?: string };
  /** Tin nhắn's panes fill the window and leave the footer out. */
  footer?: boolean;
  /** Hides the compact "Đăng tin" button on the posting pages. */
  fab?: boolean;
  /** Open Graph image. */
  image?: string;
}

const { title, description, section = null, search, footer = true, fab = true, image } = Astro.props;
---

<html lang="vi" data-theme={theme(Astro)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={favicon.src} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {image && <meta property="og:image" content={image} />}
    <meta property="og:site_name" content="ShopNexus" />
    <slot name="head" />
    <!-- Hold the first paint until the page is parsed, so pagereveal below
         finds the listing photo it pairs with the one on the last page. -->
    <link rel="expect" href="#page-end" blocking="render" />
    <script is:inline>
      // Runs before the first paint. `js` lets motion.css hide a photo until
      // it has loaded; the rest pairs a listing's photo across a page change,
      // card to gallery and back, for the view transition in motion.css.
      document.documentElement.classList.add('js');
      const loaded = (e) => e.target instanceof HTMLImageElement && (e.target.dataset.loaded = '');
      // On document: an image's load event does not reach window.
      document.addEventListener('load', loaded, true);
      document.addEventListener('error', loaded, true);

      let tapped = null;
      addEventListener('click', (e) => (tapped = e.target.closest?.('a[href]') ?? null), true);
      const photoOf = (a) => a.querySelector('img') ?? a.closest('article, li')?.querySelector('img');

      // A listing tap still on this page after 100 ms grows the card's photo into
      // a skeleton of the listing page; the real page then replaces it.
      let skeleton = null;
      let wait = 0;
      const dropSkeleton = () => {
        clearTimeout(wait);
        skeleton?.remove();
        skeleton = null;
      };
      const showSkeleton = (img) => {
        const tpl = document.getElementById('listing-skeleton');
        if (!tpl || skeleton) return;
        const el = tpl.content.firstElementChild.cloneNode(true);
        el.style.top = (document.querySelector('header.glass')?.offsetHeight ?? 0) + 'px';
        const photo = el.querySelector('[data-skeleton-photo]');
        if (img?.currentSrc) photo.src = img.currentSrc;
        else photo.classList.add('skeleton');
        const swap = () => {
          if (img) img.style.viewTransitionName = '';
          if (img?.currentSrc) photo.style.viewTransitionName = 'listing-photo';
          document.body.append(el);
          skeleton = el;
        };
        if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) return swap();
        if (img?.currentSrc) img.style.viewTransitionName = 'listing-photo';
        document.startViewTransition(swap);
      };
      addEventListener('click', (e) => {
        const a = tapped;
        if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if ((a.target && a.target !== '_self') || a.hasAttribute('download') || a.origin !== location.origin) return;
        if (!a.pathname.startsWith('/listings/') || a.pathname === location.pathname) return;
        clearTimeout(wait);
        wait = setTimeout(() => showSkeleton(photoOf(a)), 100);
      });
      // Back from the next page, or a navigation the buyer stopped.
      addEventListener('pageshow', dropSkeleton);
      addEventListener('keydown', (e) => e.key === 'Escape' && dropSkeleton());
      // A transition draws above the top layer, so a photo paired under an open
      // dialog or popover would cover it until the transition ends.
      const covered = () => {
        try { return !!document.querySelector('dialog:modal, :popover-open'); } catch { return false; }
      };
      const pair = (img, vt) => {
        if (!img || covered()) return;
        img.style.viewTransitionName = 'listing-photo';
        img.dataset.loaded = '';
        vt.finished.finally(() => (img.style.viewTransitionName = ''));
      };
      // The gallery photo in view (Gallery.astro): the first one on arrival.
      const gallery = () => {
        const t = document.querySelector('[data-gallery] [data-slides]');
        return t ? (t.children[Math.round(t.scrollLeft / Math.max(1, t.clientWidth))] ?? t.children[0]) : null;
      };
      addEventListener('pageswap', (e) => {
        clearTimeout(wait);
        if (!e.viewTransition || !e.activation?.entry?.url) return;
        const to = new URL(e.activation.entry.url);
        if (skeleton) pair(skeleton.querySelector('[data-skeleton-photo][src]'), e.viewTransition);
        else if (to.pathname.startsWith('/listings/') && tapped?.pathname === to.pathname) pair(photoOf(tapped), e.viewTransition);
        else pair(gallery(), e.viewTransition);
      });
      addEventListener('pagereveal', (e) => {
        dropSkeleton();
        if (!e.viewTransition) return;
        if (gallery()) return pair(gallery(), e.viewTransition);
        const from = window.navigation?.activation?.from?.url;
        if (!from) return;
        const path = new URL(from).pathname;
        const seen = [...document.querySelectorAll('a[href="' + path + '"]')].map(photoOf).find((img) => {
          const r = img?.getBoundingClientRect();
          return r && r.bottom > 0 && r.top < innerHeight;
        });
        pair(seen, e.viewTransition);
      });
    </script>
  </head>
  <body class="min-h-dvh font-sans text-body-large">
    <div class="relative min-h-dvh overflow-x-clip pb-40 lg:pb-0">
      <div class="relative z-10">
        <Header section={section} search={search} />
        <slot />
        {footer && <Footer />}
      </div>
    </div>
    <BottomNav section={section} fab={fab} />
    <Snackbar />
    <PersonCard />
    <template id="listing-skeleton"><ListingPageSkeleton /></template>
    <span id="page-end" hidden></span>
    <script>
      import '../scripts/page-motion';
    </script>
  </body>
</html>
