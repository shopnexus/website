# Everything at the top of the repository is ignored unless listed here, so
# a stray file there is never committed by accident. A new top-level file or
# directory needs its own line.
/*
!/.dockerignore
!/.env.example
!/.github/
!/.gitignore
!/.superdesign/
!/.vscode/
!/AGENTS.md
!/CLAUDE.md
!/DESIGN.md
!/Dockerfile
!/LICENSE
!/README.md
!/astro.config.mjs
!/bun.lock
!/package.json
!/public/
!/src/
!/tsconfig.json

# Inside the directories above:
# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# superdesign scratch files
.superdesign/tmp/
.superdesign/prototypes/map/*.pmtiles
__pycache__/
